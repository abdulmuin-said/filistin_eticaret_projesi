# ==========================================
# Ortam Değişkenleri (docker-compose için)
# ==========================================
# Bu dosyayı .env.example olarak commit edin.
# Gerçek değerlerle .env dosyası oluşturun.
# .env dosyasını ASLA git'e pushlamayın!

POSTGRES_DB=filistindb
POSTGRES_USER=kanvasuser
POSTGRES_PASSWORD=changeme_in_production

# ==========================================
# DataProtection Key Yolu (Container)
# ==========================================
# Docker volume mount: /app/secure-storage/dataprotection-keys
# Container restart sonrası key kalıcılığı için named volume zorunlu.
# Yerel geliştirmede otomatik: App_Data/DataProtectionKeys
DATA_PROTECTION_KEYS_PATH=/app/secure-storage/dataprotection-keys

# ==========================================
# Docker Mailserver SMTP Ayarları
# ==========================================
# Web ve mailserver farklı Docker Compose projelerindeyse host gateway ile bağlanır.
# Aynı Docker network'ündeyse EMAIL_HOST=mailserver kullanın.
# SMTP kullanıcısı ve gönderici adresi mailserver içinde oluşturduğunuz posta kutusu olmalıdır.

EMAIL_HOST=host.docker.internal
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=7ANRPS48
