@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AboutUs"];
    ViewData["SeoTitle"] = Localizer["AboutUs"] + " - 7ANRPS48";
}

<div class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <span class="text-brand-darktext font-medium">@Localizer["AboutUs"]</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="text-center mb-12">
        <h1 class="font-serif text-3xl md:text-5xl text-brand-olive mb-4">@Localizer["AboutUs"]</h1>
        <div class="w-16 h-1 bg-brand-gold mx-auto"></div>
    </div>

    <div class="bg-white border border-brand-border rounded-lg p-8 md:p-12 shadow-sm prose prose-sm md:prose-base max-w-none prose-headings:font-serif prose-headings:text-brand-olive prose-a:text-brand-gold prose-strong:text-brand-darktext">

        <div class="text-center mb-8">
            <p class="text-xl text-brand-mutedtext italic font-serif">"@Localizer["AboutQuote"]"</p>
        </div>

        <h2>@Localizer["OurStory"]</h2>
        <p>@Localizer["OurStoryContent"]</p>

        <h2>@Localizer["OurVision"]</h2>
        <p>@Localizer["OurVisionContent"]</p>

        <h2>@Localizer["WhyUs"]</h2>
        <ul>
            <li><strong>@Localizer["WhyUsPremium"]</strong> @Localizer["WhyUsPremiumContent"]</li>
            <li><strong>@Localizer["WhyUsDurable"]</strong> @Localizer["WhyUsDurableContent"]</li>
            <li><strong>@Localizer["WhyUsShipping"]</strong> @Localizer["WhyUsShippingContent"]</li>
        </ul>

        <div class="mt-12 bg-brand-cream p-6 text-center border border-brand-border rounded">
            <h3 class="mt-0 font-serif text-brand-olive">@Localizer["ContactUs"]</h3>
            <p class="text-sm">@Localizer["ContactUsDescription"]</p>
            <a href="/Kurumsal/Iletisim" class="inline-block mt-4 bg-brand-olive text-white px-6 py-2 text-xs uppercase tracking-widest rounded hover:bg-[#1c2001] transition-colors no-underline">
                @Localizer["ContactPage"]
            </a>
        </div>

    </div>
</div>
