@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ReturnExchange"];
    ViewData["SeoTitle"] = Localizer["ReturnExchange"] + " - 7ANRPS48";
}

<div class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <span class="text-brand-darktext font-medium">@Localizer["ReturnExchange"]</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-4xl">
    <div class="text-center mb-12">
        <h1 class="font-serif text-3xl md:text-5xl text-brand-olive mb-4">@Localizer["ReturnExchange"]</h1>
        <div class="w-16 h-1 bg-brand-gold mx-auto"></div>
    </div>

    <div class="bg-white border border-brand-border rounded-lg p-8 md:p-12 shadow-sm prose prose-sm md:prose-base max-w-none prose-headings:font-serif prose-headings:text-brand-olive prose-a:text-brand-gold prose-strong:text-brand-darktext">

        <h2>@Localizer["GeneralReturnTerms"]</h2>
        <p>@Localizer["GeneralReturnTermsContent"]</p>

        <h2>@Localizer["ReturnProcess"]</h2>
        <ul>
            <li>@Localizer["ReturnCondition"]</li>
            <li>@Localizer["ReturnHowTo"]</li>
            <li>@Localizer["ReturnShipping"]</li>
        </ul>

        <h2>@Localizer["DamagedProducts"]</h2>
        <p>@Localizer["DamagedProductsContent"]</p>

        <h2>@Localizer["CustomDesignProducts"]</h2>
        <p>@Localizer["CustomDesignProductsContent"]</p>

        <h2>@Localizer["Refund"]</h2>
        <p>@Localizer["RefundContent"]</p>

    </div>
</div>
