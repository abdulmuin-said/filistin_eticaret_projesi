@using FilistinProje.Web.Extensions
@using System.Globalization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject FilistinProje.Core.Interfaces.ISepetService SepetService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessorForCart
@inject UserManager<FilistinProje.Core.Varliklar.AppUser> UserManagerForCart
@using Microsoft.AspNetCore.Identity
@using FilistinProje.Core.Varliklar
@{
    var siteSettings = SiteSettingsService.GetSettings();
    var _cartUserId = UserManagerForCart.GetUserId(User);
    var _cartSessionId = HttpContextAccessorForCart.HttpContext?.Features.Get<Microsoft.AspNetCore.Http.Features.ISessionFeature>()?.Session?.Id ?? string.Empty;
    var sepetCount = await SepetService.GetSepetUrunSayisiAsync(_cartUserId, _cartSessionId);
    var brandName = string.IsNullOrWhiteSpace(siteSettings.MarkaAdi) ? siteSettings.SiteAdi : siteSettings.MarkaAdi;
    var pageTitle = ViewData["Title"]?.ToString();
    var seoTitle = ViewData["SeoTitle"]?.ToString();
    var layoutTitle = !string.IsNullOrWhiteSpace(seoTitle)
        ? seoTitle
        : (string.IsNullOrWhiteSpace(pageTitle) ? brandName : $"{pageTitle} - {brandName}");
    var metaDescription = ViewData["MetaDescription"]?.ToString();
    if (string.IsNullOrWhiteSpace(metaDescription))
    {
        metaDescription = string.IsNullOrWhiteSpace(siteSettings.MetaDescription)
            ? (string.IsNullOrWhiteSpace(siteSettings.SiteAciklamasi) ? "منتجات ديكور احترافية متميزة." : siteSettings.SiteAciklamasi)
            : siteSettings.MetaDescription;
    }
    var metaKeywords = ViewData["MetaKeywords"]?.ToString();
    var logoUrl = string.IsNullOrWhiteSpace(siteSettings.SiteLogoUrl) ? "/74anrps48logo2.svg" : siteSettings.SiteLogoUrl;
    var touchIconUrl = "/favicon.svg";
    var faviconUrl = string.IsNullOrWhiteSpace(siteSettings.FaviconUrl) ? "/favicon.svg" : siteSettings.FaviconUrl;
    var viewOgImage = ViewData["OgImage"]?.ToString();
    var ogImage = !string.IsNullOrWhiteSpace(viewOgImage)
        ? SiteSettingsService.BuildAbsoluteUrl(viewOgImage)
        : (string.IsNullOrWhiteSpace(siteSettings.VarsayilanSosyalPaylasimGorseliUrl)
            ? SiteSettingsService.BuildAbsoluteUrl(logoUrl)
            : SiteSettingsService.BuildAbsoluteUrl(siteSettings.VarsayilanSosyalPaylasimGorseliUrl));
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "/";
    var currentQuery = HttpContextAccessor.HttpContext?.Request.QueryString.Value ?? string.Empty;
    var currentUrl = SiteSettingsService.BuildAbsoluteUrl($"{currentPath}{currentQuery}");
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentDirection = currentCulture == "ar" ? "rtl" : "ltr";
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();

    canonicalUrl = string.IsNullOrWhiteSpace(canonicalUrl)
        ? currentUrl
        : SiteSettingsService.BuildAbsoluteUrl(canonicalUrl);
    var ogType = string.IsNullOrWhiteSpace(ViewData["OgType"]?.ToString()) ? "website" : ViewData["OgType"]!.ToString();
    var rawThemeColor = siteSettings.TemaRengi?.Trim();
    var validThemeColor = !string.IsNullOrWhiteSpace(rawThemeColor) && System.Text.RegularExpressions.Regex.IsMatch(rawThemeColor, @"^#[0-9A-Fa-f]{6}$")
        ? rawThemeColor
        : null;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@currentDirection">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@layoutTitle</title>
<link rel="icon" href="@faviconUrl" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="@touchIconUrl">
    <link rel="canonical" href="@canonicalUrl">
    <meta name="description" content="@metaDescription">
    @if (!string.IsNullOrWhiteSpace(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords">
    }
    <meta property="og:site_name" content="@brandName">
    <meta property="og:title" content="@layoutTitle">
    <meta property="og:description" content="@metaDescription">
    <meta property="og:type" content="@ogType">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:image" content="@ogImage">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@layoutTitle">
    <meta name="twitter:description" content="@metaDescription">
    <meta name="twitter:image" content="@ogImage">

    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <script src="~/vendor/firebase/firebase-app-compat.js" asp-append-version="true"
            crossorigin="anonymous"
            async defer></script>
    <script src="~/vendor/firebase/firebase-messaging-compat.js" asp-append-version="true"
            crossorigin="anonymous"
            async defer></script>
    <link rel="stylesheet" href="~/vendor/fonts/local-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" asp-append-version="true" />

    @if (!string.IsNullOrWhiteSpace(validThemeColor))
    {
        <style>
            :root {
                --brand-primary: @validThemeColor;
            }
            .btn-primary, .bg-brand-olive, .brand-primary-bg {
                background-color: var(--brand-primary) !important;
            }
            .btn-primary:hover {
                filter: brightness(0.9);
            }
            .text-brand-olive, .brand-primary-text {
                color: var(--brand-primary) !important;
            }
            .border-brand-olive, .brand-primary-border {
                border-color: var(--brand-primary) !important;
            }
        </style>
    }
    <style data-purpose="custom-fonts">
        body { font-family: 'IBM Plex Sans Arabic', 'Inter', -apple-system, sans-serif; color: var(--color-text-dark); padding: 0 !important; margin: 0 !important; background: var(--color-cream) !important; font-size: 14px; line-height: 1.6; }
        h1, h2, h3, h4, h5, h6, .font-serif { font-family: 'IBM Plex Sans Arabic', 'Inter', sans-serif; font-weight: 600; }
        .text-xxs { font-size: 0.65rem; }
        nav a, button, .tracking-widest { letter-spacing: 0.1em; }
    </style>
    <style data-purpose="custom-utilities">
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .custom-scrollbar::-webkit-scrollbar { display: none; }
        .custom-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .trust-ticker-track { width: max-content; animation: trustTicker 80s linear infinite; will-change: transform; }
        .trust-ticker-group { display: flex; align-items: center; flex-shrink: 0; }
        .trust-ticker:hover .trust-ticker-track { animation-play-state: paused; }
        @@keyframes trustTicker {
            from { transform: translate3d(0, 0, 0); }
            to { transform: translate3d(-50%, 0, 0); }
        }
@@media (prefers-reduced-motion: reduce) {
            .trust-ticker-track { animation: none; transform: translateX(0); }
        }
        
        /* Cart bounce animation */
        @@keyframes cartBounce {
            0% { transform: scale(1); }
            50% { transform: scale(1.5); }
            100% { transform: scale(1); }
        }
        .bounce-animation {
            animation: cartBounce 0.4s ease-out;
        }

        /* Floating cart gentle pulse */
        @@keyframes cartPulse {
            0%, 100% { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1); }
            50% { box-shadow: 0 0 0 8px rgba(49, 53, 17, 0.15); }
        }
        .floating-cart-btn {
            animation: cartPulse 3s ease-in-out infinite;
        }
        .floating-cart-btn:hover {
            animation: none;
        }
        
        /* Kategori menusu dropdown opacity/visibility gecisi */
        [data-category-dropdown] {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease, visibility 0.25s ease !important;
            transition-delay: 0.15s !important;
        }
        li[data-category-menu-item]:hover > div[data-category-dropdown] {
            opacity: 1 !important;
            visibility: visible !important;
            transition-delay: 0s !important;
        }
        /* Header dropdown'larÄ±n slider Ã¼stÃ¼nde kalmasÄ± iÃ§in */
        header.sticky {
            z-index: 9999 !important;
        }

        /* Footer styles */
        .site-footer a { transition: color 0.2s ease; }
        .footer-social-link {
            width: 40px; height: 40px;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 999px;
            background: rgba(255,255,255,0.05);
            transition: all 0.2s ease;
            font-size: 1.1rem;
        }
        .footer-social-link:hover {
            background: rgba(255,255,255,0.12);
            transform: translateY(-2px);
        }
        @@media (max-width: 767px) {
            .footer-social-link { width: 36px; height: 36px; font-size: 0.95rem; }
        }

        /* Mobile nav panel animation */
        .mobile-nav-panel {
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .mobile-nav-panel.is-open {
            transform: translateX(0);
        }
        .mobile-nav-backdrop {
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .mobile-nav-backdrop.is-open {
            opacity: 1;
        }

        /* ─── Premium Motion Scroll Reveal Styles ─── */
        .motion-reveal,
        .motion-stagger-item {
            opacity: 0;
            transform: translate3d(0, 20px, 0);
            transition: opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1), transform 0.58s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .motion-stagger-item {
            transition-delay: var(--motion-delay, 0ms);
        }
        .motion-reveal.is-visible,
        .motion-stagger-item.is-visible {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
        .motion-reveal.is-animating,
        .motion-stagger-item.is-animating,
        .motion-hero-prep {
            will-change: opacity, transform;
        }
        .motion-hero-prep {
            opacity: 0;
            transform: translate3d(0, 14px, 0) scale(0.985);
            transition: opacity 0.66s cubic-bezier(0.22, 1, 0.36, 1), transform 0.66s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .motion-hero-prep.is-visible {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
        }

        /* ─── Skeleton Loading & Lazy Load Styles ─── */
        .skeleton {
            background-color: #f7f1e6;
            position: relative;
            overflow: hidden;
        }
        .skeleton::after {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            left: 0;
            transform: translateX(-100%);
            background-image: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0%,
                rgba(255, 255, 255, 0.4) 30%,
                rgba(255, 255, 255, 0.6) 60%,
                rgba(255, 255, 255, 0) 100%
            );
            animation: shimmer 1.6s infinite;
            content: '';
        }
        .rtl .skeleton::after {
            animation: shimmer-rtl 1.6s infinite;
        }
        @@keyframes shimmer {
            100% { transform: translateX(100%); }
        }
        @@keyframes shimmer-rtl {
            100% { transform: translateX(-100%); }
        }
        .img-lazy-load {
            opacity: 0;
            transition: opacity 0.4s ease-in-out;
            will-change: opacity;
        }
        .img-lazy-load.loaded {
            opacity: 1;
        }

        /* ─── RTL Icon & Focus-Visible A11y overrides ─── */
        html[dir="rtl"] .fa-arrow-right,
        html[dir="rtl"] .fa-chevron-right,
        html[dir="rtl"] .fa-long-arrow-alt-right {
            transform: scaleX(-1);
            display: inline-block;
        }
        html[dir="rtl"] .fa-arrow-left,
        html[dir="rtl"] .fa-chevron-left,
        html[dir="rtl"] .fa-long-arrow-alt-left {
            transform: scaleX(-1);
            display: inline-block;
        }

        /* Focus state visibility helper */
        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible {
            outline: 2px solid #b58735 !important;
            outline-offset: 2px !important;
        }

        @@media (prefers-reduced-motion: reduce) {
            .motion-reveal,
            .motion-stagger-item,
            .motion-hero-prep {
                transition-duration: 0.01ms !important;
                transition-delay: 0ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
            .motion-reveal,
            .motion-stagger-item,
            .motion-hero-prep,
            .motion-reveal.is-visible,
            .motion-stagger-item.is-visible,
            .motion-hero-prep.is-visible {
                opacity: 1 !important;
                transform: none !important;
            }
        }
    </style>
    
    @* site.css legacy — removed, all styles in storefront.css *@
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var isProductDetailPage =
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Urun", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Detay", StringComparison.OrdinalIgnoreCase);
}
<body class="bg-brand-cream overflow-x-hidden antialiased flex flex-col min-h-screen @(isProductDetailPage ? "product-detail-page" : string.Empty)">
    <form id="globalAntiForgeryForm" class="hidden">
        @Html.AntiForgeryToken()
    </form>

@await Html.PartialAsync("_Header")


    <main class="flex-grow">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/firebase-init.js" asp-append-version="true"></script>
    <script nonce="firebase-config">
        // ============================================================
        // FIREBASE PUSH BILDIRIM â€” Yapilandirma
        // ============================================================
        var firebaseConfig = {
            apiKey: '@Configuration["Firebase:ApiKey"]',
            authDomain: '@Configuration["Firebase:AuthDomain"]',
            projectId: '@Configuration["Firebase:ProjectId"]',
            storageBucket: '@Configuration["Firebase:StorageBucket"]',
            messagingSenderId: '@Configuration["Firebase:MessagingSenderId"]',
            appId: '@Configuration["Firebase:AppId"]'
        };
        window.__firebaseVapidKey = '@Configuration["Firebase:VapidKey"]';

        if (typeof window.__firebaseReady === 'function') {
            window.__firebaseReady(firebaseConfig);
        }

        if ('serviceWorker' in navigator) {
            var isConfigured = firebaseConfig.apiKey && firebaseConfig.apiKey.length > 5;
            if (isConfigured) {
                navigator.serviceWorker.register('/firebase-messaging-sw.js')
                    .then(function (registration) {
                        registration.active && registration.active.postMessage({ type: 'FIREBASE_CONFIG', config: firebaseConfig });
                    })
                    .catch(function () {});
            }
        }
    </script>
    <script>
        window.toggleMobileNav = function(open) {
            const drawer = document.getElementById('mobileNav');
            const backdrop = document.getElementById('mobileNavBackdrop');
            const button = document.getElementById('mobileMenuBtn');
            if (!drawer || !backdrop) return;

            const shouldOpen = typeof open === 'boolean' ? open : drawer.classList.contains('hidden');
            if (shouldOpen) {
                drawer.classList.remove('hidden');
                backdrop.classList.remove('hidden');
                requestAnimationFrame(() => {
                    drawer.classList.add('is-open');
                    backdrop.classList.add('is-open');
                });
                if (button) button.setAttribute('aria-expanded', 'true');
                const firstFocusable = drawer.querySelector('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
                if (firstFocusable) setTimeout(() => firstFocusable.focus(), 100);
            } else {
                drawer.classList.remove('is-open');
                backdrop.classList.remove('is-open');
                if (button) button.setAttribute('aria-expanded', 'false');
                setTimeout(() => {
                    drawer.classList.add('hidden');
                    backdrop.classList.add('hidden');
                }, 430);
                if (button) button.focus({ preventScroll: true });
            }
            document.documentElement.classList.toggle('overflow-hidden', shouldOpen);
            document.body.classList.toggle('overflow-hidden', shouldOpen);
        };

        document.addEventListener('keydown', function(e) {
            const mobileNav = document.getElementById('mobileNav');
            if (!mobileNav || mobileNav.classList.contains('hidden')) return;

            if (e.key === 'Escape') {
                e.preventDefault();
                window.toggleMobileNav(false);
                return;
            }

            if (e.key !== 'Tab') return;
            const focusable = Array.from(mobileNav.querySelectorAll('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])'))
                .filter(el => !el.disabled && el.offsetParent !== null);
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        window.toggleLangMenu = function() {
            const popover = document.getElementById('mobileLangPopover');
            if (!popover) return;
            popover.classList.toggle('hidden');
        };

        window.toggleDesktopLangMenu = function() {
            const popover = document.getElementById('desktopLangPopover');
            if (!popover) return;
            popover.classList.toggle('hidden');
        };

        document.addEventListener('click', function(e) {
            const toggle = document.getElementById('mobileLangToggle');
            const popover = document.getElementById('mobileLangPopover');
            if (toggle && popover && !toggle.contains(e.target) && !popover.classList.contains('hidden')) {
                popover.classList.add('hidden');
            }
            const dtoggle = document.getElementById('desktopLangToggle');
            const dpopover = document.getElementById('desktopLangPopover');
            if (dtoggle && dpopover && !dtoggle.contains(e.target) && !dpopover.classList.contains('hidden')) {
                dpopover.classList.add('hidden');
            }
        });

        (function() {
            const edgePadding = 16;

function alignCategoryDropdown(menuItem) {
                const dropdown = menuItem.querySelector('[data-category-dropdown]');
                if (!dropdown || window.innerWidth < 768) return;
                const mobileBar = document.getElementById('mobileSearchBar');
                const desktopBar = document.getElementById('desktopSearchBar');
                if ((mobileBar && mobileBar.style.display === 'flex') || (desktopBar && !desktopBar.classList.contains('hidden'))) return;

                dropdown.style.left = '50%';
                dropdown.style.right = 'auto';
                dropdown.style.transform = 'translateX(-50%)';

                const itemRect = menuItem.getBoundingClientRect();
                const width = Math.min(820, window.innerWidth - (edgePadding * 2));
                const preferredLeft = itemRect.left + (itemRect.width / 2) - (width / 2);
                const boundedLeft = Math.min(
                    Math.max(preferredLeft, edgePadding),
                    window.innerWidth - edgePadding - width
                );

                dropdown.style.left = `${boundedLeft - itemRect.left}px`;
                dropdown.style.transform = 'none';
            }

            window.alignCatDropdown = alignCategoryDropdown;

            // CSS group-hover zaten gÃ¶steriyor. JS sadece konumlandÄ±rma iÃ§in.
            $(document).ready(function() {
                // Her hover'da konumlandÄ±rmayÄ± gÃ¼ncelle (ilk seferde de Ã§alÄ±ÅŸÄ±r)
                $('[data-category-menu-item]').on('mouseenter', function() {
                    if (window.alignCatDropdown) window.alignCatDropdown(this);
                });
                $(window).on('resize', function() {
                    // resize'da gÃ¶rÃ¼nÃ¼r dropdown varsa konumlandÄ±r
                    $('[data-category-menu-item]:hover').each(function() {
                        if (window.alignCatDropdown) window.alignCatDropdown(this);
                    });
                });
            });
        })();

document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                window.toggleMobileNav(false);
                window.toggleSearchBar(false);
            }
        });

        $(document).ready(function() {
            // Newsletter AJAX Submission
            $('#newsletterForm').on('submit', function(e) {
                e.preventDefault();
                var form = $(this);
                var btn = form.find('button[type="submit"]');
                btn.prop('disabled', true).attr('aria-busy', 'true');
                
                $.ajax({
                    type: form.attr('method'),
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function(response) {
                        if (response.success) {
                            window.showToast(response.message || '@Localizer["SuccessfullySubscribed"]', 'success');
                            $('#newsletterEmail').val('');
                        } else {
                            window.showToast(response.message || '@Localizer["OperationFailed"]', 'error');
                        }
                    },
                    error: function(xhr) {
                        const responseMessage = xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : '@Localizer["OperationFailed"]';
                        window.showToast(responseMessage, 'error');
                    },
                    complete: function() {
                        btn.prop('disabled', false).removeAttr('aria-busy');
                    }
                });
            });


        });

        window.formatMoney = function(amount, culture) {
            if (typeof amount !== 'number' || !isFinite(amount)) return '\u20AA' + amount;
            const lang = culture || document.documentElement.lang || 'ar';
            const locale = lang === 'ar' ? 'ar-PS' : 'en-IL';
            const currency = 'ILS';
            try {
                return new Intl.NumberFormat(locale, {
                    style: 'currency',
                    currency: currency,
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(amount).replace(/[\s]*ILS/i, '').trim();
            } catch (e) {
                return '\u20AA' + amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        };

        window.showToast = function(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'transform translate-y-10 opacity-0 transition-all duration-500 ease-out flex items-center gap-3 px-6 py-4 rounded shadow-lg backdrop-blur-md min-w-[300px] border-l-4';
            
            let iconHtml = '';
            const decoder = document.createElement('textarea');
            decoder.innerHTML = String(message || '');
            const safeMessage = decoder.value.replace(/[&<>"']/g, function(char) {
                return ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[char];
            });

            if (type === 'success') {
                toast.classList.add('bg-brand-cream', 'bg-opacity-95', 'text-brand-olive', 'border-brand-olive');
                iconHtml = '<i class="fas fa-check-circle text-xl text-brand-olive"></i>';
            } else if (type === 'error') {
                toast.classList.add('bg-white', 'bg-opacity-95', 'text-red-800', 'border-red-600');
                iconHtml = '<i class="fas fa-exclamation-circle text-xl text-red-600"></i>';
            } else {
                toast.classList.add('bg-white', 'bg-opacity-95', 'text-blue-800', 'border-blue-600');
                iconHtml = '<i class="fas fa-info-circle text-xl text-blue-600"></i>';
            }

            toast.innerHTML = `
                ${iconHtml}
                <div class="flex-1">
                    <p class="font-medium text-sm tracking-wide font-sans">${safeMessage}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="text-gray-400 hover:text-brand-olive transition-colors ml-4">
                    <i class="fas fa-times"></i>
                </button>
            `;

            container.appendChild(toast);

            // Trigger animation
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    toast.classList.remove('translate-y-10', 'opacity-0');
                    toast.classList.add('translate-y-0', 'opacity-100');
                });
            });

            // Auto remove
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 4000);
        };

        // ─── AJAX Sepete Ekleme Sistemi (Event Delegation) ───
        const quickAddAddingText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddingToCart"].Value));
        const quickAddAddedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddedToCart"].Value));
        const quickAddCartErrorText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["CartError"].Value));

        document.body.addEventListener('click', function(e) {
            const btn = e.target.closest('.js-quick-add-btn');
            if (!btn) return;
            e.preventDefault();

            if (btn.disabled) return;

            const urunId = btn.getAttribute('data-urun-id');
            if (!urunId) return;

            const icon = btn.querySelector('.js-quick-add-icon');
            const label = btn.querySelector('.js-quick-add-label');

            const originalIconClass = icon ? icon.className : '';
            const originalLabelText = label ? label.textContent : '';

            // Loading state
            btn.disabled = true;
            btn.classList.add('cursor-wait', 'opacity-80');
            if (icon) icon.className = 'fas fa-spinner fa-spin text-xs';
            if (label) label.textContent = quickAddAddingText;

            // Anti-forgery token
            const tokenForm = document.getElementById('globalAntiForgeryForm');
            const tokenInput = tokenForm ? tokenForm.querySelector('input[name="__RequestVerificationToken"]') : null;
            const token = tokenInput ? tokenInput.value : '';

            const formData = new FormData();
            formData.append('UrunId', urunId);
            formData.append('Adet', '1');
            if (token) {
                formData.append('__RequestVerificationToken', token);
            }

            fetch('/cart/Ekle', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (icon) icon.className = 'fas fa-check text-xs';
                    if (label) label.textContent = quickAddAddedText;
                    window.showToast(quickAddAddedText, 'success');

                    // Sepet sayısını güncelle
                    fetch('/cart/count')
                    .then(r => r.json())
                    .then(countData => {
                        const newCount = countData.count;

                        // Sayaçları güncelle
                        const cartCountEl = document.getElementById('cartItemCount');
                        const cartCountMobileEl = document.getElementById('cartItemCountMobile');
                        const floatingCartEl = document.querySelector('.floating-cart-btn');

                        if (cartCountEl) {
                            cartCountEl.textContent = newCount;
                            cartCountEl.classList.remove('scale-0');
                            cartCountEl.classList.add('scale-110');
                            setTimeout(() => cartCountEl.classList.remove('scale-110'), 250);
                        }
                        if (cartCountMobileEl) {
                            cartCountMobileEl.textContent = newCount;
                        }

                        // Floating sepet sayacı
                        if (floatingCartEl) {
                            let floatBadge = floatingCartEl.querySelector('span');
                            if (newCount > 0) {
                                if (!floatBadge) {
                                    floatBadge = document.createElement('span');
                                    floatBadge.className = 'absolute -top-1 -end-1 bg-brand-gold text-white text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold shadow-md';
                                    floatingCartEl.appendChild(floatBadge);
                                }
                                floatBadge.textContent = newCount;
                            } else if (floatBadge) {
                                floatBadge.remove();
                            }
                        }
                    });
                } else {
                    window.showToast(data.message || quickAddCartErrorText, 'error');
                }
            })
            .catch(error => {
                console.error('Cart error:', error);
                window.showToast(quickAddCartErrorText, 'error');
            })
            .finally(() => {
                setTimeout(() => {
                    btn.disabled = false;
                    btn.classList.remove('cursor-wait', 'opacity-80');
                    if (icon) icon.className = originalIconClass;
                    if (label) label.textContent = originalLabelText;
                }, 1200);
            });
        });
    </script>
