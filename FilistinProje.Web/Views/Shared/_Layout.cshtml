    <!-- Search Results Dropdown -->
    <div id="searchResultsDropdown" class="fixed bg-white border border-brand-border rounded-xl shadow-xl z-[200] hidden overflow-y-auto" style="max-height: 420px; min-width: 280px;"></div>

    <script>
        window.toggleSearchBar = function(open) {
            const mobileBar = document.getElementById('mobileSearchBar');
            const desktopBar = document.getElementById('desktopSearchBar');
            const logo = document.getElementById('siteLogo');
            const nav = document.querySelector('nav');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileSearchBtn = document.getElementById('mobileSearchBtn');
            const mobileIcons = document.getElementById('mobileIcons');
            const mobileNav = document.getElementById('mobileNav');
            const mobileBackdrop = document.getElementById('mobileNavBackdrop');
            const isMobile = window.innerWidth < 768;

            if (mobileNav && !mobileNav.classList.contains('hidden')) window.toggleMobileNav(false);

            let shouldOpen;
            if (typeof open === 'boolean') {
                shouldOpen = open;
            } else {
                shouldOpen = isMobile
                    ? mobileBar.style.display !== 'flex'
                    : desktopBar.classList.contains('hidden') || desktopBar.style.display !== 'flex';
            }

            if (isMobile) {
                if (shouldOpen) {
                    mobileBar.style.display = 'flex';
                    mobileBar.classList.remove('hidden');
                    const msb = document.getElementById('mobileSearchBtn');
                    if (msb) msb.style.display = 'none';
                    setTimeout(() => document.getElementById('mobileSearchInput')?.focus(), 50);
                } else {
                    mobileBar.style.display = 'none';
                    mobileBar.classList.add('hidden');
                    const msb = document.getElementById('mobileSearchBtn');
                    if (msb) msb.style.display = 'inline-flex';
                    const inp = document.getElementById('mobileSearchInput');
                    if (inp) inp.value = '';
                    document.getElementById('searchResultsDropdown')?.classList.add('hidden');
                }
            } else {
                if (shouldOpen) {
                    desktopBar.style.display = 'flex';
                    desktopBar.classList.remove('hidden');
                    const dsb = document.getElementById('desktopSearchBtn');
                    if (dsb) dsb.style.display = 'none';
                    setTimeout(() => document.getElementById('desktopSearchInput')?.focus(), 50);
                } else {
                    desktopBar.style.display = 'none';
                    desktopBar.classList.add('hidden');
                    const dsb = document.getElementById('desktopSearchBtn');
                    if (dsb) dsb.style.display = 'block';
                    const inp = document.getElementById('desktopSearchInput');
                    if (inp) inp.value = '';
                    document.getElementById('searchResultsDropdown')?.classList.add('hidden');
                }
            }
        };

        document.getElementById('mobileSearchCloseBtn')?.addEventListener('click', () => window.toggleSearchBar(false));
        document.getElementById('desktopSearchCloseBtn')?.addEventListener('click', () => window.toggleSearchBar(false));
        document.getElementById('mobileSearchBtn')?.addEventListener('click', (event) => {
            event.preventDefault();
            window.toggleSearchBar(true);
        });
        document.getElementById('desktopSearchBtn')?.addEventListener('click', (event) => {
            event.preventDefault();
            window.toggleSearchBar(true);
        });
        document.getElementById('mobileSearchSubmit')?.addEventListener('click', function (e) {
            e.preventDefault();
            const term = document.getElementById('mobileSearchInput')?.value.trim() || '';
            window.location.href = '/products' + (term ? '?s=' + encodeURIComponent(term) : '');
        });

        (function () {
            const desktopInput = document.getElementById('desktopSearchInput');
            const mobileInput = document.getElementById('mobileSearchInput');
            const resultsDropdown = document.getElementById('searchResultsDropdown');
            let searchTimer = null, abortController = null;
            let selectedIndex = -1;
            let currentResults = [];

            /* ---- helpers ---- */

            function escapeHtml(value) {
                return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }

            function getActiveInput() {
                return window.innerWidth < 768 ? mobileInput : desktopInput;
            }

            function positionDropdown() {
                if (!resultsDropdown || resultsDropdown.classList.contains('hidden')) return;
                const input = getActiveInput();
                if (!input) return;
                const rect = input.getBoundingClientRect();
                const scrollTop = window.scrollY || document.documentElement.scrollTop;
                const width = Math.max(rect.width, 300);
                resultsDropdown.style.width = width + 'px';
                if (window.innerWidth < 768) {
                    resultsDropdown.style.top = (rect.bottom + scrollTop + 6) + 'px';
                    resultsDropdown.style.left = '16px';
                    resultsDropdown.style.right = '16px';
                    resultsDropdown.style.minWidth = 'unset';
                } else {
                    resultsDropdown.style.top = (rect.bottom + scrollTop + 8) + 'px';
                    resultsDropdown.style.left = Math.max(rect.left, 8) + 'px';
                    resultsDropdown.style.right = 'auto';
                    resultsDropdown.style.minWidth = '340px';
                    resultsDropdown.style.maxWidth = Math.min(500, window.innerWidth - 32) + 'px';
                }
            }

            /* ---- render helpers ---- */

            function renderItemsHtml(items) {
                return items.slice(0, 8).map((item, idx) => {
                    const title = escapeHtml(item.baslik || '');
                    const brand = item.marka ? escapeHtml(item.marka) : '';
                    const category = item.kategori ? escapeHtml(item.kategori) : '';
                    const price = item.fiyat ? escapeHtml(item.fiyat) : '';
                    const image = item.gorsel ? `<img src="${escapeHtml(item.gorsel)}" alt="${title}" class="w-12 h-12 object-cover rounded" loading="lazy" onerror="this.style.display='none';this.parentElement.querySelector('.search-img-fallback').style.display='flex'">` : '';
                    const fallbackIcon = `<div class="w-12 h-12 rounded flex items-center justify-center search-img-fallback" style="${image ? 'display:none' : 'display:flex'}"><i class="fas fa-image text-brand-gold"></i></div>`;
                    const url = item.slug ? '/products/' + encodeURIComponent(item.slug) + '-' + item.id : '/products/' + item.id;
                    let metaHtml = '';
                    if (brand) metaHtml += `<span class="text-[11px] text-brand-mutedtext px-1.5 py-0.5 rounded border border-brand-border">${brand}</span>`;
                    if (category) metaHtml += `<span class="text-[11px] text-brand-mutedtext px-1.5 py-0.5 rounded border border-brand-border">${category}</span>`;
                    return `<a href="${url}" class="search-result-item flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors hover:bg-brand-warmcream group" data-index="${idx}" role="option" aria-selected="false">
                        ${image}${fallbackIcon}
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-medium text-brand-darktext truncate group-hover:text-brand-gold transition-colors">${title}</div>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                ${price ? `<div class="text-xs text-brand-gold font-semibold">${price}</div>` : ''}
                                ${metaHtml}
                            </div>
                        </div>
                        <i class="fas fa-arrow-right text-[10px] text-brand-gold opacity-0 group-hover:opacity-100 transition-opacity"></i>
                    </a>`;
                }).join('');
            }

            function renderDropdown(data) {
                const items = data && data.items ? data.items : (Array.isArray(data) ? data : []);
                const total = data && typeof data.total === 'number' ? data.total : items.length;
                currentResults = items;
                selectedIndex = -1;
                if (!items || items.length === 0) {
                    showResults('<div class="px-4 py-5 text-center text-sm text-brand-mutedtext"><i class="fas fa-search mr-1"></i>@Localizer["NoResultsFound"]</div>');
                    return;
                }
                const term = (getActiveInput()?.value || '').trim();
                const resultCountLabel = '<div class="text-[10px] uppercase tracking-widest text-brand-mutedtext px-2 pb-2">' + total + ' @Localizer["ResultsFound"]</div>';
                const itemsHtml = renderItemsHtml(items);
                const footer = total > 8
                    ? `<a href="/products?s=${encodeURIComponent(term)}" class="block text-center text-xs text-brand-gold font-semibold py-2.5 border-t border-brand-border hover:bg-brand-warmcream transition-colors rounded-b-lg" role="option">@Localizer["ViewAllResults"] <i class="fas fa-arrow-right ml-1 text-[10px]"></i></a>`
                    : '';
                showResults('<div class="p-2" role="listbox" aria-label="@Localizer["SearchResults"]">' + resultCountLabel + itemsHtml + footer + '</div>');
                if (resultsDropdown) resultsDropdown.scrollTop = 0;
            }

            function showLoading() {
                if (!resultsDropdown) return;
                resultsDropdown.innerHTML = '<div class="px-4 py-6 text-center text-sm text-brand-mutedtext"><i class="fas fa-spinner fa-spin mr-2"></i>@Localizer["Searching"]</div>';
                resultsDropdown.classList.remove('hidden');
                positionDropdown();
            }

            function showResults(html) {
                if (!resultsDropdown) return;
                resultsDropdown.innerHTML = html;
                resultsDropdown.classList.remove('hidden');
                positionDropdown();
            }

            function hideResults() {
                resultsDropdown?.classList.add('hidden');
                currentResults = [];
                selectedIndex = -1;
            }

            /* ---- keyboard navigation ---- */

            function getResultLinks() {
                if (!resultsDropdown || resultsDropdown.classList.contains('hidden')) return [];
                return Array.from(resultsDropdown.querySelectorAll('.search-result-item'));
            }

            function updateSelection() {
                const links = getResultLinks();
                links.forEach((link, i) => {
                    link.classList.toggle('bg-brand-warmcream', i === selectedIndex);
                    link.setAttribute('aria-selected', i === selectedIndex ? 'true' : 'false');
                });
                if (selectedIndex >= 0 && links[selectedIndex]) {
                    links[selectedIndex].scrollIntoView({ block: 'nearest' });
                }
            }

            function navigateSelection(direction) {
                const links = getResultLinks();
                if (links.length === 0) return;
                selectedIndex = Math.max(0, Math.min(links.length - 1, selectedIndex + direction));
                updateSelection();
            }

            function commitSelection() {
                const links = getResultLinks();
                if (selectedIndex >= 0 && selectedIndex < links.length) {
                    window.location.href = links[selectedIndex].href;
                    return true;
                }
                // No selection â€” submit the form to go to search results page
                return false;
            }

            /* ---- fetch ---- */

            function runSearch(term) {
                if (term.length < 2) { hideResults(); return; }
                if (abortController) abortController.abort();
                abortController = new AbortController();
                showLoading();
                fetch('/products/CanliAra?q=' + encodeURIComponent(term), { signal: abortController.signal })
                    .then(r => r.ok ? r.json() : null)
                    .then(data => { renderDropdown(data); })
                    .catch(error => {
                        if (error.name !== 'AbortError') {
                            showResults('<div class="px-4 py-5 text-center text-sm text-red-600"><i class="fas fa-exclamation-circle mr-1"></i>@Localizer["SearchUnavailable"]</div>');
                        }
                    });
            }

            /* ---- event bindings ---- */

            [desktopInput, mobileInput].forEach(input => {
                if (!input) return;

                input.addEventListener('input', function () {
                    clearTimeout(searchTimer);
                    const term = this.value.trim();
                    if (term.length < 2) { hideResults(); return; }
                    searchTimer = setTimeout(() => runSearch(term), 220);
                });

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        if (resultsDropdown?.classList.contains('hidden') && this.value.trim().length >= 2) {
                            runSearch(this.value.trim());
                        } else {
                            navigateSelection(1);
                        }
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        navigateSelection(-1);
                    } else if (e.key === 'Enter') {
                        if (!resultsDropdown?.classList.contains('hidden')) {
                            const committed = commitSelection();
                            if (committed) { e.preventDefault(); return; }
                        }
                        // fall through to default form submit
                    } else if (e.key === 'Escape') {
                        hideResults();
                    }
                });

                input.setAttribute('aria-autocomplete', 'list');
                input.setAttribute('aria-controls', 'searchResultsDropdown');
                input.setAttribute('aria-expanded', 'false');
                input.setAttribute('role', 'combobox');
            });

            /* ---- global close/resize ---- */

            document.addEventListener('click', function (e) {
                if (!resultsDropdown?.contains(e.target) &&
                    !e.target.closest('#desktopSearchInput') &&
                    !e.target.closest('#mobileSearchInput')) {
                    hideResults();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { hideResults(); window.toggleSearchBar(false); }
            });

            window.addEventListener('resize', positionDropdown);
            window.addEventListener('scroll', positionDropdown, true);

            /* update aria-expanded on dropdown toggle */
            const observer = new MutationObserver(() => {
                const input = getActiveInput();
                if (input) {
                    input.setAttribute('aria-expanded', resultsDropdown?.classList.contains('hidden') ? 'false' : 'true');
                }
            });
            if (resultsDropdown) observer.observe(resultsDropdown, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>

<script>
        window.toggleFavori = function(btn, urunId) {
            const evt = window.event;
            if (evt) {
                evt.preventDefault();
                evt.stopPropagation();
            }

            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm text-brand-mutedtext"></i>';
            btn.disabled = true;

            let token = document.querySelector('#globalAntiForgeryForm input[name="__RequestVerificationToken"]')?.value;

            fetch('/favorites/Toggle?urunId=' + urunId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                }
            })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if(data.isAdded) {
                        btn.innerHTML = '<i class="fas fa-heart text-sm text-red-500 drop-shadow-sm"></i>';
                        if(window.showToast) window.showToast('@Localizer["ProductAddedToFavorites"]', 'success');
                    } else {
                        btn.innerHTML = '<i class="far fa-heart text-sm text-[#4a4a4a] group-hover/btn:text-red-400 transition-colors"></i>';
                        if(window.showToast) window.showToast('@Localizer["ProductRemovedFromFavorites"]', 'info');
                    }
                } else {
                    if (data.message === '@Localizer["PleaseLogin"]') {
                        window.location.href = '/account/GirisYap?ReturnUrl=' + window.location.pathname;
                    } else {
                        if(window.showToast) window.showToast(data.message || '@Localizer["AnErrorOccurred"]', 'error');
                        btn.innerHTML = originalHtml;
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if(window.showToast) window.showToast('@Localizer["ConnectionError"]', 'error');
                btn.innerHTML = originalHtml;
            })
            .finally(() => {
                btn.disabled = false;
            });
        };
    </script>

    @await Html.PartialAsync("_FloatingButtons")

    @{
        var defaultCookieNotice = currentCulture == "ar"
            ? "نستخدم ملفات تعريف الارتباط لتحسين تجربتك وتحليل حركة الموقع."
            : "We use cookies to enhance your browsing experience and analyze site traffic.";
        var cookieMessage = string.IsNullOrWhiteSpace(siteSettings.CookieMetni) 
            ? defaultCookieNotice 
            : siteSettings.CookieMetni;
        var acceptBtnText = currentCulture == "ar" ? "موافق" : "Accept";
        var declineBtnText = currentCulture == "ar" ? "رفض" : "Decline";
        var gaId = (siteSettings.GoogleAnalyticsId ?? string.Empty).Trim();
        var fbId = (siteSettings.FacebookPixelId ?? string.Empty).Trim();
    }

    <div id="cookieConsentBanner" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-xl p-4 sm:p-5 rounded-2xl hidden z-[999999] transition-all duration-300" style="background-color: #ffffff !important; color: #25280c !important; border: 1.5px solid #b58735 !important; box-shadow: 0 16px 40px rgba(49, 53, 17, 0.16) !important; opacity: 1 !important;">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background-color: rgba(181, 135, 53, 0.12); border: 1px solid rgba(181, 135, 53, 0.3);">
                    <i class="fas fa-cookie-bite text-lg" style="color: #b58735 !important;"></i>
                </div>
                <p class="text-xs sm:text-sm leading-relaxed font-sans font-medium" style="color: #25280c !important;">@cookieMessage</p>
            </div>
            <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end pt-3 sm:pt-0" style="border-top: 1px solid rgba(0,0,0,0.08);">
                <button type="button" id="declineCookiesBtn" class="px-4 py-2 text-xs rounded-xl transition-colors font-semibold" style="color: #6b6e4e !important; background: #f8f6f0; border: 1px solid #e2dcd0;">@declineBtnText</button>
                <button type="button" id="acceptCookiesBtn" class="px-5 py-2 text-xs font-bold rounded-xl shadow-md transition-all hover:opacity-90" style="background-color: #b58735 !important; color: #ffffff !important;">@acceptBtnText</button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const gaId = '@gaId';
            const fbId = '@fbId';
            
            function loadAnalytics() {
                if (gaId && (gaId.startsWith('G-') || gaId.startsWith('UA-'))) {
                    const script = document.createElement('script');
                    script.async = true;
                    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
                    document.head.appendChild(script);
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', gaId);
                }
                if (fbId && /^\d+$/.test(fbId)) {
                    !function(f,b,e,v,n,t,s)
                    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                    n.queue=[];t=b.createElement(e);t.async=!0;
                    t.src=v;s=b.getElementsByTagName(e)[0];
                    s.parentNode.insertBefore(t,s)}(window, document,'script',
                    'https://connect.facebook.net/en_US/fbevents.js');
                    fbq('init', fbId);
                    fbq('track', 'PageView');
                }
            }

            const consent = localStorage.getItem('cookieConsent');
            const banner = document.getElementById('cookieConsentBanner');

            if (consent === 'accepted') {
                loadAnalytics();
            } else if (consent !== 'declined') {
                if (banner) banner.classList.remove('hidden');
            }

            document.getElementById('acceptCookiesBtn')?.addEventListener('click', function () {
                localStorage.setItem('cookieConsent', 'accepted');
                if (banner) banner.classList.add('hidden');
                loadAnalytics();
            });

            document.getElementById('declineCookiesBtn')?.addEventListener('click', function () {
                localStorage.setItem('cookieConsent', 'declined');
                if (banner) banner.classList.add('hidden');
            });
        })();
    </script>
</body>
</html>
