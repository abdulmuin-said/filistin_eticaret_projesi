@model IEnumerable<FilistinProje.Core.DTOs.ProductBadge>
@inject IStringLocalizer<SharedResource> Localizer

@if (Model.Any())
{
    <div class="product-badge-group" data-product-badges>
        @foreach (var badge in Model)
        {
            var badgeText = !string.IsNullOrEmpty(badge.Metin)
                ? badge.Metin
                : Localizer[badge.LocalizasyonKey].Value;
            var badgeStyle = string.IsNullOrWhiteSpace(badge.ArkaPlanRengi)
                ? null
                : $"background-color:{badge.ArkaPlanRengi};border-color:{badge.ArkaPlanRengi};color:{badge.YaziRengi}";
            <span class="product-badge @badge.CssClass"
                  style="@badgeStyle"
                  data-badge-key="@badge.LocalizasyonKey">
                @badgeText
            </span>
        }
    </div>
}
