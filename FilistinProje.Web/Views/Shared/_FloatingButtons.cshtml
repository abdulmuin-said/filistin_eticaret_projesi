@using Microsoft.AspNetCore.Identity
@using FilistinProje.Core.Varliklar
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject UserManager<AppUser> UserManagerForCart
@inject FilistinProje.Core.Interfaces.ISepetService SepetService
@{
    var siteSettings = SiteSettingsService.GetSettings();
    var _cartUserId = UserManagerForCart.GetUserId(User);
    var _cartSessionId = HttpContextAccessor.HttpContext?.Features.Get<Microsoft.AspNetCore.Http.Features.ISessionFeature>()?.Session?.Id ?? string.Empty;
    var sepetCount = await SepetService.GetSepetUrunSayisiAsync(_cartUserId, _cartSessionId);
}

<style>
    .floating-action-btn {
        width: 60px;
        height: 60px;
    }

    .floating-action-btn svg {
        width: 32px;
        height: 32px;
    }

    @@media (max-width: 767px) {
        .whatsapp-btn,
        .floating-cart-btn {
            bottom: 16px !important;
        }
    }

    @@media (min-width: 768px) {
        .floating-action-btn {
            width: 72px;
            height: 72px;
        }

        .floating-action-btn svg {
            width: 40px;
            height: 40px;
        }
    }
</style>

<!-- Floating WhatsApp Button -->
@if (!string.IsNullOrWhiteSpace(siteSettings.WhatsappNumarasi))
{
    var waNumber = siteSettings.WhatsappNumarasi.Replace(" ", "").Replace("+", "").TrimStart('0');
    if (!waNumber.StartsWith("9")) waNumber = "9" + waNumber;
    <a href="https://wa.me/@waNumber" target="_blank" rel="noopener noreferrer"
       class="fixed bottom-6 end-6 z-50 bg-[#25D366] text-white rounded-full shadow-xl hover:bg-[#20BD5A] hover:scale-110 transition-all duration-300 group whatsapp-btn floating-action-btn flex items-center justify-center"
       aria-label="@Localizer["WhatsAppContact"]">
        <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.162-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="absolute end-full me-3 top-1/2 hidden -translate-y-1/2 rounded-lg bg-white px-3 py-1.5 text-xs font-medium text-[#25D366] opacity-0 shadow-md transition-opacity group-hover:opacity-100 whitespace-nowrap rtl:origin-bottom-right md:block">
            WhatsApp
        </span>
    </a>
}

<!-- Floating Cart Button -->
<a href="/Sepet" aria-label="@Localizer["Cart"]"
    class="fixed bottom-6 start-6 z-50 bg-brand-olive text-white rounded-full shadow-xl hover:bg-[#1c2001] hover:scale-110 transition-all duration-300 group floating-cart-btn floating-action-btn flex items-center justify-center"
    title="@Localizer["MyCart"]">
    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24">
        <path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    @if (sepetCount > 0)
    {
        <span class="absolute -top-1 -end-1 bg-brand-gold text-white text-sm w-7 h-7 rounded-full flex items-center justify-center font-bold shadow-md">@sepetCount</span>
    }
</a>
