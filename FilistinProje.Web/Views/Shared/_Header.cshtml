@using Microsoft.AspNetCore.Identity
@using FilistinProje.Core.Helpers
@using FilistinProje.Core.Varliklar
@using FilistinProje.Web.Extensions
@using FilistinProje.Web.Models
@using System.Globalization
@inject SignInManager<FilistinProje.Core.Varliklar.AppUser> SignInManager
@inject UserManager<FilistinProje.Core.Varliklar.AppUser> UserManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject FilistinProje.Core.Interfaces.ISepetService SepetService
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject FilistinProje.Web.Services.IHeaderCategoryService HeaderCategoryService
@inject IStringLocalizer<SharedResource> Localizer
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var userId = UserManager.GetUserId(User);
    var sessionId = HttpContextAccessor.HttpContext?.Session.Id ?? string.Empty;
    var sepetCount = await SepetService.GetSepetUrunSayisiAsync(userId, sessionId);
    var siteSettings = SiteSettingsService.GetSettings();
    var brandName = string.IsNullOrWhiteSpace(siteSettings.MarkaAdi) ? siteSettings.SiteAdi : siteSettings.MarkaAdi;
    var logoUrl = string.IsNullOrWhiteSpace(siteSettings.SiteLogoUrl) ? "/74anrps48logo2.svg" : siteSettings.SiteLogoUrl;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "/";
    var currentQuery = HttpContextAccessor.HttpContext?.Request.QueryString.Value ?? string.Empty;
    var languageReturnUrl = $"{currentPath}{currentQuery}";
    var encodedLanguageReturnUrl = Uri.EscapeDataString(languageReturnUrl);
    var arActive = currentCulture == "ar";
    var enActive = currentCulture == "en";

    var freeShippingLimitText = siteSettings.UcretsizKargoLimiti == decimal.Truncate(siteSettings.UcretsizKargoLimiti)
        ? siteSettings.UcretsizKargoLimiti.ToString("N0")
        : siteSettings.UcretsizKargoLimiti.ToString("N2");
    var topBarPrimary = string.Format(Localizer["FreeShippingLimit"], freeShippingLimitText, siteSettings.ParaBirimi);
    var trustMessages = new List<string>
    {
        topBarPrimary,
        Localizer["BankTransferFooter"],
        Localizer["CashOnDeliveryFooter"],
        Localizer["FastProduction"],
        Localizer["CarefulPackaging"],
        Localizer["PalestineWideShipping"],
        string.Format(Localizer["EasyReturnDays"], siteSettings.IadeHakkiGun),
        Localizer["ManufacturerGuarantee"]
    };

    if (!string.IsNullOrWhiteSpace(siteSettings.UstBarMesaji))
    {
        trustMessages.Insert(0, siteSettings.UstBarMesaji);
    }

    if (!string.IsNullOrWhiteSpace(siteSettings.KampanyaMesaji))
    {
        trustMessages.Insert(0, siteSettings.KampanyaMesaji);
    }

    if (!string.IsNullOrWhiteSpace(siteSettings.WhatsappNumarasi))
    {
        trustMessages.Add(Localizer["WhatsAppSupport"]);
    }

    trustMessages = trustMessages
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    var tumKategoriler = await HeaderCategoryService.GetCategoriesAsync();

    string? GetCategoryMenuImage(Kategori category)
    {
        if (!string.IsNullOrWhiteSpace(category.MenuGorselUrl))
        {
            return category.MenuGorselUrl;
        }

        if (!string.IsNullOrWhiteSpace(category.GorselUrl))
        {
            return category.GorselUrl;
        }

        return !string.IsNullOrWhiteSpace(category.BannerUrl) ? category.BannerUrl : null;
    }
}

<!-- BEGIN: AnnouncementBar -->
    @if (siteSettings.UstBarEtkin)
    {
        var tickerSpeed = siteSettings.UstBarHizi > 0 ? siteSettings.UstBarHizi : 34;
        <div class="trust-ticker relative z-50 overflow-hidden py-2 text-xs font-semibold tracking-wider" dir="ltr" style="background-color: #d7c176; color: var(--brand-primary); box-shadow: inset 0 -1px 0 rgb(var(--brand-primary-rgb) / 0.16);">
            <div class="trust-ticker-track flex items-center" style="animation-duration: @tickerSpeed.ToString("0", System.Globalization.CultureInfo.InvariantCulture)s;">
                @for (var repeat = 0; repeat < 2; repeat++)
                {
                    <div class="trust-ticker-group" aria-hidden="@(repeat == 1 ? "true" : "false")">
                        @foreach (var message in trustMessages)
                        {
                            <span class="mx-5 flex shrink-0 items-center gap-2 whitespace-nowrap" dir="auto">
                                <i class="fas fa-check text-[10px]" style="color: var(--brand-primary);"></i>
                                @message
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <!-- END: AnnouncementBar -->

<!-- BEGIN: MainHeader -->
    <header class="sticky top-0 bg-brand-cream z-[9999] border-b border-brand-border">
        <div class="w-full max-w-[1360px] mx-auto px-4 py-1.5 md:py-2 flex min-h-[62px] flex-col items-center justify-center relative md:min-h-0 md:justify-start">
            <div class="absolute left-4 top-1/2 -translate-y-1/2 hidden lg:flex items-center gap-1 rounded-full border border-[#c9b58a]/70 bg-[#fffaf0]/95 p-1 shadow-sm ring-1 ring-white/70" style="box-shadow: 0 10px 28px rgba(49, 53, 17, 0.10);">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-brand-gold shadow-sm" aria-hidden="true">
                    <i class="fas fa-globe text-xs"></i>
                </span>
                <a href="/Dil/Degistir?culture=ar&returnUrl=@encodedLanguageReturnUrl"
                   lang="ar" dir="rtl"
                   class="rounded-full px-3 py-1.5 text-xs font-semibold tracking-normal transition-all @(arActive ? "bg-brand-olive text-white shadow-md" : "text-brand-mutedtext hover:bg-white hover:text-brand-olive")">
                    العربية
                </a>
                <a href="/Dil/Degistir?culture=en&returnUrl=@encodedLanguageReturnUrl"
                   lang="en" dir="ltr"
                   class="rounded-full px-3 py-1.5 text-xs font-semibold tracking-wide transition-all @(enActive ? "bg-brand-olive text-white shadow-md" : "text-brand-mutedtext hover:bg-white hover:text-brand-olive")">
                    English
                </a>
            </div>

            <!-- Logo -->
            <a class="mb-0.5 mt-0.5 inline-block leading-none" href="/" aria-label="@brandName" id="siteLogo">
                @if (!string.IsNullOrEmpty(logoUrl)) {
                    <img src="@logoUrl" asp-append-version="true" alt="@siteSettings.MarkaAdi" class="block h-auto w-[118px] object-contain sm:w-[132px] md:w-[178px]" width="178" height="77" decoding="async" fetchpriority="high" />
                } else {
                    <h1 class="font-serif text-2xl md:text-3xl tracking-widest text-brand-olive font-medium text-center">@siteSettings.MarkaAdi</h1>
                }
            </a>

            <!-- Desktop Nav Right Side: Search + Account/favoritestes/Cart -->
            <div class="absolute right-4 top-1/2 -translate-y-1/2 hidden md:flex items-center gap-4 text-brand-darktext">

                <!-- Desktop Search Bar (inline, replaces button when active) -->
                <div id="desktopSearchBar" class="hidden items-center">
                    <form action="/products" method="get" class="relative flex items-center">
                        <input type="text" name="s" id="desktopSearchInput" placeholder="@Localizer["SearchProducts"]" autocomplete="off"
                               class="w-[260px] bg-white border border-brand-border rounded-full px-4 pr-9 py-2 text-sm text-brand-darktext placeholder-[] focus:outline-none focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold shadow-md" />
                        <button type="submit" aria-label="@Localizer["Search"]" class="absolute right-3 top-1/2 -translate-y-1/2 text-brand-mutedtext hover:text-brand-gold transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                        </button>
                    </form>
                    <button type="button" id="desktopSearchCloseBtn" class="ms-3 me-1 p-1 text-brand-mutedtext hover:text-brand-olive transition-colors rounded-full hover:bg-black/5" aria-label="@Localizer["Close"]">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </button>
                </div>

                <!-- Desktop Search Button (shown when search is closed) -->
                <button type="button" aria-label="@Localizer["Search"]" onclick="window.toggleSearchBar()" class="hover:text-brand-gold transition-colors" id="desktopSearchBtn">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </button>

                <!-- Desktop Language Toggle (md only, lg+ uses the pill) -->
                <div class="relative hidden md:block lg:hidden" id="desktopLangToggle">
                    <button type="button" onclick="window.toggleDesktopLangMenu()" class="hover:text-brand-gold transition-colors" aria-label="@Localizer["Language"]">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <!-- Desktop Popover (md only) -->
                    <div id="desktopLangPopover" class="absolute right-0 top-full mt-2 hidden z-[9999] min-w-[150px] rounded-2xl border border-[#c9b58a]/70 bg-[#fffaf0] p-1.5 shadow-xl ring-1 ring-white/70">
                        <a href="/Dil/Degistir?culture=ar&returnUrl=@encodedLanguageReturnUrl" lang="ar" dir="rtl" class="block rounded-xl px-3 py-2 text-center text-xs font-semibold transition-colors @(arActive ? "bg-brand-olive text-white" : "text-brand-olive hover:bg-white")">العربية</a>
                        <a href="/Dil/Degistir?culture=en&returnUrl=@encodedLanguageReturnUrl" lang="en" dir="ltr" class="mt-1 block rounded-xl px-3 py-2 text-center text-xs font-semibold tracking-wide transition-colors @(enActive ? "bg-brand-olive text-white" : "text-brand-mutedtext hover:bg-white hover:text-brand-olive")">English</a>
                    </div>
                </div>

                <!-- Account -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="/profile" aria-label="@Localizer["MyAccount"]" title="@Localizer["MyAccount"]" class="hover:text-brand-gold transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </a>
                }
                else
                {
                    <a href="/account/GirisYap" aria-label="@Localizer["Login"]" title="@Localizer["Login"]" class="hover:text-brand-gold transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </a>
                }

                <!-- Favoriler -->
                <a href="/favorites" aria-label="@Localizer["Favorites"]" class="hover:text-red-500 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                </a>

                <!-- Sepet -->
                <a href="/cart" aria-label="@Localizer["Cart"]" class="relative hover:text-brand-gold transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    <span id="cartItemCount" class="absolute -top-1 -end-2 bg-brand-gold text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center transition-transform duration-300">@sepetCount</span>
                </a>
            </div>

            <!-- Mobile Left: Hamburger + Search Toggle -->
            <div class="absolute left-2 top-[calc(50%+3px)] -translate-y-1/2 flex md:hidden items-center gap-0.5 text-brand-darktext" dir="ltr">
                <!-- Hamburger (ilk sirada — her dilde en solda) -->
                <button aria-label="@Localizer["OpenMenu"]" onclick="window.toggleMobileNav(true)" class="flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors" id="mobileMenuBtn" aria-expanded="false" aria-controls="mobileNav">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M3.75 6h16.5m-16.5 6h16.5m-16.5 6h16.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </button>
                <button type="button" aria-label="@Localizer["Search"]" onclick="window.toggleSearchBar()" class="flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors" id="mobileSearchBtn">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </button>
                <!-- Mobile Language Toggle (son sirada) -->
                <div class="relative" id="mobileLangToggle">
                    <button type="button" onclick="window.toggleLangMenu()" class="flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors" aria-label="@Localizer["Language"]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <!-- Popover -->
                    <div id="mobileLangPopover" class="absolute left-1/2 -translate-x-1/2 top-full mt-2 hidden z-[9999] min-w-[150px] rounded-2xl border border-[#c9b58a]/70 bg-[#fffaf0] p-1.5 shadow-xl ring-1 ring-white/70">
                        <a href="/Dil/Degistir?culture=ar&returnUrl=@encodedLanguageReturnUrl" lang="ar" dir="rtl" class="block rounded-xl px-3 py-2 text-center text-xs font-semibold transition-colors @(arActive ? "bg-brand-olive text-white" : "text-brand-olive hover:bg-white")">العربية</a>
                        <a href="/Dil/Degistir?culture=en&returnUrl=@encodedLanguageReturnUrl" lang="en" dir="ltr" class="mt-1 block rounded-xl px-3 py-2 text-center text-xs font-semibold tracking-wide transition-colors @(enActive ? "bg-brand-olive text-white" : "text-brand-mutedtext hover:bg-white hover:text-brand-olive")">English</a>
                    </div>
                </div>
            </div>

            <!-- Mobile Right: Account/Favorites/Cart -->
            <div id="mobileIcons" class="absolute right-2 top-[calc(50%+3px)] -translate-y-1/2 flex md:hidden items-center gap-0.5 text-brand-darktext">

                @if (SignInManager.IsSignedIn(User))
                {
                    <a href="/profile" aria-label="@Localizer["MyAccount"]" title="@Localizer["MyAccount"]" class="flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </a>
                }
                else
                {
                    <a href="/account/GirisYap" aria-label="@Localizer["Login"]" title="@Localizer["Login"]" class="flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </a>
                }
                <a href="/favorites" aria-label="@Localizer["Favorites"]" class="flex h-9 w-9 items-center justify-center hover:text-red-500 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                </a>
                <a href="/cart" aria-label="@Localizer["Cart"]" class="relative flex h-9 w-9 items-center justify-center hover:text-brand-gold rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    <span id="cartItemCountMobile" class="absolute -top-1 -end-2 bg-brand-gold text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center">@sepetCount</span>
                </a>
            </div>

            <!-- Desktop Navigation -->
            <nav class="w-full hidden md:block z-50" data-desktop-nav>
                <ul class="flex justify-center space-x-4 text-sm tracking-widest text-brand-mutedtext font-light uppercase" data-desktop-nav-list>
                    @foreach (var kategori in tumKategoriler.Where(x => x.ParentKategoriId == null).OrderBy(x => x.Sira).ThenBy(x => x.LocalizedAd))
                    {
                        var altKategoriler = tumKategoriler.Where(x => x.ParentKategoriId == kategori.Id).OrderBy(x => x.Sira).ToList();
                        var kategoriPreviewGorsel = GetCategoryMenuImage(kategori);
                        var kategoriPreviewMetin = !string.IsNullOrWhiteSpace(kategori.LocalizedKisaAciklama)
                            ? kategori.LocalizedKisaAciklama
                            : Localizer["ExploreCollectionProducts"];

                        <li class="relative group cursor-pointer hover:text-brand-darktext transition-colors py-2" data-category-menu-item>
                            <a href="/products?k=@kategori.Id" class="flex items-center gap-1 whitespace-nowrap">
                                @kategori.LocalizedAd
                                <svg class="w-3 h-3 opacity-70 group-hover:rotate-180 transition-transform duration-300 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>

                            <!-- Geniş kategori menüsü ve önizleme -->
                            <div class="absolute left-1/2 top-full pt-3 w-[min(820px,calc(100vw-32px))] z-[9999]" style="transform:translateX(-50%)" data-category-dropdown>
                                <div class="bg-brand-warmcream border border-[#c9b58a]/60 shadow-xl rounded-sm p-6 ring-1 ring-brand-olive/5">
                                    <div class="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
                                        
                                        <!-- Sol Kısım: Menüler / Alt Kategoriler -->
                                        <div>
                                            <div class="mb-5 flex items-center justify-between border-b border-brand-darkborder pb-3">
                                                <div>
                                                    <div class="font-serif text-xl normal-case tracking-normal text-brand-olive">@kategori.LocalizedAd</div>
                                                    <div class="mt-1 text-xs font-light normal-case tracking-wide text-brand-mutedtext">
                                                        @(altKategoriler.Any() ? Localizer["Subcategories"] : Localizer["CategoryDetail"])
                                                    </div>
                                                </div>
                                                <a href="/products?k=@kategori.Id" class="text-[11px] font-medium uppercase tracking-widest text-brand-gold hover:text-brand-olive transition-colors">@Localizer["ViewAll"]</a>
                                            </div>

                                            @if (altKategoriler.Any())
                                            {
                                                <div class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3">
                                                    @foreach (var alt in altKategoriler)
                                                    {
                                                        <a href="/products?k=@alt.Id" class="flex items-center gap-3 group/item py-2 transition-colors">
                                                            <span class="text-sm font-medium normal-case tracking-normal text-brand-mutedtext group-hover/item:text-brand-olive">@alt.LocalizedAd</span>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="normal-case tracking-normal pt-2">
                                                    <p class="text-sm leading-6 text-brand-mutedtext max-w-md">@kategoriPreviewMetin</p>
                                                    <a href="/products?k=@kategori.Id" class="mt-6 inline-flex w-fit items-center gap-2 text-[11px] font-semibold uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                                                        @Localizer["ExploreCategory"]
                                                        <i class="fas fa-arrow-right text-[10px] rtl:rotate-180"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>

                                        <!-- Sağ Kısım: Görsel Önizleme -->
                                        <div class="hidden sm:block overflow-hidden rounded-lg bg-canvasia-sand relative group/preview">
                                            @if (!string.IsNullOrWhiteSpace(kategoriPreviewGorsel))
                                            {
                                                <img src="@kategoriPreviewGorsel" alt="@kategori.LocalizedAd" class="h-full w-full object-cover transition-transform duration-700 group-hover/preview:scale-105" loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full min-h-[220px] items-center justify-center bg-gradient-to-br from-brand-olive via-[#42471a] to-brand-gold text-white">
                                                    <i class="fas fa-store text-4xl opacity-50"></i>
                                                </div>
                                            }
                                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/preview:opacity-100 flex items-end p-5">
                                                <a href="/products?k=@kategori.Id" class="text-white text-sm font-medium tracking-wide">@Localizer["ExploreCategory"]</a>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                    <li class="cursor-pointer hover:text-brand-darktext transition-colors py-2 whitespace-nowrap"><a href="/pages/Iletisim">@Localizer["Contact"]</a></li>
                </ul>
            </nav>
        </div>

        @await Html.PartialAsync("_MobileNav", new ViewDataDictionary(ViewData) {
            { "brandName", brandName },
            { "encodedLanguageReturnUrl", encodedLanguageReturnUrl },
            { "tumKategoriler", tumKategoriler },
            { "sepetCount", sepetCount }
        })

        <!-- Mobile Search Bar (full width overlay) -->
        <form id="mobileSearchBar" action="/products" method="get" style="display:none;" class="absolute left-0 right-0 top-0 z-[95] bg-brand-cream px-4 py-3 flex items-center gap-3 border-b border-brand-border md:hidden">
            <button type="button" id="mobileSearchCloseBtn" class="shrink-0 text-brand-mutedtext hover:text-brand-olive">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <div class="flex-1 relative">
                <input type="text" name="s" id="mobileSearchInput" placeholder="@Localizer["SearchProducts"]" autocomplete="off"
                       class="w-full bg-white border border-brand-border rounded-full px-4 pr-10 py-2.5 text-sm text-brand-darktext placeholder-[] focus:outline-none focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold" />
                <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-mutedtext pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
            <button type="submit" id="mobileSearchSubmit" class="shrink-0 text-brand-gold hover:text-brand-olive text-xs font-medium uppercase tracking-wider">@Localizer["Search"]</button>
        </form>
    </header>
    <!-- END: MainHeader -->
