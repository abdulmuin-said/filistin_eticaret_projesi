@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model DateTime?

@{
    if (Model == null) return;
    var endDate = Model.Value;
    var now = DateTime.UtcNow;
    if (endDate <= now) return;
}
<div data-countdown data-end="@endDate.ToString("yyyy-MM-ddTHH:mm:ss")"
     class="countdown-timer flex items-center justify-center gap-1.5 text-[11px] font-semibold tracking-wider text-white bg-gradient-to-r from-red-600 via-rose-600 to-red-700 rounded-md px-2 py-1 mt-1.5 w-full shadow-sm border border-white/20">
    <span class="text-xs text-yellow-300 animate-pulse">⏱</span>
    <span class="cd-days font-bold bg-black/30 px-1.5 py-0.5 rounded text-[10px]">0</span>
    <span class="cd-hours font-bold bg-black/30 px-1.5 py-0.5 rounded text-[10px]">00</span>
    <span class="cd-sep opacity-75 font-bold">:</span>
    <span class="cd-mins font-bold bg-black/30 px-1.5 py-0.5 rounded text-[10px]">00</span>
    <span class="cd-sep opacity-75 font-bold">:</span>
    <span class="cd-secs font-bold bg-black/30 px-1.5 py-0.5 rounded text-[10px]">00</span>
    <span class="cd-ended hidden items-center gap-1 text-[10px] font-bold"></span>
</div>

<script src="~/js/site-countdown.js" asp-append-version="true"></script>
