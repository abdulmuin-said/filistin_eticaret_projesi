@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["PageNotFound"];
}

<div class="min-h-[75vh] flex items-center justify-center py-16 px-4 bg-brand-cream">
    <div class="w-full max-w-xl text-center">
        <div class="font-serif text-[120px] md:text-[160px] leading-none text-brand-border font-bold mb-4 select-none">
            404
        </div>
        <h1 class="font-serif text-2xl md:text-4xl text-brand-olive mb-4">@Localizer["PageNotFound"]</h1>
        <p class="text-sm text-brand-mutedtext mb-8 leading-relaxed max-w-md mx-auto">
            @Localizer["PageNotFoundMessage"]
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/" class="w-full sm:w-auto bg-brand-olive text-white px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors">
                @Localizer["ReturnHome"]
            </a>
            <a href="/Urun" class="w-full sm:w-auto bg-white border border-brand-border text-brand-olive px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-brand-warmcream transition-colors">
                @Localizer["Collections"]
            </a>
        </div>
    </div>
</div>
