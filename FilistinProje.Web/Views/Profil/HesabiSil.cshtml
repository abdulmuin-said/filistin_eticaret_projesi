@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["DeleteAccount"];
}

<div class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <a href="/Profil" class="hover:text-brand-olive transition-colors">@Localizer["MyAccount"]</a>
        <span>/</span>
        <span class="text-brand-darktext font-medium">@Localizer["DeleteAccount"]</span>
    </div>
</div>

<div class="container mx-auto px-4 py-16 max-w-2xl text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-100 mb-6">
        <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
    </div>
    <h1 class="font-serif text-3xl tracking-widest text-brand-olive uppercase mb-4">@Localizer["DeleteAccountWarning"]</h1>
    <p class="text-sm text-brand-mutedtext mb-8 leading-relaxed">
        @Localizer["DeleteAccountMessage"]
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <form asp-action="HesabiSilOnay" method="post" class="w-full sm:w-auto">
            <button type="submit" class="w-full sm:w-auto bg-red-600 text-white px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-red-700 transition-colors flex items-center justify-center gap-2">
                <i class="fas fa-trash"></i> @Localizer["ConfirmDeleteAccount"]
            </button>
        </form>
        <a href="/Profil" class="w-full sm:w-auto bg-white border border-brand-border text-brand-olive px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-brand-cream transition-colors inline-block text-center">
            @Localizer["Cancel"]
        </a>
    </div>
</div>
