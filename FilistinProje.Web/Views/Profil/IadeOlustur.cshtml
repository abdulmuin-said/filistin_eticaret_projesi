@model FilistinProje.Core.Varliklar.Siparis
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["CreateReturnRequestTitle"];
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;
}

<div class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <a href="/profile" class="hover:text-brand-olive transition-colors">@Localizer["MyAccount"]</a>
        <span>/</span>
        <a href="/profile/orderslerim" class="hover:text-brand-olive transition-colors">@Localizer["MyOrders"]</a>
        <span>/</span>
        <span class="text-brand-darktext font-medium">@Localizer["ReturnRequest"]</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10 max-w-3xl">
    <h1 class="font-serif text-3xl text-brand-olive mb-6">@Localizer["CreateReturnRequest"]</h1>
    
    <div class="bg-white border border-brand-border rounded-lg p-6 mb-8">
        <h3 class="font-bold text-brand-darktext mb-4 border-b border-brand-border pb-2">@Localizer["OrderInfo"]</h3>
        <p class="text-sm text-brand-mutedtext mb-2"><strong>@Localizer["OrderNoLabel"]</strong> @Model.SiparisNo</p>
        <p class="text-sm text-brand-mutedtext mb-2"><strong>@Localizer["DateLabel"]</strong> @Model.OlusturulmaTarihi.ToString("dd.MM.yyyy")</p>
        <p class="text-sm text-brand-mutedtext"><strong>@Localizer["AmountLabel"]</strong> @Model.ToplamTutar.ToString("N2") @currencySymbol</p>
    </div>

    <form asp-action="IadeOlustur" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SiparisId" value="@Model.Id" />
        
        <div>
            <label class="block text-xs uppercase tracking-widest text-brand-darktext font-medium mb-2">@Localizer["ReturnReason"]</label>
            <select name="Neden" required class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream">
                <option value="">@Localizer["SelectOption"]</option>
                <option value="Hasarlı Ürün">@Localizer["ReasonDamagedProduct"]</option>
                <option value="Yanlış Ürün">@Localizer["ReasonWrongProduct"]</option>
                <option value="Beklentimi Karşılamadı">@Localizer["ReasonNotAsExpected"]</option>
                <option value="Vazgeçtim">@Localizer["ReasonChangedMind"]</option>
            </select>
        </div>

        <div>
            <label class="block text-xs uppercase tracking-widest text-brand-darktext font-medium mb-2">@Localizer["DescriptionOptional"]</label>
            <textarea name="Aciklama" rows="4" class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream resize-none" placeholder="@Localizer["ReturnDescriptionPlaceholder"]"></textarea>
        </div>

        <div>
            <label class="block text-xs uppercase tracking-widest text-brand-darktext font-medium mb-2">@Localizer["IBANOptional"]</label>
            <input name="IBAN" class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" placeholder="@Localizer["IBANPlaceholder"]" />
        </div>

        <div class="flex gap-4">
            <button type="submit" class="bg-brand-olive text-white px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors">
                @Localizer["SubmitRequest"]
            </button>
            <a href="/profile/orderslerim" class="bg-white border border-brand-border text-brand-olive px-8 py-3 text-xs tracking-widest uppercase rounded hover:bg-brand-cream transition-colors inline-flex items-center">
                @Localizer["CancelRequest"]
            </a>
        </div>
    </form>
</div>
