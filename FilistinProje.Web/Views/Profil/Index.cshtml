@model FilistinProje.Core.Varliklar.AppUser
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["MyAccount"];
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;
    var firstLetter = !string.IsNullOrEmpty(Model.AdSoyad) ? Model.AdSoyad.Substring(0, 1).ToUpperInvariant() : "U";
}

<!-- Breadcrumb -->
<div class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <span class="text-brand-darktext font-medium">@Localizer["MyAccount"]</span>
    </div>
</div>

<div class="container mx-auto px-4 py-10">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Yan Menü -->
        <aside class="lg:w-56 flex-shrink-0">
            <div class="bg-white border border-brand-border rounded-lg overflow-hidden">
                <!-- Avatar -->
                <div class="bg-brand-olive p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-brand-gold flex items-center justify-center text-white font-serif text-2xl mx-auto mb-3">
                        @firstLetter
                    </div>
                    <p class="text-white text-sm font-medium">@Model.AdSoyad</p>
                    <p class="text-brand-lightgold text-xs mt-0.5">@Model.Email</p>
                </div>
                <!-- Menü -->
                <nav class="p-2">
                    <a href="/profile" class="flex items-center gap-3 px-3 py-2.5 rounded text-sm text-brand-olive bg-brand-warmcream font-medium mb-1">
                        <i class="fas fa-user w-4"></i> @Localizer["MyAccount"]
                    </a>
                    <a href="/profile/orderslerim" class="flex items-center gap-3 px-3 py-2.5 rounded text-sm text-brand-mutedtext hover:bg-brand-warmcream transition-colors mb-1">
                        <i class="fas fa-box w-4"></i> @Localizer["MyOrders"]
                    </a>
                    <a href="/profile/Adreslerim" class="flex items-center gap-3 px-3 py-2.5 rounded text-sm text-brand-mutedtext hover:bg-brand-warmcream transition-colors mb-1">
                        <i class="fas fa-location-dot w-4"></i> @Localizer["MyAddresses"]
                    </a>
                    <a href="/favorites" class="flex items-center gap-3 px-3 py-2.5 rounded text-sm text-brand-mutedtext hover:bg-brand-warmcream transition-colors mb-1">
                        <i class="fas fa-heart w-4"></i> @Localizer["MyFavorites"]
                    </a>
                    <hr class="border-brand-border my-2" />
                    <form action="/Hesap/CikisYap" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded text-sm text-red-500 hover:bg-red-50 transition-colors text-left">
                            <i class="fas fa-right-from-bracket w-4"></i> @Localizer["Logout"]
                        </button>
                    </form>
                </nav>
            </div>
        </aside>

        <!-- Ana İçerik -->
        <main class="flex-1 space-y-6">
            @if (TempData["Mesaj"] != null)
            {
                <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-lg flex items-center gap-2 shadow-sm">
                    <i class="fas fa-circle-check"></i>
                    <span>@TempData["Mesaj"]</span>
                </div>
            }
            @if (TempData["Hata"] != null)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg flex items-center gap-2 shadow-sm">
                    <i class="fas fa-circle-exclamation"></i>
                    <span>@TempData["Hata"]</span>
                </div>
            }

            <!-- Hoş Geldin Kartı -->
            <div class="bg-white border border-brand-border rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="font-serif text-2xl text-brand-olive mb-1">@(string.IsNullOrWhiteSpace(Model.AdSoyad) ? Localizer["WelcomeToAccount"].Value : string.Format(Localizer["HelloUser"].Value, Model.AdSoyad))</h1>
                        <p class="text-xs text-brand-mutedtext">@Localizer["WelcomeToAccount"]</p>
                    </div>
                    <div class="flex gap-3">
                        <a href="/profile/orderslerim" class="border border-brand-olive text-brand-olive text-xs tracking-widest uppercase px-4 py-2 rounded hover:bg-brand-olive hover:text-white transition-colors">
                            @Localizer["Orders"]
                        </a>
                        <a href="/profile/Adreslerim" class="bg-brand-olive text-white text-xs tracking-widest uppercase px-4 py-2 rounded hover:bg-[#1c2001] transition-colors">
                            @Localizer["Addresses"]
                        </a>
                    </div>
                </div>
            </div>

            <!-- İstatistikler -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white border border-brand-border rounded-lg p-5 text-center">
                    <div class="font-serif text-4xl text-brand-olive mb-1">@ViewBag.SiparisSayisi</div>
                    <div class="text-xs text-brand-mutedtext uppercase tracking-wide">@Localizer["TotalOrders"]</div>
                </div>
                <div class="bg-white border border-brand-border rounded-lg p-5 text-center">
                    <div class="font-serif text-3xl text-brand-olive mb-1">@ViewBag.ToplamHarcama <span class="text-lg">@currencySymbol</span></div>
                    <div class="text-xs text-brand-mutedtext uppercase tracking-wide">@Localizer["TotalSpent"]</div>
                </div>
                <a href="/favorites" class="bg-white border border-brand-border rounded-lg p-5 text-center hover:border-brand-gold transition-colors group">
                    <div class="font-serif text-4xl text-red-400 mb-1 group-hover:scale-110 transition-transform">@ViewBag.FavoriSayisi</div>
                    <div class="text-xs text-brand-mutedtext uppercase tracking-wide">@Localizer["MyFavorites"]</div>
                </a>
            </div>

            @if (ViewBag.SonFavoriler != null && ((List<FilistinProje.Core.Varliklar.Favori>)ViewBag.SonFavoriler).Count > 0)
            {
                var sonFavoriler = (List<FilistinProje.Core.Varliklar.Favori>)ViewBag.SonFavoriler;
                <div class="bg-white border border-brand-border rounded-lg p-6">
                    <div class="flex items-center justify-between mb-5 pb-3 border-b border-brand-border">
                        <h2 class="font-serif text-xl text-brand-olive">
                            <i class="fas fa-heart text-red-400 mr-2"></i> @Localizer["RecentFavorites"]
                        </h2>
                        <a href="/favorites" class="text-xs text-brand-gold hover:text-brand-olive transition-colors font-medium uppercase tracking-wider">
                            @Localizer["ViewAll"] <i class="fas fa-arrow-right ml-1 text-[10px]"></i>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        @foreach (var favori in sonFavoriler)
                        {
                            var urun = favori.Urun;
                            if (urun == null) continue;
                            var urlSlug = string.IsNullOrEmpty(urun.Slug)
                                ? $"{FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(urun.Baslik)}-{urun.Id}"
                                : $"{urun.Slug}-{urun.Id}";
                            <a href="/products/@urlSlug" class="group block">
                                <div class="aspect-square bg-brand-cream rounded-lg overflow-hidden mb-2 border border-brand-border">
                                    <img src="@urun.AnaGorselUrl" alt="@urun.Baslik"
                                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                         loading="lazy" decoding="async" />
                                </div>
                                <h6 class="text-xs font-medium text-brand-darktext line-clamp-1 group-hover:text-brand-gold transition-colors">@urun.Baslik</h6>
                                @if (!urun.FiyatGizliMi)
                                {
                                    <p class="mt-0.5 text-xs font-semibold text-brand-gold">@urun.EtkinFiyat.ToString("N2") @currencySymbol</p>
                                }
                                else
                                {
                                    <p class="mt-0.5 text-xs italic text-brand-mutedtext">@Localizer["PriceOnRequest"]</p>
                                }
                                @if (urun.FiyatGizliMi || urun.WhatsappSiparisVarMi)
                                {
                                    <span class="mt-2 flex items-center justify-center gap-1 rounded border border-green-500 px-2 py-1 text-[10px] font-semibold uppercase text-green-600"><i class="fab fa-whatsapp"></i>@Localizer["Admin_WhatsappOrder"]</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Hesap Bilgileri -->
            <div class="bg-white border border-brand-border rounded-lg p-6">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-5 pb-3 border-b border-brand-border">
                    <h2 class="font-serif text-xl text-brand-olive mb-0">@Localizer["AccountInfo"]</h2>
                    <div class="flex items-center gap-2">
                        <button type="button" id="editProfileBtn" class="border border-brand-olive text-brand-olive hover:bg-brand-olive hover:text-white px-3 py-1.5 text-xs rounded transition-colors flex items-center gap-1.5 shadow-sm">
                            <i class="fas fa-user-pen"></i> @Localizer["Profile_UpdateInfo"]
                        </button>
                        <button type="button" id="changePasswordBtn" class="border border-brand-border text-brand-mutedtext hover:border-brand-gold hover:text-brand-gold px-3 py-1.5 text-xs rounded transition-colors flex items-center gap-1.5 shadow-sm">
                            <i class="fas fa-key"></i> @Localizer["Profile_ChangePassword"]
                        </button>
                    </div>
                </div>
                <div class="space-y-4">
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-brand-warmcream flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-user text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["FullName"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@Model.AdSoyad</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-envelope text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["Email"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@Model.Email</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-phone text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["Phone"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@(!string.IsNullOrEmpty(Model.PhoneNumber) ? Model.PhoneNumber : Localizer["NotSpecified"].Value)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-id-card text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["NationalId"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@(!string.IsNullOrEmpty(Model.KimlikNo) ? Model.KimlikNo : Localizer["NotSpecified"].Value)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-calendar text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["DateOfBirth"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@(Model.DogumTarihi.HasValue ? Model.DogumTarihi.Value.ToString("dd MMMM yyyy") : Localizer["NotSpecified"].Value)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-location-dot text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["City"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@(!string.IsNullOrEmpty(Model.Sehir) ? Model.Sehir : Localizer["NotSpecified"].Value)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3 border-b border-brand-border">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-home text-brand-olive text-xs"></i>
                        </div>
                        <div>
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["Address"]</div>
                            <div class="text-sm font-medium text-brand-darktext">@(!string.IsNullOrEmpty(Model.Adres) ? Model.Adres : Localizer["NotSpecified"].Value)</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 py-3">
                        <div class="w-9 h-9 rounded-full bg-[#e2e6b3] flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-id-card text-brand-olive text-xs"></i>
                        </div>
                        <div class="flex-1">
                            <div class="text-xs text-brand-mutedtext uppercase tracking-wide mb-0.5">@Localizer["IdentityPhoto"]</div>
                            @if (!string.IsNullOrEmpty(Model.KimlikFotografYolu))
                            {
                                <div class="mt-2">
                                    <img src="@Url.Action("Kimlik", "Belge", new { userId = Model.Id })" alt="Kimlik Foto�raf�"
                                         class="w-48 h-32 object-cover rounded border border-brand-border cursor-pointer hover:opacity-90 transition-opacity"
                                         onclick="window.open('@Url.Action("Kimlik", "Belge", new { userId = Model.Id })', '_blank')" />
                                    <p class="text-xs text-brand-mutedtext mt-1">@Localizer["ClickToViewFull"]</p>
                                </div>
                            }
                            else
                            {
                                <div class="text-sm font-medium text-brand-darktext">@Localizer["NotSpecified"]</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Modal: Bilgileri Düzenle -->
<div id="editProfileModal" class="fixed inset-0 z-[100000] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto" style="z-index: 100000 !important;">
    <div class="bg-white rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl relative my-auto">
        <div class="flex items-center justify-between p-6 border-b border-brand-border">
            <h3 class="font-serif text-xl text-brand-olive flex items-center gap-2">
                <i class="fas fa-user-pen text-brand-gold"></i>
                <span>@Localizer["Profile_UpdateInfo"]</span>
            </h3>
            <button id="closeEditProfileModal" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-brand-olive transition-colors rounded-full hover:bg-brand-warmcream">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form action="/profile/update" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["FullName"] <span class="text-red-500">*</span></label>
                <input type="text" name="adSoyad" value="@Model.AdSoyad" required
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Email"]</label>
                <input type="email" value="@Model.Email" disabled readonly
                       class="w-full border border-brand-border/60 rounded-lg px-4 py-2.5 text-sm bg-gray-100 text-gray-500 cursor-not-allowed" />
                <p class="text-[11px] text-brand-mutedtext mt-1"><i class="fas fa-lock text-xs me-1"></i>@Localizer["Profile_EmailCannotBeChanged"]</p>
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Phone"]</label>
                <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" dir="ltr" placeholder="+970..."
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["City"]</label>
                <input type="text" name="sehir" value="@Model.Sehir" placeholder="Ramallah, Gaza, Hebron..."
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Address"]</label>
                <textarea name="adres" rows="3"
                          class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none resize-none bg-brand-cream">@Model.Adres</textarea>
            </div>
            <div class="flex justify-end gap-3 pt-3 border-t border-brand-border">
                <button type="button" id="cancelEditProfileModal" class="border border-brand-border text-brand-mutedtext text-xs tracking-widest uppercase px-5 py-2.5 rounded-lg hover:bg-brand-warmcream transition-colors">
                    @Localizer["Cancel"]
                </button>
                <button type="submit" class="bg-brand-olive text-white text-xs tracking-widest uppercase px-5 py-2.5 rounded-lg hover:bg-[#1c2001] transition-colors shadow-md flex items-center gap-2">
                    <i class="fas fa-check"></i>
                    <span>@Localizer["Save"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Şifre Değiştir -->
<div id="changePasswordModal" class="fixed inset-0 z-[100000] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto" style="z-index: 100000 !important;">
    <div class="bg-white rounded-2xl w-full max-w-md max-h-[90vh] overflow-y-auto shadow-2xl relative my-auto">
        <div class="flex items-center justify-between p-6 border-b border-brand-border">
            <h3 class="font-serif text-xl text-brand-olive flex items-center gap-2">
                <i class="fas fa-key text-brand-gold"></i>
                <span>@Localizer["Profile_ChangePassword"]</span>
            </h3>
            <button id="closeChangePasswordModal" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-brand-olive transition-colors rounded-full hover:bg-brand-warmcream">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form action="/profile/change-password" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Profile_CurrentPassword"] <span class="text-red-500">*</span></label>
                <input type="password" name="mevcutSifre" required autocomplete="current-password"
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Profile_NewPassword"] <span class="text-red-500">*</span></label>
                <input type="password" name="yeniSifre" required autocomplete="new-password" minlength="6"
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div>
                <label class="block text-xs font-medium text-brand-darktext tracking-wide uppercase mb-1.5">@Localizer["Profile_ConfirmNewPassword"] <span class="text-red-500">*</span></label>
                <input type="password" name="yeniSifreTekrar" required autocomplete="new-password" minlength="6"
                       class="w-full border border-brand-border rounded-lg px-4 py-2.5 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
            </div>
            <div class="flex justify-end gap-3 pt-3 border-t border-brand-border">
                <button type="button" id="cancelChangePasswordModal" class="border border-brand-border text-brand-mutedtext text-xs tracking-widest uppercase px-5 py-2.5 rounded-lg hover:bg-brand-warmcream transition-colors">
                    @Localizer["Cancel"]
                </button>
                <button type="submit" class="bg-brand-olive text-white text-xs tracking-widest uppercase px-5 py-2.5 rounded-lg hover:bg-[#1c2001] transition-colors shadow-md flex items-center gap-2">
                    <i class="fas fa-check"></i>
                    <span>@Localizer["Save"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        const editModal = document.getElementById('editProfileModal');
        const openEditBtn = document.getElementById('editProfileBtn');
        const closeEditBtns = [document.getElementById('closeEditProfileModal'), document.getElementById('cancelEditProfileModal')];

        const pwdModal = document.getElementById('changePasswordModal');
        const openPwdBtn = document.getElementById('changePasswordBtn');
        const closePwdBtns = [document.getElementById('closeChangePasswordModal'), document.getElementById('cancelChangePasswordModal')];

        function showModal(m) {
            if (!m) return;
            m.classList.remove('hidden');
            m.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function hideModal(m) {
            if (!m) return;
            m.classList.add('hidden');
            m.classList.remove('flex');
            document.body.style.overflow = '';
        }

        openEditBtn?.addEventListener('click', () => showModal(editModal));
        closeEditBtns.forEach(btn => btn?.addEventListener('click', () => hideModal(editModal)));

        openPwdBtn?.addEventListener('click', () => showModal(pwdModal));
        closePwdBtns.forEach(btn => btn?.addEventListener('click', () => hideModal(pwdModal)));

        [editModal, pwdModal].forEach(m => {
            m?.addEventListener('click', (e) => {
                if (e.target === m) hideModal(m);
            });
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                hideModal(editModal);
                hideModal(pwdModal);
            }
        });
    })();
</script>
