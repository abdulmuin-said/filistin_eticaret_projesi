@section Scripts {
    <script>
        window.toggleFilterDrawer = function(open) {
            const drawer = document.getElementById('filterDrawer');
            const backdrop = document.getElementById('filterDrawerBackdrop');
            const btn = document.getElementById('mobileFilterBtn');
            if (!drawer || !backdrop) return;

            const shouldOpen = typeof open === 'boolean' ? open : drawer.classList.contains('hidden');
            if (shouldOpen) {
                drawer.classList.remove('hidden');
                backdrop.classList.remove('hidden');
                requestAnimationFrame(function() {
                    drawer.classList.add('is-open');
                    backdrop.classList.add('is-open');
                });
                if (btn) btn.setAttribute('aria-expanded', 'true');
                document.documentElement.classList.add('overflow-hidden');
                document.body.classList.add('overflow-hidden');
                var firstFocusable = drawer.querySelector('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
                if (firstFocusable) setTimeout(function() { firstFocusable.focus(); }, 100);
            } else {
                drawer.classList.remove('is-open');
                backdrop.classList.remove('is-open');
                if (btn) btn.setAttribute('aria-expanded', 'false');
                document.documentElement.classList.remove('overflow-hidden');
                document.body.classList.remove('overflow-hidden');
                setTimeout(function() {
                    drawer.classList.add('hidden');
                    backdrop.classList.add('hidden');
                }, 430);
            }
        };

        document.addEventListener('keydown', function(e) {
            var drawer = document.getElementById('filterDrawer');
            if (!drawer || drawer.classList.contains('hidden')) return;

            if (e.key === 'Escape') {
                e.preventDefault();
                window.toggleFilterDrawer(false);
                return;
            }

            if (e.key !== 'Tab') return;
            var focusable = Array.from(drawer.querySelectorAll('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])'))
                .filter(function(el) { return !el.disabled && el.offsetParent !== null; });
            if (focusable.length === 0) return;

            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        // ��� Desktop Price Slider ���
        /* Legacy noUiSlider initialization intentionally disabled; numeric inputs are now authoritative.
        (function () {
            var slider = document.getElementById('priceSlider');
            var minInput = document.getElementById('minInput');
            var maxInput = document.getElementById('maxInput');
            var minDisplay = document.getElementById('minPriceDisplay');
            var maxDisplay = document.getElementById('maxPriceDisplay');
            var form = document.getElementById('priceFilterForm');

            var availableMin = @(ViewBag.AvailableMinFiyat ?? 0);
            var availableMax = @(ViewBag.AvailableMaxFiyat ?? 10000);
            var currentMin = @(aktifMin ?? ViewBag.AvailableMinFiyat ?? 0);
            var currentMax = @(aktifMax ?? ViewBag.AvailableMaxFiyat ?? 10000);

            if (slider && availableMax > availableMin) {
                noUiSlider.create(slider, {
                    start: [currentMin, currentMax],
                    connect: true,
                    step: 1,
                    range: { 'min': availableMin, 'max': availableMax },
                    format: { to: function (v) { return Math.round(v); }, from: function (v) { return Number(v); } }
                });
                slider.noUiSlider.on('update', function (values, handle) {
                    var value = values[handle];
                    if (handle === 0) { minDisplay.textContent = '\u20AA' + window.formatMoney(Number(value)); minInput.value = value; }
                    else { maxDisplay.textContent = '\u20AA' + window.formatMoney(Number(value)); maxInput.value = value; }
                });
                var timeout = null;
                slider.noUiSlider.on('change', function () {
                    if (timeout) clearTimeout(timeout);
                    timeout = setTimeout(function () { form.requestSubmit(); }, 300);
                });
            }
        })();

        // ��� Mobile Price Slider ���
        (function () {
            var slider = document.getElementById('mobilePriceSlider');
            var minInput = document.getElementById('mobileMinInput');
            var maxInput = document.getElementById('mobileMaxInput');
            var minDisplay = document.getElementById('mobileMinPriceDisplay');
            var maxDisplay = document.getElementById('mobileMaxPriceDisplay');
            var form = document.getElementById('mobilePriceFilterForm');

            if (!slider || !form) return;
            var availableMin = @(ViewBag.AvailableMinFiyat ?? 0);
            var availableMax = @(ViewBag.AvailableMaxFiyat ?? 10000);
            var currentMin = @(aktifMin ?? ViewBag.AvailableMinFiyat ?? 0);
            var currentMax = @(aktifMax ?? ViewBag.AvailableMaxFiyat ?? 10000);

            if (availableMax <= availableMin) return;
            noUiSlider.create(slider, {
                start: [currentMin, currentMax],
                connect: true,
                step: 1,
                range: { 'min': availableMin, 'max': availableMax },
                format: { to: function (v) { return Math.round(v); }, from: function (v) { return Number(v); } }
            });
            slider.noUiSlider.on('update', function (values, handle) {
                var value = values[handle];
                if (handle === 0) { minDisplay.textContent = '\u20AA' + window.formatMoney(Number(value)); minInput.value = value; }
                else { maxDisplay.textContent = '\u20AA' + window.formatMoney(Number(value)); maxInput.value = value; }
            });
            var mtimeout = null;
            slider.noUiSlider.on('change', function () {
                if (mtimeout) clearTimeout(mtimeout);
                mtimeout = setTimeout(function () { form.requestSubmit(); }, 300);
            });
        })();

        // ��� Grid / List Layout Toggle ���
        */
        window.setProductLayout = function(layout) {
            const grid = document.getElementById('productGrid');
            const btnGrid = document.getElementById('btnGridView');
            const btnList = document.getElementById('btnListView');

            if (!grid) return;

            if (layout === 'list') {
                grid.classList.add('layout-list');
                localStorage.setItem('product_layout', 'list');

                if (btnGrid) {
                    btnGrid.classList.remove('bg-brand-warmcream', 'text-brand-olive');
                    btnGrid.classList.add('bg-white', 'text-brand-mutedtext');
                }
                if (btnList) {
                    btnList.classList.remove('bg-white', 'text-brand-mutedtext');
                    btnList.classList.add('bg-brand-warmcream', 'text-brand-olive');
                }
            } else {
                grid.classList.remove('layout-list');
                localStorage.setItem('product_layout', 'grid');

                if (btnGrid) {
                    btnGrid.classList.remove('bg-white', 'text-brand-mutedtext');
                    btnGrid.classList.add('bg-brand-warmcream', 'text-brand-olive');
                }
                if (btnList) {
                    btnList.classList.remove('bg-brand-warmcream', 'text-brand-olive');
                    btnList.classList.add('bg-white', 'text-brand-mutedtext');
                }
            }
        };

        (function() {
            const savedLayout = localStorage.getItem('product_layout') || 'grid';
            window.setProductLayout(savedLayout);
        })();
    </script>
}
