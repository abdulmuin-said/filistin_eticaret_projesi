                </div>
<div class="flex items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(aktifArama))
                    {
                        <span class="bg-brand-olive text-white text-xs px-3 py-1 rounded-full flex items-center gap-1">
                            "<span>@aktifArama</span>"
                            <a href="/products@(aktifKategori.HasValue ? "?k=" + aktifKategori : "")" class="ml-1 opacity-70 hover:opacity-100">�</a>
                        </span>
                    }
                    <!-- Mobile Filter Toggle Button -->
                    <button type="button" onclick="window.toggleFilterDrawer(true)" id="mobileFilterBtn" class="lg:hidden flex items-center gap-1.5 border border-brand-border text-xs rounded px-3 py-2 focus:ring-1 focus:ring-[#b58735] bg-white text-brand-mutedtext hover:bg-brand-warmcream transition-colors" aria-label="@Localizer["Filters"]" aria-expanded="false" aria-controls="filterDrawer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3.75 6h16.5M6.75 12h10.5m-8.25 6h6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span>@Localizer["Filters"]</span>
                        @if (activeFilterCount > 0)
                        {
                            <span class="bg-brand-gold text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">@activeFilterCount</span>
