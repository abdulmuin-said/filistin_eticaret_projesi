@model FilistinProje.Core.Varliklar.Urun
@using FilistinProje.Service.Helpers
@using FilistinProje.Core.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Model.LocalizedBaslik;
    var siteSettings = SiteSettingsService.GetSettings();
    var brandName = string.IsNullOrWhiteSpace(siteSettings.MarkaAdi) ? siteSettings.SiteAdi : siteSettings.MarkaAdi;
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;
    var whatsappSiparisModu = Model.FiyatGizliMi || Model.WhatsappSiparisVarMi;
    var whatsappNumber = new string((siteSettings.WhatsappNumarasi ?? string.Empty).Where(char.IsDigit).ToArray());
    var isRtlDetay = System.Threading.Thread.CurrentThread.CurrentUICulture.TextInfo.IsRightToLeft;

    // --- VARYANT VE FIYAT HESAPLAMA ---
    var secenekler = ViewBag.Secenekler as List<FilistinProje.Core.Varliklar.UrunSecenek> ?? new List<FilistinProje.Core.Varliklar.UrunSecenek>();
    var stokBiteniGriGoster = siteSettings.StokBiteniGriGoster;
    var stoktaYokSatisIzni = siteSettings.StoktaYokSatisIzni;
    var varsayilanSecenek = secenekler
        .Where(x => x.VarsayilanMi)
        .OrderBy(x => x.Sira)
        .ThenBy(x => x.SatisFiyati)
        .FirstOrDefault(x => stoktaYokSatisIzni || x.SatinAlinabilirMi)
        ?? secenekler
            .Where(x => x.VarsayilanMi)
            .OrderBy(x => x.Sira)
            .ThenBy(x => x.SatisFiyati)
            .FirstOrDefault();
    var isWholesale = ViewBag.IsWholesale is bool ws && ws;
    decimal gosterilecekFiyat;
    decimal? gosterilecekEskiFiyat;
    DateTime? gosterilecekIndirimBitisTarihi;

    if (varsayilanSecenek == null)
    {
        if (isWholesale && Model.TopFiyat.HasValue && Model.TopFiyat.Value > 0)
        {
            gosterilecekFiyat = Model.TopFiyat.Value;
            gosterilecekEskiFiyat = Model.IndirimVarMi ? Model.Fiyat : null;
            gosterilecekIndirimBitisTarihi = null;
        }
        else if (Model.IndirimVarMi)
        {
            gosterilecekFiyat = Model.EtkinFiyat;
            gosterilecekEskiFiyat = Model.Fiyat;
            gosterilecekIndirimBitisTarihi = Model.KampanyaBitisTarihi;
        }
        else
        {
            gosterilecekFiyat = Model.Fiyat;
            gosterilecekEskiFiyat = null;
            gosterilecekIndirimBitisTarihi = null;
        }
    }
    else
    {
        if (isWholesale && Model.TopFiyat.HasValue && Model.TopFiyat.Value > 0)
        {
            gosterilecekFiyat = varsayilanSecenek.FiyatFarki != 0 ? (Model.TopFiyat.Value + varsayilanSecenek.FiyatFarki) : Model.TopFiyat.Value;
            gosterilecekEskiFiyat = varsayilanSecenek.SatisFiyati > gosterilecekFiyat ? varsayilanSecenek.SatisFiyati : null;
            gosterilecekIndirimBitisTarihi = null;
        }
        else if (varsayilanSecenek.IndirimVarMi)
        {
            gosterilecekFiyat = varsayilanSecenek.EtkinFiyat;
            gosterilecekEskiFiyat = varsayilanSecenek.SatisFiyati;
            gosterilecekIndirimBitisTarihi = varsayilanSecenek.IndirimBitisTarihi;
        }
        else if (varsayilanSecenek.SatisFiyati > 0)
        {
            gosterilecekFiyat = varsayilanSecenek.SatisFiyati;
            gosterilecekEskiFiyat = null;
            gosterilecekIndirimBitisTarihi = null;
        }
        else
        {
            gosterilecekFiyat = Model.EtkinFiyat;
            gosterilecekEskiFiyat = Model.IndirimVarMi ? Model.Fiyat : null;
            gosterilecekIndirimBitisTarihi = Model.KampanyaBitisTarihi;
        }
    }

    int? gosterilecekIndirimYuzdesi = IndirimHesaplayici.YuzdeHesapla(gosterilecekEskiFiyat ?? 0, gosterilecekFiyat);
    var badges = Model.ToBadges(stoktaYokSatisIzni, gosterilecekEskiFiyat ?? 0, gosterilecekFiyat);
    int toplamStok = secenekler.Any() ? secenekler.Where(x => !x.SilindiMi && x.AktifMi).Sum(x => x.StokAdedi) : Model.ToplamStok;
    bool stoktaVar = secenekler.Any()
        ? secenekler.Any(x => stoktaYokSatisIzni || x.SatinAlinabilirMi)
        : Model.StoktaVarMi;
    string stokDurumuMetni = varsayilanSecenek != null
        ? (stoktaYokSatisIzni || varsayilanSecenek.SatinAlinabilirMi ? Localizer["MadeToOrder"].Value : (varsayilanSecenek.OnSipariseAcikMi ? Localizer["PreOrderOpen"].Value : Localizer["OutOfStock"].Value))
        : (stoktaVar
            ? Localizer["MadeToOrder"].Value
            : Localizer["OutOfStock"].Value);
    var stokIkonClass = stoktaVar ? "fas fa-check-circle text-green-600" : "fas fa-times-circle text-red-600";
    int minSiparisAdedi = Model.MinSiparisAdedi > 0 ? Model.MinSiparisAdedi : 1;
    int varsayilanMax = varsayilanSecenek?.StokAdedi > 0
        ? varsayilanSecenek.StokAdedi
        : (varsayilanSecenek?.OnSipariseAcikMi == true ? Math.Max(minSiparisAdedi, 25) : Math.Max(minSiparisAdedi, 10));
    int maxSiparisAdedi = Model.MaxSiparisAdedi ?? varsayilanMax;
    if (maxSiparisAdedi < minSiparisAdedi)
    {
        maxSiparisAdedi = minSiparisAdedi;
    }

    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var rawVaryantMetni = varsayilanSecenek != null 
        ? (string.IsNullOrWhiteSpace(varsayilanSecenek.GetLocalizedVaryantBasligi(isAr)) ? (varsayilanSecenek.Olcu ?? string.Empty) : varsayilanSecenek.GetLocalizedVaryantBasligi(isAr)) 
        : string.Empty;
    var seciliVaryantMetni = string.Join(" / ", rawVaryantMetni.Split(new[] { " / " }, StringSplitOptions.RemoveEmptyEntries).Where(x => !x.Contains("Standart", StringComparison.OrdinalIgnoreCase) && !x.Contains("Standard", StringComparison.OrdinalIgnoreCase) && !x.Contains("Bask", StringComparison.OrdinalIgnoreCase)));
    if (string.IsNullOrWhiteSpace(seciliVaryantMetni) && !string.IsNullOrWhiteSpace(rawVaryantMetni) && !rawVaryantMetni.Contains("Standart", StringComparison.OrdinalIgnoreCase) && !rawVaryantMetni.Contains("Standard", StringComparison.OrdinalIgnoreCase))
    {
        seciliVaryantMetni = rawVaryantMetni.Split('/')[0].Trim();
    }
    if (secenekler.Count <= 1)
    {
        seciliVaryantMetni = string.Empty;
    }
    var seciliVaryantDetayi = varsayilanSecenek?.VaryantOzeti ?? string.Empty;
    int gosterilecekUretimSuresi = varsayilanSecenek?.UretimSuresiGun > 0
        ? varsayilanSecenek.UretimSuresiGun
        : Model.UretimSuresiGun;
    int gosterilecekKargoSuresi = Model.KargoyaVerilisSuresiGun > 0 ? Model.KargoyaVerilisSuresiGun : 3;
    int gosterilecekTeslimSuresi = Model.TahminiTeslimSuresiGun > 0
        ? Model.TahminiTeslimSuresiGun
        : siteSettings.SiparisTeslimSuresiGun;
    int iadeSuresi = siteSettings.IadeHakkiGun > 0 ? siteSettings.IadeHakkiGun : 14;

    var teknikSatirlari = (Model.TeknikOzellikler ?? string.Empty)
        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

    var dinamikOzellikler = (Model.UrunOzellikleri ?? Enumerable.Empty<FilistinProje.Core.Varliklar.UrunOzellikDegeri>())
        .Where(x =>
            !x.SilindiMi &&
            x.UrunOzellikTanimi != null &&
            x.UrunOzellikTanimi.AktifMi &&
            x.UrunOzellikTanimi.DetaySayfasindaGoster &&
            !string.IsNullOrWhiteSpace(x.Deger))
        .OrderBy(x => x.UrunOzellikTanimi.Sira)
        .ThenBy(x => x.UrunOzellikTanimi.Ad)
        .ToList();

    var teknikTabloSatirlari = new List<(string Baslik, string Deger)>();
    teknikTabloSatirlari.AddRange(dinamikOzellikler
        .Where(x => x.UrunOzellikTanimi.TeknikTablodaGoster)
        .Select(x => (x.UrunOzellikTanimi.Ad, x.DegerGosterimi)));

    foreach (var rawSatir in teknikSatirlari)
    {
        var satir = rawSatir.Trim();
        if (string.IsNullOrWhiteSpace(satir)) continue;

        string baslik = string.Empty;
        string deger = string.Empty;

        if (satir.Contains('|'))
        {
            var parts = satir.Split('|', StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var targetPart = isAr ? parts[1] : parts[0];
                var colonIdx = targetPart.IndexOf(':');
                if (colonIdx > 0 && colonIdx < targetPart.Length - 1)
                {
                    baslik = targetPart[..colonIdx].Trim();
                    deger = targetPart[(colonIdx + 1)..].Trim();
                }
                else
                {
                    deger = targetPart;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(baslik))
        {
            var ayiriciIndex = satir.IndexOf(':');
            if (ayiriciIndex > 0 && ayiriciIndex < satir.Length - 1)
            {
                baslik = satir[..ayiriciIndex].Trim();
                deger = satir[(ayiriciIndex + 1)..].Trim();
            }
            else
            {
                baslik = isAr ? "التفاصيل" : "Detail";
                deger = satir;
            }
        }

        if (isAr)
        {
            if (baslik.Contains("Brand", StringComparison.OrdinalIgnoreCase)) baslik = "🏷️ العلامة التجارية";
            else if (baslik.Contains("SKU", StringComparison.OrdinalIgnoreCase)) baslik = "🔖 رمز المنتج";
            else if (baslik.Contains("Category", StringComparison.OrdinalIgnoreCase)) baslik = "📦 الفئة";
            else if (baslik.Contains("Availability", StringComparison.OrdinalIgnoreCase)) baslik = "✅ حالة التوفر";
            else if (baslik.Equals("Detay", StringComparison.OrdinalIgnoreCase)) baslik = "التفاصيل";
        }
        else
        {
            if (baslik.Contains("العلامة", StringComparison.OrdinalIgnoreCase)) baslik = "🏷️ Brand";
            else if (baslik.Contains("رمز المنتج", StringComparison.OrdinalIgnoreCase)) baslik = "🔖 SKU";
            else if (baslik.Contains("الفئة", StringComparison.OrdinalIgnoreCase)) baslik = "📦 Category";
            else if (baslik.Contains("المتوفر", StringComparison.OrdinalIgnoreCase) || baslik.Contains("التوفر", StringComparison.OrdinalIgnoreCase)) baslik = "✅ Availability";
            else if (baslik.Equals("Detay", StringComparison.OrdinalIgnoreCase)) baslik = "Detail";
        }

        if (deger.Contains('|'))
        {
            var dParts = deger.Split('|', StringSplitOptions.TrimEntries);
            if (dParts.Length == 2)
            {
                deger = isAr ? dParts[1] : dParts[0];
                if (deger.Contains(':'))
                {
                    var cIdx = deger.IndexOf(':');
                    deger = deger[(cIdx + 1)..].Trim();
                }
            }
        }

        teknikTabloSatirlari.Add((baslik, deger));
    }

    var tumMedya = ViewBag.TumMedya as List<FilistinProje.Core.Varliklar.UrunResim> ?? new List<FilistinProje.Core.Varliklar.UrunResim>();
    var galeriMedyalari = ViewBag.Galeri as List<FilistinProje.Core.Varliklar.UrunResim> ?? tumMedya.Where(x => !x.VideoMu).ToList();
    var videoMedyalari = ViewBag.VideoMedyalari as List<FilistinProje.Core.Varliklar.UrunResim> ?? new List<FilistinProje.Core.Varliklar.UrunResim>();
    var yakinDetayMedyalari = ViewBag.YakinDetayMedyalari as List<FilistinProje.Core.Varliklar.UrunResim> ?? new List<FilistinProje.Core.Varliklar.UrunResim>();
    var uretimMedyalari = ViewBag.UretimMedyalari as List<FilistinProje.Core.Varliklar.UrunResim> ?? new List<FilistinProje.Core.Varliklar.UrunResim>();
    var kullanimMedyalari = ViewBag.KullanimMedyalari as List<FilistinProje.Core.Varliklar.UrunResim> ?? new List<FilistinProje.Core.Varliklar.UrunResim>();
    var varsayilanMedya = secenekler.Count > 1
        // Çoklu varyant: varyanta ait olmayan galeri medyasını önceliklendir (açılışta ana ürün görseli gösterilsin)
        ? (galeriMedyalari
            .Where(x => !x.UrunSecenekId.HasValue)
            .OrderByDescending(x => x.VarsayilanMi)
            .ThenBy(x => x.Sira)
            .FirstOrDefault()
          ?? galeriMedyalari
            .OrderByDescending(x => x.VarsayilanMi)
            .ThenBy(x => x.Sira)
            .FirstOrDefault())
        : galeriMedyalari
            .OrderByDescending(x => x.VarsayilanMi)
            .ThenBy(x => x.Sira)
            .FirstOrDefault();
    // Çoklu varyant durumunda açılış görseli: Model.AnaGorselUrl tercih edilir
    var varsayilanGaleriGorseli = secenekler.Count > 1
        ? (!string.IsNullOrWhiteSpace(Model.AnaGorselUrl)
            ? Model.AnaGorselUrl
            : (varsayilanMedya?.ResimYolu ?? string.Empty))
        : (varsayilanMedya?.ResimYolu ?? Model.AnaGorselUrl);
    var varsayilanGaleriAltMetni = !string.IsNullOrWhiteSpace(varsayilanMedya?.AltMetin)
        ? varsayilanMedya.AltMetin
        : Model.LocalizedBaslik;
    var varyantMedyaHaritasi = tumMedya
        .Where(x => x.UrunSecenekId.HasValue && !x.VideoMu && !string.IsNullOrWhiteSpace(x.ResimYolu))
        .GroupBy(x => x.UrunSecenekId!.Value)
        .ToDictionary(
            x => x.Key,
            x => x.OrderByDescending(y => y.VarsayilanMi).ThenBy(y => y.Sira).Select(y => y.ResimYolu).First());
    bool medyaVitriniVar = videoMedyalari.Any() || yakinDetayMedyalari.Any() || uretimMedyalari.Any() || kullanimMedyalari.Any();

    List<FilistinProje.Core.Varliklar.Yorum> yorumlar = ViewBag.Yorumlar ?? new List<FilistinProje.Core.Varliklar.Yorum>();
    double ortalamaPuan = ViewBag.OrtalamaPuan != null ? (double)ViewBag.OrtalamaPuan : 0;
    int yorumSayisi = ViewBag.YorumSayisi != null ? (int)ViewBag.YorumSayisi : 0;
    
    // YÃ„Â±ldÃ„Â±z Hesaplama
    int tamYildiz = (int)ortalamaPuan;
    bool yarimYildiz = (ortalamaPuan - tamYildiz) >= 0.5;
    
    // --- SCHEMA.ORG Ã„Â°Ãƒâ€¡Ã„Â°N URL VE GÃƒâ€“RSEL ---
    var request = HttpContextAccessor.HttpContext?.Request;
    string baseUrl = request != null ? SiteSettingsService.BuildAbsoluteUrl(string.Empty) : "";
    string detaySlug = string.IsNullOrWhiteSpace(Model.Slug) ? $"{FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(Model.LocalizedBaslik)}-{Model.Id}" : $"{Model.Slug}-{Model.Id}";
    string productUrl = $"{baseUrl}/products/{detaySlug}";
    var encodedProductUrl = Uri.EscapeDataString(productUrl);
    var encodedProductTitle = Uri.EscapeDataString(Model.LocalizedBaslik);
    var schemaImagePath = !string.IsNullOrWhiteSpace(varsayilanMedya?.EtkinPosterYolu) ? varsayilanMedya.EtkinPosterYolu : varsayilanGaleriGorseli;
    string productImage = schemaImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? schemaImagePath : $"{baseUrl}{schemaImagePath}";
    var seoDescriptionSource = !string.IsNullOrWhiteSpace(Model.LocalizedKisaAciklama) ? Model.LocalizedKisaAciklama : Model.LocalizedAciklama;
    var seoDescription = System.Text.RegularExpressions.Regex.Replace(seoDescriptionSource ?? string.Empty, "<.*?>", " ");
    seoDescription = System.Net.WebUtility.HtmlDecode(seoDescription);
    seoDescription = System.Text.RegularExpressions.Regex.Replace(seoDescription, @"\s+", " ").Trim();
    if (seoDescription.Length > 155)
    {
        var cut = seoDescription[..155].Trim();
        var lastSpace = cut.LastIndexOf(' ');
        seoDescription = (lastSpace > 80 ? cut[..lastSpace] : cut).TrimEnd('.', ',', ';', ':') + "...";
    }
    if (string.IsNullOrWhiteSpace(seoDescription))
    {
        seoDescription = $"{Model.LocalizedBaslik} {Localizer["MadeToOrder"].Value}. {brandName}.";
    }

    var keywordParts = new List<string?>
    {
        Model.LocalizedBaslik,
        Model.Kategori?.Ad,
        Model.UrunTipi,
        Model.Marka,
        "dekorasyon",
        "premium dekorasyon",
        "siparişe özel üretim"
    };
    keywordParts.AddRange((Model.Etiketler ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    ViewData["SeoTitle"] = !string.IsNullOrWhiteSpace(Model.LocalizedSeoTitle) ? Model.LocalizedSeoTitle : $"{Model.LocalizedBaslik} | {brandName}";
    ViewData["MetaDescription"] = !string.IsNullOrWhiteSpace(Model.LocalizedSeoDescription) ? Model.LocalizedSeoDescription : seoDescription;
    ViewData["MetaKeywords"] = !string.IsNullOrWhiteSpace(Model.SeoKeywords) ? Model.SeoKeywords : string.Join(", ", keywordParts.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase));
    ViewData["CanonicalUrl"] = productUrl;
    ViewData["OgType"] = "product";
    ViewData["OgImage"] = productImage;
    
    // SCHEMA.ORG JSON-LD: Google Shopping Rich Snippets
    var productSchema = SchemaGenerator.GenerateProductSchema(
        Model, 
        ortalamaPuan, 
        yorumSayisi, 
        productImage, 
        productUrl,
        brandName
    );

    var breadcrumbList = new List<(string name, string url)>
    {
        (Localizer["HomePage"].Value, $"{baseUrl}/"),
        (Localizer["Collection"].Value, $"{baseUrl}/products")
    };
    if (Model.Kategori?.ParentKategori != null)
    {
        breadcrumbList.Add((Model.Kategori.ParentKategori.LocalizedAd, $"{baseUrl}/products?k={Model.Kategori.ParentKategori.Id}"));
    }
    if (Model.Kategori != null)
    {
        breadcrumbList.Add((Model.Kategori.LocalizedAd, $"{baseUrl}/products?k={Model.Kategori.Id}"));
    }
    breadcrumbList.Add((Model.LocalizedBaslik, productUrl));

    var breadcrumbSchema = SchemaGenerator.GenerateBreadcrumbSchema(breadcrumbList);
}

<!-- SCHEMA.ORG JSON-LD: Google Shopping Rich Snippets & Breadcrumbs -->
<script type="application/ld+json">
@Html.Raw(productSchema)
</script>
<script type="application/ld+json">
@Html.Raw(breadcrumbSchema)
</script>


<!-- Mobile Lightbox -->
<div id="mobileLightbox" class="fixed inset-0 z-[99990] hidden bg-black/95 items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-label="@Localizer["ProductImage"]">
    <button type="button" class="absolute top-4 right-4 z-[100000] text-white bg-black/50 hover:bg-black/70 rounded-full w-12 h-12 flex items-center justify-center" onclick="closeMobileLightbox()" aria-label="@Localizer["CloseImage"]">
        <i class="fas fa-times text-2xl"></i>
    </button>
    <div class="relative z-[99991] w-full h-full flex items-center justify-center overflow-hidden px-4 py-20" id="lightboxImgContainer">
        <img id="mobileLightboxImage" class="max-w-full max-h-full object-contain transition-transform duration-200" src="@varsayilanGaleriGorseli" alt="@varsayilanGaleriAltMetni" decoding="async">
    </div>
    <div class="absolute bottom-8 left-1/2 z-[100000] transform -translate-x-1/2 flex items-center gap-4 bg-black/60 text-white rounded-full px-4 py-2">
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="rotateMobileImage()" aria-label="@Localizer["Rotate"]"><i class="fas fa-redo"></i></button>
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="zoomOutMobile()" aria-label="@Localizer["ZoomOut"]"><i class="fas fa-search-minus"></i></button>
        <span id="zoomLevel" class="text-sm min-w-[42px] text-center">100%</span>
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="zoomInMobile()" aria-label="@Localizer["ZoomIn"]"><i class="fas fa-search-plus"></i></button>
    </div>
</div>

<!-- Desktop Lightbox Modal -->
<div class="fixed inset-0 z-[99990] hidden bg-black/95 items-center justify-center" id="desktopLightboxModal" role="dialog" aria-modal="true" aria-hidden="true" aria-label="@Localizer["ProductImage"]">
    <button type="button" class="absolute top-4 right-4 z-[100000] text-white bg-black/50 hover:bg-black/70 rounded-full w-12 h-12 flex items-center justify-center" id="closeDesktopModalBtn" aria-label="@Localizer["CloseImage"]">
        <i class="fas fa-times text-2xl"></i>
    </button>
    <div class="absolute top-4 left-1/2 z-[100000] transform -translate-x-1/2 flex items-center gap-3 bg-black/60 text-white rounded-full px-4 py-2">
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="rotateDesktopImage()" aria-label="@Localizer["Rotate"]"><i class="fas fa-redo"></i></button>
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="zoomOutDesktop()" aria-label="@Localizer["ZoomOut"]"><i class="fas fa-search-minus"></i></button>
        <button type="button" class="w-10 h-10 flex items-center justify-center" onclick="zoomInDesktop()" aria-label="@Localizer["ZoomIn"]"><i class="fas fa-search-plus"></i></button>
    </div>
    <div class="relative z-[99991] w-full h-full flex items-center justify-center overflow-hidden px-6 py-20">
        <img id="desktopLightboxImage" src="@varsayilanGaleriGorseli" class="max-w-full max-h-full object-contain transition-transform duration-200" alt="@varsayilanGaleriAltMetni" loading="lazy" decoding="async">
    </div>
</div>


<!-- Yorum Yapma Modal -->
<div class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 items-center justify-center" id="commentModal" role="dialog" aria-modal="true" aria-labelledby="commentModalTitle" aria-hidden="true">
    <div class="bg-white rounded-lg w-full max-w-md p-6 relative">
        <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-black" id="closeCommentModalBtn" aria-label="@Localizer["Close"]"><i class="fas fa-times" aria-hidden="true"></i></button>
        <h5 id="commentModalTitle" class="font-serif text-2xl text-brand-olive mb-6">@Localizer["RateProduct"]</h5>
        <form action="/products/YorumYap" method="post" data-review-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="UrunId" value="@Model.Id" />

            <div class="star-rating justify-center mb-6" role="radiogroup" aria-label="@Localizer["RateProduct"]" data-star-rating data-default-rating="1" dir="ltr">
                <input type="hidden" name="Puan" value="1" data-rating-input />
                @for (int p = 1; p <= 5; p++)
                {
                    <button type="button"
                            class="star-rating-option"
                            role="radio"
                            aria-label="@($"{p} / 5")"
                            aria-checked="@(p == 1 ? "true" : "false")"
                            tabindex="@(p == 1 ? "0" : "-1")"
                            data-rating-value="@p">
                        <i class="fas fa-star" aria-hidden="true"></i>
                    </button>
                }
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="mb-4">
                    <label class="block text-xs uppercase tracking-widest text-brand-darktext font-medium mb-1.5">@Localizer["YourFullName"]</label>
                    <input type="text" name="AdSoyad" class="w-full border border-brand-border rounded px-4 py-2 text-sm focus:ring-[#b58735] focus:border-brand-gold" required>
                </div>
            }

            <div class="mb-6">
                    <label class="block text-xs uppercase tracking-widest text-brand-darktext font-medium mb-1.5">@Localizer["YourComment"]</label>
                <textarea name="YorumMetni" class="w-full border border-brand-border rounded px-4 py-2 text-sm focus:ring-[#b58735] focus:border-brand-gold" rows="4" required></textarea>
            </div>

            <button type="submit" class="w-full bg-brand-olive text-white text-xs tracking-widest uppercase py-3 rounded hover:bg-[#1c2001] transition-colors">@Localizer["SubmitReview"]</button>
        </form>
    </div>
</div>

<!-- Breadcrumb -->
<nav aria-label="@Localizer["Collection"]" class="bg-brand-cream border-b border-brand-border py-3">
    <div class="container mx-auto px-4 flex flex-wrap items-center gap-2 text-xs text-brand-mutedtext">
        <a href="/" class="hover:text-brand-olive transition-colors">@Localizer["HomePage"]</a>
        <span>/</span>
        <a href="/products" class="hover:text-brand-olive transition-colors">@Localizer["Collection"]</a>
        @if (Model.Kategori?.ParentKategori != null)
        {
            <span>/</span>
            <a href="/products?k=@Model.Kategori.ParentKategori.Id" class="hover:text-brand-olive transition-colors">@Model.Kategori.ParentKategori.LocalizedAd</a>
        }
        @if (Model.Kategori != null)
        {
            <span>/</span>
            <a href="/products?k=@Model.Kategori.Id" class="hover:text-brand-olive transition-colors">@Model.Kategori.LocalizedAd</a>
        }
        <span>/</span>
        <span class="text-brand-darktext font-medium truncate max-w-[240px] sm:max-w-none">@Model.LocalizedBaslik</span>
    </div>
</nav>

<div class="container mx-auto px-4 py-6 lg:py-10">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10 xl:gap-14">
        <div class="min-w-0 space-y-4">
            @* ��� ANA MEDYA ALANI ���
                Galeri + Video kar���k medya listesi. width/height CLS i�in explicit.
                Keyboard ve touch swipe _Layout/globalmedia.js i�inde delegated. *@
            <div id="mainProductImageContainer"
                 class="product-media group relative mx-auto w-full overflow-hidden rounded-lg bg-brand-cream"
                 role="region"
                 aria-roledescription="image"
                 aria-label="@Localizer["ProductImage"]"
                 tabindex="0">
                @{
                    var anaMedya = !string.IsNullOrWhiteSpace(varsayilanGaleriGorseli)
                        ? Url.Content(varsayilanGaleriGorseli)
                        : Url.Content("/img/products/placeholder.webp");
                }
                @if (!string.IsNullOrWhiteSpace(varsayilanGaleriGorseli))
                {
                    <img id="mainProductImage"
                         src="@anaMedya"
                         alt="@varsayilanGaleriAltMetni"
                         data-product-name="@Model.LocalizedBaslik"
                         width="800" height="800"
                         class="main-product-image h-full w-full cursor-zoom-in object-contain p-3 transition-opacity duration-300 ease-out group-hover:opacity-95 sm:p-4"
                         onclick="openProductLightbox()"
                         loading="eager"
                         decoding="async"
                         onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.src='/img/products/placeholder.webp';}" />
                }
                else
                {
                    <div class="flex h-full w-full flex-col items-center justify-center gap-3 text-brand-border" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="120" height="120" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" class="opacity-40">
                            <rect x="40" y="60" width="120" height="90" rx="10" />
                            <path d="M40 90 L160 90" />
                            <path d="M85 60 L85 40 L145 40 L145 60" />
                            <circle cx="135" cy="120" r="6" />
                        </svg>
                        <p class="text-xs text-brand-mutedtext">@Model.LocalizedBaslik</p>
                    </div>
                }

                <div id="productBadgeHost">
                    @await Html.PartialAsync("_ProductBadges", badges)
                </div>

                @* Galeri ok tu�lar� � RTL/LTR uyumlu (mant�ksal prev/next; start/end always visual)
                   Mant�ksal olarak prev/next tipleri i�in ui ikonu locale g�re ters �evrilir. *@
                @if (galeriMedyalari.Count > 1)
                {
                    var prevIcon = isRtlDetay ? "fa-chevron-right" : "fa-chevron-left";
                    var nextIcon = isRtlDetay ? "fa-chevron-left" : "fa-chevron-right";
                    <button type="button" onclick="navigateGallery('prev', event)" aria-label="@Localizer["PreviousImage"]"
                            class="gallery-nav-btn gallery-nav-prev absolute top-1/2 start-4 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/85 text-brand-olive opacity-0 shadow-sm backdrop-blur transition-opacity hover:bg-white group-hover:opacity-100 focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-brand-gold">
                        <i class="fas @prevIcon text-sm text-brand-darktext"></i>
                    </button>
                    <button type="button" onclick="navigateGallery('next', event)" aria-label="@Localizer["NextImage"]"
                            class="gallery-nav-btn gallery-nav-next absolute top-1/2 end-4 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/85 text-brand-olive opacity-0 shadow-sm backdrop-blur transition-opacity hover:bg-white group-hover:opacity-100 focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-brand-gold">
                        <i class="fas @nextIcon text-sm text-brand-darktext"></i>
                    </button>
                }
            </div>

            @* ��� THUMBNAIL STRIP � klavye/swipe friendly tab list ��� *@
            @if (galeriMedyalari.Count > 1)
            {
                <div class="product-thumbs flex gap-3 overflow-x-auto pb-2 px-1"
                     role="tablist"
                     aria-label="@Localizer["ProductImage"]"
                     data-thumb-strip>
                    @foreach (var medya in galeriMedyalari.Where(x => !string.IsNullOrWhiteSpace(x.ResimYolu)))
                    {
                        var thumbAlt = !string.IsNullOrWhiteSpace(medya.AltMetin) ? medya.AltMetin : Model.LocalizedBaslik;
                        var isActive = string.Equals(medya.ResimYolu, varsayilanGaleriGorseli, StringComparison.OrdinalIgnoreCase) || (string.IsNullOrWhiteSpace(varsayilanGaleriGorseli) && medya == varsayilanMedya);
                        <button type="button"
                                class="thumbnail-item h-20 w-20 shrink-0 overflow-hidden rounded-xl border @(isActive ? "border-brand-olive ring-2 ring-brand-olive/40" : "border-transparent") bg-white p-1 transition-colors hover:border-brand-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold"
                                data-image="@Url.Content(medya.ResimYolu)"
                                data-thumb-alt="@thumbAlt"
                                role="tab"
                                aria-selected="@(isActive ? "true" : "false")"
                                tabindex="@(isActive ? "0" : "-1")"
                                onclick="changeProductImage('@Url.Content(medya.ResimYolu)', this, '@thumbAlt')">
                            <img src="@Url.Content(medya.ResimYolu)" alt="@thumbAlt" width="80" height="80" class="h-full w-full object-cover pointer-events-none" loading="lazy" decoding="async" />
                        </button>
                    }
                </div>
            }

            @* ��� VIDEO BLOKLARI �autoplay kapal�, poster = image, playsinline ��� *@
            @if (videoMedyalari.Any())
            {
                <div class="grid grid-cols-1 gap-3">
                    @foreach (var vid in videoMedyalari)
                    {
                        var kaynak = !string.IsNullOrWhiteSpace(vid.VideoUrl) ? vid.VideoUrl : vid.ResimYolu;
                        if (string.IsNullOrWhiteSpace(kaynak)) { continue; }
                        var guvenliVideoKaynak = kaynak.StartsWith("/media/products/videos/", StringComparison.OrdinalIgnoreCase)
                            || kaynak.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                            || kaynak.StartsWith("http://", StringComparison.OrdinalIgnoreCase);
                        if (!guvenliVideoKaynak) { continue; }
                        var poster = !string.IsNullOrWhiteSpace(vid.EtkinPosterYolu) ? vid.EtkinPosterYolu : anaMedya;
                        var videoAlt = !string.IsNullOrWhiteSpace(vid.AltMetin) ? vid.AltMetin : Model.LocalizedBaslik;
                        <figure class="rounded-2xl overflow-hidden border border-brand-border bg-black/5">
                            <video controls preload="metadata" playsinline crossorigin="anonymous"
                                   poster="@poster"
                                   aria-label="@videoAlt"
                                   class="w-full h-auto object-cover max-h-[420px]">
                                <source src="@kaynak" type="video/mp4" />
                                @Localizer["VideoNotSupported"]
                            </video>
                            @if (!string.IsNullOrWhiteSpace(vid.Baslik))
                            {
                                <figcaption class="px-3 py-2 text-xs text-brand-mutedtext bg-white/80 border-t border-brand-border">@vid.Baslik</figcaption>
                            }
                        </figure>
                    }
                </div>
            }
        </div>

        <div class="flex flex-col">
            <div class="border-b border-brand-border pb-6">
                <div class="flex items-center justify-between gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(Model.Kategori?.LocalizedAd))
                    {
                        <a href="/products?k=@Model.KategoriId" class="inline-flex text-xs font-semibold uppercase tracking-[0.22em] text-brand-gold hover:text-brand-olive">@Model.Kategori.LocalizedAd</a>
                    }
                    else
                    {
                        <span></span>
                    }

                    <div class="flex items-center gap-2">
                        <!-- Wishlist Toggle Button -->
                        <button type="button" id="btnToggleFavorite" data-product-id="@Model.Id" class="inline-flex items-center gap-1.5 rounded-full border border-brand-border px-3 py-1.5 text-xs font-medium text-brand-darktext hover:border-red-400 hover:text-red-500 transition-colors @(ViewBag.IsFavorited == true ? "is-favorited text-red-500 border-red-300 bg-red-50/60" : "bg-white")" title="@(ViewBag.IsFavorited == true ? Localizer["RemoveFromFavorites"].Value : Localizer["AddToFavorites"].Value)">
                            <i class="@(ViewBag.IsFavorited == true ? "fas fa-heart text-red-500" : "far fa-heart") text-xs favorite-icon"></i>
                            <span class="favorite-text hidden sm:inline">@(ViewBag.IsFavorited == true ? Localizer["RemoveFromFavorites"].Value : Localizer["AddToFavorites"].Value)</span>
                        </button>

                        <!-- Social Share Cluster -->
                        <div class="flex items-center gap-1">
                            <a href="https://api.whatsapp.com/send?text=@encodedProductTitle%20@encodedProductUrl" target="_blank" rel="noopener noreferrer" class="flex h-7 w-7 items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-colors" title="@Localizer["ShareOnWhatsApp"]">
                                <i class="fab fa-whatsapp text-xs"></i>
                            </a>
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedProductUrl" target="_blank" rel="noopener noreferrer" class="flex h-7 w-7 items-center justify-center rounded-full bg-[#1877F2]/10 text-[#1877F2] hover:bg-[#1877F2] hover:text-white transition-colors" title="@Localizer["ShareOnFacebook"]">
                                <i class="fab fa-facebook-f text-[11px]"></i>
                            </a>
                            <button type="button" onclick="copyProductLink(this)" data-url="@productUrl" class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-cream border border-brand-border text-brand-mutedtext hover:text-brand-olive hover:border-brand-olive transition-colors" title="@Localizer["ProductLink"]">
                                <i class="fas fa-link text-[11px]"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <h1 class="font-serif text-3xl leading-tight text-brand-olive md:text-4xl lg:text-5xl">@Model.LocalizedBaslik</h1>
                <div class="mt-4 flex items-center gap-3">
                    <div class="flex text-sm text-brand-gold" aria-label="@ortalamaPuan.ToString("0.0")">
                        @for (var yildiz = 1; yildiz <= 5; yildiz++)
                        {
                            if (yorumSayisi > 0 && yildiz <= tamYildiz) { <i class="fas fa-star"></i> }
                            else if (yorumSayisi > 0 && yildiz == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                            else { <i class="far fa-star text-brand-border"></i> }
                        }
                    </div>
                    <a href="#reviews" class="text-xs text-brand-mutedtext underline-offset-4 hover:text-brand-olive hover:underline">@string.Format(Localizer["ReviewCount"].Value, yorumSayisi)</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.LocalizedKisaAciklama))
                {
                    <p class="mt-4 text-sm leading-7 text-brand-mutedtext">@Model.LocalizedKisaAciklama</p>
                }
            </div>

            @if (!Model.FiyatGizliMi)
            {
                <div class="flex flex-wrap items-end gap-3 border-b border-brand-border py-6">
                    <span id="priceDisplay" class="text-3xl font-medium tracking-tight text-brand-darktext">@gosterilecekFiyat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol</span>
                    @if (gosterilecekEskiFiyat.HasValue)
                    {
                        <span id="oldPriceDisplay" class="pb-1 text-lg text-brand-mutedtext line-through">@gosterilecekEskiFiyat.Value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol</span>
                    }
                    else { <span id="oldPriceDisplay" class="hidden"></span> }
                    @if (gosterilecekIndirimYuzdesi.HasValue)
                    {
                        <span id="discountBadge" class="product-discount-pill mb-1 inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-xs font-bold text-white shadow-sm">
                            <i class="fas fa-bolt text-yellow-300 text-[11px]"></i>
                            <span>%@gosterilecekIndirimYuzdesi @Localizer["Discount"]</span>
                        </span>
                    }
                    else { <span id="discountBadge" class="hidden"></span> }

                    <div id="productDetailCountdown"
                         class="product-countdown-card @(gosterilecekIndirimBitisTarihi.HasValue && gosterilecekIndirimBitisTarihi.Value > DateTime.UtcNow ? "inline-flex" : "hidden") items-center gap-2.5 rounded-xl px-3.5 py-2 text-xs font-semibold text-white shadow-md"
                         data-countdown
                         data-end="@(gosterilecekIndirimBitisTarihi?.ToString("yyyy-MM-ddTHH:mm:ssZ"))"
                         data-original-price="@(gosterilecekEskiFiyat ?? gosterilecekFiyat)">
                        <div class="countdown-pulse-icon flex items-center justify-center w-6 h-6 rounded-full bg-white/20 text-amber-300">
                            <i class="fas fa-clock text-xs animate-pulse"></i>
                        </div>
                        <div class="cd-counter flex items-center gap-2 font-mono">
                            <span class="countdown-label text-white/95 font-medium text-xs">@Localizer["DiscountEndsIn"]</span>
                            <div class="countdown-boxes flex items-center gap-1" dir="ltr">
                                <div class="cd-box"><span class="cd-days">0</span><small>@(isAr ? "ي" : "d")</small></div>
                                <span class="cd-sep">:</span>
                                <div class="cd-box"><span class="cd-hours">00</span></div>
                                <span class="cd-sep">:</span>
                                <div class="cd-box"><span class="cd-mins">00</span></div>
                                <span class="cd-sep">:</span>
                                <div class="cd-box"><span class="cd-secs">00</span></div>
                            </div>
                        </div>
                        <span class="cd-ended hidden text-white font-bold">@Localizer["DiscountEnded"]</span>
                    </div>
                </div>
            }

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-brand-border py-4 text-xs text-brand-mutedtext">
                <span id="stockStatusText" class="flex items-center gap-2"><i class="@stokIkonClass"></i>@stokDurumuMetni</span>
                <span class="flex items-center gap-2"><i class="fas fa-truck text-brand-gold"></i>@gosterilecekKargoSuresi @Localizer["Days"]</span>
                @if (gosterilecekUretimSuresi > 0) { <span id="productionTimeText" class="flex items-center gap-2"><i class="fas fa-hammer text-brand-gold"></i>@string.Format(Localizer["ProductionInDaysJS"].Value, gosterilecekUretimSuresi)</span> }
            </div>

            @{
                var varsayilanStok = varsayilanSecenek?.StokAdedi ?? toplamStok;
                var varsayilanAzStok = !stoktaYokSatisIzni && varsayilanStok >= 1 && varsayilanStok <= 4;
            }
            <div id="lowStockWarning"
                 class="@(varsayilanAzStok ? "" : "hidden") rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700"
                 role="status"
                 aria-live="polite">
                <i class="fas fa-hourglass-half me-2"></i>
                <span id="lowStockText">@string.Format(Localizer["LowStockText"].Value, varsayilanStok)</span>
            </div>

            @if (whatsappSiparisModu)
            {
                @if (secenekler.Count > 1)
                {
                    <div class="pt-6">
                        <div class="mb-3 flex items-center justify-between gap-2">
                            <div id="variantSummaryText" class="text-xs font-medium uppercase tracking-widest text-brand-darktext @(string.IsNullOrWhiteSpace(seciliVaryantMetni) ? "hidden" : "")"><i class="fas fa-layer-group me-1.5"></i><span>@seciliVaryantMetni</span></div>
                            <button type="button" 
                                    class="clear-variant-selection-btn text-xs font-semibold text-brand-gold hover:text-brand-dark hover:underline cursor-pointer hidden items-center gap-1 transition-colors"
                                    onclick="resetToMainProductState(false)">
                                <i class="fas fa-undo-alt text-[10px]"></i>
                                <span>@(isAr ? "المنتج الأصلي (إلغاء التحديد)" : "Original product (Clear)")</span>
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var varyant in secenekler)
                            {
                                var varyantSatinAlinabilir = stoktaYokSatisIzni || varyant.SatinAlinabilirMi;
                                var varyantEtiket = string.IsNullOrWhiteSpace(varyant.GetLocalizedVaryantBasligi(isAr)) ? (string.IsNullOrWhiteSpace(varyant.Olcu) ? (isAr ? "افتراضي" : "Standard") : varyant.Olcu) : varyant.GetLocalizedVaryantBasligi(isAr);
                                if (varyantEtiket.Equals("Standart", StringComparison.OrdinalIgnoreCase) || varyantEtiket.Equals("Standard", StringComparison.OrdinalIgnoreCase)) { varyantEtiket = isAr ? "افتراضي" : "Standard"; }
                                var varyantGorseli = !string.IsNullOrWhiteSpace(varyant.GorselUrl) ? varyant.GorselUrl : (varyantMedyaHaritasi.TryGetValue(varyant.Id, out var eslesen) ? eslesen : string.Empty);
                                var varyantEskiFiyat = varyant.IndirimVarMi ? varyant.SatisFiyati : 0;
                                var varyantSecimRengi = FilistinProje.Core.Helpers.VaryantRenkYardimcisi.TryNormalizeHex(varyant.RenkKodu, out var guvenliVaryantRengi) ? guvenliVaryantRengi : string.Empty;
                                <label class="variant-option-card relative cursor-pointer select-none rounded border-2 border-brand-border bg-white px-4 py-3 text-sm text-brand-mutedtext transition-all duration-150 hover:border-brand-gold @(!varyantSatinAlinabilir ? "is-disabled" : "")">
                                    @if (Model.FiyatGizliMi)
                                    {
                                        <input type="radio" class="variant-radio absolute h-0 w-0 opacity-0" name="productVariant" value="@varyant.Id" checked="@(varyant.Id == varsayilanSecenek?.Id ? "checked" : null)" data-purchasable="@(varyantSatinAlinabilir.ToString().ToLowerInvariant())" data-color="@varyantSecimRengi" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyant.UretimSuresiGun" data-image="@varyantGorseli" data-label="@varyantEtiket" data-olcu="@varyantEtiket" />
                                    }
                                    else
                                    {
                                        <input type="radio" class="variant-radio absolute h-0 w-0 opacity-0" name="productVariant" value="@varyant.Id" checked="@(varyant.Id == varsayilanSecenek?.Id ? "checked" : null)" data-purchasable="@(varyantSatinAlinabilir.ToString().ToLowerInvariant())" data-color="@varyantSecimRengi" data-price="@varyant.EtkinFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-oldprice="@(varyantEskiFiyat > 0 ? varyantEskiFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" data-enddate="@(varyant.IndirimVarMi && varyant.IndirimBitisTarihi.HasValue ? varyant.IndirimBitisTarihi.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : string.Empty)" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyant.UretimSuresiGun" data-image="@varyantGorseli" data-label="@varyantEtiket" data-olcu="@varyantEtiket" />
                                    }
                                    @if (!string.IsNullOrWhiteSpace(varyant.RenkKodu) || !string.IsNullOrWhiteSpace(varyant.Renk)) { <span class="me-1 inline-block h-3 w-3 rounded-full border align-middle" data-variant-color="@varyant.Id" style="background-color:@varyant.GuvenliRenkKodu;border-color:rgba(0,0,0,.35)"></span> }
                                    @varyantEtiket
                                </label>
                            }
                        </div>
                    </div>
                }

                var whatsappMessageParts = new List<string> { Model.LocalizedBaslik };
                var varsayilanWhatsappVaryanti = varsayilanSecenek == null
                    ? string.Empty
                    : (string.IsNullOrWhiteSpace(varsayilanSecenek.VaryantBasligi) ? varsayilanSecenek.Olcu : varsayilanSecenek.VaryantBasligi);
                if (!string.IsNullOrWhiteSpace(varsayilanWhatsappVaryanti))
                {
                    whatsappMessageParts.Add(varsayilanWhatsappVaryanti);
                }
                whatsappMessageParts.Add(productUrl);
                var whatsappText = Uri.EscapeDataString(string.Join("\n", whatsappMessageParts));
                <a id="whatsappOrderLink"
                   href="https://wa.me/@whatsappNumber?text=@whatsappText"
                   rel="noopener noreferrer"
                   target="_blank"
                   class="mt-6 inline-flex w-full items-center justify-center gap-3 rounded-full bg-[#25D366] px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-lg hover:bg-[#1da851]">
                    <i class="fab fa-whatsapp text-xl"></i>
                    <span>@Localizer["Admin_WhatsappOrder"]</span>
                </a>
            }
            else
            {
            <form id="addToCartForm" class="space-y-6 pt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UrunId" value="@Model.Id" />
                <input type="hidden" id="selectedVariantId" value="@(varsayilanSecenek?.Id.ToString() ?? "")" />
                <input type="hidden" id="selectedQuantity" name="Adet" value="@minSiparisAdedi" />

                @if (secenekler.Count > 1)
                {
                    <div>
                        <div class="mb-3 flex items-center justify-between gap-2">
                            <div id="variantSummaryText" class="text-xs font-medium uppercase tracking-widest text-brand-darktext @(string.IsNullOrWhiteSpace(seciliVaryantMetni) ? "hidden" : "")"><i class="fas fa-layer-group me-1.5"></i><span>@seciliVaryantMetni</span></div>
                            <button type="button" 
                                    class="clear-variant-selection-btn text-xs font-semibold text-brand-gold hover:text-brand-dark hover:underline cursor-pointer hidden items-center gap-1 transition-colors"
                                    onclick="resetToMainProductState(false)">
                                <i class="fas fa-undo-alt text-[10px]"></i>
                                <span>@(isAr ? "المنتج الأصلي (إلغاء التحديد)" : "Original product (Clear)")</span>
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var varyant in secenekler)
                            {
                                var varyantSatinAlinabilir = stoktaYokSatisIzni || varyant.SatinAlinabilirMi;
                                var varyantEtiket = string.IsNullOrWhiteSpace(varyant.GetLocalizedVaryantBasligi(isAr)) ? (string.IsNullOrWhiteSpace(varyant.Olcu) ? (isAr ? "افتراضي" : "Standard") : varyant.Olcu) : varyant.GetLocalizedVaryantBasligi(isAr);
                                if (varyantEtiket.Equals("Standart", StringComparison.OrdinalIgnoreCase) || varyantEtiket.Equals("Standard", StringComparison.OrdinalIgnoreCase)) { varyantEtiket = isAr ? "افتراضي" : "Standard"; }
                                var varyantGorseli = !string.IsNullOrWhiteSpace(varyant.GorselUrl) ? varyant.GorselUrl : (varyantMedyaHaritasi.TryGetValue(varyant.Id, out var eslesen) ? eslesen : string.Empty);
                                decimal varyantEtkinFiyat;
                                if (isWholesale)
                                {
                                    var kademeFiyati = varyant.ToptanFiyatKademeleri?.Where(k => k.AktifMi).OrderBy(k => k.MinAdet).FirstOrDefault()?.BirimFiyat;
                                    if (kademeFiyati.HasValue && kademeFiyati.Value > 0)
                                    {
                                        varyantEtkinFiyat = kademeFiyati.Value;
                                    }
                                    else if (Model.TopFiyat.HasValue && Model.TopFiyat.Value > 0)
                                    {
                                        varyantEtkinFiyat = varyant.FiyatFarki != 0 ? (Model.TopFiyat.Value + varyant.FiyatFarki) : Model.TopFiyat.Value;
                                    }
                                    else
                                    {
                                        varyantEtkinFiyat = varyant.EtkinFiyat;
                                    }
                                }
                                else
                                {
                                    varyantEtkinFiyat = varyant.EtkinFiyat;
                                }
                                var varyantEskiFiyat = varyant.IndirimVarMi ? varyant.SatisFiyati : (isWholesale && varyantEtkinFiyat < varyant.SatisFiyati ? varyant.SatisFiyati : 0);
                                var varyantSecimRengi = FilistinProje.Core.Helpers.VaryantRenkYardimcisi.TryNormalizeHex(varyant.RenkKodu, out var guvenliVaryantRengi) ? guvenliVaryantRengi : string.Empty;
                                <label class="variant-option-card relative cursor-pointer select-none rounded border-2 border-brand-border bg-white px-4 py-3 text-sm text-brand-mutedtext transition-all duration-150 hover:border-brand-gold @(!varyantSatinAlinabilir ? "is-disabled" : "")">
                                    <input type="radio" class="variant-radio absolute h-0 w-0 opacity-0" name="productVariant" value="@varyant.Id" checked="@(varyant.Id == varsayilanSecenek?.Id ? "checked" : null)" data-purchasable="@(varyantSatinAlinabilir.ToString().ToLowerInvariant())" data-color="@varyantSecimRengi" data-price="@varyantEtkinFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-oldprice="@(varyantEskiFiyat > 0 ? varyantEskiFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" data-enddate="@(varyant.IndirimVarMi && varyant.IndirimBitisTarihi.HasValue ? varyant.IndirimBitisTarihi.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : string.Empty)" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyant.UretimSuresiGun" data-image="@varyantGorseli" data-label="@varyantEtiket" data-olcu="@varyantEtiket" />
                                    @if (!string.IsNullOrWhiteSpace(varyant.RenkKodu) || !string.IsNullOrWhiteSpace(varyant.Renk)) { <span class="me-1 inline-block h-3 w-3 rounded-full border align-middle" data-variant-color="@varyant.Id" style="background-color:@varyant.GuvenliRenkKodu;border-color:rgba(0,0,0,.35)"></span> }
                                    @varyantEtiket
                                </label>
                            }
                        </div>
                    </div>
                }

                @{
                    var ozelPaketler = (Model.HediyePaketSecenekleri ?? new List<FilistinProje.Core.Varliklar.UrunHediyePaketSecenegi>())
                        .Where(x => x.AktifMi && !x.SilindiMi)
                        .OrderBy(x => x.Sira)
                        .ThenBy(x => x.Id)
                        .ToList();
                    var genelPaketler = (ViewBag.HediyePaketleri as List<FilistinProje.Core.Varliklar.UrunHediyePaketSecenegi>) ?? new List<FilistinProje.Core.Varliklar.UrunHediyePaketSecenegi>();
                    var hediyePaketSecenekleri = ozelPaketler.Count > 0 ? ozelPaketler : genelPaketler;
                }
                @if (hediyePaketSecenekleri.Count > 0)
                {
                    <div class="rounded-2xl border border-brand-border bg-brand-cream p-4">
                        <label for="giftPackageSelect" class="mb-2 block text-xs font-medium uppercase tracking-widest text-brand-darktext">
                            @Localizer["GiftPackageType"]
                            <span class="text-[11px] font-normal text-brand-mutedtext">(@Localizer["GiftPackagePriceNote"])</span>
                        </label>
                        <div class="relative">
                            <select id="giftPackageSelect" name="giftPackageOption" class="w-full appearance-none rounded-xl border border-brand-border bg-white py-3 ps-4 pe-10 text-sm font-medium text-brand-darktext shadow-sm transition hover:border-brand-gold focus:border-brand-olive focus:outline-none focus:ring-1 focus:ring-brand-olive cursor-pointer">
                                <option value="" data-price="0">@Localizer["NoGiftPackage"]</option>
                                @foreach (var paket in hediyePaketSecenekleri)
                                {
                                    <option value="@paket.Id" data-price="@paket.Fiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @paket.LocalizedAd (+@paket.Fiyat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol / @Localizer["Piece"])
                                    </option>
                                }
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-brand-mutedtext">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </div>
                        </div>
                        <p class="mt-2 text-xs text-brand-mutedtext">@Localizer["GiftWrapDesc"]</p>
                        <textarea id="giftNoteText" maxlength="500" rows="2" class="mt-3 hidden w-full rounded-xl border border-brand-border bg-white p-3 text-sm" placeholder="@Localizer["GiftWrapDesc"]"></textarea>
                    </div>
                }

                <div id="selectionSummary" class="hidden rounded-xl border border-brand-border/80 bg-brand-warmcream/60 p-2.5 sm:p-3 space-y-1 text-[11px] text-brand-darktext transition-all shadow-sm">
                    <div class="flex items-center justify-between border-b border-brand-border/60 pb-1.5">
                        <span class="font-semibold uppercase tracking-wider text-[10px] text-brand-olive flex items-center gap-1">
                            <i class="fas fa-list-check text-brand-gold text-[9px]"></i>@Localizer["SelectionSummary"]
                        </span>
                        <span id="summaryGiftBadge" class="hidden inline-flex items-center gap-1 rounded-full bg-brand-olive px-1.5 py-0.5 text-[9px] font-medium text-white">
                            <i class="fas fa-gift text-[8px]"></i>@Localizer["GiftPackaging"]
                        </span>
                    </div>
                    <div id="summaryVariantRow" class="hidden flex items-center justify-between text-brand-mutedtext">
                        <span>@Localizer["Variant"]:</span>
                        <span id="summaryOlcu" class="font-medium text-brand-darktext">-</span>
                    </div>
                    <div class="flex items-center justify-between text-brand-mutedtext">
                        <span>@Localizer["ProductUnitPrice"]:</span>
                        <span id="summaryProductPrice" class="font-medium text-brand-darktext">-</span>
                    </div>
                    <div id="summaryGiftRow" class="hidden flex items-center justify-between font-medium text-brand-olive">
                        <span id="summaryGiftTitle" class="flex items-center gap-1">
                            <i class="fas fa-gift text-brand-gold text-[9px]"></i>
                            <span id="summaryGiftName">+ @Localizer["GiftPackaging"]:</span>
                        </span>
                        <span id="summaryGiftPrice" class="font-semibold text-brand-gold">-</span>
                    </div>
                    <div class="pt-1 border-t border-brand-border/70 flex items-center justify-between font-bold text-[12px] text-brand-olive">
                        <span>@Localizer["TotalPayable"]:</span>
                        <div class="text-end">
                            <span id="summaryFiyat" class="text-brand-olive"></span>
                            <span id="summaryBirimFiyat" class="block text-[9px] font-normal text-brand-mutedtext"></span>
                        </div>
                    </div>
                    <div id="summaryBreakdown" class="text-[10px] text-brand-mutedtext text-end font-mono"></div>
                </div>

                <div class="product-purchase-actions flex items-end gap-3">
                    <div>
                        <label class="mb-2 block text-xs font-medium uppercase tracking-widest text-brand-darktext">@Localizer["Quantity"]</label>
                        <div class="flex h-12 items-center border border-brand-border bg-white rounded-md">
                            <button type="button" class="flex h-full w-10 items-center justify-center hover:bg-brand-cream transition-colors text-brand-darktext font-bold" onclick="decreaseQuantity()" aria-label="@Localizer["Decrease"]">-</button>
                            <input id="productQuantity" type="number" min="@minSiparisAdedi" max="@maxSiparisAdedi" value="@minSiparisAdedi" class="h-full w-14 border-0 bg-transparent p-0 text-center text-sm font-semibold text-brand-darktext focus:ring-0 focus:outline-none" />
                            <button type="button" class="flex h-full w-10 items-center justify-center hover:bg-brand-cream transition-colors text-brand-darktext font-bold" onclick="increaseQuantity()" aria-label="@Localizer["Increase"]">+</button>
                        </div>
                    </div>
                    <button id="ajaxSepetBtn" type="button" class="flex h-12 min-w-0 flex-1 items-center justify-center gap-2 bg-brand-olive px-4 text-xs font-bold uppercase tracking-widest text-white rounded-md transition-colors hover:bg-[#1c2001] disabled:cursor-wait disabled:opacity-70"><i class="fas fa-shopping-bag add-to-cart-icon"></i><span class="add-to-cart-text">@Localizer["AddToCart"]</span></button>
                    <a href="/cart" class="flex h-12 w-12 items-center justify-center bg-brand-gold text-white rounded-md transition-colors hover:bg-[#8e6a28]" aria-label="@Localizer["Cart"]"><i class="fas fa-shopping-cart"></i></a>
                </div>
            </form>
            }

            @if (!Model.IsExchangeable)
            {
                var noExColor = string.IsNullOrWhiteSpace(Model.NoExchangeBadgeColor) ? "#DC2626" : Model.NoExchangeBadgeColor;
                var hex = noExColor.TrimStart('#');
                var isLight = false;
                if (hex.Length == 6 && int.TryParse(hex[..2], System.Globalization.NumberStyles.HexNumber, null, out var r)
                    && int.TryParse(hex[2..4], System.Globalization.NumberStyles.HexNumber, null, out var g)
                    && int.TryParse(hex[4..6], System.Globalization.NumberStyles.HexNumber, null, out var b))
                {
                    var luminance = (r * 0.299 + g * 0.587 + b * 0.114);
                    isLight = luminance > 175;
                }
                var textColor = isLight ? "#1F2937" : "#FFFFFF";

                <div class="product-no-exchange-badge mt-4 flex items-center gap-3 rounded-xl px-4 py-3 text-xs font-semibold shadow-sm transition-all"
                     style="background-color: @noExColor; color: @textColor;"
                     role="alert"
                     data-no-exchange-badge="true">
                    <i class="fas fa-ban text-base shrink-0"></i>
                    <span class="tracking-wide">@Localizer["Product_NoExchangeNotice"]</span>
                </div>
            }

            @if (!Model.FiyatGizliMi && Model.ToptanFiyatKademeleri.Any(x => x.AktifMi && !x.SilindiMi))
            {
                @if (isWholesale)
                {
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 shadow-sm">
                        <label for="wholesaleTierSelect" class="mb-2 block text-xs font-bold uppercase tracking-widest text-emerald-900 flex items-center gap-2">
                            <i class="fas fa-boxes-stacked text-emerald-600"></i>
                            <span>@Localizer["WholesalePrices"]</span>
                            <span class="text-[11px] font-normal text-emerald-700">(@Localizer["WholesaleTierNotice"])</span>
                        </label>
                        <div class="relative">
                            <select id="wholesaleTierSelect" class="w-full appearance-none rounded-xl border border-emerald-300 bg-white py-3 ps-4 pe-10 text-sm font-medium text-emerald-950 shadow-sm transition hover:border-emerald-500 focus:border-emerald-600 focus:outline-none cursor-pointer">
                                <option value="" data-min="1" data-price="">@Localizer["StandardRetailPrice"] (@Localizer["SelectWholesaleTier"])</option>
                                @foreach (var tier in Model.ToptanFiyatKademeleri.Where(x => x.AktifMi && !x.SilindiMi).OrderBy(x => x.MinAdet))
                                {
                                    var tierVariant = Model.UrunSecenek.FirstOrDefault(x => x.Id == tier.UrunSecenekId);
                                    <option value="@tier.Id" 
                                            data-min="@tier.MinAdet" 
                                            data-price="@tier.BirimFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-variant-id="@(tier.UrunSecenekId ?? 0)">
                                        @tier.MinAdet+ @Localizer["Piece"] — @tier.BirimFiyat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol / @Localizer["Piece"] @(tierVariant == null ? "" : $" ({tierVariant.VaryantBasligi})")
                                    </option>
                                }
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-emerald-700">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </div>
                        </div>
                        <p class="mt-2 text-xs text-emerald-700">@Localizer["WholesaleTierSelectHelp"]</p>
                    </div>
                }
                else
                {
                    <div class="rounded-2xl border border-brand-border/70 bg-brand-cream/60 p-4">
                        <div class="flex items-start gap-3">
                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-olive/10 text-brand-olive">
                                <i class="fas fa-boxes-stacked text-base"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <h4 class="text-xs font-bold uppercase tracking-wider text-brand-olive">@Localizer["WholesalePrices"]</h4>
                                <p class="mt-1 text-xs text-brand-mutedtext leading-relaxed">
                                    @Localizer["WholesaleApplyOrLoginPrompt"]
                                </p>
                                <div class="mt-2 flex items-center gap-3">
                                    <a href="/Hesap/GirisYap?returnUrl=@Uri.EscapeDataString(productUrl)" class="text-xs font-semibold text-brand-gold hover:text-brand-olive hover:underline">
                                        @Localizer["Login"] &rarr;
                                    </a>
                                    <span class="text-brand-border">|</span>
                                    <a href="/Hesap/KayitOl" class="text-xs font-semibold text-brand-gold hover:text-brand-olive hover:underline">
                                        @Localizer["Register"] &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            @if (Model.ToptanciUrunGrubu != null && Model.ToptanciUrunGrubu.IskontoOranlari.Any(x => x.AktifMi && !x.SilindiMi))
            {
                <div class="mt-3 rounded-2xl border border-blue-200 bg-blue-50/70 p-4">
                    <div class="mb-3 flex items-center gap-2 text-sm font-bold text-blue-900">
                        <i class="fas fa-tags"></i>
                        @Localizer["SpecialDiscountTiers"] (@Model.ToptanciUrunGrubu.Ad)
                    </div>
                    <div class="grid gap-2 sm:grid-cols-2">
                        @foreach (var disc in Model.ToptanciUrunGrubu.IskontoOranlari.Where(x => x.AktifMi && !x.SilindiMi).OrderBy(x => x.MinAdet))
                        {
                            <div class="flex items-center justify-between rounded-xl bg-white px-3 py-2 text-xs shadow-sm">
                                <span class="text-brand-mutedtext">@disc.MinAdet+ @Localizer["Piece"]</span>
                                <strong class="text-blue-800">
                                    @if (disc.IskontoTipi == "Tutar")
                                    {
                                        <span>-@currencySymbol@disc.IskontoTutari.ToString("N2") / @Localizer["Piece"]</span>
                                    }
                                    else
                                    {
                                        <span>%@disc.IskontoYuzdesi.ToString("0.##") @Localizer["Discount"]</span>
                                    }
                                </strong>
                            </div>
                        }
                    </div>
                    <div class="mt-2 text-[11px] text-blue-700 italic">
                        <i class="fas fa-info-circle me-1"></i>@Localizer["WholesaleTierNotice"]
                    </div>
                </div>
            }
            <div class="mt-7 grid grid-cols-3 border-y border-brand-border py-5 text-center">
                <div><i class="fas fa-shield-alt mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["SecurePayment"]</p></div>
                <div><i class="fas fa-truck mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["FreeShipping"]</p></div>
                @if (Model.IsExchangeable)
                {
                    <div><i class="fas fa-undo-alt mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["ReturnGuarantee"]</p></div>
                }
                else
                {
                    <div><i class="fas fa-ban mb-2 text-rose-600"></i><p class="text-xs font-semibold text-rose-600">@Localizer["Admin_NoExchangePolicy"]</p></div>
                }
            </div>
            <div class="mt-4 flex items-center justify-center gap-2 text-xs text-brand-mutedtext"><i class="fas fa-circle-check text-brand-gold"></i>@Localizer["Product_TrustNote"]</div>
        </div>
    </div>

    <section id="reviews" class="product-detail-sections mt-20 border-t border-brand-border pt-12">
        <div class="flex flex-col gap-12 lg:flex-row">
            <div class="space-y-12 lg:w-2/3">
                @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi) || !string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi) || !string.IsNullOrWhiteSpace(Model.BakimTalimati))
                {
                    <div class="grid gap-3 sm:grid-cols-3">
                        @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi)) { <article class="product-benefit-card"><i class="fas fa-gem"></i><h3>@Localizer["Product_Material"]</h3><p>@Model.MalzemeBilgisi</p></article> }
                        @if (!string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi)) { <article class="product-benefit-card"><i class="fas fa-box-open"></i><h3>@Localizer["Packaging"]</h3><p>@Model.PaketlemeBilgisi</p></article> }
                        @if (!string.IsNullOrWhiteSpace(Model.BakimTalimati)) { <article class="product-benefit-card"><i class="fas fa-hand-sparkles"></i><h3>@Localizer["Product_Care"]</h3><p>@Model.BakimTalimati</p></article> }
                    </div>
                }
                <div>
                    <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-file-alt text-brand-gold"></i>@Localizer["ProductDescription"]</h2>
                    <div class="prose prose-sm max-w-none leading-relaxed text-brand-mutedtext">
                        @if (!string.IsNullOrWhiteSpace(Model.LocalizedAciklama))
                        {
                            @Html.SanitizeHtml(Model.LocalizedAciklama)
                        }
                        else
                        {
                            <p>@Model.LocalizedKisaAciklama</p>
                        }
                    </div>
                </div>

                @if (teknikTabloSatirlari.Any())
                {
                    <div>
                        <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-cogs text-brand-gold"></i>@Localizer["ProductDetails"]</h2>
                        <div class="overflow-hidden rounded-lg border border-brand-border bg-white">
                            <table class="w-full text-sm">
                                <tbody class="divide-y divide-brand-border">
                                    @foreach (var satir in teknikTabloSatirlari)
                                    {
                                        <tr class="transition-colors hover:bg-[#fcf9f3]">
                                            <th scope="row" class="w-1/3 bg-brand-cream px-5 py-4 text-start font-semibold text-brand-darktext">@satir.Baslik</th>
                                            <td class="px-5 py-4 text-brand-mutedtext">@satir.Deger</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <aside class="lg:w-1/3">
                <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-comments text-brand-gold"></i>@Localizer["Reviews"]</h2>
                @if (yorumlar.Any())
                {
                    <div class="mb-7 rounded-lg border border-brand-border bg-white p-6 text-center">
                        <p class="font-serif text-5xl text-brand-olive">@ortalamaPuan.ToString("0.0")</p>
                        <div class="my-3 text-brand-gold">
                            @for (var yildiz = 1; yildiz <= 5; yildiz++)
                            {
                                if (yorumSayisi > 0 && yildiz <= tamYildiz) { <i class="fas fa-star"></i> }
                                else if (yorumSayisi > 0 && yildiz == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                                else { <i class="far fa-star text-brand-border"></i> }
                            }
                        </div>
                        <p class="mb-5 text-sm text-brand-mutedtext">@string.Format(Localizer["ReviewCount"].Value, yorumSayisi)</p>
                        <button type="button" id="openCommentModalBtn" class="w-full rounded border border-brand-olive py-2.5 text-xs font-semibold uppercase tracking-widest text-brand-olive transition-colors hover:bg-brand-olive hover:text-white">@Localizer["WriteReview"]</button>
                    </div>
                    <div id="reviewsList" class="space-y-4">
                        @for (int i = 0; i < yorumlar.Count; i++)
                        {
                            var yorum = yorumlar[i];
                            var isHidden = i >= 3;
                            var adParcalari = (yorum.AdSoyad ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var basHarfler = adParcalari.Length == 0 ? "?" : string.Concat(adParcalari.Select(x => x[0]));
                            <article class="review-item rounded-lg border border-brand-border bg-white p-4 transition-all @(isHidden ? "hidden extra-review" : "")">
                                <div class="mb-3 flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-cream text-sm font-semibold text-brand-olive">@basHarfler</span>
                                        <div>
                                            <strong class="block text-sm text-brand-darktext">@yorum.AdSoyad</strong>
                                            <span class="text-[10px]">
                                                @for (var yildiz = 1; yildiz <= 5; yildiz++)
                                                {
                                                    if (yildiz <= yorum.Puan)
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <time class="text-[10px] text-brand-mutedtext">@yorum.OlusturulmaTarihi.ToString("dd MMM yyyy")</time>
                                </div>
                                <p class="text-sm leading-6 text-brand-mutedtext">@yorum.YorumMetni</p>
                            </article>
                        }
                    </div>
                    @if (yorumlar.Count > 3)
                    {
                        <button type="button" id="showAllReviewsBtn" onclick="toggleAllReviews()" class="mt-4 w-full rounded border border-brand-border bg-brand-cream/60 py-2.5 text-xs font-semibold uppercase tracking-wider text-brand-olive hover:bg-brand-cream transition-colors flex items-center justify-center gap-2" data-show-text="@string.Format(Localizer["ShowAllReviews"].Value, yorumlar.Count)" data-hide-text="@Localizer["ShowLess"].Value" data-expanded="false">
                            <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="showReviewsIcon"></i>
                            <span id="showReviewsText">@string.Format(Localizer["ShowAllReviews"].Value, yorumlar.Count)</span>
                        </button>
                    }
                }
                else
                {
                    <div class="rounded-lg border border-brand-border bg-white px-6 py-12 text-center"><i class="far fa-comments mb-4 text-4xl text-brand-border"></i><p class="mb-5 text-sm text-brand-mutedtext">@Localizer["NoReviewsYet"]</p><button type="button" id="openCommentModalBtnEmpty" class="rounded bg-brand-olive px-6 py-2.5 text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:bg-[#1c2001]">@Localizer["WriteReview"]</button></div>
                }
            </aside>
        </div>
    </section>

@{
    var benzerUrunler = ViewBag.BenzerUrunler as List<FilistinProje.Core.DTOs.BenzerUrunDto>;
}
@if (benzerUrunler != null && benzerUrunler.Count > 0)
{
    <section class="py-16 bg-[#fafaf8]" aria-labelledby="relatedProductsTitle">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-center mb-10">
                <hr class="w-1/4 border-brand-border hidden md:block"/>
                <h2 id="relatedProductsTitle" class="font-serif text-3xl mx-8 text-center text-brand-olive">@Localizer["SimilarProducts"]</h2>
                <hr class="w-1/4 border-brand-border hidden md:block"/>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
                @foreach (var item in benzerUrunler)
                {
                    decimal itemFiyat = item.GosterFiyat;
                    decimal? bEskiFiyat = !item.FiyatGizliMi && item.IndirimliFiyat != null && item.IndirimliFiyat < item.Fiyat ? item.Fiyat : null;
                    var benzerUrlSlug = !string.IsNullOrEmpty(item.Slug) ? item.Slug : FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(item.LocalizedBaslik);
                    if (string.IsNullOrWhiteSpace(benzerUrlSlug)) { benzerUrlSlug = "urun"; }
                    string bProductUrl = $"/products/{benzerUrlSlug}-{item.Id}";
                    bool benzerResimVar = !string.IsNullOrWhiteSpace(item.AnaGorselUrl);
                    <a href="@bProductUrl" class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 rounded">
                        <div class="related-image-container relative overflow-hidden mb-3 aspect-square bg-[#f8f6f2] rounded">
                            @if (benzerResimVar)
                            {
                                <img alt="@item.LocalizedBaslik"
                                     src="@item.AnaGorselUrl"
                                     width="400" height="400"
                                     class="related-product-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                     loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center text-brand-border" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" class="opacity-30">
                                        <rect x="35" y="55" width="130" height="100" rx="8" />
                                        <path d="M35 85 L165 85" />
                                        <path d="M85 55 L85 35 L145 35 L145 55" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <h3 class="text-xs font-semibold text-brand-darktext tracking-wide line-clamp-2 mb-1">@item.LocalizedBaslik</h3>
                        @if (!item.FiyatGizliMi)
                        {
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-bold text-brand-olive">@itemFiyat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol</span>
                                @if (bEskiFiyat != null)
                                {
                                    <span class="text-xs text-[#999] line-through">@bEskiFiyat?.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) @currencySymbol</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-xs italic text-brand-mutedtext">@Localizer["PriceOnRequest"]</p>
                        }
                        @if (item.WhatsappSiparisModu)
                        {
                            <span class="mt-2 flex items-center gap-1.5 text-[10px] font-semibold uppercase text-green-600"><i class="fab fa-whatsapp"></i>@Localizer["Admin_WhatsappOrder"]</span>
                        }
                    </a>
                }
            </div>
        </div>
    </section>
}

