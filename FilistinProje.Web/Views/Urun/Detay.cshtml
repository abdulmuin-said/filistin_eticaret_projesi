    updateSelectionSummary();
}

function updateVariantCardStyles() {
    document.querySelectorAll('.variant-radio').forEach(function(radio) {
        var card = radio.closest('label');
        if (!card) return;

        var safeColor = /^#[0-9A-Fa-f]{6}$/.test(radio.dataset.color || '') ? radio.dataset.color : '';
        var isPurchasable = radio.getAttribute('data-purchasable') !== 'false';
        var isSelected = radio.checked;
        card.classList.toggle('is-selected', isSelected);
        card.classList.toggle('is-disabled', !isPurchasable);

        if (safeColor) {
            var red = parseInt(safeColor.slice(1, 3), 16);
            var green = parseInt(safeColor.slice(3, 5), 16);
            var blue = parseInt(safeColor.slice(5, 7), 16);
            var channels = [red, green, blue].map(function(channel) {
                var normalized = channel / 255;
                return normalized <= .04045 ? normalized / 12.92 : Math.pow((normalized + .055) / 1.055, 2.4);
            });
            var luminance = .2126 * channels[0] + .7152 * channels[1] + .0722 * channels[2];
            card.style.setProperty('--variant-selection-color', safeColor);
            card.style.setProperty('--variant-selection-text', luminance > .179 ? '#1c1c18' : '#ffffff');
        } else {
            card.style.removeProperty('--variant-selection-color');
            card.style.removeProperty('--variant-selection-text');
        }

        if (isSelected) {
            var existingBadge = card.querySelector('.variant-check-badge');
            if (!existingBadge) {
                var badge = document.createElement('div');
                badge.className = 'variant-check-badge absolute -top-2 -right-2 w-5 h-5 bg-brand-gold rounded-full flex items-center justify-center shadow-sm';
                badge.setAttribute('aria-hidden', 'true');
                badge.innerHTML = '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
                card.appendChild(badge);
            }
            var priceSpan = card.querySelector('.variant-price');
            if (priceSpan) priceSpan.className = 'variant-price text-xs font-medium';
            var stockSpan = card.querySelector('.variant-stock-warning');
            if (stockSpan) stockSpan.classList.remove('text-amber-600');
        } else {
            var badge = card.querySelector('.variant-check-badge');
            if (badge) badge.remove();
            var priceSpan = card.querySelector('.variant-price');
            if (priceSpan) priceSpan.className = 'variant-price text-xs text-brand-gold font-medium';
            var stockSpan = card.querySelector('.variant-stock-warning');
            if (stockSpan) stockSpan.classList.add('text-amber-600');
        }
    });
}

document.querySelectorAll('.variant-radio').forEach(function(radio) {
    radio.addEventListener('change', function() {
        if (this.checked) {
            var imageUrl = this.getAttribute('data-image');
            var label = this.getAttribute('data-label');
            var isPreorder = this.getAttribute('data-preorder') === 'true';
            var stock = parseInt(this.getAttribute('data-stock')) || 0;
            var productionDays = parseInt(this.getAttribute('data-production')) || 0;

            var selectedVariantId = document.getElementById('selectedVariantId');
            if (selectedVariantId) selectedVariantId.value = this.value;

            updateVariantCardStyles();

            var wholesaleSelect = document.getElementById('wholesaleTierSelect');
            if (wholesaleSelect && wholesaleSelect.value) {
                var selectedOption = wholesaleSelect.options[wholesaleSelect.selectedIndex];
                var tierVariantId = parseInt(selectedOption?.getAttribute('data-variant-id')) || 0;
                if (tierVariantId > 0 && tierVariantId != this.value) {
                    wholesaleSelect.value = '';
                }
            }

            updatePriceDisplay();
            updateWhatsappOrderLink();

            // "İptal / Ana Ürüne Dön" butonunu göster
            document.querySelectorAll('.clear-variant-selection-btn').forEach(function(btn) {
                btn.classList.remove('hidden');
                btn.classList.add('inline-flex');
            });

            var targetImg = (imageUrl && imageUrl.trim() !== '') ? imageUrl : (MAIN_PRODUCT_IMAGE || DEFAULT_PRODUCT_IMAGE);
            if (targetImg) {
                changeProductImage(targetImg, null, label);
            }
            
            var variantSummary = document.getElementById('variantSummaryText');
            if (variantSummary) {
                variantSummary.innerHTML = '<i class="fas fa-layer-group mr-1.5"></i> ' + label;
                variantSummary.classList.remove('hidden');
            }
            
            var lowStockWarning = document.getElementById('lowStockWarning');
            var lowStockText = document.getElementById('lowStockText');
            if (lowStockWarning) {
                if (!PRODUCT_STOKTA_YOK_SATIS_IZNI && stock >= 1 && stock <= 4) {
                    if (lowStockText) {
                        lowStockText.textContent = TXT_LOW_STOCK.replace('{0}', stock);
                    }
                    lowStockWarning.classList.remove('hidden');
                } else {
                    lowStockWarning.classList.add('hidden');
                }
            }

            var stockStatusText = document.getElementById('stockStatusText');
            if (stockStatusText) {
                if (stock > 0) {
                    stockStatusText.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> ' + TXT_MADE_TO_ORDER;
                } else if (isPreorder) {
                    stockStatusText.innerHTML = '<i class="fas fa-clock text-blue-600"></i> ' + TXT_PREORDER;
                } else {
                    stockStatusText.innerHTML = '<i class="fas fa-times-circle text-red-600"></i> ' + TXT_OUT_OF_STOCK;
                }
            }

            var productionTimeText = document.getElementById('productionTimeText');
            if (productionTimeText && productionDays > 0) {
                productionTimeText.innerHTML = '<i class="fas fa-hammer text-brand-olive"></i> ' + TXT_PRODUCTION_IN_DAYS.replace('{0}', productionDays);
            }

            var productionCardText = document.getElementById('productionCardText');
            if (productionCardText && productionDays > 0) {
                productionCardText.innerText = TXT_BUSINESS_DAYS.replace('{0}', productionDays);
            }
            
            var quantityInput = document.getElementById('productQuantity');
            if (quantityInput) {
                quantityInput.max = stock > 0 ? stock : (isPreorder ? 99 : 1);
                var minQuantity = parseInt(quantityInput.getAttribute('min')) || 1;
                quantityInput.value = minQuantity;
                var selectedQuantity = document.getElementById('selectedQuantity');
                if (selectedQuantity) selectedQuantity.value = minQuantity;
            }

            var isPurchasable = this.getAttribute('data-purchasable') !== 'false';
            var ajaxBtn = document.getElementById('ajaxSepetBtn');
            if (ajaxBtn) {
                if (!isPurchasable) {
                    ajaxBtn.disabled = true;
                    ajaxBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    var btnText = ajaxBtn.querySelector('.add-to-cart-text');
                    if (btnText) btnText.textContent = TXT_OUT_OF_STOCK;
                } else {
                    ajaxBtn.disabled = false;
                    ajaxBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    var btnText = ajaxBtn.querySelector('.add-to-cart-text');
                    if (btnText) btnText.textContent = TXT_ADD_TO_CART;
                }
            }
        }
    });
});

// Varyant kartlarına tıklama / dokunma
document.querySelectorAll('.variant-option-card').forEach(function(card) {
    var radio = card.querySelector('.variant-radio');
    if (!radio) return;

    card.addEventListener('click', function(e) {
        if (radio.disabled || radio.getAttribute('data-purchasable') === 'false') {
            e.preventDefault();
            return;
        }
        if (!radio.checked) {
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
    });
});

function increaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let max = parseInt(input.getAttribute('max')) || 99;
    let val = parseInt(input.value) || 1;
    if (val < max) {
        input.value = val + 1;
        if (selectedInput) selectedInput.value = val + 1;
        updateSelectionSummary();
    }
}

function decreaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let min = parseInt(input.getAttribute('min')) || 1;
    let val = parseInt(input.value) || 1;
    if (val > min) {
        input.value = val - 1;
        if (selectedInput) selectedInput.value = val - 1;
        updateSelectionSummary();
    }
}

const ajaxSepetBtn = document.getElementById('ajaxSepetBtn');
if (ajaxSepetBtn) {
    ajaxSepetBtn.addEventListener('click', async function (e) {
        e.preventDefault();
        const form = document.getElementById('addToCartForm');
        const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        
        const url = '/cart/Ekle';
        const urunId = form.querySelector('input[name="UrunId"]')?.value;
        const adet = form.querySelector('input[name="Adet"]')?.value;
        const secenekId = document.getElementById('selectedVariantId')?.value;
        
        const params = new URLSearchParams();
        params.append('UrunId', urunId);
        params.append('Adet', adet || '1');
        if (secenekId) params.append('SecenekId', secenekId);
        
        var giftSelect = document.getElementById('giftPackageSelect');
        if (giftSelect && giftSelect.value) {
            params.append('HediyePaketSecenegiId', giftSelect.value);
            var giftNote = document.getElementById('giftNoteText')?.value;
            if (giftNote) params.append('MusteriNotu', giftNote);
        }
        
        const originalHtml = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> ' + PRODUCT_ADDED_TEXT;
        this.disabled = true;

        fetch(url + '?' + params.toString(), {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const btn = this;
                const icon = btn.querySelector('.add-to-cart-icon');
                const text = btn.querySelector('.add-to-cart-text');
                
                if (icon) {
                    icon.classList.remove('fa-shopping-bag');
                    icon.classList.add('fa-check');
                }
                if (text) {
                    text.textContent = PRODUCT_ADDED_TEXT;
                }
                btn.classList.add('bg-green-600');

                // Update cart counter with bounce and remove hidden class
                const cartCounter = document.getElementById('cartItemCount');
                const cartCounterMobile = document.getElementById('cartItemCountMobile');
                const floatingCartBadge = document.getElementById('floatingCartBadge');
                const cartCounters = [cartCounter, cartCounterMobile, floatingCartBadge].filter(el => el);
                
                cartCounters.forEach(counter => {
                    let current = parseInt(counter.innerText) || 0;
                    let added = parseInt(adet) || 1;
                    counter.innerText = current + added;
                    counter.classList.remove('hidden');
                    counter.classList.add('scale-150', 'bounce-animation');
                    setTimeout(() => {
                        counter.classList.remove('scale-150', 'bounce-animation');
                        counter.classList.add('scale-125');
                        setTimeout(() => counter.classList.remove('scale-125'), 150);
                    }, 300);
                });

                if (window.showToast) {
                    window.showToast(PRODUCT_ADDED_TO_CART_TEXT, 'success');
                }
                
                // 1 saniye sonra butonu sıfırla (tekrar tıklanabilir olsun)
                setTimeout(() => {
                    if (icon) {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-shopping-bag');
                    }
                    if (text) text.textContent = TXT_ADD_TO_CART;
                    btn.classList.remove('bg-green-600');
                    btn.disabled = false;
                }, 1000);
                
            } else {
                if (window.showToast) {
                    window.showToast(data.message || TXT_ERROR_OCCURRED, 'error');
                } else {
                    alert(data.message || TXT_ERROR_OCCURRED);
                }
                this.innerHTML = originalHtml;
                this.disabled = false;
            }
        })
        .catch(error => {
            console.error(error);
            if (window.showToast) {
                window.showToast(TXT_CONNECTION_ERROR, 'error');
            } else {
                alert(TXT_CONNECTION_ERROR_SHORT);
            }
            this.innerHTML = originalHtml;
            this.disabled = false;
        });
    });
}

function navigateGallery(direction, event) {
    if (event) event.stopPropagation();
    
    const thumbnails = Array.from(document.querySelectorAll('.thumbnail-item'));
    if (thumbnails.length <= 1) return;
    
    const mainImage = document.getElementById('mainProductImage');
    const currentSrc = mainImage?.getAttribute('src') || '';
    
    let currentIndex = thumbnails.findIndex(item => {
        const dataImage = item.getAttribute('data-image') || '';
        return dataImage === currentSrc || currentSrc.endsWith(dataImage);
    });
    if (currentIndex === -1) currentIndex = 0;
    
    let nextIndex;
    if (direction === 'next') {
        nextIndex = (currentIndex + 1) % thumbnails.length;
    } else {
        nextIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    }
    
    const nextThumb = thumbnails[nextIndex];
    if (nextThumb) {
        nextThumb.click();
    }
}

function copyProductLink(button) {
    const url = button?.getAttribute('data-url') || window.location.href;
    const originalHtml = button.innerHTML;

    const markCopied = () => {
        button.innerHTML = '<i class="fas fa-check text-xs"></i> ' + TXT_COPIED;
        setTimeout(() => {
            button.innerHTML = originalHtml;
        }, 1800);
    };

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(markCopied).catch(() => {
            window.prompt(TXT_PRODUCT_LINK, url);
        });
        return;
    }

    window.prompt(TXT_PRODUCT_LINK, url);
}

// Masaüstü fare koordinatlarına göre pürüzsüz zoom (transform-origin)
document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById('mainProductImageContainer');
    const img = document.getElementById('mainProductImage');
    
    if (container && img) {
        container.addEventListener('mousemove', function (e) {
            const rect = container.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            img.style.transformOrigin = x + '% ' + y + '%';
        });
        container.addEventListener('mouseleave', function () {
            img.style.transformOrigin = 'center center';
        });
    }
});

// Wholesale tier dropdown: auto-set quantity and update price
const wholesaleSelect = document.getElementById('wholesaleTierSelect');
if (wholesaleSelect) {
    wholesaleSelect.addEventListener('change', function () {
        const selectedOption = this.options[this.selectedIndex];
        if (!selectedOption || !this.value) {
            // Standart fiyata ve seçili varyanta geri dön
            updateProductPricing();
            return;
        }
        const minQty = parseInt(selectedOption.getAttribute('data-min')) || 1;
        const tierPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
        const tierVariantId = parseInt(selectedOption.getAttribute('data-variant-id')) || 0;

        // 1. Eğer kademe belirli bir varyanta aitse o varyantı seç
        if (tierVariantId > 0) {
            const matchingRadio = document.querySelector(`.variant-radio[value="${tierVariantId}"]`);
            if (matchingRadio && !matchingRadio.checked) {
                matchingRadio.checked = true;
                matchingRadio.dispatchEvent(new Event('change'));
            }
        }

        // 2. Adet kutusunu kademenin minimum adedine ayarla
        const qtyInput = document.getElementById('productQuantity');
        const hiddenQty = document.getElementById('selectedQuantity');
        if (qtyInput && minQty > 1) {
            const currentMax = parseInt(qtyInput.getAttribute('max')) || 99;
            if (minQty > currentMax) {
                qtyInput.setAttribute('max', minQty + 1000);
            }
            qtyInput.value = minQty;
            if (hiddenQty) hiddenQty.value = minQty;
        }

        // 3. Fiyat göstergesini toptan birim fiyatıyla güncelle
        const priceDisplay = document.getElementById('priceDisplay');
        if (priceDisplay && tierPrice > 0) {
            priceDisplay.textContent = window.formatMoney(tierPrice);
        }

        // 4. Özet hesaplamasını tetikle
        updateSelectionSummary();
    });
}

// Sayfa ilk yüklendiğinde ve BFCache (Geri/İleri) durumunda senkronize et
function initProductDetailState() {
    updatePriceDisplay();
    updateVariantCardStyles();
    var hasSelectedVariant = document.querySelector('.variant-radio:checked');
    document.querySelectorAll('.clear-variant-selection-btn').forEach(function(btn) {
        if (hasSelectedVariant) {
            btn.classList.remove('hidden');
            btn.classList.add('inline-flex');
        } else {
            btn.classList.add('hidden');
            btn.classList.remove('inline-flex');
        }
    });
}
initProductDetailState();
window.addEventListener('pageshow', function (event) {
    initProductDetailState();
});
