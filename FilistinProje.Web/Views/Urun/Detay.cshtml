function updateDiscountDisplays(oldPrice, effectivePrice) {
    var oldPriceDisplay = document.getElementById('oldPriceDisplay');
    var discountBadge = document.getElementById('discountBadge');
    var discount = null;
    if (window.caDiscountCalculator && typeof window.caDiscountCalculator.calculatePercentage === 'function') {
        discount = window.caDiscountCalculator.calculatePercentage(oldPrice, effectivePrice);
    } else if (oldPrice > effectivePrice && oldPrice > 0 && effectivePrice >= 0) {
        discount = Math.round(((oldPrice - effectivePrice) / oldPrice) * 100);
    }
    var hasDiscount = discount !== null;

    if (oldPriceDisplay) {
        oldPriceDisplay.classList.toggle('hidden', !hasDiscount);
        if (hasDiscount) {
            oldPriceDisplay.innerHTML = window.formatMoney(oldPrice);
        }
    }

    if (discountBadge) {
        discountBadge.classList.toggle('hidden', !hasDiscount);
        if (hasDiscount) {
            discountBadge.innerHTML = '<i class="fas fa-bolt text-yellow-300 text-[11px]"></i> <span>%' + discount + ' ' + TXT_DISCOUNT + '</span>';
        }
    }

    var badgeHost = document.getElementById('productBadgeHost');
    if (!badgeHost) return;

    var badgeGroup = badgeHost.querySelector('[data-product-badges]');
    var imageDiscountBadge = badgeHost.querySelector('.product-badge--discount');
    if (!hasDiscount) {
        if (imageDiscountBadge) imageDiscountBadge.remove();
        return;
    }

    if (!badgeGroup) {
        badgeGroup = document.createElement('div');
        badgeGroup.className = 'product-badge-group';
        badgeGroup.setAttribute('data-product-badges', '');
        badgeHost.appendChild(badgeGroup);
    }

    if (!imageDiscountBadge) {
        imageDiscountBadge = document.createElement('span');
        imageDiscountBadge.className = 'product-badge product-badge--discount';
        imageDiscountBadge.setAttribute('data-badge-key', 'Badge_Discount');
        badgeGroup.appendChild(imageDiscountBadge);
    }
    imageDiscountBadge.textContent = '-' + discount + '%';
}

function syncCountdownTimer(endDate, originalPrice) {
    var countdownEl = document.getElementById('productDetailCountdown');
    if (!countdownEl) return;

    var isFutureDate = false;
    if (endDate && typeof endDate === 'string' && endDate.trim() !== '') {
        var dateStr = endDate.trim();
        var parseTarget = (dateStr.endsWith('Z') || dateStr.includes('+')) ? dateStr : dateStr + 'Z';
        var d = new Date(parseTarget);
        if (isNaN(d.getTime())) {
            d = new Date(dateStr);
        }
        if (!isNaN(d.getTime()) && d.getTime() > Date.now()) {
            isFutureDate = true;
        }
    }

    if (isFutureDate) {
        if (countdownEl._cdInterval) {
            clearInterval(countdownEl._cdInterval);
            countdownEl._cdInterval = null;
        }
        countdownEl.setAttribute('data-end', endDate);
        countdownEl.setAttribute('data-original-price', (originalPrice > 0 ? originalPrice : PRODUCT_BASE_PRICE));
        countdownEl.classList.remove('hidden');
        countdownEl.classList.add('inline-flex');

        var counterEl = countdownEl.querySelector('.cd-counter');
        if (counterEl) counterEl.style.display = 'flex';
        var endedEl = countdownEl.querySelector('.cd-ended');
        if (endedEl) {
            endedEl.classList.add('hidden');
            endedEl.style.display = 'none';
        }

        if (window.CountdownTimer && typeof window.CountdownTimer.init === 'function') {
            window.CountdownTimer.init(countdownEl);
        }
    } else {
        if (countdownEl._cdInterval) {
            clearInterval(countdownEl._cdInterval);
            countdownEl._cdInterval = null;
        }
        countdownEl.removeAttribute('data-end');
        countdownEl.classList.add('hidden');
        countdownEl.classList.remove('inline-flex');
    }
}

function updatePriceDisplay() {
    var selectedVariant = document.querySelector('.variant-radio:checked');
    var wholesaleSelect = document.getElementById('wholesaleTierSelect');
    var selectedTierOption = wholesaleSelect && wholesaleSelect.value ? wholesaleSelect.options[wholesaleSelect.selectedIndex] : null;
    var tierPrice = selectedTierOption ? parseFloat(selectedTierOption.getAttribute('data-price')) || 0 : 0;

    var newPrice = tierPrice > 0 ? tierPrice : (selectedVariant ? (parseFloat(selectedVariant.getAttribute('data-price')) || PRODUCT_MAIN_PRICE) : PRODUCT_BASE_PRICE);
    var newOldPrice = selectedVariant ? (parseFloat(selectedVariant.getAttribute('data-oldprice')) || 0) : PRODUCT_MAIN_OLD_PRICE;

    var priceDisplay = document.getElementById('priceDisplay');
    if (priceDisplay) {
        priceDisplay.innerHTML = window.formatMoney(newPrice);
    }
    updateDiscountDisplays(newOldPrice, newPrice);

    // Geri sayım sayacı senkronizasyonu
    var endDate = selectedVariant ? (selectedVariant.getAttribute('data-enddate') || '') : (MAIN_PRODUCT_CAMPAIGN_END_DATE || MAIN_CAMPAIGN_END_DATE);
    syncCountdownTimer(endDate, (newOldPrice > 0 ? newOldPrice : newPrice));

    updateSelectionSummary();
}

