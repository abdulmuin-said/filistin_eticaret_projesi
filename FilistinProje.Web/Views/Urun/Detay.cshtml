</div>

<div class="container mx-auto px-4 py-10 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
        <div class="space-y-4">
            @* ��� ANA MEDYA ALANI ���
                Galeri + Video kar���k medya listesi. width/height CLS i�in explicit.
                Keyboard ve touch swipe _Layout/globalmedia.js i�inde delegated. *@
            <div id="mainProductImageContainer"
                 class="product-media group relative aspect-square overflow-hidden rounded-lg bg-brand-cream"
                 role="region"
                 aria-roledescription="image"
                 aria-label="@Localizer["ProductImage"]"
                 tabindex="0">
                @{
                    var anaMedya = !string.IsNullOrWhiteSpace(varsayilanGaleriGorseli)
                        ? Url.Content(varsayilanGaleriGorseli)
                        : Url.Content("/img/products/placeholder.webp");
                }
                @if (!string.IsNullOrWhiteSpace(varsayilanGaleriGorseli))
                {
                    <img id="mainProductImage"
                         src="@anaMedya"
                         alt="@varsayilanGaleriAltMetni"
                         data-product-name="@Model.LocalizedBaslik"
                         width="800" height="800"
                          class="main-product-image h-full w-full cursor-zoom-in object-contain p-4 transition-transform duration-700 ease-out group-hover:scale-[1.65]"
                         onclick="openProductLightbox()"
                         loading="eager"
                         decoding="async"
                         onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.src='/img/products/placeholder.webp';}" />
                }
                else
                {
                    <div class="flex h-full w-full flex-col items-center justify-center gap-3 text-brand-border" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="120" height="120" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" class="opacity-40">
                            <rect x="40" y="60" width="120" height="90" rx="10" />
                            <path d="M40 90 L160 90" />
                            <path d="M85 60 L85 40 L145 40 L145 60" />
                            <circle cx="135" cy="120" r="6" />
                        </svg>
                        <p class="text-xs text-brand-mutedtext">@Model.LocalizedBaslik</p>
                    </div>
                }

                @if (badges.Any())
                {
                    <div class="pointer-events-none absolute start-2 top-2 z-10 flex flex-col gap-1.5">
                        @foreach (var badge in badges)
                        {
                            var badgeText = !string.IsNullOrEmpty(badge.Metin)
                                ? badge.Metin
                                : Localizer[badge.LocalizasyonKey].Value;
                            <span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider shadow-sm @badge.CssClass">
                                @badgeText
                            </span>
                        }
                    </div>
                }

                @* Galeri ok tu�lar� � RTL/LTR uyumlu (mant�ksal prev/next; start/end always visual)
                   Mant�ksal olarak prev/next tipleri i�in ui ikonu locale g�re ters �evrilir. *@
                @if (galeriMedyalari.Count > 1)
                {
                    var prevIcon = isRtlDetay ? "fa-chevron-right" : "fa-chevron-left";
                    var nextIcon = isRtlDetay ? "fa-chevron-left" : "fa-chevron-right";
                    <button type="button" onclick="navigateGallery('prev', event)" aria-label="@Localizer["PreviousImage"]"
                            class="gallery-nav-btn gallery-nav-prev absolute top-1/2 start-4 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/85 text-brand-olive opacity-0 shadow-sm backdrop-blur transition-opacity hover:bg-white group-hover:opacity-100 focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-brand-gold">
                        <i class="fas @prevIcon text-sm text-brand-darktext"></i>
                    </button>
                    <button type="button" onclick="navigateGallery('next', event)" aria-label="@Localizer["NextImage"]"
                            class="gallery-nav-btn gallery-nav-next absolute top-1/2 end-4 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/85 text-brand-olive opacity-0 shadow-sm backdrop-blur transition-opacity hover:bg-white group-hover:opacity-100 focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-brand-gold">
                        <i class="fas @nextIcon text-sm text-brand-darktext"></i>
                    </button>
                }
            </div>

            @* ��� THUMBNAIL STRIP � klavye/swipe friendly tab list ��� *@
            @if (galeriMedyalari.Count > 1)
            {
                <div class="product-thumbs flex gap-3 overflow-x-auto pb-2 px-1"
                     role="tablist"
                     aria-label="@Localizer["ProductImage"]"
                     data-thumb-strip>
                    @foreach (var medya in galeriMedyalari.Where(x => !string.IsNullOrWhiteSpace(x.ResimYolu)))
                    {
                        var thumbAlt = !string.IsNullOrWhiteSpace(medya.AltMetin) ? medya.AltMetin : Model.LocalizedBaslik;
                        var isActive = medya == varsayilanMedya;
                        <button type="button"
                                class="thumbnail-item h-20 w-20 shrink-0 overflow-hidden rounded-xl border @(isActive ? "border-brand-olive ring-2 ring-brand-olive/40" : "border-transparent") bg-white p-1 transition-colors hover:border-brand-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold"
                                data-image="@Url.Content(medya.ResimYolu)"
                                data-thumb-alt="@thumbAlt"
                                role="tab"
                                aria-selected="@(isActive ? "true" : "false")"
                                tabindex="@(isActive ? "0" : "-1")"
                                onclick="changeProductImage('@Url.Content(medya.ResimYolu)', this, '@thumbAlt')">
                            <img src="@Url.Content(medya.ResimYolu)" alt="@thumbAlt" width="80" height="80" class="h-full w-full object-cover pointer-events-none" loading="lazy" decoding="async" />
                        </button>
                    }
                </div>
            }

            @* ��� VIDEO BLOKLARI �autoplay kapal�, poster = image, playsinline ��� *@
            @if (videoMedyalari.Any())
            {
                <div class="grid grid-cols-1 gap-3">
                    @foreach (var vid in videoMedyalari)
                    {
                        var kaynak = !string.IsNullOrWhiteSpace(vid.VideoUrl) ? vid.VideoUrl : vid.ResimYolu;
                        if (string.IsNullOrWhiteSpace(kaynak)) { continue; }
                        var guvenliVideoKaynak = kaynak.StartsWith("/media/products/videos/", StringComparison.OrdinalIgnoreCase)
                            || kaynak.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                            || kaynak.StartsWith("http://", StringComparison.OrdinalIgnoreCase);
                        if (!guvenliVideoKaynak) { continue; }
                        var poster = !string.IsNullOrWhiteSpace(vid.EtkinPosterYolu) ? vid.EtkinPosterYolu : anaMedya;
                        var videoAlt = !string.IsNullOrWhiteSpace(vid.AltMetin) ? vid.AltMetin : Model.LocalizedBaslik;
                        <figure class="rounded-2xl overflow-hidden border border-brand-border bg-black/5">
                            <video controls preload="metadata" playsinline crossorigin="anonymous"
                                   poster="@poster"
                                   aria-label="@videoAlt"
                                   class="w-full h-auto object-cover max-h-[420px]">
                                <source src="@kaynak" type="video/mp4" />
                                @Localizer["VideoNotSupported"]
                            </video>
                            @if (!string.IsNullOrWhiteSpace(vid.Baslik))
                            {
                                <figcaption class="px-3 py-2 text-xs text-brand-mutedtext bg-white/80 border-t border-brand-border">@vid.Baslik</figcaption>
                            }
                        </figure>
                    }
                </div>
            }
        </div>

        <div class="flex flex-col">
            <div class="border-b border-brand-border pb-6">
                @if (!string.IsNullOrWhiteSpace(Model.Kategori?.LocalizedAd))
                {
                    <a href="/products?k=@Model.KategoriId" class="mb-3 inline-flex text-xs font-semibold uppercase tracking-[0.22em] text-brand-gold hover:text-brand-olive">@Model.Kategori.LocalizedAd</a>
                }
                <h1 class="font-serif text-3xl leading-tight text-brand-olive md:text-4xl lg:text-5xl">@Model.LocalizedBaslik</h1>
                <div class="mt-4 flex items-center gap-3">
                    <div class="flex text-sm text-brand-gold" aria-label="@ortalamaPuan.ToString("0.0")">
                        @for (var yildiz = 1; yildiz <= 5; yildiz++)
                        {
                            if (yildiz <= tamYildiz) { <i class="fas fa-star"></i> }
                            else if (yildiz == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                            else { <i class="far fa-star"></i> }
                        }
                    </div>
                    <a href="#reviews" class="text-xs text-brand-mutedtext underline-offset-4 hover:text-brand-olive hover:underline">@string.Format(Localizer["ReviewCount"].Value, yorumSayisi)</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.LocalizedKisaAciklama))
                {
                    <p class="mt-4 text-sm leading-7 text-brand-mutedtext">@Model.LocalizedKisaAciklama</p>
                }
            </div>

            @if (!Model.FiyatGizliMi)
            {
                <div class="flex flex-wrap items-end gap-3 border-b border-brand-border py-6">
                    <span id="priceDisplay" class="text-3xl font-medium tracking-tight text-brand-darktext">@gosterilecekFiyat.ToString("N2") @currencySymbol</span>
                    @if (gosterilecekEskiFiyat.HasValue)
                    {
                        <span id="oldPriceDisplay" class="pb-1 text-lg text-brand-mutedtext line-through">@gosterilecekEskiFiyat.Value.ToString("N2") @currencySymbol</span>
                    }
                    else { <span id="oldPriceDisplay" class="hidden"></span> }
                    @if (gosterilecekIndirimYuzdesi.HasValue)
                    {
                        <span id="discountBadge" class="mb-1 rounded bg-brand-gold px-2 py-1 text-xs font-semibold text-white">%@gosterilecekIndirimYuzdesi @Localizer["Discount"]</span>
                    }
                    else { <span id="discountBadge" class="hidden"></span> }
                </div>
            }

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-brand-border py-4 text-xs text-brand-mutedtext">
                <span id="stockStatusText" class="flex items-center gap-2"><i class="@stokIkonClass"></i>@stokDurumuMetni</span>
                <span class="flex items-center gap-2"><i class="fas fa-truck text-brand-gold"></i>@gosterilecekKargoSuresi @Localizer["Days"]</span>
                @if (gosterilecekUretimSuresi > 0) { <span id="productionTimeText" class="flex items-center gap-2"><i class="fas fa-hammer text-brand-gold"></i>@string.Format(Localizer["ProductionInDaysJS"].Value, gosterilecekUretimSuresi)</span> }
            </div>

            @{
                var varsayilanStok = varsayilanSecenek?.StokAdedi ?? toplamStok;
                var varsayilanAzStok = !stoktaYokSatisIzni && varsayilanStok >= 1 && varsayilanStok <= 4;
            }
            <div id="lowStockWarning"
                 class="@(varsayilanAzStok ? "" : "hidden") rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700"
                 role="status"
                 aria-live="polite">
                <i class="fas fa-hourglass-half me-2"></i>
                <span id="lowStockText">@string.Format(Localizer["LowStockText"].Value, varsayilanStok)</span>
            </div>

            @if (Model.WhatsappSiparisVarMi || Model.FiyatGizliMi)
            {
                var whatsappNumber = new string((siteSettings.WhatsappNumarasi ?? string.Empty).Where(char.IsDigit).ToArray());
                var whatsappText = Uri.EscapeDataString($"{Model.LocalizedBaslik} - {productUrl}");
                <a href="https://wa.me/@whatsappNumber?text=@whatsappText"
                   rel="noopener noreferrer"
                   target="_blank"
                   class="inline-flex w-full items-center justify-center gap-3 rounded-full bg-[#25D366] px-6 py-4 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-lg hover:bg-[#1da851]">
                    <i class="fab fa-whatsapp text-xl"></i>
                    <span>@Localizer["WhatsApp"]</span>
                </a>
            }
            else
            {
            <form id="addToCartForm" class="space-y-6 pt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UrunId" value="@Model.Id" />
                <input type="hidden" id="selectedVariantId" value="@varsayilanSecenek?.Id" />
                <input type="hidden" id="selectedQuantity" name="Adet" value="@minSiparisAdedi" />
                <input type="hidden" id="selectedFrameModel" value="" />
                <input type="hidden" id="selectedFrameFarki" value="0" />

                @if (secenekler.Any())
                {
                    <div>
                        <div id="variantSummaryText" class="mb-3 text-xs font-medium uppercase tracking-widest text-brand-darktext @(string.IsNullOrWhiteSpace(seciliVaryantMetni) ? "hidden" : "")"><i class="fas fa-layer-group me-1.5"></i>@seciliVaryantMetni</div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var varyant in secenekler)
                            {
                                var varyantSatinAlinabilir = stoktaYokSatisIzni || varyant.SatinAlinabilirMi;
                                var varyantEtiket = string.IsNullOrWhiteSpace(varyant.VaryantBasligi) ? (varyant.Olcu ?? "Standard") : varyant.VaryantBasligi;
                                var varyantGorseli = !string.IsNullOrWhiteSpace(varyant.GorselUrl) ? varyant.GorselUrl : (varyantMedyaHaritasi.TryGetValue(varyant.Id, out var eslesen) ? eslesen : string.Empty);
                                var varyantEskiFiyat = Model.Fiyat > varyant.SatisFiyati ? Model.Fiyat : 0;
                                <label class="relative cursor-pointer rounded border border-brand-border px-4 py-2 text-sm transition-colors hover:border-brand-gold has-[:checked]:border-brand-olive has-[:checked]:bg-brand-olive has-[:checked]:text-white @(!varyantSatinAlinabilir ? "cursor-not-allowed opacity-45" : "")">
                                    <input type="radio" class="variant-radio absolute h-0 w-0 opacity-0" name="productVariant" value="@varyant.Id" checked="@(varyant.Id == varsayilanSecenek?.Id ? "checked" : null)" disabled="@(!varyantSatinAlinabilir ? "disabled" : null)" data-price="@varyant.SatisFiyati.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-oldprice="@(varyantEskiFiyat > 0 ? varyantEskiFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" data-stock="@varyant.StokAdedi" data-preorder="@varyant.OnSipariseAcikMi.ToString().ToLowerInvariant()" data-production="@varyant.UretimSuresiGun" data-image="@varyantGorseli" data-label="@varyantEtiket" data-olcu="@varyantEtiket" />
                                    @varyantEtiket
                                </label>
                            }
                        </div>
                    </div>
                }

                @if (cerceveSecimiGerekli)
                {
                    <div id="frameSelectionBlock">
                        <label class="mb-3 block text-xs font-medium uppercase tracking-widest text-brand-darktext">@Localizer["SelectFrame"]</label>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var cerceve in cerceveModelleri)
                            {
                                <label class="cursor-pointer rounded border border-brand-border px-3 py-2 text-xs transition-colors hover:border-brand-gold has-[:checked]:border-brand-gold has-[:checked]:bg-brand-cream">
                                    <input type="radio" class="frame-radio me-1 accent-brand-gold" name="CerceveModeli" value="@cerceve" />@cerceve
                                </label>
                            }
                        </div>
                        <p id="frameSelectionError" class="mt-2 hidden text-xs font-medium text-red-600">@Localizer["FrameSelectionRequired"]</p>
                    </div>
                }

                @if (Model.HediyePaketiVarMi)
                {
                    <div class="rounded-2xl border border-brand-border bg-brand-cream p-4">
                        <label class="flex cursor-pointer items-start gap-3">
                            <input id="giftWrapCheckbox" type="checkbox" class="mt-1 h-4 w-4 accent-brand-gold" onchange="document.getElementById('giftNoteText')?.classList.toggle('hidden', !this.checked); updateSelectionSummary();" />
                            <span class="flex-1">
                                <span class="block text-sm font-semibold text-brand-olive">@Localizer["GiftWrap"] (+@Model.HediyePaketFiyati.ToString("N2") @currencySymbol)</span>
                                <span class="mt-1 block text-xs text-brand-mutedtext">@Localizer["GiftWrapDesc"]</span>
                            </span>
                        </label>
                        <input id="hediyePaketFiyatiHidden" type="hidden" value="@Model.HediyePaketFiyati.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        <textarea id="giftNoteText" maxlength="500" rows="2" class="mt-3 hidden w-full rounded-xl border border-brand-border bg-white p-3 text-sm" placeholder="@Localizer["GiftWrapDesc"]"></textarea>
                    </div>
                }

                <div class="product-purchase-actions flex items-end gap-3">
                    <div><label class="mb-2 block text-xs font-medium uppercase tracking-widest text-brand-darktext">@Localizer["Quantity"]</label><div class="flex h-12 items-center border border-brand-border bg-white"><button type="button" class="flex h-full w-10 items-center justify-center hover:bg-brand-cream" onclick="decreaseQuantity()">-</button><input id="productQuantity" type="number" min="@minSiparisAdedi" max="@maxSiparisAdedi" value="@minSiparisAdedi" class="h-full w-12 border-0 bg-transparent p-0 text-center text-sm font-semibold focus:ring-0" readonly /><button type="button" class="flex h-full w-10 items-center justify-center hover:bg-brand-cream" onclick="increaseQuantity()">+</button></div></div>
                    <button id="ajaxSepetBtn" type="button" class="flex h-12 min-w-0 flex-1 items-center justify-center gap-2 bg-brand-olive px-4 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-[#1c2001] disabled:cursor-wait disabled:opacity-70"><i class="fas fa-shopping-bag add-to-cart-icon"></i><span class="add-to-cart-text">@Localizer["AddToCart"]</span></button>
                    <a href="/cart" class="flex h-12 w-12 items-center justify-center bg-brand-gold text-white transition-colors hover:bg-[#8e6a28]" aria-label="@Localizer["Cart"]"><i class="fas fa-shopping-cart"></i></a>
                </div>
            </form>
            }
            <div class="mt-7 grid grid-cols-3 border-y border-brand-border py-5 text-center">
                <div><i class="fas fa-shield-alt mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["SecurePayment"]</p></div>
                <div><i class="fas fa-truck mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["FreeShipping"]</p></div>
                <div><i class="fas fa-undo-alt mb-2 text-brand-gold"></i><p class="text-xs font-semibold text-brand-darktext">@Localizer["ReturnGuarantee"]</p></div>
            </div>
            <div class="mt-4 flex items-center justify-center gap-2 text-xs text-brand-mutedtext"><i class="fas fa-circle-check text-brand-gold"></i>@Localizer["Product_TrustNote"]</div>
        </div>
    </div>

    <section id="reviews" class="product-detail-sections mt-20 border-t border-brand-border pt-12">
        <div class="flex flex-col gap-12 lg:flex-row">
            <div class="space-y-12 lg:w-2/3">
                @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi) || !string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi) || !string.IsNullOrWhiteSpace(Model.BakimTalimati))
                {
                    <div class="grid gap-3 sm:grid-cols-3">
                        @if (!string.IsNullOrWhiteSpace(Model.MalzemeBilgisi)) { <article class="product-benefit-card"><i class="fas fa-gem"></i><h3>@Localizer["Product_Material"]</h3><p>@Model.MalzemeBilgisi</p></article> }
                        @if (!string.IsNullOrWhiteSpace(Model.PaketlemeBilgisi)) { <article class="product-benefit-card"><i class="fas fa-box-open"></i><h3>@Localizer["Packaging"]</h3><p>@Model.PaketlemeBilgisi</p></article> }
                        @if (!string.IsNullOrWhiteSpace(Model.BakimTalimati)) { <article class="product-benefit-card"><i class="fas fa-hand-sparkles"></i><h3>@Localizer["Product_Care"]</h3><p>@Model.BakimTalimati</p></article> }
                    </div>
                }
                <div>
                    <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-file-alt text-brand-gold"></i>@Localizer["ProductDescription"]</h2>
                    <div class="prose prose-sm max-w-none leading-relaxed text-brand-mutedtext">
                        @if (!string.IsNullOrWhiteSpace(Model.LocalizedAciklama))
                        {
                            @Html.SanitizeHtml(Model.LocalizedAciklama)
                        }
                        else
                        {
                            <p>@Model.LocalizedKisaAciklama</p>
                        }
                    </div>
                </div>

                @if (teknikTabloSatirlari.Any())
                {
                    <div>
                        <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-cogs text-brand-gold"></i>@Localizer["ProductDetails"]</h2>
                        <div class="overflow-hidden rounded-lg border border-brand-border bg-white">
                            <table class="w-full text-sm">
                                <tbody class="divide-y divide-brand-border">
                                    @foreach (var satir in teknikTabloSatirlari)
                                    {
                                        <tr class="transition-colors hover:bg-[#fcf9f3]">
                                            <th scope="row" class="w-1/3 bg-brand-cream px-5 py-4 text-start font-semibold text-brand-darktext">@satir.Baslik</th>
                                            <td class="px-5 py-4 text-brand-mutedtext">@satir.Deger</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <aside class="lg:w-1/3">
                <h2 class="mb-6 flex items-center gap-3 font-serif text-2xl text-brand-olive"><i class="fas fa-comments text-brand-gold"></i>@Localizer["Reviews"]</h2>
                @if (yorumlar.Any())
                {
                    <div class="mb-7 rounded-lg border border-brand-border bg-white p-6 text-center">
                        <p class="font-serif text-5xl text-brand-olive">@ortalamaPuan.ToString("0.0")</p>
                        <div class="my-3 text-brand-gold">
                            @for (var yildiz = 1; yildiz <= 5; yildiz++)
                            {
                                if (yildiz <= tamYildiz) { <i class="fas fa-star"></i> }
                                else if (yildiz == tamYildiz + 1 && yarimYildiz) { <i class="fas fa-star-half-alt"></i> }
                                else { <i class="far fa-star"></i> }
                            }
                        </div>
                        <p class="mb-5 text-sm text-brand-mutedtext">@string.Format(Localizer["ReviewCount"].Value, yorumSayisi)</p>
                        <button type="button" id="openCommentModalBtn" class="w-full rounded border border-brand-olive py-2.5 text-xs font-semibold uppercase tracking-widest text-brand-olive transition-colors hover:bg-brand-olive hover:text-white">@Localizer["WriteReview"]</button>
                    </div>
                    <div id="reviewsList" class="space-y-4">
                        @foreach (var yorum in yorumlar.Take(3))
                        {
                            var adParcalari = (yorum.AdSoyad ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var basHarfler = adParcalari.Length == 0 ? "?" : string.Concat(adParcalari.Take(1).Select(x => x[0]), adParcalari.Skip(1).TakeLast(1).Select(x => x[0]));
                            <article class="rounded-lg border border-brand-border bg-white p-4">
                                <div class="mb-3 flex items-start justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-cream text-sm font-semibold text-brand-olive">@basHarfler</span>
                                        <div><strong class="block text-sm text-brand-darktext">@yorum.AdSoyad</strong><span class="text-[10px] text-brand-gold">@string.Concat(Enumerable.Repeat("?", yorum.Puan))</span></div>
                                    </div>
                                    <time class="text-[10px] text-brand-mutedtext">@yorum.OlusturulmaTarihi.ToString("dd MMM yyyy")</time>
                                </div>
                                <p class="text-sm leading-6 text-brand-mutedtext">@yorum.YorumMetni</p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-lg border border-brand-border bg-white px-6 py-12 text-center"><i class="far fa-comments mb-4 text-4xl text-brand-border"></i><p class="mb-5 text-sm text-brand-mutedtext">@Localizer["NoReviewsYet"]</p><button type="button" id="openCommentModalBtnEmpty" class="rounded bg-brand-olive px-6 py-2.5 text-xs font-semibold uppercase tracking-widest text-white transition-colors hover:bg-[#1c2001]">@Localizer["WriteReview"]</button></div>
                }
            </aside>
        </div>
    </section>

    @{ var urunlerleBirlikte = ViewBag.BenzerUrunler as List<FilistinProje.Core.DTOs.BenzerUrunDto> ?? new List<FilistinProje.Core.DTOs.BenzerUrunDto>(); }
    @if (urunlerleBirlikte.Any())
    {
        <section class="product-together mt-16 rounded-lg border border-brand-border bg-brand-cream p-5 md:p-7" aria-labelledby="togetherTitle">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-gold">@Localizer["Product_WhyYouWillLove"]</p><h2 id="togetherTitle" class="mt-1 font-serif text-2xl text-brand-olive">@Localizer["Product_Together"]</h2></div><a href="/products?k=@Model.KategoriId" class="text-xs font-semibold text-brand-olive underline-offset-4 hover:underline">@Localizer["Collection"]</a></div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                @foreach (var item in urunlerleBirlikte.Take(3))
                {
                    var itemSlug = string.IsNullOrWhiteSpace(item.Slug) ? FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(item.LocalizedBaslik) : item.Slug;
                    <a href="/products/@itemSlug-@item.Id" class="group rounded-md bg-white p-2 transition-transform hover:-translate-y-1">
                        <img src="@(string.IsNullOrWhiteSpace(item.AnaGorselUrl) ? "/img/products/placeholder.webp" : item.AnaGorselUrl)" alt="@item.LocalizedBaslik" class="aspect-square w-full rounded object-cover" loading="lazy" decoding="async" />
                        <h3 class="mt-2 line-clamp-2 text-xs font-semibold text-brand-darktext">@item.LocalizedBaslik</h3>
                        <p class="mt-1 text-sm font-bold text-brand-olive">@item.GosterFiyat.ToString("N2") @currencySymbol</p>
                    </a>
                }
            </div>
        </section>
    }

@{
    var benzerUrunler = ViewBag.BenzerUrunler as List<FilistinProje.Core.DTOs.BenzerUrunDto>;
}
@if (benzerUrunler != null && benzerUrunler.Count > 0)
{
    <section class="py-16 bg-[#fafaf8]" aria-labelledby="relatedProductsTitle">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-center mb-10">
                <hr class="w-1/4 border-brand-border hidden md:block"/>
                <h2 id="relatedProductsTitle" class="font-serif text-3xl mx-8 text-center text-brand-olive">@Localizer["SimilarProducts"]</h2>
                <hr class="w-1/4 border-brand-border hidden md:block"/>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-6">
                @foreach (var item in benzerUrunler)
                {
                    decimal itemFiyat = item.GosterFiyat;
                    decimal? bEskiFiyat = (item.IndirimliFiyat != null && item.IndirimliFiyat < item.Fiyat) ? item.Fiyat : null;
                    var benzerUrlSlug = !string.IsNullOrEmpty(item.Slug) ? item.Slug : FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(item.LocalizedBaslik);
                    if (string.IsNullOrWhiteSpace(benzerUrlSlug)) { benzerUrlSlug = "urun"; }
                    string bProductUrl = $"/products/{benzerUrlSlug}-{item.Id}";
                    bool benzerResimVar = !string.IsNullOrWhiteSpace(item.AnaGorselUrl);
                    <a href="@bProductUrl" class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 rounded">
                        <div class="related-image-container relative overflow-hidden mb-3 aspect-square bg-[#f8f6f2] rounded">
                            @if (benzerResimVar)
                            {
                                <img alt="@item.LocalizedBaslik"
                                     src="@item.AnaGorselUrl"
                                     width="400" height="400"
                                     class="related-product-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                     loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center text-brand-border" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="80" height="80" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" class="opacity-30">
                                        <rect x="35" y="55" width="130" height="100" rx="8" />
                                        <path d="M35 85 L165 85" />
                                        <path d="M85 55 L85 35 L145 35 L145 55" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <h3 class="text-xs font-semibold text-brand-darktext tracking-wide line-clamp-2 mb-1">@item.LocalizedBaslik</h3>
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-bold text-brand-olive">@itemFiyat.ToString("N2") @currencySymbol</span>
                            @if (bEskiFiyat != null)
                            {
                                <span class="text-xs text-[#999] line-through">@bEskiFiyat?.ToString("N2") @currencySymbol</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<style>
    .product-benefit-card { border: 1px solid #e5e2dc; background: #fff; padding: 1rem; }
    .product-benefit-card > i { color: #b58735; margin-bottom: .65rem; }
    .product-benefit-card h3 { color: #313511; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .product-benefit-card p { color: #47473d; font-size: .75rem; line-height: 1.5; margin-top: .35rem; }
    .product-detail-sections { margin-top: 5rem; }
    @@media (max-width: 1023px) { .product-detail-sections { margin-top: 3.5rem; } }
    @@media (max-width: 767px) {
        .product-purchase-actions {
            position: sticky;
            bottom: 0;
            z-index: 40;
            margin-inline: -1rem;
            padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom, 0px));
            background: rgba(255, 250, 240, .97);
            border-top: 1px solid #d8ceb8;
            box-shadow: 0 -10px 25px rgba(49, 53, 17, .09);
            backdrop-filter: blur(10px);
        }
    }
    @@media (max-width: 767px) and (max-height: 500px) {
        .product-purchase-actions { position: static; margin-inline: 0; }
    }
</style>

<script>
const PRODUCT_CURRENCY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencySymbol));
const PRODUCT_ADDED_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Added"].Value));
const PRODUCT_ADDED_TO_CART_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddedToCartSuccess"].Value));
const PRODUCT_ADD_TO_CART_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddToCart"].Value));
const PRODUCT_STOKTA_YOK_SATIS_IZNI = @Json.Serialize(stoktaYokSatisIzni);

// Modal event listeners
document.addEventListener('DOMContentLoaded', function() {
    const desktopModal = document.getElementById('desktopLightboxModal');
    const mobileModal = document.getElementById('mobileLightbox');
    const closeBtn = document.getElementById('closeDesktopModalBtn');

    [desktopModal, mobileModal].forEach(modal => {
        if (modal && modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
    });

    if (closeBtn && desktopModal) {
        closeBtn.addEventListener('click', closeDesktopLightbox);
    }

    [desktopModal, mobileModal].forEach(modal => {
        if (modal) {
            modal.addEventListener('click', event => {
                if (event.target === modal) {
                    closeProductLightbox();
                }
            });
        }
    });

    window.addEventListener('keydown', event => {
        if (event.key === 'Escape' || event.code === 'Escape') {
            closeProductLightbox();
        }

        const activeInGallery = document.activeElement?.closest?.('#mainProductImageContainer, [data-thumb-strip], #desktopLightboxModal, #mobileLightbox');
        if (activeInGallery && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
            event.preventDefault();
            const isRtl = document.documentElement.dir === 'rtl';
            const logicalNext = event.key === 'ArrowRight' ? !isRtl : isRtl;
            navigateGallery(logicalNext ? 'next' : 'prev', event);
        }
    }, true);

    const mediaContainer = document.getElementById('mainProductImageContainer');
    let touchStartX = 0;
    if (mediaContainer) {
        mediaContainer.addEventListener('touchstart', event => {
            touchStartX = event.changedTouches?.[0]?.clientX || 0;
        }, { passive: true });
        mediaContainer.addEventListener('touchend', event => {
            const endX = event.changedTouches?.[0]?.clientX || 0;
            const delta = endX - touchStartX;
            if (Math.abs(delta) < 40) return;
            const isRtl = document.documentElement.dir === 'rtl';
            const logicalNext = delta < 0 ? !isRtl : isRtl;
            navigateGallery(logicalNext ? 'next' : 'prev', event);
        }, { passive: true });
    }

    const commentModal = document.getElementById('commentModal');
    if (commentModal) {
        const openBtns = [document.getElementById('openCommentModalBtn'), document.getElementById('openCommentModalBtnEmpty')];
        openBtns.forEach(btn => btn && btn.addEventListener('click', () => {
            commentModal.classList.remove('hidden');
            commentModal.classList.add('flex');
            commentModal.setAttribute('aria-hidden', 'false');
        }));

        const closeCommentBtn = document.getElementById('closeCommentModalBtn');
        if (closeCommentBtn) {
            closeCommentBtn.addEventListener('click', () => {
                commentModal.classList.add('hidden');
                commentModal.classList.remove('flex');
                commentModal.setAttribute('aria-hidden', 'true');
            });
        }
    }

    setTimeout(function() {
        updateSelectionSummary();
        updateVariantCardStyles();
    }, 100);
});

document.getElementById('productQuantity')?.addEventListener('input', function() {
    var val = parseInt(this.value) || 0;
    var min = parseInt(this.getAttribute('min')) || 1;
    var max = parseInt(this.getAttribute('max')) || 99;
    if (val < min) this.value = min;
    if (val > max) this.value = max;
    var selectedQuantity = document.getElementById('selectedQuantity');
    if (selectedQuantity) selectedQuantity.value = this.value;
    updateSelectionSummary();
});

let currentZoom = 1;
let currentRotation = 0;
let previousBodyOverflow = '';

function syncLightboxImage() {
    const mainImage = document.getElementById('mainProductImage');
    if (!mainImage) return;

    const imageSrc = mainImage.currentSrc || mainImage.src;
    const imageAlt = mainImage.alt || mainImage.getAttribute('data-product-name') || '';

    const desktopImage = document.getElementById('desktopLightboxImage');
    if (desktopImage && imageSrc) {
        desktopImage.src = imageSrc;
        desktopImage.alt = imageAlt;
    }

    const mobileImage = document.getElementById('mobileLightboxImage');
    if (mobileImage && imageSrc) {
        mobileImage.src = imageSrc;
        mobileImage.alt = imageAlt;
    }
}

function lockLightboxScroll() {
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
}

function unlockLightboxScroll() {
    document.body.style.overflow = previousBodyOverflow;
}

function openProductLightbox() {
    syncLightboxImage();
    lockLightboxScroll();

    if (window.innerWidth >= 1024) {
        const dm = document.getElementById('desktopLightboxModal');
        if (dm) {
            dm.classList.remove('hidden');
            dm.classList.add('flex');
            dm.setAttribute('aria-hidden', 'false');
            resetDesktopZoom();
        }
    } else {
        const mm = document.getElementById('mobileLightbox');
        if (mm) {
            mm.classList.remove('hidden');
            mm.classList.add('flex');
            mm.setAttribute('aria-hidden', 'false');
            resetMobileZoom();
        }
    }
}

function toggleAllReviews() {
    var list = document.getElementById('reviewsList');
    var btn = document.getElementById('showAllReviewsBtn');
    if (!list || !btn) return;
    if (list.style.maxHeight && list.style.maxHeight !== '600px') {
        list.style.maxHeight = '600px';
        btn.textContent = 'Tüm Yorumları Gör (' + btn.textContent.match(/\d+/)?.[0] + ')';
    } else {
        list.style.maxHeight = list.scrollHeight + 'px';
        btn.textContent = 'Gizle';
    }
}

function closeProductLightbox() {
    closeDesktopLightbox();
    closeMobileLightbox();
}

function closeDesktopLightbox() {
    const dm = document.getElementById('desktopLightboxModal');
    if (dm) {
        dm.classList.add('hidden');
        dm.classList.remove('flex');
        dm.setAttribute('aria-hidden', 'true');
        resetDesktopZoom();
    }
    unlockLightboxScroll();
}

function closeMobileLightbox() {
    const mm = document.getElementById('mobileLightbox');
    if (mm) {
        mm.classList.add('hidden');
        mm.classList.remove('flex');
        mm.setAttribute('aria-hidden', 'true');
        resetMobileZoom();
    }
    unlockLightboxScroll();
}

function resetMobileZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateMobileTransform();
}

function zoomInMobile() {
    if (currentZoom < 3) { currentZoom += 0.5; updateMobileTransform(); }
}

function zoomOutMobile() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateMobileTransform(); }
}

function rotateMobileImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateMobileTransform();
}

function updateMobileTransform() {
    const img = document.getElementById('mobileLightboxImage');
    if (img) img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    const zl = document.getElementById('zoomLevel');
    if (zl) zl.innerText = `${Math.round(currentZoom * 100)}%`;
}

function resetDesktopZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateDesktopTransform();
}

function zoomInDesktop() {
    if (currentZoom < 3) { currentZoom += 0.5; updateDesktopTransform(); }
}

function zoomOutDesktop() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateDesktopTransform(); }
}

function rotateDesktopImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateDesktopTransform();
}

function updateDesktopTransform() {
    const img = document.getElementById('desktopLightboxImage');
    if (img) {
        img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    }
}

function changeProductImage(imageUrl, thumbnailElement, altText) {
    if (!thumbnailElement && imageUrl) {
        thumbnailElement = Array.from(document.querySelectorAll('.thumbnail-item'))
            .find(item => item.getAttribute('data-image') === imageUrl) || null;
    }

    const mainImage = document.getElementById('mainProductImage');
    if (mainImage) {
        mainImage.src = imageUrl;
        if (altText) mainImage.alt = altText;
    }
    
    const deskImg = document.getElementById('desktopLightboxImage');
    if (deskImg) {
        deskImg.src = imageUrl;
        if (altText) deskImg.alt = altText;
    }
    
    const mobImg = document.getElementById('mobileLightboxImage');
    if (mobImg) {
        mobImg.src = imageUrl;
        if (altText) mobImg.alt = altText;
    }
    
    const thumbnails = document.querySelectorAll('.thumbnail-item');
    thumbnails.forEach(item => {
        if (item) {
            item.classList.remove('border-brand-olive');
            item.classList.remove('ring-2', 'ring-brand-olive/40');
            item.classList.add('border-transparent');
            item.setAttribute('aria-selected', 'false');
            item.setAttribute('tabindex', '-1');
        }
    });
    if (thumbnailElement) {
        thumbnailElement.classList.remove('border-transparent');
        thumbnailElement.classList.add('border-brand-olive');
        thumbnailElement.classList.add('ring-2', 'ring-brand-olive/40');
        thumbnailElement.setAttribute('aria-selected', 'true');
        thumbnailElement.setAttribute('tabindex', '0');
        thumbnailElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        thumbnailElement.focus({ preventScroll: true });
    }

}

const FRAME_PRICE_PER_METER = 250;

function parseOlcu(olcuText) {
    if (!olcuText) return null;
    var match = olcuText.match(/(\d+(?:[.,]\d+)?)\s*(?:cm)?\s*[xX×]\s*(\d+(?:[.,]\d+)?)/i);
    if (!match) return null;
    var w = parseFloat(match[1].replace(',', '.'));
    var h = parseFloat(match[2].replace(',', '.'));
    if (isNaN(w) || isNaN(h)) return null;
    return { width: w, height: h };
}

function calcFrameFiyat(olcuText, cerceve) {
    if (!cerceve || cerceve === 'Çerçevesiz') return 0;
    var dims = parseOlcu(olcuText);
    if (!dims) return 0;
    var cevreMetre = ((dims.width + dims.height) * 2) / 100;
    return cevreMetre * FRAME_PRICE_PER_METER;
}

function updateSelectionSummary() {
    var selectedVariant = document.querySelector('.variant-radio:checked');
    var selectedFrame = document.querySelector('.frame-radio:checked');
    var summary = document.getElementById('selectionSummary');
    if (!summary) return;

    if (!selectedVariant && !selectedFrame) {
        summary.classList.add('hidden');
        return;
    }

    var olcu = selectedVariant ? selectedVariant.getAttribute('data-olcu') || selectedVariant.getAttribute('data-label') || '-' : '-';
    var cerceve = selectedFrame ? selectedFrame.value : null;
    var temelFiyat = selectedVariant ? parseFloat(selectedVariant.getAttribute('data-price')) || 0 : 0;
    var adet = parseInt(document.getElementById('productQuantity')?.value) || 1;
    var cerceveFarki = selectedVariant ? calcFrameFiyat(olcu, cerceve || 'Çerçevesiz') : 0;
    var toplamBirim = temelFiyat + cerceveFarki;
    var toplam = toplamBirim * adet;

    var summaryOlcuEl = document.getElementById('summaryOlcu');
    if (summaryOlcuEl) summaryOlcuEl.textContent = olcu;

    var summaryCerceveEl = document.getElementById('summaryCerceve');
    if (summaryCerceveEl) {
        summaryCerceveEl.textContent = cerceve || '@Localizer["SelectFrame"]';
    }

    var giftPrice = 0;
    var giftCheck = document.getElementById('giftWrapCheckbox');
    if (giftCheck && giftCheck.checked) {
        var giftPriceInput = document.getElementById('hediyePaketFiyatiHidden');
        if (giftPriceInput) giftPrice = parseFloat(giftPriceInput.value) || 0;
    }
    var toplamBirimGift = toplamBirim + giftPrice;
    var toplamGift = toplamBirimGift * adet;

    var summaryFiyatEl = document.getElementById('summaryFiyat');
    if (summaryFiyatEl) {
        summaryFiyatEl.textContent = window.formatMoney(toplamGift) + ' @currencySymbol';
    }

    var summaryBirimFiyatEl = document.getElementById('summaryBirimFiyat');
    if (summaryBirimFiyatEl) {
        summaryBirimFiyatEl.textContent = adet > 1 ? `(birim: ${window.formatMoney(toplamBirimGift)} @currencySymbol)` : '';
    }

    var giftBadge = document.getElementById('summaryGiftBadge');
    if (giftBadge) {
        if (giftPrice > 0) {
            giftBadge.classList.remove('hidden');
        } else {
            giftBadge.classList.add('hidden');
        }
    }

    summary.classList.remove('hidden');
}

function toggleGiftWrap(container) {
    var checkbox = container.querySelector('input[type="checkbox"]');
    if (!checkbox) return;
    checkbox.checked = !checkbox.checked;
    
    var hiddenInput = document.getElementById('hediyePaketiHidden');
    if (hiddenInput) hiddenInput.value = checkbox.checked ? 'true' : 'false';
    
    var noteBlock = document.getElementById('giftNoteBlock');
    if (noteBlock) {
        if (checkbox.checked) {
            noteBlock.classList.remove('hidden');
        } else {
            noteBlock.classList.add('hidden');
        }
    }
    
    updateSelectionSummary();
    
    var priceDisplay = document.getElementById('priceDisplay');
    if (priceDisplay) {
        var selectedVariant = document.querySelector('.variant-radio:checked');
        if (selectedVariant) {
            var basePrice = parseFloat(selectedVariant.getAttribute('data-price')) || 0;
            var olcu = selectedVariant.getAttribute('data-olcu') || selectedVariant.getAttribute('data-label') || '';
            var selectedFrame = document.querySelector('.frame-radio:checked');
            var cerceve = selectedFrame ? selectedFrame.value : null;
            var cerceveFarki = calcFrameFiyat(olcu, cerceve || 'Çerçevesiz');
            var totalPrice = basePrice + cerceveFarki;
            if (checkbox.checked) {
                var giftPriceInput = document.getElementById('hediyePaketFiyatiHidden');
                if (giftPriceInput) totalPrice += parseFloat(giftPriceInput.value) || 0;
            }
            priceDisplay.innerHTML = window.formatMoney(totalPrice) + ' @currencySymbol';
        }
    }
}

function updatePriceWithFrame() {
    var selectedVariant = document.querySelector('.variant-radio:checked');
    var selectedFrame = document.querySelector('.frame-radio:checked');
    if (!selectedVariant) return;

    var basePrice = parseFloat(selectedVariant.getAttribute('data-price')) || 0;
    var olcu = selectedVariant.getAttribute('data-olcu') || selectedVariant.getAttribute('data-label') || '';
    var cerceve = selectedFrame ? selectedFrame.value : null;
    var cerceveFarki = calcFrameFiyat(olcu, cerceve || 'Çerçevesiz');
    var newPrice = basePrice + cerceveFarki;

    var priceDisplay = document.getElementById('priceDisplay');
    if (priceDisplay) {
        priceDisplay.innerHTML = `${window.formatMoney(newPrice)} @currencySymbol`;
    }

    var frameFarkiInput = document.getElementById('selectedFrameFarki');
    if (frameFarkiInput) {
        frameFarkiInput.value = cerceveFarki.toFixed(2);
    }

    updateSelectionSummary();
}

function updateVariantCardStyles() {
    document.querySelectorAll('.variant-radio').forEach(function(radio) {
        var card = radio.closest('label');
        if (!card) return;
        if (radio.checked) {
            card.className = 'relative border-2 border-brand-olive bg-brand-olive text-white shadow-md rounded-lg px-4 py-3 cursor-pointer transition-all duration-150';
            var existingBadge = card.querySelector('.variant-check-badge');
            if (!existingBadge) {
                var badge = document.createElement('div');
                badge.className = 'variant-check-badge absolute -top-2 -right-2 w-5 h-5 bg-brand-gold rounded-full flex items-center justify-center shadow-sm';
                badge.innerHTML = '<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
                card.appendChild(badge);
            }
            var priceSpan = card.querySelector('.variant-price');
            if (priceSpan) priceSpan.className = 'variant-price text-xs text-white/80 font-medium';
            var stockSpan = card.querySelector('.variant-stock-warning');
            if (stockSpan) stockSpan.className = stockSpan.className.replace(/text-amber-600/g, 'text-amber-200');
        } else {
            card.className = 'relative border-2 border-brand-border bg-white text-brand-mutedtext hover:border-brand-gold rounded-lg px-4 py-3 cursor-pointer transition-all duration-150';
            var badge = card.querySelector('.variant-check-badge');
            if (badge) badge.remove();
            var priceSpan = card.querySelector('.variant-price');
            if (priceSpan) priceSpan.className = 'variant-price text-xs text-brand-gold font-medium';
            var stockSpan = card.querySelector('.variant-stock-warning');
            if (stockSpan) stockSpan.className = stockSpan.className.replace(/text-amber-200/g, 'text-amber-600');
        }
    });
}

document.querySelectorAll('.variant-radio').forEach(function(radio) {
    radio.addEventListener('change', function() {
        if (this.checked) {
            var price = parseFloat(this.getAttribute('data-price')) || 0;
            var oldPrice = parseFloat(this.getAttribute('data-oldprice')) || 0;
            var imageUrl = this.getAttribute('data-image');
            var label = this.getAttribute('data-label');
            var isPreorder = this.getAttribute('data-preorder') === 'true';
            var stock = parseInt(this.getAttribute('data-stock')) || 0;
            var productionDays = parseInt(this.getAttribute('data-production')) || 0;

            var selectedVariantId = document.getElementById('selectedVariantId');
            if (selectedVariantId) selectedVariantId.value = this.value;

            updateVariantCardStyles();
            updatePriceWithFrame();
            
            var oldPriceDisplay = document.getElementById('oldPriceDisplay');
            var discountBadge = document.getElementById('discountBadge');
            var selectedFrame = document.querySelector('.frame-radio:checked');
            var cerceveFarki = 0;
            if (selectedFrame) {
                var olcuText = this.getAttribute('data-olcu') || this.getAttribute('data-label') || '';
                cerceveFarki = calcFrameFiyat(olcuText, selectedFrame.value);
            }
            var effectivePrice = price + cerceveFarki;
            var effectiveOldPrice = oldPrice > 0 ? oldPrice + cerceveFarki : 0;
            
            if (effectiveOldPrice > effectivePrice) {
                if (oldPriceDisplay) {
                    oldPriceDisplay.innerHTML = window.formatMoney(effectiveOldPrice) + ' ' + PRODUCT_CURRENCY;
                    oldPriceDisplay.classList.remove('hidden');
                }
                if (discountBadge) {
                    var discount = Math.round((1 - (effectivePrice / effectiveOldPrice)) * 100);
                    discountBadge.innerHTML = '%' + discount + ' @Localizer["Discount"]';
                    discountBadge.classList.remove('hidden');
                }
            } else {
                if (oldPriceDisplay) oldPriceDisplay.classList.add('hidden');
                if (discountBadge) discountBadge.classList.add('hidden');
            }
            
            if (imageUrl) {
                changeProductImage(imageUrl, null, label);
            }
            
            var variantSummary = document.getElementById('variantSummaryText');
            if (variantSummary) {
                variantSummary.innerHTML = '<i class="fas fa-layer-group mr-1.5"></i> ' + label;
                variantSummary.classList.remove('hidden');
            }
            
            var lowStockWarning = document.getElementById('lowStockWarning');
            var lowStockText = document.getElementById('lowStockText');
            if (lowStockWarning) {
                if (!PRODUCT_STOKTA_YOK_SATIS_IZNI && stock >= 1 && stock <= 4) {
                    if (lowStockText) {
                        var tpl = '@Html.Raw(Localizer["LowStockText"])';
                        lowStockText.textContent = tpl.replace('{0}', stock);
                    }
                    lowStockWarning.classList.remove('hidden');
                } else {
                    lowStockWarning.classList.add('hidden');
                }
            }

            var stockStatusText = document.getElementById('stockStatusText');
            if (stockStatusText) {
                if (stock > 0) {
                    stockStatusText.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> @Localizer["MadeToOrder"]';
                } else if (isPreorder) {
                    stockStatusText.innerHTML = '<i class="fas fa-clock text-blue-600"></i> @Localizer["PreOrder"]';
                } else {
                    stockStatusText.innerHTML = '<i class="fas fa-times-circle text-red-600"></i> @Localizer["OutOfStock"]';
                }
            }

            var productionTimeText = document.getElementById('productionTimeText');
            if (productionTimeText && productionDays > 0) {
                productionTimeText.innerHTML = '<i class="fas fa-hammer text-brand-olive"></i> @Localizer["ProductionInDaysJS"]'.replace('{0}', productionDays);
            }

            var productionCardText = document.getElementById('productionCardText');
            if (productionCardText && productionDays > 0) {
                productionCardText.innerText = '@Localizer["BusinessDaysJS"]'.replace('{0}', productionDays);
            }
            
            var quantityInput = document.getElementById('productQuantity');
            if (quantityInput) {
                quantityInput.max = stock > 0 ? stock : (isPreorder ? 99 : 1);
                var minQuantity = parseInt(quantityInput.getAttribute('min')) || 1;
                quantityInput.value = minQuantity;
                var selectedQuantity = document.getElementById('selectedQuantity');
                if (selectedQuantity) selectedQuantity.value = minQuantity;
            }
        }
    });
});

document.querySelectorAll('.frame-radio').forEach(function(radio) {
    radio.addEventListener('change', function () {
        var selectedFrameModel = document.getElementById('selectedFrameModel');
        if (selectedFrameModel) selectedFrameModel.value = this.value;
        var frameSelectionError = document.getElementById('frameSelectionError');
        var frameSelectionBlock = document.getElementById('frameSelectionBlock');
        if (frameSelectionError) frameSelectionError.classList.add('hidden');
        if (frameSelectionBlock) frameSelectionBlock.classList.remove('ring-2', 'ring-red-400', 'ring-offset-2');

        updatePriceWithFrame();
    });
});

function increaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let max = parseInt(input.getAttribute('max')) || 99;
    let val = parseInt(input.value) || 1;
    if (val < max) {
        input.value = val + 1;
        if (selectedInput) selectedInput.value = val + 1;
        updateSelectionSummary();
    }
}

function decreaseQuantity() {
    const input = document.getElementById('productQuantity');
    const selectedInput = document.getElementById('selectedQuantity');
    if (!input) return;
    
    let min = parseInt(input.getAttribute('min')) || 1;
    let val = parseInt(input.value) || 1;
    if (val > min) {
        input.value = val - 1;
        if (selectedInput) selectedInput.value = val - 1;
        updateSelectionSummary();
    }
}

const ajaxSepetBtn = document.getElementById('ajaxSepetBtn');
if (ajaxSepetBtn) {
    ajaxSepetBtn.addEventListener('click', async function (e) {
        e.preventDefault();
        const form = document.getElementById('addToCartForm');
        const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const frameSelectionBlock = document.getElementById('frameSelectionBlock');
        const selectedFrame = document.querySelector('input[name="CerceveModeli"]:checked');

        if (frameSelectionBlock && !selectedFrame) {
            const frameSelectionError = document.getElementById('frameSelectionError');
            if (frameSelectionError) frameSelectionError.classList.remove('hidden');
            frameSelectionBlock.classList.add('ring-2', 'ring-red-400', 'ring-offset-2');
            frameSelectionBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });

            if (window.showToast) {
                window.showToast('@Localizer["FrameSelectionRequired"]', 'error');
            } else {
                alert('@Localizer["FrameSelectionRequired"]');
            }

            return;
        }
        
        const url = '/cart/Ekle';
        const urunId = form.querySelector('input[name="UrunId"]')?.value;
        const adet = form.querySelector('input[name="Adet"]')?.value;
        const secenekId = document.getElementById('selectedVariantId')?.value;
        const cerceveModeli = selectedFrame?.value;
        const cerceveFarki = document.getElementById('selectedFrameFarki')?.value;
        
        const params = new URLSearchParams();
        params.append('UrunId', urunId);
        params.append('Adet', adet || '1');
        if (secenekId) params.append('SecenekId', secenekId);
        if (cerceveModeli) params.append('CerceveModeli', cerceveModeli);
        if (cerceveFarki && cerceveFarki !== '0') params.append('CerceveFarki', cerceveFarki);
        
        var hediyePaketiCheck = document.getElementById('giftWrapCheckbox');
        if (hediyePaketiCheck && hediyePaketiCheck.checked) {
            params.append('HediyePaketi', 'true');
            var hediyeFiyat = document.getElementById('hediyePaketFiyatiHidden')?.value;
            if (hediyeFiyat) params.append('HediyePaketFiyati', hediyeFiyat);
            var giftNote = document.getElementById('giftNoteText')?.value;
            if (giftNote) params.append('MusteriNotu', giftNote);
        }
        
        const originalHtml = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> ' + PRODUCT_ADDED_TEXT;
        this.disabled = true;

        fetch(url + '?' + params.toString(), {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const btn = this;
                const icon = btn.querySelector('.add-to-cart-icon');
                const text = btn.querySelector('.add-to-cart-text');
                
                if (icon) {
                    icon.classList.remove('fa-shopping-bag');
                    icon.classList.add('fa-check');
                }
                if (text) {
                    text.textContent = PRODUCT_ADDED_TEXT;
                }
                btn.classList.add('bg-green-600');

                // Update cart counter with bounce
                const cartCounter = document.getElementById('cartItemCount');
                const cartCounterMobile = document.getElementById('cartItemCountMobile');
                const cartCounters = [cartCounter, cartCounterMobile].filter(el => el);
                
                cartCounters.forEach(counter => {
                    let current = parseInt(counter.innerText) || 0;
                    let added = parseInt(adet) || 1;
                    counter.innerText = current + added;
                    counter.classList.add('scale-150', 'bounce-animation');
                    setTimeout(() => {
                        counter.classList.remove('scale-150', 'bounce-animation');
                        counter.classList.add('scale-125');
                        setTimeout(() => counter.classList.remove('scale-125'), 150);
                    }, 300);
                });

                if (window.showToast) {
                    window.showToast(PRODUCT_ADDED_TO_CART_TEXT, 'success');
                }
                
                // 1 saniye sonra butonu sıfırla (tekrar tıklanabilir olsun)
                setTimeout(() => {
                    if (icon) {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-shopping-bag');
                    }
                    if (text) text.textContent = PRODUCT_ADD_TO_CART_TEXT;
                    btn.classList.remove('bg-green-600');
                    btn.disabled = false;
                }, 1000);
                
            } else {
                if (window.showToast) {
                    window.showToast(data.message || '@Localizer["ErrorOccurred"]', 'error');
                } else {
                    alert(data.message || '@Localizer["ErrorOccurred"]');
                }
                this.innerHTML = originalHtml;
                this.disabled = false;
            }
        })
        .catch(error => {
            console.error(error);
            if (window.showToast) {
                window.showToast('@Localizer["ConnectionError"]', 'error');
            } else {
                alert('@Localizer["ConnectionErrorShort"]');
            }
            this.innerHTML = originalHtml;
            this.disabled = false;
        });
    });
}

function navigateGallery(direction, event) {
    if (event) event.stopPropagation();
    
    const thumbnails = Array.from(document.querySelectorAll('.thumbnail-item'));
    if (thumbnails.length <= 1) return;
    
    const mainImage = document.getElementById('mainProductImage');
    const currentSrc = mainImage?.getAttribute('src') || '';
    
    let currentIndex = thumbnails.findIndex(item => {
        const dataImage = item.getAttribute('data-image') || '';
        return dataImage === currentSrc || currentSrc.endsWith(dataImage);
    });
    if (currentIndex === -1) currentIndex = 0;
    
    let nextIndex;
    if (direction === 'next') {
        nextIndex = (currentIndex + 1) % thumbnails.length;
    } else {
        nextIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    }
    
    const nextThumb = thumbnails[nextIndex];
    if (nextThumb) {
        nextThumb.click();
    }
}

function copyProductLink(button) {
    const url = button?.getAttribute('data-url') || window.location.href;
    const originalHtml = button.innerHTML;

    const markCopied = () => {
        button.innerHTML = '<i class="fas fa-check text-xs"></i> @Localizer["Copied"]';
        setTimeout(() => {
            button.innerHTML = originalHtml;
        }, 1800);
    };

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(markCopied).catch(() => {
            window.prompt('@Localizer["ProductLink"]', url);
        });
        return;
    }

    window.prompt('@Localizer["ProductLink"]', url);
}

function selectFrameOption(label, value) {
    const radios = document.querySelectorAll('input[name="CerceveModeli"]');
    radios.forEach(r => r.checked = false);
    const radio = label.querySelector('input[name="CerceveModeli"]');
    if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
    }
}

// Masaüstü fare koordinatlarına göre pürüzsüz zoom (transform-origin)
document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById('mainProductImageContainer');
    const img = document.getElementById('mainProductImage');
    
    if (container && img) {
        container.addEventListener('mousemove', function (e) {
            const rect = container.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            img.style.transformOrigin = x + '% ' + y + '%';
        });
        container.addEventListener('mouseleave', function () {
            img.style.transformOrigin = 'center center';
        });
    }
});
</script>
