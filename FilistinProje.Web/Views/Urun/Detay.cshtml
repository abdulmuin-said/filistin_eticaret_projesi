        thumbnailElement.classList.remove('border-transparent');
        thumbnailElement.classList.add('border-brand-olive');
        thumbnailElement.classList.add('ring-2', 'ring-brand-olive/40');
        thumbnailElement.setAttribute('aria-selected', 'true');
        thumbnailElement.setAttribute('tabindex', '0');
        thumbnailElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        thumbnailElement.focus({ preventScroll: true });
    }
}

const PRODUCT_BASE_PRICE = @Model.EtkinFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture);
const PRODUCT_MAIN_PRICE = @Model.EtkinFiyat.ToString(System.Globalization.CultureInfo.InvariantCulture);
const PRODUCT_MAIN_OLD_PRICE = @(Model.IndirimVarMi ? Model.Fiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0");
const MAIN_CAMPAIGN_END_DATE = '@(Model.KampanyaBitisTarihi?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "")';
const MAIN_PRODUCT_CAMPAIGN_END_DATE = '@(Model.KampanyaBitisTarihi?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? "")';

function updateSelectionSummary() {
    var summary = document.getElementById('selectionSummary');
    if (!summary) return;

    var selectedVariant = document.querySelector('.variant-radio:checked');
    var giftSelect = document.getElementById('giftPackageSelect');
    var selectedGiftOption = giftSelect && giftSelect.selectedIndex >= 0 ? giftSelect.options[giftSelect.selectedIndex] : null;

    var olcu = selectedVariant ? (selectedVariant.getAttribute('data-olcu') || selectedVariant.getAttribute('data-label') || '-') : '-';

    var wholesaleSelect = document.getElementById('wholesaleTierSelect');
    var selectedTierOption = wholesaleSelect && wholesaleSelect.value ? wholesaleSelect.options[wholesaleSelect.selectedIndex] : null;
    var tierPrice = selectedTierOption ? parseFloat(selectedTierOption.getAttribute('data-price')) || 0 : 0;

    var temelFiyat = tierPrice > 0 ? tierPrice : (selectedVariant ? (parseFloat(selectedVariant.getAttribute('data-price')) || PRODUCT_MAIN_PRICE) : PRODUCT_BASE_PRICE);
    var adet = parseInt(document.getElementById('productQuantity')?.value) || 1;
    var unitProductPrice = temelFiyat;
    var productTotal = unitProductPrice * adet;

    var giftPrice = selectedGiftOption && selectedGiftOption.value ? (parseFloat(selectedGiftOption.getAttribute('data-price') || '0') || 0) : 0;
    var giftTotal = giftPrice * adet;
    var grandTotal = productTotal + giftTotal;

    var hasMultipleVariants = document.querySelectorAll('.variant-radio').length > 1;
    var hasPackaging = giftPrice > 0;
    var hasMultipleQty = adet > 1;
    var hasTier = tierPrice > 0;

    if (!hasPackaging && !hasTier && !hasMultipleVariants && !hasMultipleQty) {
        summary.classList.add('hidden');
        return;
    }

    // Varyant satırı
    var variantRow = document.getElementById('summaryVariantRow');
    var summaryOlcuEl = document.getElementById('summaryOlcu');
    if (variantRow && summaryOlcuEl) {
        if (hasMultipleVariants && olcu && olcu !== '-') {
            summaryOlcuEl.textContent = olcu;
            variantRow.classList.remove('hidden');
        } else {
            variantRow.classList.add('hidden');
        }
    }

    // Ürün Birim / Ara Toplam
    var summaryProductPriceEl = document.getElementById('summaryProductPrice');
    if (summaryProductPriceEl) {
        if (adet > 1) {
            summaryProductPriceEl.textContent = `${window.formatMoney(unitProductPrice)} × ${adet} = ${window.formatMoney(productTotal)}`;
        } else {
            summaryProductPriceEl.textContent = window.formatMoney(unitProductPrice);
        }
    }

    // Hediye Paketi Satırı ve Rozeti
    var giftRow = document.getElementById('summaryGiftRow');
    var giftBadge = document.getElementById('summaryGiftBadge');
    var giftPriceEl = document.getElementById('summaryGiftPrice');
    var giftNameEl = document.getElementById('summaryGiftName');

    if (giftPrice > 0 && selectedGiftOption) {
        var giftLabel = selectedGiftOption.textContent?.trim() || TXT_GIFT_PACKAGING;
        if (giftNameEl) giftNameEl.textContent = `+ ${giftLabel}:`;
        if (giftPriceEl) {
            if (adet > 1) {
                giftPriceEl.textContent = `+${window.formatMoney(giftPrice)} × ${adet} = +${window.formatMoney(giftTotal)}`;
            } else {
                giftPriceEl.textContent = `+${window.formatMoney(giftPrice)}`;
            }
        }
        if (giftRow) giftRow.classList.remove('hidden');
        if (giftBadge) giftBadge.classList.remove('hidden');
    } else {
        if (giftRow) giftRow.classList.add('hidden');
        if (giftBadge) giftBadge.classList.add('hidden');
    }

    // Toplam Tutar
    var summaryFiyatEl = document.getElementById('summaryFiyat');
    if (summaryFiyatEl) {
        summaryFiyatEl.textContent = window.formatMoney(grandTotal);
    }

    var summaryBirimFiyatEl = document.getElementById('summaryBirimFiyat');
    if (summaryBirimFiyatEl) {
        var totalBirim = unitProductPrice + giftPrice;
        summaryBirimFiyatEl.textContent = adet > 1 ? `(${TXT_UNIT_LABEL}: ${window.formatMoney(totalBirim)})` : '';
    }

    // Açık Formül Dökümü
    var breakdownEl = document.getElementById('summaryBreakdown');
    if (breakdownEl) {
        var prodFormula = adet > 1 ? `(${window.formatMoney(unitProductPrice)} × ${adet})` : window.formatMoney(unitProductPrice);
        if (giftPrice > 0) {
            var giftFormula = adet > 1 ? `(${window.formatMoney(giftPrice)} × ${adet})` : window.formatMoney(giftPrice);
            breakdownEl.textContent = `${prodFormula} + ${giftFormula} = ${window.formatMoney(grandTotal)}`;
        } else if (adet > 1) {
            breakdownEl.textContent = `${prodFormula} = ${window.formatMoney(grandTotal)}`;
        } else {
            breakdownEl.textContent = '';
        }
    }

    summary.classList.remove('hidden');
}

