    updatePriceDisplay();
}

function resetToMainProductState(keepCurrentThumbnail) {
    // 1. Tüm varyant seçimlerini kaldır
    document.querySelectorAll('.variant-radio').forEach(function(r) {
        r.checked = false;
    });

    // 2. Seçili varyant ID gizli alanını boşalt
    var selectedVariantId = document.getElementById('selectedVariantId');
    if (selectedVariantId) selectedVariantId.value = '';

    // 3. Varyant kart stillerini sıfırla (.is-selected ve onay ikonlarını kaldır)
    updateVariantCardStyles();

    // 4. "İptal / Ana Ürün" butonlarını gizle
    document.querySelectorAll('.clear-variant-selection-btn').forEach(function(btn) {
        btn.classList.add('hidden');
        btn.classList.remove('inline-flex');
    });

    // 5. Toptancı varyant kademesi varsa sıfırla
    var wholesaleSelect = document.getElementById('wholesaleTierSelect');
    if (wholesaleSelect && wholesaleSelect.value) {
        var selectedOption = wholesaleSelect.options[wholesaleSelect.selectedIndex];
        var tierVariantId = parseInt(selectedOption?.getAttribute('data-variant-id')) || 0;
        if (tierVariantId > 0) {
            wholesaleSelect.value = '';
        }
    }

    // 6. Fiyat, eski fiyat, indirim rozeti ve indirim sayacını ana ürüne göre güncelle
    updatePriceDisplay();
    updateWhatsappOrderLink();

    // 7. Ana ürün görseline geri dön (eğer tıklanan küçük resim zaten seçilmediyse)
    if (!keepCurrentThumbnail) {
        var targetImg = MAIN_PRODUCT_IMAGE || DEFAULT_PRODUCT_IMAGE;
        if (targetImg) {
            changeProductImage(targetImg, null, '');
        }
    }

    // 8. Varyant özet metnini gizle
    var variantSummary = document.getElementById('variantSummaryText');
    if (variantSummary) {
        variantSummary.innerHTML = '';
        variantSummary.classList.add('hidden');
    }

    // 9. Düşük stok uyarısını gizle
    var lowStockWarning = document.getElementById('lowStockWarning');
    if (lowStockWarning) lowStockWarning.classList.add('hidden');

    // 10. Stok durum metnini ana ürüne göre ayarla
    var stockStatusText = document.getElementById('stockStatusText');
    if (stockStatusText) {
        if (PRODUCT_INITIAL_STOKTA_VAR || PRODUCT_STOKTA_YOK_SATIS_IZNI) {
            stockStatusText.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> ' + TXT_MADE_TO_ORDER;
        } else {
            stockStatusText.innerHTML = '<i class="fas fa-times-circle text-red-600"></i> ' + TXT_OUT_OF_STOCK;
        }
    }

    // 11. Adet kutusu sınırlarını sıfırla
    var quantityInput = document.getElementById('productQuantity');
    if (quantityInput) {
        quantityInput.max = 99;
        var minQuantity = parseInt(quantityInput.getAttribute('min')) || 1;
        quantityInput.value = minQuantity;
        var selectedQuantity = document.getElementById('selectedQuantity');
        if (selectedQuantity) selectedQuantity.value = minQuantity;
    }

    // 12. Sepete ekle butonunu aktif et
    var ajaxBtn = document.getElementById('ajaxSepetBtn');
    if (ajaxBtn) {
        var canBuy = PRODUCT_INITIAL_STOKTA_VAR || PRODUCT_STOKTA_YOK_SATIS_IZNI;
        ajaxBtn.disabled = !canBuy;
        ajaxBtn.classList.toggle('opacity-50', !canBuy);
        ajaxBtn.classList.toggle('cursor-not-allowed', !canBuy);
        var btnText = ajaxBtn.querySelector('.add-to-cart-text');
        if (btnText) {
            btnText.textContent = canBuy ? TXT_ADD_TO_CART : TXT_OUT_OF_STOCK;
        }
    }
}

