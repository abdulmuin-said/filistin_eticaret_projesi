<script>
const PRODUCT_CURRENCY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencySymbol));
const PRODUCT_ADDED_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Added"].Value));
const PRODUCT_ADDED_TO_CART_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddedToCartSuccess"].Value));
const PRODUCT_ADD_TO_CART_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddToCart"].Value));
const TXT_OUT_OF_STOCK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["OutOfStock"].Value));
const TXT_ADD_TO_CART = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddToCart"].Value));
const TXT_PREORDER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PreOrderOpen"].Value));
const TXT_MADE_TO_ORDER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["MadeToOrder"].Value));
const TXT_GIFT_PACKAGING = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["GiftPackaging"].Value));
const TXT_DISCOUNT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Discount"].Value));
const TXT_ERROR_OCCURRED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ErrorOccurred"].Value));
const TXT_CONNECTION_ERROR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConnectionError"].Value));
const TXT_CONNECTION_ERROR_SHORT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConnectionErrorShort"].Value));
const TXT_COPIED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Copied"].Value));
const TXT_PRODUCT_LINK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProductLink"].Value));
const TXT_BUSINESS_DAYS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["BusinessDaysJS"].Value));
const TXT_PRODUCTION_IN_DAYS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProductionInDaysJS"].Value));
const TXT_LOW_STOCK = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["LowStockText"].Value));
const TXT_UNIT_LABEL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isAr ? "للقطعة" : "unit"));
const TXT_FAV_ADDED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProductAddedToFavorites"].Value));
const TXT_FAV_REMOVED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProductRemovedFromFavorites"].Value));
const TXT_ADD_TO_FAVORITES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AddToFavorites"].Value));
const TXT_REMOVE_FROM_FAVORITES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["RemoveFromFavorites"].Value));
const PRODUCT_STOKTA_YOK_SATIS_IZNI = @Json.Serialize(stoktaYokSatisIzni);
const PRODUCT_INITIAL_STOKTA_VAR = @Json.Serialize(stoktaVar);
const MAIN_PRODUCT_CAMPAIGN_END_DATE = '@(Model.IndirimVarMi && Model.KampanyaBitisTarihi.HasValue ? Model.KampanyaBitisTarihi.Value.ToString("yyyy-MM-ddTHH:mm:ssZ") : "")';
const PRODUCT_WHATSAPP_NAME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LocalizedBaslik));
const PRODUCT_WHATSAPP_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productUrl));
const PRODUCT_WHATSAPP_NUMBER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(whatsappNumber));

function updateWhatsappOrderLink() {
    const link = document.getElementById('whatsappOrderLink');
    if (!link) return;

    const selectedVariant = document.querySelector('.variant-radio:checked');
    const variantLabel = selectedVariant?.getAttribute('data-label')?.trim();
    const messageParts = [PRODUCT_WHATSAPP_NAME];
    if (variantLabel) messageParts.push(variantLabel);
    messageParts.push(PRODUCT_WHATSAPP_URL);
    link.href = `https://wa.me/${PRODUCT_WHATSAPP_NUMBER}?text=${encodeURIComponent(messageParts.join('\n'))}`;
}

// Modal and Global Listeners
document.addEventListener('DOMContentLoaded', function() {
    const desktopModal = document.getElementById('desktopLightboxModal');
    const mobileModal = document.getElementById('mobileLightbox');
    const closeBtn = document.getElementById('closeDesktopModalBtn');

    [desktopModal, mobileModal].forEach(modal => {
        if (modal && modal.parentElement !== document.body) {
            document.body.appendChild(modal);
        }
    });

    if (closeBtn && desktopModal) {
        closeBtn.addEventListener('click', closeDesktopLightbox);
    }

    [desktopModal, mobileModal].forEach(modal => {
        if (modal) {
            modal.addEventListener('click', event => {
                if (event.target === modal) {
                    closeProductLightbox();
                }
            });
        }
    });

    window.addEventListener('keydown', event => {
        if (event.key === 'Escape' || event.code === 'Escape') {
            closeProductLightbox();
        }

        const activeInGallery = document.activeElement?.closest?.('#mainProductImageContainer, [data-thumb-strip], #desktopLightboxModal, #mobileLightbox');
        if (activeInGallery && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
            event.preventDefault();
            const isRtl = document.documentElement.dir === 'rtl';
            const logicalNext = event.key === 'ArrowRight' ? !isRtl : isRtl;
            navigateGallery(logicalNext ? 'next' : 'prev', event);
        }
    }, true);

    const mediaContainer = document.getElementById('mainProductImageContainer');
    let touchStartX = 0;
    let touchStartY = 0;
    if (mediaContainer) {
        mediaContainer.addEventListener('touchstart', event => {
            touchStartX = event.changedTouches?.[0]?.clientX || 0;
            touchStartY = event.changedTouches?.[0]?.clientY || 0;
        }, { passive: true });
        mediaContainer.addEventListener('touchend', event => {
            const endX = event.changedTouches?.[0]?.clientX || 0;
            const endY = event.changedTouches?.[0]?.clientY || 0;
            const deltaX = endX - touchStartX;
            const deltaY = endY - touchStartY;
            if (Math.abs(deltaX) < 40 || Math.abs(deltaY) > Math.abs(deltaX)) return;
            const isRtl = document.documentElement.dir === 'rtl';
            const logicalNext = deltaX < 0 ? !isRtl : isRtl;
            navigateGallery(logicalNext ? 'next' : 'prev', event);
        }, { passive: true });
    }

    // Wishlist Button Handler
    const favBtn = document.getElementById('btnToggleFavorite');
    if (favBtn) {
        favBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const prodId = this.getAttribute('data-product-id');
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            fetch('/Favori/Toggle?urunId=' + encodeURIComponent(prodId), {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const icon = favBtn.querySelector('.favorite-icon');
                    const text = favBtn.querySelector('.favorite-text');
                    if (data.isAdded) {
                        favBtn.classList.add('is-favorited', 'text-red-500', 'border-red-300', 'bg-red-50/60');
                        favBtn.classList.remove('bg-white');
                        favBtn.setAttribute('title', TXT_REMOVE_FROM_FAVORITES);
                        if (icon) {
                            icon.classList.remove('far');
                            icon.classList.add('fas', 'text-red-500');
                        }
                        if (text) text.textContent = TXT_REMOVE_FROM_FAVORITES;
                        if (window.showToast) window.showToast(TXT_FAV_ADDED, 'success');
                    } else {
                        favBtn.classList.remove('is-favorited', 'text-red-500', 'border-red-300', 'bg-red-50/60');
                        favBtn.classList.add('bg-white');
                        favBtn.setAttribute('title', TXT_ADD_TO_FAVORITES);
                        if (icon) {
                            icon.classList.remove('fas', 'text-red-500');
                            icon.classList.add('far');
                        }
                        if (text) text.textContent = TXT_ADD_TO_FAVORITES;
                        if (window.showToast) window.showToast(TXT_FAV_REMOVED, 'info');
                    }
                } else {
                    if (window.showToast) {
                        window.showToast(data.message || TXT_ERROR_OCCURRED, 'error');
                    } else {
                        alert(data.message || TXT_ERROR_OCCURRED);
                    }
                }
            })
            .catch(() => {
                if (window.showToast) {
                    window.showToast(TXT_CONNECTION_ERROR_SHORT, 'error');
                }
            });
        });
    }

    const commentModal = document.getElementById('commentModal');
    if (commentModal) {
        const openBtns = [document.getElementById('openCommentModalBtn'), document.getElementById('openCommentModalBtnEmpty')];
        openBtns.forEach(btn => btn && btn.addEventListener('click', () => {
            const ratingGroup = commentModal.querySelector('[data-star-rating]');
            window.starRatings?.reset(ratingGroup);
            commentModal.classList.remove('hidden');
            commentModal.classList.add('flex');
            commentModal.setAttribute('aria-hidden', 'false');
            ratingGroup?.querySelector('[role="radio"][tabindex="0"]')?.focus();
        }));

        const closeCommentBtn = document.getElementById('closeCommentModalBtn');
        if (closeCommentBtn) {
            closeCommentBtn.addEventListener('click', () => {
                commentModal.classList.add('hidden');
                commentModal.classList.remove('flex');
                commentModal.setAttribute('aria-hidden', 'true');
            });
        }
    }

    setTimeout(function() {
        updateSelectionSummary();
        updateVariantCardStyles();
        updateWhatsappOrderLink();
    }, 100);
});

document.getElementById('productQuantity')?.addEventListener('input', function() {
    var val = parseInt(this.value) || 0;
    var min = parseInt(this.getAttribute('min')) || 1;
    var max = parseInt(this.getAttribute('max')) || 99;
    if (val < min) this.value = min;
    if (val > max) this.value = max;
    var selectedQuantity = document.getElementById('selectedQuantity');
    if (selectedQuantity) selectedQuantity.value = this.value;
    updateSelectionSummary();
});

let currentZoom = 1;
let currentRotation = 0;
let previousBodyOverflow = '';

function syncLightboxImage() {
    const mainImage = document.getElementById('mainProductImage');
    if (!mainImage) return;

    const imageSrc = mainImage.currentSrc || mainImage.src;
    const imageAlt = mainImage.alt || mainImage.getAttribute('data-product-name') || '';

    const desktopImage = document.getElementById('desktopLightboxImage');
    if (desktopImage && imageSrc) {
        desktopImage.src = imageSrc;
        desktopImage.alt = imageAlt;
    }

    const mobileImage = document.getElementById('mobileLightboxImage');
    if (mobileImage && imageSrc) {
        mobileImage.src = imageSrc;
        mobileImage.alt = imageAlt;
    }
}

function lockLightboxScroll() {
    previousBodyOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
}

function unlockLightboxScroll() {
    document.body.style.overflow = previousBodyOverflow;
}

function openProductLightbox() {
    syncLightboxImage();
    lockLightboxScroll();

    if (window.innerWidth >= 1024) {
        const dm = document.getElementById('desktopLightboxModal');
        if (dm) {
            dm.classList.remove('hidden');
            dm.classList.add('flex');
            dm.setAttribute('aria-hidden', 'false');
            resetDesktopZoom();
        }
    } else {
        const mm = document.getElementById('mobileLightbox');
        if (mm) {
            mm.classList.remove('hidden');
            mm.classList.add('flex');
            mm.setAttribute('aria-hidden', 'false');
            resetMobileZoom();
        }
    }
}

function toggleAllReviews() {
    const extraReviews = document.querySelectorAll('.extra-review');
    const btn = document.getElementById('showAllReviewsBtn');
    const icon = document.getElementById('showReviewsIcon');
    const textEl = document.getElementById('showReviewsText');
    if (!btn || extraReviews.length === 0) return;

    const isExpanded = btn.getAttribute('data-expanded') === 'true';
    if (isExpanded) {
        extraReviews.forEach(el => el.classList.add('hidden'));
        btn.setAttribute('data-expanded', 'false');
        if (textEl) textEl.textContent = btn.getAttribute('data-show-text');
        if (icon) icon.classList.remove('rotate-180');
    } else {
        extraReviews.forEach(el => el.classList.remove('hidden'));
        btn.setAttribute('data-expanded', 'true');
        if (textEl) textEl.textContent = btn.getAttribute('data-hide-text');
        if (icon) icon.classList.add('rotate-180');
    }
}

function closeProductLightbox() {
    closeDesktopLightbox();
    closeMobileLightbox();
}

function closeDesktopLightbox() {
    const dm = document.getElementById('desktopLightboxModal');
    if (dm) {
        dm.classList.add('hidden');
        dm.classList.remove('flex');
        dm.setAttribute('aria-hidden', 'true');
        resetDesktopZoom();
    }
    unlockLightboxScroll();
}

function closeMobileLightbox() {
    const mm = document.getElementById('mobileLightbox');
    if (mm) {
        mm.classList.add('hidden');
        mm.classList.remove('flex');
        mm.setAttribute('aria-hidden', 'true');
        resetMobileZoom();
    }
    unlockLightboxScroll();
}

function resetMobileZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateMobileTransform();
}

function zoomInMobile() {
    if (currentZoom < 3) { currentZoom += 0.5; updateMobileTransform(); }
}

function zoomOutMobile() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateMobileTransform(); }
}

function rotateMobileImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateMobileTransform();
}

function updateMobileTransform() {
    const img = document.getElementById('mobileLightboxImage');
    if (img) img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    const zl = document.getElementById('zoomLevel');
    if (zl) zl.innerText = `${Math.round(currentZoom * 100)}%`;
}

function resetDesktopZoom() {
    currentZoom = 1;
    currentRotation = 0;
    updateDesktopTransform();
}

function zoomInDesktop() {
    if (currentZoom < 3) { currentZoom += 0.5; updateDesktopTransform(); }
}

function zoomOutDesktop() {
    if (currentZoom > 1) { currentZoom -= 0.5; updateDesktopTransform(); }
}

function rotateDesktopImage() {
    currentRotation = (currentRotation + 90) % 360;
    updateDesktopTransform();
}

function updateDesktopTransform() {
    const img = document.getElementById('desktopLightboxImage');
    if (img) {
        img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
    }
}

const MAIN_PRODUCT_IMAGE = '@Url.Content(Model.AnaGorselUrl)';
const DEFAULT_PRODUCT_IMAGE = '@Url.Content(varsayilanGaleriGorseli)';

function isSameImagePath(path1, path2) {
    if (!path1 || !path2) return false;
    var p1 = path1.trim().toLowerCase().replace(/^\/+/, '').split('?')[0];
    var p2 = path2.trim().toLowerCase().replace(/^\/+/, '').split('?')[0];
    return p1 === p2;
}

function changeProductImage(imageUrl, thumbnailElement, altText) {
    // If thumbnail was clicked, check if it belongs to a variant and auto-select that variant
    if (thumbnailElement && imageUrl) {
        const matchingRadio = Array.from(document.querySelectorAll('.variant-radio'))
            .find(r => isSameImagePath(r.getAttribute('data-image'), imageUrl));
        if (matchingRadio) {
            if (!matchingRadio.checked && !matchingRadio.disabled) {
                matchingRadio.checked = true;
                matchingRadio.dispatchEvent(new Event('change'));
                return;
            }
        }
    }

    if (!thumbnailElement && imageUrl) {
        thumbnailElement = Array.from(document.querySelectorAll('.thumbnail-item'))
            .find(item => isSameImagePath(item.getAttribute('data-image'), imageUrl)) || null;
    }

    const mainImage = document.getElementById('mainProductImage');
    if (mainImage) {
        mainImage.src = imageUrl;
        if (altText) mainImage.alt = altText;
    }
    
    const deskImg = document.getElementById('desktopLightboxImage');
    if (deskImg) {
        deskImg.src = imageUrl;
        if (altText) deskImg.alt = altText;
    }
    
    const mobImg = document.getElementById('mobileLightboxImage');
    if (mobImg) {
        mobImg.src = imageUrl;
        if (altText) mobImg.alt = altText;
    }
    
    const thumbnails = document.querySelectorAll('.thumbnail-item');
    thumbnails.forEach(item => {
        if (item) {
            item.classList.remove('border-brand-olive');
            item.classList.remove('ring-2', 'ring-brand-olive/40');
            item.classList.add('border-transparent');
            item.setAttribute('aria-selected', 'false');
            item.setAttribute('tabindex', '-1');
        }
    });
