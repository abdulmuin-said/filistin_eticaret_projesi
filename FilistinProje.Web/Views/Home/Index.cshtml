            <div class="home-feature-card rounded-3xl border border-brand-lightgold/35 p-4 text-start transition-all duration-300 hover:-translate-y-1 hover:shadow-soft md:p-8 md:text-center">
                <div class="home-feature-icon mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-olive text-brand-lightgold md:mx-auto md:mb-5 md:h-14 md:w-14">
                    <img src="/icons/shipping.svg" class="w-6 h-6 md:h-7 md:w-7" alt="" aria-hidden="true" />
                </div>
                <h4 class="font-serif mb-1 text-base text-brand-olive md:mb-2 md:text-lg">@Localizer["FastDelivery"]</h4>
                <p class="text-xs leading-relaxed text-brand-mutedtext md:text-sm">@Localizer["FastDeliveryDesc"]</p>
            </div>
            <div class="home-feature-card rounded-3xl border border-brand-lightgold/35 p-4 text-start transition-all duration-300 hover:-translate-y-1 hover:shadow-soft md:p-8 md:text-center">
                <div class="home-feature-icon mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-olive text-brand-lightgold md:mx-auto md:mb-5 md:h-14 md:w-14">
                    <img src="/icons/satisfaction.svg" class="w-6 h-6 md:h-7 md:w-7" alt="" aria-hidden="true" />
                </div>
                <h4 class="font-serif mb-1 text-base text-brand-olive md:mb-2 md:text-lg">@Localizer["CustomerSatisfaction"]</h4>
                <p class="text-xs leading-relaxed text-brand-mutedtext md:text-sm">@Localizer["CustomerSatisfactionDesc"]</p>
            </div>
        </div>
    </div>
</section>
