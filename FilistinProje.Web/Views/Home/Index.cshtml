@using System.Globalization
@using FilistinProje.Core.Varliklar
@model FilistinProje.Web.Models.HomeViewModel
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;
    var freeShippingLimitText = siteSettings.UcretsizKargoLimiti == decimal.Truncate(siteSettings.UcretsizKargoLimiti)
        ? siteSettings.UcretsizKargoLimiti.ToString("N0")
        : siteSettings.UcretsizKargoLimiti.ToString("N2");
    var brandName = string.IsNullOrWhiteSpace(siteSettings.MarkaAdi) ? siteSettings.SiteAdi : siteSettings.MarkaAdi;
    ViewData["Title"] = Localizer["HomePage"];
    ViewData["SeoTitle"] = string.Format(Localizer["HomeSeoTitle"], brandName);
    ViewData["MetaDescription"] = string.Format(Localizer["HomeMetaDescription"], brandName);
    ViewData["MetaKeywords"] = Localizer["HomeMetaKeywords"];
    ViewData["OgType"] = "website";
    var aktifSlaytlar = Model.AktifSlaytlar ?? new List<FilistinProje.Core.Varliklar.Slayt>();
    var heroSlaytlar = aktifSlaytlar
        .Where(x => string.Equals(x.Tur, "Video", StringComparison.OrdinalIgnoreCase)
            ? !string.IsNullOrWhiteSpace(x.VideoUrl)
            : !string.IsNullOrWhiteSpace(x.ResimUrl))
        .ToList();
    var heroSlideCount = heroSlaytlar.Count;
    var heroAnimationDuration = Math.Max(heroSlideCount, 1) * 5;
    var heroTitle = currentCulture == "ar" ? siteSettings.HeroBaslikAr : siteSettings.HeroBaslikEn;
    var heroSubtitle = currentCulture == "ar" ? siteSettings.HeroAltBaslikAr : siteSettings.HeroAltBaslikEn;
    var siteUrl = SiteSettingsService.BuildAbsoluteUrl(string.Empty);
    var isWholesale = User.IsInRole("Wholesale");
    FilistinProje.Web.Models.ProductCardViewModel BuildHomeProductCard(
        FilistinProje.Core.Varliklar.Urun urun,
        string? badgeText = null)
    {
        var slug = !string.IsNullOrWhiteSpace(urun.Slug)
            ? urun.Slug
            : FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(urun.LocalizedBaslik);

        return new FilistinProje.Web.Models.ProductCardViewModel
        {
            Id = urun.Id,
            Baslik = urun.LocalizedBaslik,
            Slug = string.IsNullOrWhiteSpace(slug) ? "urun" : slug,
            GorselUrl = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                ? urun.AnaGorselUrl
                : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu ?? string.Empty,
            Fiyat = urun.Fiyat,
            IndirimliFiyat = urun.IndirimliFiyat,
            TopFiyat = urun.TopFiyat,
            IndirimVarMi = urun.IndirimVarMi,
            IndirimYuzdesi = urun.IndirimYuzdesi,
            YeniUrunMu = urun.YeniUrunMu,
            OneCikanMi = urun.OneCikanMi,
            KampanyaliMi = urun.KampanyaliMi,
            OneCikanEtiketRengi = urun.OneCikanEtiketRengi,
            YeniUrunEtiketRengi = urun.YeniUrunEtiketRengi,
            KampanyaEtiketRengi = urun.KampanyaEtiketRengi,
            IndirimEtiketRengi = urun.IndirimEtiketRengi,
            StoktaVarMi = urun.StoktaVarMi,
            ToplamStok = urun.ToplamStok,
            FiyatGizliMi = urun.FiyatGizliMi,
            WhatsappSiparisVarMi = urun.WhatsappSiparisVarMi,
            KampanyaBitisTarihi = urun.KampanyaBitisTarihi,
            IsWholesale = isWholesale,
            BadgeText = badgeText,
            ShowFavori = true,
            ShowQuickAdd = true
        };
    }

    var websiteSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = brandName,
        ["url"] = siteUrl,
        ["potentialAction"] = new Dictionary<string, object?>
        {
            ["@type"] = "SearchAction",
            ["target"] = SiteSettingsService.BuildAbsoluteUrl("/products?s={search_term_string}"),
            ["query-input"] = "required name=search_term_string"
        }
    };

    var organizationSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = brandName,
        ["url"] = siteUrl,
        ["logo"] = SiteSettingsService.BuildAbsoluteUrl(string.IsNullOrWhiteSpace(siteSettings.SiteLogoUrl) ? "/74anrps48logo2.svg" : siteSettings.SiteLogoUrl),
        ["description"] = ViewData["MetaDescription"]
    };
}

<script type="application/ld+json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(websiteSchema))
</script>
<script type="application/ld+json">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(organizationSchema))
</script>

<style>
    .home-hero-frame {
        height: 35vh;
        min-height: 280px;
        background:
            radial-gradient(circle at 12% 18%, rgba(215, 193, 118, 0.34), transparent 28%),
            linear-gradient(135deg, #fffaf0 0%, #f7f1e6 52%, #efe3c7 100%);
        box-shadow: 0 22px 55px rgba(49, 53, 17, 0.14);
    }

    .home-hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 1000ms cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
    }

    .home-hero-copy {
        position: absolute;
        inset-inline-start: clamp(1.5rem, 7vw, 7rem);
        bottom: clamp(2rem, 8vw, 5.5rem);
        z-index: 8;
        max-width: min(38rem, 78%);
        color: white;
        text-shadow: 0 3px 24px rgba(0, 0, 0, .55);
    }

    .home-hero-slide.is-active {
        opacity: 1;
        z-index: 2;
    }

    .home-hero-image {
        object-fit: contain;
        background: transparent;
        filter: drop-shadow(0 18px 34px rgba(49, 53, 17, 0.16));
        transform: scale(1.05);
        transition: transform 6000ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .home-hero-slide.is-active .home-hero-image {
        transform: scale(1);
    }

    .home-hero-blur {
        position: absolute;
        inset: -18px;
        width: calc(100% + 36px);
        height: calc(100% + 36px);
        object-fit: cover;
        filter: blur(18px) saturate(1.08);
        transform: scale(1.06);
        opacity: 0.46;
    }

    .home-hero-vignette {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 50% 42%, rgba(255,255,255,0.30), transparent 42%),
            linear-gradient(180deg, rgba(252,249,243,0.44), rgba(247,241,230,0.16) 45%, rgba(49,53,17,0.12));
    }

    .hero-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(181, 135, 53, 0.3);
        color: var(--brand-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: all 300ms ease;
    }

    .home-hero-frame:hover .hero-nav-btn {
        opacity: 1;
    }

    .hero-nav-btn:hover {
        background: #ffffff;
        color: #b58735;
        border-color: #b58735;
        transform: translateY(-50%) scale(1.05);
        box-shadow: 0 4px 15px rgba(181, 135, 53, 0.2);
    }

    .hero-nav-prev {
        left: 1rem;
    }

    [dir="rtl"] .hero-nav-prev {
        left: auto;
        right: 1rem;
        transform: translateY(-50%) rotate(180deg);
    }

    [dir="rtl"] .hero-nav-prev:hover {
        transform: translateY(-50%) rotate(180deg) scale(1.05);
    }

    .hero-nav-next {
        right: 1rem;
    }

    [dir="rtl"] .hero-nav-next {
        right: auto;
        left: 1rem;
        transform: translateY(-50%) rotate(180deg);
    }

    [dir="rtl"] .hero-nav-next:hover {
        transform: translateY(-50%) rotate(180deg) scale(1.05);
    }

    .hero-dots {
        position: absolute;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        gap: 0.5rem;
    }

    .hero-dot {
        width: 2rem;
        height: 0.25rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.4);
        cursor: pointer;
        transition: all 300ms ease;
    }

    .hero-dot.is-active {
        background: #b58735;
        width: 3rem;
    }

    .home-trust-scroll {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
    }

    .home-trust-card {
        flex: 1 1 auto;
        min-height: 58px;
        min-width: 220px;
        background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(255,250,240,0.82));
        box-shadow: 0 10px 30px rgba(49, 53, 17, 0.08);
        border: 1px solid rgba(198, 202, 153, 0.35);
        border-radius: 1rem;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    .home-feature-card {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(circle at 12% 12%, rgba(215, 193, 118, 0.25), transparent 28%),
            linear-gradient(135deg, rgba(255,255,255,0.94), rgba(255,250,240,0.88));
        box-shadow: 0 14px 40px rgba(49, 53, 17, 0.09);
    }

    .home-feature-card::after {
        content: "";
        position: absolute;
        inset-inline-end: -28px;
        top: -28px;
        width: 88px;
        height: 88px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(45, 212, 191, 0.22), transparent 68%);
        pointer-events: none;
    }

    .home-feature-icon {
        box-shadow: 0 0 0 6px rgba(215, 193, 118, 0.16), 0 0 28px rgba(45, 212, 191, 0.24);
    }

    /* ─── Premium Light Categories ─── */
    .home-cat-wrapper {
        position: relative;
        overflow: hidden;
        background: #fbf8f2;
    }

    .home-cat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .home-cat-item {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid rgba(181, 135, 53, 0.15);
        box-shadow: 0 4px 15px rgba(49, 53, 17, 0.03);
        transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 400ms ease, border-color 400ms ease;
        display: flex;
        flex-direction: column;
    }

    .home-cat-item:hover,
    .home-cat-item:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(49, 53, 17, 0.06);
        border-color: rgba(181, 135, 53, 0.35);
        outline: none;
    }

    .home-cat-img-box {
        position: relative;
        width: 100%;
        aspect-ratio: 1/1;
        overflow: hidden;
        background: #f7f1e6;
    }

    .home-cat-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .home-cat-item:hover .home-cat-img,
    .home-cat-item:focus-visible .home-cat-img {
        transform: scale(1.05);
    }

    .home-cat-fallback {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 50% 50%, rgba(198, 202, 153, 0.15), transparent 60%),
            repeating-linear-gradient(45deg, rgba(181, 135, 53, 0.03) 0 1px, transparent 1px 12px),
            #fcf9f3;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .home-cat-content {
        padding: 0.6rem 0.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        background: linear-gradient(180deg, #ffffff, #fcf9f3);
    }

    @@media (min-width: 640px) {
        .home-cat-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }
    }

    @@media (min-width: 768px) {
        .home-hero-frame {
            height: 400px;
        }

        .home-hero-image {
            object-fit: cover;
            filter: none;
        }

        .home-hero-blur,
        .home-hero-vignette {
            display: none;
        }

        .home-trust-scroll {
            gap: 1.25rem;
        }

        .home-cat-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .home-cat-content {
            padding: 0.75rem;
        }
    }

    @@media (min-width: 1024px) {
        .home-hero-frame {
            height: 440px;
            box-shadow: 0 28px 80px rgba(49, 53, 17, 0.20);
        }
    }
</style>

<!-- BEGIN: Hero Banner - Pure Image (no text/buttons) -->
<section class="w-full relative overflow-hidden bg-brand-warmcream px-3 py-3 md:px-6 md:py-5" aria-label="Hero Banner">
    <div class="home-hero-frame relative mx-auto max-w-[1480px] overflow-hidden rounded-3xl border border-white/90 shadow-2xl" id="heroSlider">
        
        <div id="heroSlidesContainer" class="relative h-full w-full">
            @if (heroSlaytlar.Any())
            {
                for (var i = 0; i < heroSlaytlar.Count; i++)
                {
                    var slayt = heroSlaytlar[i];
                    var isVideo = string.Equals(slayt.Tur, "Video", StringComparison.OrdinalIgnoreCase);
                    var mediaUrl = isVideo ? slayt.VideoUrl : slayt.ResimUrl;
                    var slideClass = i == 0 ? "is-active" : "";

                    <div class="home-hero-slide @slideClass" data-slide-index="@i">
                        @if (isVideo)
                        {
                            <video class="home-hero-image relative z-10 h-full w-full" autoplay muted loop playsinline preload="metadata">
                                <source src="@mediaUrl" />
                            </video>
                        }
                        else
                        {
                            <img src="@mediaUrl" alt="" class="home-hero-blur" aria-hidden="true" />
                            <div class="home-hero-vignette pointer-events-none" aria-hidden="true"></div>
                            <img src="@mediaUrl" alt="@(string.IsNullOrWhiteSpace(slayt.LocalizedBaslik) ? brandName + " Banner" : slayt.LocalizedBaslik)" class="home-hero-image relative z-10 h-full w-full" loading="@(i == 0 ? "eager" : "lazy")" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="home-hero-slide is-active" data-slide-index="0">
                    <img src="@siteSettings.HeroGorselUrl" alt="" class="home-hero-blur" aria-hidden="true" />
                    <div class="home-hero-vignette pointer-events-none" aria-hidden="true"></div>
                    <img src="@siteSettings.HeroGorselUrl" alt="@brandName Banner" class="home-hero-image relative z-10 h-full w-full" loading="eager" onerror="this.src='/placeholder.svg';this.onerror=null;" />
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(heroTitle) || !string.IsNullOrWhiteSpace(heroSubtitle))
        {
            <div class="home-hero-copy" dir="auto">
                @if (!string.IsNullOrWhiteSpace(heroTitle))
                {
                    <h1 class="font-serif text-3xl font-semibold leading-tight md:text-5xl">@heroTitle</h1>
                }
                @if (!string.IsNullOrWhiteSpace(heroSubtitle))
                {
                    <p class="mt-3 max-w-xl text-sm font-medium md:text-lg">@heroSubtitle</p>
                }
            </div>
        }

        @if (heroSlideCount > 1)
        {
            <button type="button" class="hero-nav-btn hero-nav-prev" aria-label="Previous Slide" onclick="moveSlide(-1)">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            </button>
            <button type="button" class="hero-nav-btn hero-nav-next" aria-label="Next Slide" onclick="moveSlide(1)">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
            </button>

            <div class="hero-dots">
                @for (var i = 0; i < heroSlideCount; i++)
                {
                    <button type="button" class="hero-dot @(i == 0 ? "is-active" : "")" aria-label="Go to slide @(i + 1)" onclick="goToSlide(@i)"></button>
                }
            </div>
        }

        <div class="pointer-events-none absolute inset-0 z-[5] bg-[linear-gradient(90deg,rgba(255,255,255,0.14),rgba(255,255,255,0)_45%,rgba(215,193,118,0.10))]"></div>
        <div class="pointer-events-none absolute inset-x-6 bottom-4 h-px bg-gradient-to-r from-transparent via-brand-gold/45 to-transparent z-[5]"></div>
    </div>
</section>

<script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.home-hero-slide');
    const dots = document.querySelectorAll('.hero-dot');
    const totalSlides = slides.length;
    let slideInterval;

    function updateSlider() {
        slides.forEach((slide, index) => {
            if (index === currentSlide) {
                slide.classList.add('is-active');
            } else {
                slide.classList.remove('is-active');
            }
        });

        dots.forEach((dot, index) => {
            if (index === currentSlide) {
                dot.classList.add('is-active');
            } else {
                dot.classList.remove('is-active');
            }
        });
    }

    function moveSlide(direction) {
        currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
        updateSlider();
        resetInterval();
    }

    function goToSlide(index) {
        currentSlide = index;
        updateSlider();
        resetInterval();
    }

    function startInterval() {
        if (totalSlides > 1) {
            slideInterval = setInterval(() => moveSlide(1), 5000);
        }
    }

    function resetInterval() {
        clearInterval(slideInterval);
        startInterval();
    }

    if (totalSlides > 1) {
        startInterval();
    }
</script>
<!-- END: Hero Banner -->

