@* Dynamic Homepage Sections *@
@if (Model.Sections != null && Model.Sections.Any())
{
    foreach (var homeSection in Model.Sections)
    {
        // -------------------------------------------------------------
        // 1. MANUEL ÜRÜN BLOĞU
        // -------------------------------------------------------------
        if (homeSection.SectionType == HomePageSectionType.ProductBlock)
        {
            var sectionProducts = (homeSection.SectionProducts?
                .OrderBy(sp => sp.SortOrder)
                .Select(sp => sp.Urun)
                .Where(u => u != null && u.AktifMi && !u.SilindiMi)
                .ToList()) ?? new List<Urun>();

            if (sectionProducts.Any())
            {
                <section class="bg-brand-cream py-14 md:py-16" data-motion-section>
                    <div class="container mx-auto px-4">
                        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                            <div>
                                @if (!string.IsNullOrWhiteSpace(homeSection.Title))
                                {
                                    <h2 class="font-serif text-3xl text-brand-olive">@(homeSection.Title)</h2>
                                }
                                @if (!string.IsNullOrWhiteSpace(homeSection.Subtitle))
                                {
                                    <p class="mt-2 max-w-2xl text-sm text-brand-mutedtext">@(homeSection.Subtitle)</p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(homeSection.ViewAllUrl))
                            {
                                <a href="@(homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold md:self-auto">
                                    @(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? Localizer["ViewAll"] : homeSection.ViewAllText)
                                    <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </a>
                            }
                        </div>
                        <div class="grid grid-cols-2 gap-5 md:grid-cols-4 lg:grid-cols-5" data-motion-stagger>
                            @foreach (var urun in sectionProducts.Take(15))
                            {
                                var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                                    ? urun.AnaGorselUrl
                                    : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;

                                <article class="group bg-white rounded-2xl border border-brand-border shadow-sm hover:shadow-soft hover:-translate-y-1 transition-all duration-300 p-3" data-motion-item>
                                    <a href="@BuildProductUrl(urun)" class="block">
                                        <div class="relative mb-3 aspect-square overflow-hidden bg-brand-cream rounded-xl flex items-center justify-center p-2">
                                            @if (!string.IsNullOrWhiteSpace(gorsel))
                                            {
                                                <img src="@gorsel" alt="@urun.LocalizedBaslik" class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full w-full items-center justify-center bg-brand-cream">
                                                    <img src="/img/products/placeholder.webp" alt="Placeholder" class="w-1/2 opacity-20 grayscale" loading="lazy" decoding="async" />
                                                </div>
                                            }
                                        </div>
                                        <h3 class="mb-1 line-clamp-2 text-xs font-semibold tracking-wide text-brand-darktext transition-colors group-hover:text-brand-gold">@urun.LocalizedBaslik</h3>
                                        <p class="text-xs text-brand-mutedtext">@urun.EtkinFiyat.ToString("N0") @currencySymbol</p>
                                    </a>
                                </article>
                            }
                        </div>
                    </div>
                </section>
            }
        }
        // -------------------------------------------------------------
        // 2. ÖZEL BANNER
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.CustomBanner && !string.IsNullOrWhiteSpace(homeSection.ImageUrl))
        {
            <section class="py-8" data-motion-section>
                <div class="container mx-auto px-4">
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ButtonUrl) ? "#" : homeSection.ButtonUrl)" class="block relative group overflow-hidden">
                        <img src="@(homeSection.ImageUrl)" alt="@(homeSection.Title)" class="w-full h-auto transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                        @if (!string.IsNullOrWhiteSpace(homeSection.Title) || !string.IsNullOrWhiteSpace(homeSection.Subtitle))
                        {
                            <div class="absolute inset-0 bg-black/30 flex flex-col justify-center items-center text-center p-4">
                                <h3 class="text-white font-serif text-3xl md:text-5xl mb-2 drop-shadow-md">@homeSection.Title</h3>
                                <p class="text-white/90 text-sm md:text-base drop-shadow-md">@homeSection.Subtitle</p>
                            </div>
                        }
                    </a>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 3. AUTO: 5 PARÇALI KOLEKSİYON
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoBesParcali && Model.BesParcaliKoleksiyon != null && Model.BesParcaliKoleksiyon.Any())
        {
            <section class="bg-brand-cream py-14 md:py-16">
                <div class="container mx-auto px-4">
                    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                        <div>
                            <h2 class="font-serif text-3xl text-brand-olive">@(string.IsNullOrWhiteSpace(homeSection.Title) ? Localizer["FeaturedProducts"] : homeSection.Title)</h2>
                            <p class="mt-2 max-w-2xl text-sm text-brand-mutedtext">@(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? Localizer["FeaturedProductsSubtitle"] : homeSection.Subtitle)</p>
                        </div>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?s=5%20Par%C3%A7a" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold md:self-auto">
                            @(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? Localizer["ViewAll5Piece"] : homeSection.ViewAllText)
                            <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-5 md:grid-cols-4 lg:grid-cols-5">
                        @foreach (var urun in Model.BesParcaliKoleksiyon.Take(15))
                        {
                            var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                                ? urun.AnaGorselUrl
                                : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;

                            <article class="group bg-white rounded-2xl border border-brand-border shadow-sm hover:shadow-soft hover:-translate-y-1 transition-all duration-300 p-3">
                                <a href="@BuildProductUrl(urun)" class="block">
                                    <div class="relative mb-3 aspect-square overflow-hidden bg-brand-cream rounded-xl flex items-center justify-center p-2">
                                        <span class="absolute left-2 top-2 z-10 bg-white/90 px-2 py-1 text-[9px] uppercase tracking-widest text-brand-olive shadow-sm">@Localizer["5Piece"]</span>
                                        @if (!string.IsNullOrWhiteSpace(gorsel))
                                        {
                                            <img src="@gorsel" alt="@urun.LocalizedBaslik" class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="flex h-full w-full items-center justify-center bg-brand-cream">
                                                <img src="/img/products/placeholder.webp" alt="Placeholder" class="w-1/2 opacity-20 grayscale" loading="lazy" decoding="async" />
                                            </div>
                                        }
                                    </div>
                                    <h3 class="mb-1 line-clamp-2 text-xs font-semibold tracking-wide text-brand-darktext transition-colors group-hover:text-brand-gold">@urun.LocalizedBaslik</h3>
                                    <p class="text-xs text-brand-mutedtext">@urun.EtkinFiyat.ToString("N0") @currencySymbol</p>
                                </a>
                            </article>
                        }
                    </div>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 4. AUTO: VİTRİN / ÖNE ÇIKAN ESERLER
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoVitrin && Model.VitrinUrunleri != null && Model.VitrinUrunleri.Any())
        {
            <section class="container mx-auto px-4 py-16 md:py-20">
                <div class="mb-10 text-center">
                    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-brand-gold">@brandName</p>
                    <div class="flex items-center justify-center">
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                        <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@(string.IsNullOrWhiteSpace(homeSection.Title) ? Localizer["FeaturedProducts"] : homeSection.Title)</h2>
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(homeSection.Subtitle))
                {
                    <p class="text-center text-sm text-brand-mutedtext mb-8 -mt-4">@homeSection.Subtitle</p>
                }
                <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-5">
                    @foreach (var urun in Model.VitrinUrunleri.Take(8))
                    {
                        <div class="group flex cursor-pointer flex-col overflow-hidden rounded-2xl border border-brand-border bg-white p-2.5 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-lightgold hover:shadow-2xl md:p-3">
                            <div class="relative mb-3 flex aspect-square items-center justify-center overflow-hidden rounded-xl bg-brand-warmcream p-3">
                                <a href="@BuildProductUrl(urun)" class="block w-full h-full flex items-center justify-center">
                                @if (urun.YeniUrunMu || urun.IndirimVarMi)
                                {
                                    <span class="absolute start-2 top-2 z-10 rounded-full bg-brand-olive px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-white shadow-sm">
                                        @(urun.YeniUrunMu ? Localizer["New"] : Localizer["%Indirim", urun.IndirimYuzdesi])
                                    </span>
                                }
                                @{
                                    var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                                        ? urun.AnaGorselUrl
                                        : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;
                                }
                                @if (!string.IsNullOrWhiteSpace(gorsel))
                                {
                                <img alt="@urun.LocalizedBaslik" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500" src="@gorsel" loading="lazy" decoding="async"/>
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center bg-brand-cream">
                                        <svg class="w-8 h-8 text-brand-lightgold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"/></svg>
                                    </div>
                                }
                                </a>
                                <button type="button" onclick="window.toggleFavori(this, @urun.Id)" class="group/btn absolute end-2 top-2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/95 shadow-md transition-all duration-200 hover:scale-110 active:scale-90" title="@Localizer["AddToFavorites"]">
                                    <svg class="w-3.5 h-3.5 text-brand-mutedtext group-hover/btn:text-red-400 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                                </button>
                            </div>
                            <div class="px-1 pb-1">
                            <h3 class="mb-2 line-clamp-2 min-h-[2.4em] text-xs font-semibold leading-relaxed tracking-tight text-brand-darktext md:text-[13px]">
                                <a href="@BuildProductUrl(urun)" class="hover:text-brand-gold transition-colors">@urun.LocalizedBaslik</a>
                            </h3>
                            <div class="mt-auto flex flex-wrap items-center justify-between gap-x-1.5 gap-y-1 border-t border-brand-border/70 pt-2">
                                <p class="text-sm font-bold text-brand-olive">@urun.EtkinFiyat.ToString("N0") @currencySymbol</p>
                                @if (urun.IndirimVarMi)
                                {
                                    <p class="text-[10px] text-brand-mutedtext line-through">@urun.Fiyat.ToString("N0") @currencySymbol</p>
                                    <span class="text-[9px] text-white bg-brand-gold px-1 py-0.5 rounded font-bold">-%@urun.IndirimYuzdesi</span>
                                }
                            </div>
                            <button type="button" class="js-quick-add-btn mt-2 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-olive px-3 py-2 text-[10px] font-bold uppercase tracking-widest text-white transition-colors hover:bg-[#1c2001] disabled:cursor-wait" data-urun-id="@urun.Id" aria-label="@Localizer["AddToCart"]">
                                <i class="js-quick-add-icon fas fa-shopping-bag text-[10px]"></i>
                                <span class="js-quick-add-label">@Localizer["AddToCart"]</span>
                            </button>
                            </div>
                            @if (urun.KampanyaBitisTarihi.HasValue && urun.KampanyaBitisTarihi.Value > DateTime.UtcNow)
                            {
                                @await Html.PartialAsync("_CountdownPartial", urun.KampanyaBitisTarihi.Value)
                            }
                        </div>
                    }
                </div>
                <div class="mt-12 text-center">
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun" : homeSection.ViewAllUrl)" class="inline-flex items-center justify-center rounded-full border border-brand-olive bg-brand-olive px-8 py-3 text-xs uppercase tracking-widest text-white shadow-sm transition-colors hover:bg-[#22250b] hover:shadow-soft">
                        @(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? Localizer["ViewAll"] : homeSection.ViewAllText)
                    </a>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 5. AUTO: ÇOK SATANLAR
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoCokSatanlar && Model.CokSatanlar != null && Model.CokSatanlar.Any())
        {
            <section class="container mx-auto px-4 pb-16">
                <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                    <div>
                        <p class="mb-2 text-xs uppercase tracking-[0.25em] text-brand-gold">@(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? Localizer["BestSellers"] : homeSection.Subtitle)</p>
                        <h2 class="font-serif text-3xl text-brand-olive">@(string.IsNullOrWhiteSpace(homeSection.Title) ? Localizer["MostPreferred"] : homeSection.Title)</h2>
                    </div>
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?sort=popularity" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold md:self-auto">
                        @(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? Localizer["ViewAll"] : homeSection.ViewAllText)
                        <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>
                <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
                    @foreach (var urun in Model.CokSatanlar.Take(8))
                    {
                        var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                            ? urun.AnaGorselUrl
                            : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;

                        <article class="group overflow-hidden rounded-2xl border border-brand-border bg-white p-3 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-lightgold hover:shadow-2xl">
                            <a href="@BuildProductUrl(urun)" class="block">
                                <div class="relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden rounded-xl bg-brand-warmcream p-3">
                                    <span class="absolute start-3 top-3 z-10 rounded-full bg-white/95 px-2.5 py-1 text-[10px] uppercase tracking-widest text-brand-olive shadow-sm">@Localizer["Bestseller"]</span>
                                    @if (urun.IndirimVarMi)
                                    {
                                        <span class="absolute right-3 top-3 z-10 bg-brand-gold text-white text-[10px] font-bold px-2 py-0.5 rounded-sm shadow-sm">%@urun.IndirimYuzdesi</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(gorsel))
                                    {
                                        <img src="@gorsel" alt="@urun.LocalizedBaslik" class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center bg-brand-cream">
                                            <img src="/img/products/placeholder.webp" alt="Placeholder" class="w-1/2 opacity-20 grayscale" loading="lazy" decoding="async" />
                                        </div>
                                    }
                                </div>
                                <h3 class="mb-2 line-clamp-2 min-h-[2.6em] text-sm font-semibold leading-relaxed tracking-wide text-brand-darktext transition-colors group-hover:text-brand-gold">@urun.LocalizedBaslik</h3>
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-brand-border/70 pt-2">
                                    <p class="text-sm font-bold text-brand-olive">@urun.EtkinFiyat.ToString("N0") @currencySymbol</p>
                                    @if (urun.IndirimVarMi)
                                    {
                                        <p class="text-[10px] text-brand-mutedtext line-through">@urun.Fiyat.ToString("N0") @currencySymbol</p>
                                        <span class="text-[9px] text-white bg-brand-gold px-1 py-0.5 rounded font-bold">-%@urun.IndirimYuzdesi</span>
                                    }
                                </div>
                            </a>
                        </article>
                    }
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 6. AUTO: FIRSAT ÜRÜNLERİ
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoFirsatUrunleri && Model.FirsatUrunleri != null && Model.FirsatUrunleri.Any())
        {
            <section class="bg-brand-warmcream py-16">
                <div class="container mx-auto px-4">
                    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="mb-2 text-xs uppercase tracking-[0.25em] text-brand-gold">@(string.IsNullOrWhiteSpace(homeSection.Subtitle) ? Localizer["DealProducts"] : homeSection.Subtitle)</p>
                            <h2 class="font-serif text-3xl text-brand-olive">@(string.IsNullOrWhiteSpace(homeSection.Title) ? Localizer["CampaignSelections"] : homeSection.Title)</h2>
                        </div>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/Urun?sort=price_asc" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 self-start border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold md:self-auto">
                            @(string.IsNullOrWhiteSpace(homeSection.ViewAllText) ? Localizer["ViewDeals"] : homeSection.ViewAllText)
                            <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
                    @foreach (var urun in Model.FirsatUrunleri.Take(8))
                    {
                        var gorsel = !string.IsNullOrWhiteSpace(urun.AnaGorselUrl)
                            ? urun.AnaGorselUrl
                            : urun.UrunResimleri?.OrderBy(r => r.Sira).FirstOrDefault()?.ResimYolu;

                            <article class="group overflow-hidden rounded-2xl border border-brand-border bg-white p-3 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-lightgold hover:shadow-2xl">
                                <a href="@BuildProductUrl(urun)" class="block">
                                    <div class="relative mb-4 flex aspect-[4/5] items-center justify-center overflow-hidden rounded-xl bg-brand-warmcream p-3">
                                        <span class="absolute start-3 top-3 z-10 rounded-full bg-brand-gold px-2.5 py-1 text-[10px] uppercase tracking-widest text-white shadow-sm">-%@urun.IndirimYuzdesi</span>
                                        @if (!string.IsNullOrWhiteSpace(gorsel))
                                        {
                                        <img src="@gorsel" alt="@urun.LocalizedBaslik" class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="flex h-full w-full items-center justify-center bg-brand-cream">
                                                <img src="/img/products/placeholder.webp" alt="Placeholder" class="w-1/2 opacity-20 grayscale" loading="lazy" decoding="async" />
                                            </div>
                                        }
                                    </div>
                                    <h3 class="mb-2 line-clamp-2 min-h-[2.6em] text-sm font-semibold leading-relaxed tracking-wide text-brand-darktext transition-colors group-hover:text-brand-gold">@urun.LocalizedBaslik</h3>
                                    <div class="flex flex-wrap items-center gap-2 border-t border-brand-border/70 pt-2">
                                        <p class="text-sm font-bold text-brand-olive">@urun.EtkinFiyat.ToString("N0") @currencySymbol</p>
                                        @if (urun.IndirimVarMi)
                                        {
                                            <p class="text-[10px] text-brand-mutedtext line-through">@urun.Fiyat.ToString("N0") @currencySymbol</p>
                                            <span class="text-[9px] text-white bg-brand-gold px-1 py-0.5 rounded font-bold">-%@urun.IndirimYuzdesi</span>
                                        }
                                    </div>
                                    @if (urun.KampanyaBitisTarihi.HasValue && urun.KampanyaBitisTarihi.Value > DateTime.UtcNow)
                                    {
                                        @await Html.PartialAsync("_CountdownPartial", urun.KampanyaBitisTarihi.Value)
                                    }
                                </a>
                            </article>
                    }
                    </div>
                </div>
            </section>
        }
    }
}

