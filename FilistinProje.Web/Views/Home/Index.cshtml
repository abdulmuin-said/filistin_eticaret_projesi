@* ─── Categories ─── *@
@if (Model.Kategoriler != null && Model.Kategoriler.Any())
{
    <section class="home-cat-wrapper py-10 md:py-16" aria-labelledby="homeCategoriesTitle">
        <div class="container mx-auto px-4">
            <div class="mb-10 text-center flex flex-col items-center">
                <div class="flex items-center justify-center w-full mb-4">
                    <hr class="hidden w-1/4 border-brand-border md:block"/>
                    <h2 id="homeCategoriesTitle" class="font-serif mx-6 text-2xl text-brand-olive md:text-3xl">@Localizer["Home_CategoriesTitle"]</h2>
                    <hr class="hidden w-1/4 border-brand-border md:block"/>
                </div>
                <a href="/products" class="inline-flex items-center gap-2 border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                    @Localizer["Home_AllCategories"]
                    <svg class="h-3.5 w-3.5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
                </a>
            </div>

            <div class="home-cat-grid" data-motion-stagger>
                @for (var categoryIndex = 0; categoryIndex < Model.Kategoriler.Count; categoryIndex++)
                {
                    var kategori = Model.Kategoriler[categoryIndex];
                    var kategoriGorseli = Model.KategoriGorselleri.GetValueOrDefault(kategori.Id) ?? string.Empty;

                    <a href="/products?k=@kategori.Id"
                       class="home-cat-item group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-4 focus-visible:ring-offset-brand-cream"
                       aria-label="@kategori.LocalizedAd"
                       data-motion-item>
                        
                        <div class="home-cat-img-box">
                            @if (!string.IsNullOrWhiteSpace(kategoriGorseli))
                            {
                                <img src="@kategoriGorseli"
                                     alt="@kategori.LocalizedAd"
                                     class="home-cat-img"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.src='/placeholder.svg'; this.onerror=null; this.classList.add('opacity-80', 'mix-blend-multiply');" />
                            }
                            else
                            {
                                <div class="home-cat-fallback" aria-hidden="true">
                                    <img src="/placeholder.svg" alt="@kategori.LocalizedAd" class="home-cat-img opacity-80 mix-blend-multiply" />
                                </div>
                            }
                        </div>

                        <div class="home-cat-content">
                            <h3 class="font-serif line-clamp-1 text-sm font-semibold leading-tight text-brand-primary md:text-base">@kategori.LocalizedAd</h3>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}
@* ─── /Categories ─── *@

@* Dynamic Homepage Sections *@
@if (Model.Sections != null && Model.Sections.Any())
{
    foreach (var homeSection in Model.Sections)
    {
        var sectionTitle = homeSection.LocalizedTitle;
        var sectionSubtitle = homeSection.LocalizedSubtitle;
        var sectionViewAllText = homeSection.LocalizedViewAllText;
        var sectionDescription = homeSection.LocalizedDescription;
        var sectionButtonText = homeSection.LocalizedButtonText;
        // -------------------------------------------------------------
        // 1. MANUEL ÜRÜN BLOĞU
        // -------------------------------------------------------------
        if (homeSection.SectionType == HomePageSectionType.ProductBlock)
        {
            var sectionProducts = (homeSection.SectionProducts?
                .OrderBy(sp => sp.SortOrder)
                .Select(sp => sp.Urun)
                .Where(u => u != null && u.AktifMi && !u.SilindiMi)
                .ToList()) ?? new List<Urun>();

            if (sectionProducts.Any())
            {
                <section class="bg-brand-cream py-14 md:py-16" data-motion-section>
                    <div class="container mx-auto px-4">
                        <div class="mb-10 text-center flex flex-col items-center">
                            @if (!string.IsNullOrWhiteSpace(sectionTitle))
                            {
                                <div class="flex items-center justify-center w-full mb-3">
                                    <hr class="hidden w-1/4 border-brand-border md:block"/>
                                    <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@sectionTitle</h2>
                                    <hr class="hidden w-1/4 border-brand-border md:block"/>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(sectionSubtitle))
                            {
                                <p class="text-sm text-brand-mutedtext mb-4">@sectionSubtitle</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(homeSection.ViewAllUrl))
                            {
                                <a href="@(homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                                    @(string.IsNullOrWhiteSpace(sectionViewAllText) ? Localizer["ViewAll"] : sectionViewAllText)
                                    <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </a>
                            }
                        </div>
                        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 xl:gap-4" data-motion-stagger>
                            @foreach (var urun in sectionProducts.Take(15))
                            {
                                @await Html.PartialAsync("_HomeProductCard", BuildHomeProductCard(urun))
                            }
                        </div>
                    </div>
                </section>
            }
        }
        // -------------------------------------------------------------
        // 2. ÖZEL BANNER
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.CustomBanner && !string.IsNullOrWhiteSpace(homeSection.ImageUrl))
        {
            <section class="py-8" data-motion-section>
                <div class="container mx-auto px-4">
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ButtonUrl) ? "#" : homeSection.ButtonUrl)" class="block relative group overflow-hidden">
                        <img src="@(homeSection.ImageUrl)" alt="@sectionTitle" class="w-full h-auto transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                        @if (!string.IsNullOrWhiteSpace(sectionTitle) || !string.IsNullOrWhiteSpace(sectionSubtitle))
                        {
                            <div class="absolute inset-0 bg-black/30 flex flex-col justify-center items-center text-center p-4">
                                <h3 class="text-white font-serif text-3xl md:text-5xl mb-2 drop-shadow-md">@sectionTitle</h3>
                                <p class="text-white/90 text-sm md:text-base drop-shadow-md">@sectionSubtitle</p>
                                @if (!string.IsNullOrWhiteSpace(sectionDescription))
                                {
                                    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/85 drop-shadow-md">@sectionDescription</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(sectionButtonText))
                                {
                                    <span class="mt-5 inline-flex rounded-full bg-white px-5 py-2 text-xs font-bold uppercase tracking-widest text-brand-olive shadow-lg">@sectionButtonText</span>
                                }
                            </div>
                        }
                    </a>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 3. AUTO: 5 PARÇALI KOLEKSİYON
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoBesParcali && Model.BesParcaliKoleksiyon != null && Model.BesParcaliKoleksiyon.Any())
        {
            <section class="bg-brand-cream py-14 md:py-16">
                <div class="container mx-auto px-4">
                    <div class="mb-10 text-center flex flex-col items-center">
                        <div class="flex items-center justify-center w-full mb-3">
                            <hr class="hidden w-1/4 border-brand-border md:block"/>
                            <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@(string.IsNullOrWhiteSpace(sectionTitle) ? Localizer["FeaturedProducts"] : sectionTitle)</h2>
                            <hr class="hidden w-1/4 border-brand-border md:block"/>
                        </div>
                        <p class="text-sm text-brand-mutedtext mb-4">@(string.IsNullOrWhiteSpace(sectionSubtitle) ? Localizer["FeaturedProductsSubtitle"] : sectionSubtitle)</p>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/products" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                            @(string.IsNullOrWhiteSpace(sectionViewAllText) ? Localizer["ViewAll5Piece"] : sectionViewAllText)
                            <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 xl:gap-4" data-motion-stagger>
                        @foreach (var urun in Model.BesParcaliKoleksiyon.Take(15))
                        {
                            @await Html.PartialAsync("_HomeProductCard", BuildHomeProductCard(urun, Localizer["5Piece"].Value))
                        }
                    </div>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 4. AUTO: VİTRİN / ÖNE ÇIKAN ESERLER
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoVitrin && Model.VitrinUrunleri != null && Model.VitrinUrunleri.Any())
        {
            <section class="container mx-auto px-4 py-16 md:py-20">
                <div class="mb-10 text-center">

                    <div class="flex items-center justify-center">
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                        <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@(string.IsNullOrWhiteSpace(sectionTitle) ? Localizer["FeaturedProducts"] : sectionTitle)</h2>
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(sectionSubtitle))
                {
                    <p class="text-center text-sm text-brand-mutedtext mb-8 -mt-4">@sectionSubtitle</p>
                }
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 xl:gap-4" data-motion-stagger>
                    @foreach (var urun in Model.VitrinUrunleri.Take(8))
                    {
                        @await Html.PartialAsync("_HomeProductCard", BuildHomeProductCard(urun))
                    }
                </div>
                <div class="mt-12 text-center">
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/products" : homeSection.ViewAllUrl)" class="inline-flex items-center justify-center rounded-full border border-brand-olive bg-brand-olive px-8 py-3 text-xs uppercase tracking-widest text-white shadow-sm transition-all hover:brightness-90 hover:shadow-soft">
                         @(string.IsNullOrWhiteSpace(sectionViewAllText) ? Localizer["ViewAll"] : sectionViewAllText)
                    </a>
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 5. AUTO: ÇOK SATANLAR
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoCokSatanlar && Model.CokSatanlar != null && Model.CokSatanlar.Any())
        {
            <section class="container mx-auto px-4 pb-16">
                <div class="mb-10 text-center flex flex-col items-center">
                    <p class="mb-3 text-xs uppercase tracking-[0.25em] text-brand-gold">@(string.IsNullOrWhiteSpace(sectionSubtitle) ? Localizer["BestSellers"] : sectionSubtitle)</p>
                    <div class="flex items-center justify-center w-full mb-4">
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                        <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@(string.IsNullOrWhiteSpace(sectionTitle) ? Localizer["MostPreferred"] : sectionTitle)</h2>
                        <hr class="hidden w-1/4 border-brand-border md:block"/>
                    </div>
                    <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/products?sort=popularity" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                        @(string.IsNullOrWhiteSpace(sectionViewAllText) ? Localizer["ViewAll"] : sectionViewAllText)
                        <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                </div>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 xl:gap-4" data-motion-stagger>
                    @foreach (var urun in Model.CokSatanlar.Take(8))
                    {
                        @await Html.PartialAsync("_HomeProductCard", BuildHomeProductCard(urun, Localizer["Bestseller"].Value))
                    }
                </div>
            </section>
        }
        // -------------------------------------------------------------
        // 6. AUTO: FIRSAT ÜRÜNLERİ
        // -------------------------------------------------------------
        else if (homeSection.SectionType == HomePageSectionType.AutoFirsatUrunleri && Model.FirsatUrunleri != null && Model.FirsatUrunleri.Any())
        {
            <section class="bg-brand-warmcream py-16">
                <div class="container mx-auto px-4">
                    <div class="mb-10 text-center flex flex-col items-center">
                        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-brand-gold">@(string.IsNullOrWhiteSpace(sectionSubtitle) ? Localizer["DealProducts"] : sectionSubtitle)</p>
                        <div class="flex items-center justify-center w-full mb-4">
                            <hr class="hidden w-1/4 border-brand-border md:block"/>
                            <h2 class="font-serif mx-6 text-3xl text-brand-olive md:text-4xl">@(string.IsNullOrWhiteSpace(sectionTitle) ? Localizer["CampaignSelections"] : sectionTitle)</h2>
                            <hr class="hidden w-1/4 border-brand-border md:block"/>
                        </div>
                        <a href="@(string.IsNullOrWhiteSpace(homeSection.ViewAllUrl) ? "/products?sort=price_asc" : homeSection.ViewAllUrl)" class="inline-flex items-center gap-2 border-b border-brand-olive pb-1 text-xs uppercase tracking-widest text-brand-olive transition-colors hover:text-brand-gold">
                            @(string.IsNullOrWhiteSpace(sectionViewAllText) ? Localizer["ViewDeals"] : sectionViewAllText)
                            <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8.25 4.5l7.5 7.5-7.5 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5 xl:gap-4" data-motion-stagger>
                    @foreach (var urun in Model.FirsatUrunleri.Take(8))
                    {
                        @await Html.PartialAsync("_HomeProductCard", BuildHomeProductCard(urun))
                    }
                    </div>
                </div>
            </section>
        }
    }
}

<!-- BEGIN: Features -->
<section class="bg-brand-warmcream py-10 md:py-16">
