@model FilistinProje.Web.Models.ProductCardViewModel
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer

@{
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;
    var satisaAcik = siteSettings.StoktaYokSatisIzni || Model.StoktaVarMi;

    var urlSlug = !string.IsNullOrWhiteSpace(Model.Slug)
        ? Model.Slug
        : FilistinProje.Core.Helpers.SlugHelper.GenerateSlug(Model.Baslik);
    if (string.IsNullOrWhiteSpace(urlSlug))
    {
        urlSlug = "urun";
    }

    var urunUrl = $"/products/{urlSlug}-{Model.Id}";

    // Etiketleri oluştur (ViewModel'in instance method'u)
    var badges = Model.ToBadges(siteSettings.StoktaYokSatisIzni);

    var gosterFiyat = Model.EtkinFiyat;
    decimal? eskiFiyat = Model.IndirimVarMi ? Model.Fiyat : null;

    var kampanyaAktif = Model.KampanyaBitisTarihi.HasValue &&
        Model.KampanyaBitisTarihi.Value > DateTime.UtcNow;
}

<article class="home-product-card group flex h-full flex-col overflow-hidden rounded-2xl border border-brand-border bg-white p-2.5 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-lightgold hover:shadow-2xl md:p-3" data-motion-item>
    <div class="relative mb-3 flex aspect-square items-center justify-center overflow-hidden rounded-xl bg-brand-warmcream p-3">
        <a href="@urunUrl" class="flex h-full w-full items-center justify-center" tabindex="-1" aria-hidden="true">
            @if (!string.IsNullOrWhiteSpace(Model.GorselUrl))
            {
                <img src="@Model.GorselUrl"
                     alt="@Model.Baslik"
                     width="800"
                     height="800"
                     class="max-h-full max-w-full object-contain transition-transform duration-500 group-hover:scale-105"
                     loading="lazy"
                     decoding="async"
                     onerror="if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';this.src='/img/products/placeholder.webp';}" />
            }
            else
            {
                <img src="/img/products/placeholder.webp"
                     alt=""
                     class="w-1/2 opacity-20 grayscale"
                     loading="lazy"
                     decoding="async" />
            }
        </a>

        @await Html.PartialAsync("_ProductBadges", badges)

        @if (Model.ShowFavori)
        {
            <button type="button"
                    onclick="window.toggleFavori(this, @Model.Id)"
                    class="group/favoriteste absolute end-2 top-2 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/95 shadow-md transition-all duration-200 hover:scale-110 active:scale-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold"
                    aria-label="@Localizer["AddToFavorites"]"
                    title="@Localizer["AddToFavorites"]">
                <svg class="h-3.5 w-3.5 text-brand-mutedtext transition-colors group-hover/favoriteste:text-red-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
            </button>
        }
    </div>

    <div class="flex flex-1 flex-col px-1 pb-1">
        <h3 class="mb-2.5 line-clamp-2 min-h-[2.6em] text-sm font-semibold leading-relaxed tracking-tight text-brand-darktext md:text-[15px]">
            <a href="@urunUrl" class="transition-colors hover:text-brand-gold focus-visible:outline-none focus-visible:text-brand-gold">
                @Model.Baslik
            </a>
        </h3>

        <div class="mt-auto border-t border-brand-border/70 pt-3">
            @if (!Model.FiyatGizliMi)
            {
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    <p class="text-[17px] font-bold text-brand-olive md:text-[18px]">@gosterFiyat.ToString("N0") @currencySymbol</p>
                    @if (eskiFiyat.HasValue)
                    {
                        <p class="text-[11px] text-brand-mutedtext line-through">@eskiFiyat.Value.ToString("N0") @currencySymbol</p>
                    }
                </div>
            }
            else
            {
                <p class="text-sm italic text-brand-mutedtext">@Localizer["PriceOnRequest"]</p>
            }

            @if (Model.WhatsappSiparisModu)
            {
                <a href="@urunUrl"
                   class="mt-3 flex w-full items-center justify-center gap-3 rounded-xl border-2 border-green-500 bg-green-50 px-4 py-2.5 text-xs font-semibold uppercase tracking-widest text-green-600 shadow-[0_0_8px_rgba(34,197,94,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:border-green-500 hover:bg-green-500 hover:text-white hover:shadow-[0_0_15px_rgba(34,197,94,0.6)]">
                    <i class="fab fa-whatsapp text-[15px]"></i>
                    <span>@Localizer["Admin_WhatsappOrder"]</span>
                </a>
            }
            else if (Model.ShowQuickAdd && satisaAcik && !Model.FiyatGizliMi)
            {
                <button type="button"
                        class="js-quick-add-btn mt-3 flex w-full items-center justify-center gap-3 rounded-xl border-2 border-brand-gold bg-brand-cream px-4 py-2.5 text-xs font-semibold uppercase tracking-widest text-brand-gold shadow-[0_0_8px_rgba(181,135,53,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-gold hover:bg-brand-gold hover:text-white hover:shadow-[0_0_15px_rgba(181,135,53,0.6)] disabled:cursor-wait"
                        data-urun-id="@Model.Id"
                        aria-label="@Localizer["AddToCart"]">
                    <i class="js-quick-add-icon fas fa-cart-plus text-[13px]"></i>
                    <span class="js-quick-add-label">@Localizer["AddToCart"]</span>
                </button>
            }
            else if (!satisaAcik)
            {
                <span class="mt-3 flex w-full items-center justify-center rounded-xl bg-brand-warmcream px-4 py-2.5 text-xs font-semibold uppercase tracking-widest text-brand-mutedtext">
                    @Localizer["OutOfStock"]
                </span>
            }
        </div>

        @if (kampanyaAktif)
        {
            @await Html.PartialAsync("_CountdownPartial", Model.KampanyaBitisTarihi!.Value)
        }
    </div>
</article>
