@functions {
    string FormatIban(string iban)
    {
        var clean = (iban ?? string.Empty).Replace(" ", "");
        return string.Join(" ", Enumerable.Range(0, (clean.Length + 3) / 4).Select(i => clean.Substring(i * 4, Math.Min(4, clean.Length - i * 4))));
    }
}
@model FilistinProje.Core.DTOs.CheckoutRequestDto
@using FilistinProje.Core.Varliklar
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currencySymbol = string.IsNullOrWhiteSpace(SiteSettingsService.GetSettings().ParaBirimi) ? "₪" : SiteSettingsService.GetSettings().ParaBirimi;
    bool codAktif = ViewBag.KapidaOdemeAktifMi is bool codAccess && codAccess;
    decimal codBedel = (decimal)(ViewBag.KapidaOdemeHizmetBedeli ?? 0);
    bool receteZorunlu = ViewBag.ReceteZorunluMu is bool rxRequired && rxRequired;
    bool bankaHavaleAktifMi = ViewBag.BankaHavaleAktifMi as bool? ?? false;
    var bankaHesaplari = ViewBag.BankaHesaplari as List<BankaHesap>;
}

<section class="checkout-card" aria-labelledby="payment-heading">
    <div class="checkout-section-heading">
        <span class="checkout-step">02</span>
        <div><h2 id="payment-heading">@Localizer["PaymentMethod"]</h2><p>@Localizer["Checkout_PaymentMethodHelp"]</p></div>
        <span class="ms-auto hidden items-center gap-2 rounded-full bg-[#f7f8ed] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-brand-olive sm:inline-flex"><i class="fas fa-lock text-brand-gold"></i>@Localizer["256BitSSL"]</span>
    </div>

    <div class="grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label="@Localizer["PaymentMethod"]">
        <label class="checkout-choice @(bankaHavaleAktifMi ? "" : "cursor-not-allowed opacity-50")">
            <input type="radio" name="odemeYontemi" value="BankaHavalesi" class="peer sr-only" checked="@(Model.OdemeYontemi == "BankaHavalesi" && bankaHavaleAktifMi)" disabled="@(!bankaHavaleAktifMi)" onchange="togglePaymentMethod('BankaHavalesi')">
            <span class="checkout-choice-icon"><i class="fas fa-building-columns"></i></span>
            <span><span class="block text-sm font-semibold text-brand-darktext">@Localizer["BankTransfer"]</span><span class="mt-1 block text-xs text-brand-mutedtext">@Localizer["BankTransferDescShort"]</span></span>
            <span class="checkout-choice-check"><i class="fas fa-check"></i></span>
        </label>
        @if (codAktif)
        {
            <label id="codPaymentOption" class="checkout-choice">
                <input type="radio" name="odemeYontemi" value="KapidaOdeme" class="peer sr-only" checked="@(Model.OdemeYontemi == "KapidaOdeme" || !bankaHavaleAktifMi)" onchange="togglePaymentMethod('KapidaOdeme')">
                <span class="checkout-choice-icon"><i class="fas fa-hand-holding-dollar"></i></span>
                <span><span class="block text-sm font-semibold text-brand-darktext">@Localizer["CashOnDelivery"]</span><span class="mt-1 block text-xs text-brand-mutedtext">@Localizer["CashOnDeliveryDescShort"] @if (codBedel > 0) { <text>(+@codBedel.ToString("N2") @currencySymbol)</text> }</span></span>
                <span class="checkout-choice-check"><i class="fas fa-check"></i></span>
            </label>
        }
    </div>
    <span asp-validation-for="OdemeYontemi" class="checkout-field-error mt-2"></span>

    @if (bankaHesaplari?.Any() == true)
    {
        <div id="bankAccountsSection" class="mt-5 space-y-3">
            @foreach (var banka in bankaHesaplari)
            {
                <div class="rounded-xl border border-brand-border bg-brand-cream/50 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div><strong class="text-sm text-brand-olive">@banka.BankaAdi</strong><span class="ms-2 text-xs text-brand-mutedtext">@banka.HesapSahibi</span></div>
                        <div class="flex items-center gap-2"><code id="iban-@banka.Id" class="rounded bg-white px-2 py-1 text-xs text-brand-darktext">@FormatIban(banka.IBAN)</code><button type="button" onclick="copyIban('iban-@banka.Id', this)" class="text-brand-gold" title="@Localizer["CopyIBAN"]"><i class="fas fa-copy"></i></button></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div id="bankAccountsSection" class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800">
            <div class="flex items-start gap-3"><i class="fas fa-circle-info mt-0.5"></i><div><strong class="block text-sm">@Localizer["BankTransferPayment"] @Localizer["TemporarilyUnavailable"]</strong><p class="mt-1 text-xs leading-relaxed">@Localizer["Siparis_NoActiveBankAccount"]</p></div></div>
        </div>
    }

    @if (receteZorunlu)
    {
        <div class="mt-7 border-t border-brand-border pt-6">
            <h3 class="font-serif text-xl text-brand-olive">@Localizer["PrescriptionVerification"]</h3>
            <p class="mb-4 mt-1 text-xs text-brand-mutedtext">@Localizer["PrescriptionPhotoDesc"]</p>
            <input type="hidden" name="ReceteDosyaYolu" id="ReceteDosyaYolu" value="@Model.ReceteDosyaYolu">
            <label for="receteFileInput" class="checkout-dropzone">
                <i class="fas fa-file-medical text-2xl text-brand-gold"></i><span class="font-semibold text-brand-darktext">@Localizer["UploadPrescription"]</span><span class="text-[11px] text-brand-mutedtext">PDF, JPEG, PNG, WebP · 5 MB</span>
                <input type="file" id="receteFileInput" accept="image/jpeg,image/png,image/webp,application/pdf" class="sr-only" onchange="handleReceteFileUpload(this)">
            </label>
            <div id="recetePreviewContainer" class="mt-4 hidden max-w-xs">
                <div class="relative rounded-xl border border-[#cbd3a3] bg-[#f7f8ed] p-2"><div id="recetePdfPlaceholder" class="hidden py-5 text-center"><i class="fas fa-file-pdf text-3xl text-red-500"></i><div id="recetePdfName" class="mt-2 text-xs font-semibold">@Localizer["PdfFile"]</div></div><img id="recetePreview" class="hidden aspect-[4/3] w-full rounded object-contain" alt="@Localizer["PrescriptionVerification"]"></div>
            </div>
            <span asp-validation-for="ReceteDosyaYolu" class="checkout-field-error"></span>
        </div>
    }
</section>
