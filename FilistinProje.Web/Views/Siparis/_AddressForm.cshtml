@model FilistinProje.Core.DTOs.CheckoutRequestDto
@using FilistinProje.Core.Varliklar
@using System.Text.Encodings.Web
@inject IStringLocalizer<SharedResource> Localizer
@{
    var kayitliAdresler = ViewBag.KayitliAdresler as List<Adres>;
    var sehirler = ViewBag.Sehirler as List<string> ?? new List<string>();
    bool girisYapmis = User.Identity?.IsAuthenticated == true;
}

<section class="checkout-card" aria-labelledby="delivery-heading">
    <div class="checkout-section-heading">
        <span class="checkout-step">01</span>
        <div>
            <h2 id="delivery-heading">@Localizer["DeliveryInformation"]</h2>
            <p>@Localizer["VerifyDeliveryInfo"]</p>
        </div>
    </div>

    @if (girisYapmis && kayitliAdresler?.Any() == true)
    {
        <div class="mb-7 grid gap-3 sm:grid-cols-2">
            @foreach (var adres in kayitliAdresler)
            {
                <button type="button" class="rounded-xl border border-brand-border bg-brand-cream/60 p-4 text-start transition hover:border-brand-gold hover:bg-white"
                        onclick="selectAddress('@Html.Raw(JavaScriptEncoder.Default.Encode(adres.AdSoyad ?? string.Empty))', '@Html.Raw(JavaScriptEncoder.Default.Encode(adres.Telefon ?? string.Empty))', '@Html.Raw(JavaScriptEncoder.Default.Encode(adres.Sehir ?? string.Empty))', '@Html.Raw(JavaScriptEncoder.Default.Encode(adres.Ilce ?? string.Empty))', '@Html.Raw(JavaScriptEncoder.Default.Encode(adres.AcikAdres ?? string.Empty))')">
                    <span class="mb-1 block text-xs font-semibold uppercase tracking-wider text-brand-olive">@adres.Baslik</span>
                    <span class="line-clamp-2 block text-xs leading-relaxed text-brand-mutedtext">@adres.AcikAdres</span>
                </button>
            }
        </div>
    }

    <div class="mb-7 grid gap-3 sm:grid-cols-2" role="radiogroup" aria-label="@Localizer["DeliveryType"]">
        <label class="checkout-choice">
            <input type="radio" asp-for="TeslimatTipi" value="AdreseTeslim" class="peer sr-only" onchange="toggleDeliveryType()">
            <span class="checkout-choice-icon"><i class="fas fa-truck-fast"></i></span>
            <span class="min-w-0">
                <span class="block text-sm font-semibold text-brand-darktext">@Localizer["DeliverToAddress"]</span>
                <span class="mt-1 block text-xs leading-relaxed text-brand-mutedtext">@Localizer["DeliverToAddressDesc"]</span>
            </span>
            <span class="checkout-choice-check"><i class="fas fa-check"></i></span>
        </label>
        <label class="checkout-choice">
            <input type="radio" asp-for="TeslimatTipi" value="MagazadanTeslim" class="peer sr-only" onchange="toggleDeliveryType()">
            <span class="checkout-choice-icon"><i class="fas fa-store"></i></span>
            <span class="min-w-0">
                <span class="block text-sm font-semibold text-brand-darktext">@Localizer["StorePickup"]</span>
                <span class="mt-1 block text-xs leading-relaxed text-brand-mutedtext">@Localizer["StorePickupDesc"]</span>
            </span>
            <span class="checkout-choice-check"><i class="fas fa-check"></i></span>
        </label>
    </div>

    <div id="storePickupInfo" class="mb-7 hidden rounded-xl border border-[#cbd3a3] bg-[#f7f8ed] p-4 text-sm text-brand-olive">
        <div class="flex items-start gap-3">
            <i class="fas fa-location-dot mt-1 text-brand-gold"></i>
            <div><strong class="block">@Localizer["StorePickupInfo"]</strong><span class="mt-1 block text-xs leading-relaxed text-brand-mutedtext">@Localizer["StorePickupAddressInfo"]</span></div>
        </div>
    </div>

    <div id="adresAlanlari" class="grid gap-x-5 gap-y-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
            <label class="checkout-label" for="MusteriAdSoyad">@Localizer["FullName"] <span aria-hidden="true">*</span></label>
            <input asp-for="MusteriAdSoyad" id="MusteriAdSoyad" class="checkout-input" placeholder="@Localizer["FullNamePlaceholder"]" autocomplete="name" required>
            <span asp-validation-for="MusteriAdSoyad" class="checkout-field-error"></span>
        </div>
        <div>
            <label class="checkout-label" for="Eposta">@Localizer["Email"] <span aria-hidden="true">*</span></label>
            @if (girisYapmis)
            {
                <input type="hidden" asp-for="Eposta">
                <input value="@Model.Eposta" id="Eposta" class="checkout-input cursor-not-allowed opacity-70" readonly>
                <p class="mt-1.5 text-[11px] text-brand-gold">@Localizer["RegisteredEmailUsed"]</p>
            }
            else
            {
                <input asp-for="Eposta" id="Eposta" type="email" class="checkout-input" placeholder="@Localizer["EmailPlaceholder"]" autocomplete="email" required>
            }
            <span asp-validation-for="Eposta" class="checkout-field-error"></span>
        </div>
        <div>
            <label class="checkout-label" for="Telefon">@Localizer["Phone"] <span aria-hidden="true">*</span></label>
            <input asp-for="Telefon" id="Telefon" type="tel" inputmode="tel" autocomplete="tel" class="checkout-input" placeholder="@Localizer["PhonePlaceholder"]" maxlength="20" required>
            <span asp-validation-for="Telefon" class="checkout-field-error"></span>
        </div>
        <div id="adresSehirAlani">
            <label class="checkout-label" for="Sehir">@Localizer["City"] <span aria-hidden="true">*</span></label>
            <select asp-for="Sehir" id="Sehir" class="checkout-input" required>
                <option value="">@Localizer["SelectCity"]</option>
                @foreach (var sehir in sehirler) { <option value="@sehir">@sehir</option> }
            </select>
            <span asp-validation-for="Sehir" class="checkout-field-error"></span>
        </div>
        <div id="adresIlceAlani">
            <label class="checkout-label" for="Ilce">@Localizer["District"] <span aria-hidden="true">*</span></label>
            <input asp-for="Ilce" id="Ilce" class="checkout-input" placeholder="@Localizer["DistrictPlaceholder"]" required>
            <span asp-validation-for="Ilce" class="checkout-field-error"></span>
        </div>
        <div id="adresAcikAdresAlani" class="sm:col-span-2">
            <label class="checkout-label" for="AcikAdres">@Localizer["FullAddress"] <span aria-hidden="true">*</span></label>
            <textarea asp-for="AcikAdres" id="AcikAdres" rows="3" class="checkout-input resize-none" placeholder="@Localizer["FullAddressPlaceholder"]" required></textarea>
            <span asp-validation-for="AcikAdres" class="checkout-field-error"></span>
        </div>

        @if (girisYapmis)
        {
            <div id="adresKaydetAlani" class="sm:col-span-2 rounded-xl border border-brand-border bg-brand-cream/60 p-4">
                <label class="flex cursor-pointer items-center gap-3 text-sm font-medium text-brand-darktext">
                    <input asp-for="AdresiKaydet" id="AdresiKaydet" class="h-4 w-4 rounded border-brand-border text-brand-olive focus:ring-brand-gold">
                    @Localizer["SaveAddressToAccount"]
                </label>
                <div id="adresBaslikWrapper" class="mt-4 hidden">
                    <label class="checkout-label" for="YeniAdresBasligi">@Localizer["AddressTitle"]</label>
                    <input asp-for="YeniAdresBasligi" id="YeniAdresBasligi" class="checkout-input" placeholder="@Localizer["AddressTitlePlaceholder"]">
                </div>
            </div>
        }
    </div>

    <div id="kargoAlanlari" class="mt-6 rounded-xl border border-brand-border bg-brand-cream/50 p-4">
        <div class="flex items-start gap-3">
            <span class="checkout-mini-icon"><i class="fas fa-route"></i></span>
            <div><strong class="text-sm text-brand-darktext">@Localizer["ShippingFee"]</strong><p class="mt-1 text-xs leading-relaxed text-brand-mutedtext">@Localizer["Checkout_ShippingCalculatedByCity"]</p></div>
        </div>
    </div>
</section>
