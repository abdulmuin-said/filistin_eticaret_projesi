@model FilistinProje.Core.DTOs.CheckoutRequestDto
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currencySymbol = string.IsNullOrWhiteSpace(SiteSettingsService.GetSettings().ParaBirimi) ? "₪" : SiteSettingsService.GetSettings().ParaBirimi;
    decimal genelToplam = ViewBag.ToplamTutar ?? 0;
    bool isWholesale = User.IsInRole("Wholesale");
    decimal toptanciMinTutar = (decimal)(ViewBag.ToptanciMinSiparisTutari ?? 500);
}

<section class="checkout-card" aria-labelledby="verification-heading">
    <div class="checkout-section-heading">
        <span class="checkout-step">03</span>
        <div><h2 id="verification-heading">@Localizer["IdentityVerification"]</h2><p>@Localizer["IdentityPhotoDesc"]</p></div>
    </div>

    <input type="hidden" name="KimlikFotoYolu" id="KimlikFotoYolu" value="@Model.KimlikFotoYolu">
    <div class="mb-4 grid grid-cols-2 gap-2 rounded-xl bg-brand-cream p-1.5">
        <button type="button" id="btnCameraMode" class="rounded-lg px-3 py-2.5 text-xs font-semibold text-brand-olive transition hover:bg-white" onclick="switchIdentityMode('camera')"><i class="fas fa-camera me-2"></i>@Localizer["CameraCapture"]</button>
        <button type="button" id="btnUploadMode" class="rounded-lg bg-brand-olive px-3 py-2.5 text-xs font-semibold text-white transition" onclick="switchIdentityMode('upload')"><i class="fas fa-upload me-2"></i>@Localizer["FileUpload"]</button>
    </div>

    <div id="identityCameraMode" class="hidden">
        <div id="identityCameraMessage" class="mb-4 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800"></div>
        <div class="relative mx-auto mb-4 max-w-md overflow-hidden rounded-xl bg-[#15180b]"><video id="identityVideo" playsinline class="aspect-[4/3] w-full object-cover"></video><canvas id="identityCanvas" class="hidden"></canvas><div id="identityCameraPlaceholder" class="absolute inset-0 flex items-center justify-center text-white"><div class="text-center"><i class="fas fa-camera mb-3 text-3xl text-brand-gold"></i><p class="text-xs">@Localizer["CameraCapture"]</p></div></div></div>
        <div class="flex flex-wrap justify-center gap-2"><button type="button" id="btnStartCamera" class="checkout-secondary-button" onclick="startIdentityCamera()"><i class="fas fa-play me-2"></i>@Localizer["CameraCapture"]</button><button type="button" id="btnCapturePhoto" class="checkout-secondary-button hidden" onclick="captureIdentityPhoto()"><i class="fas fa-camera me-2"></i>@Localizer["CapturePhoto"]</button><button type="button" id="btnRetakePhoto" class="checkout-secondary-button hidden" onclick="retakeIdentityPhoto()"><i class="fas fa-rotate me-2"></i>@Localizer["RetakePhoto"]</button></div>
    </div>

    <div id="identityUploadMode">
        <label for="identityFileInput" class="checkout-dropzone">
            <i class="fas fa-id-card text-2xl text-brand-gold"></i><span class="font-semibold text-brand-darktext">@Localizer["FileUpload"]</span><span class="text-[11px] text-brand-mutedtext">JPEG, PNG, WebP · 5 MB</span>
            <input type="file" id="identityFileInput" accept="image/jpeg,image/png,image/webp" class="sr-only" onchange="handleIdentityFileUpload(this)">
        </label>
    </div>
    <div id="identityPreviewContainer" class="mt-4 hidden max-w-xs"><div class="relative rounded-xl border border-[#cbd3a3] bg-[#f7f8ed] p-2"><img id="identityPreview" class="aspect-[4/3] w-full rounded object-contain" alt="@Localizer["IdentityVerification"]"><span class="absolute end-3 top-3 rounded-full bg-green-600 px-2 py-1 text-[10px] font-bold text-white"><i class="fas fa-check me-1"></i>@Localizer["IdentityPhotoUploaded"]</span></div></div>

    <div class="mt-7 border-t border-brand-border pt-6">
        <label class="checkout-label" for="Aciklama">@Localizer["OrderNote"]</label>
        <textarea asp-for="Aciklama" rows="3" maxlength="1000" class="checkout-input resize-none" placeholder="@Localizer["OrderNotePlaceholder"]"></textarea>
        <p class="mt-1 text-[10px] text-brand-mutedtext">@string.Format(Localizer["MaxChars"].Value, 1000)</p>
    </div>

    <div class="mt-5 rounded-xl border border-brand-border bg-brand-cream/60 p-4">
        <label class="flex cursor-pointer items-start gap-3">
            <input asp-for="SozlesmeOnaylandi" class="mt-0.5 h-4 w-4 shrink-0 rounded border-brand-border text-brand-olive focus:ring-brand-gold">
            <span class="text-xs leading-relaxed text-brand-mutedtext"><a href="/pages/Gizlilik" target="_blank" class="font-semibold text-brand-olive underline underline-offset-2">@Localizer["PrivacyPolicy"]</a> @Localizer["And"] <a href="/pages/KullaniciSozlesmesi" target="_blank" class="font-semibold text-brand-olive underline underline-offset-2">@Localizer["UserAgreement"]</a> @Localizer["TermsAccepted"]</span>
        </label>
        <span asp-validation-for="SozlesmeOnaylandi" class="checkout-field-error"></span>
    </div>

    @if (isWholesale && genelToplam < toptanciMinTutar)
    {
        <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-center text-sm font-semibold text-amber-800">@Localizer["WholesaleMinOrderWarning", toptanciMinTutar.ToString("N0"), currencySymbol]</div>
    }
    <button type="submit" class="mt-5 flex w-full items-center justify-center gap-3 rounded-xl bg-brand-olive px-5 py-4 text-sm font-semibold text-white shadow-[0_12px_30px_rgba(49,53,17,.18)] transition hover:-translate-y-0.5 hover:bg-[#1c2001] disabled:cursor-not-allowed disabled:opacity-50" @(isWholesale && genelToplam < toptanciMinTutar ? "disabled" : "")>
        <i class="fas fa-lock text-brand-gold"></i><span>@Localizer["CreateOrder"]</span><span class="opacity-50">·</span><span><span id="checkoutBtnTotal">@genelToplam.ToString("N2")</span> @currencySymbol</span>
    </button>
</section>
