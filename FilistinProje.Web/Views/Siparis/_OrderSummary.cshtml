@model FilistinProje.Core.DTOs.CheckoutRequestDto
@using FilistinProje.Core.Varliklar
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currencySymbol = string.IsNullOrWhiteSpace(SiteSettingsService.GetSettings().ParaBirimi) ? "₪" : SiteSettingsService.GetSettings().ParaBirimi;
    decimal araToplam = ViewBag.AraToplam ?? 0;
    decimal indirim = ViewBag.IndirimTutari ?? 0;
    decimal genelToplam = ViewBag.ToplamTutar ?? 0;
    string? kuponKodu = ViewBag.KuponKodu as string;
    var sepetItems = ViewBag.SepetItems as List<FilistinProje.Core.Varliklar.SepetItem> ?? new List<FilistinProje.Core.Varliklar.SepetItem>();
    decimal ucretsizKargoLimiti = (decimal)(ViewBag.UcretsizKargoLimiti ?? 500);
    decimal codBedel = (decimal)(ViewBag.KapidaOdemeHizmetBedeli ?? 0);
    decimal indirimliToplam = araToplam - indirim;
    decimal kalanTutar = Math.Max(0, ucretsizKargoLimiti - indirimliToplam);
    int shippingProgress = ucretsizKargoLimiti > 0 ? Math.Min(100, (int)(indirimliToplam / ucretsizKargoLimiti * 100)) : 100;
}

<div class="checkout-summary-card">
    <div class="flex items-center justify-between border-b border-brand-border pb-5">
        <h2 class="font-serif text-2xl text-brand-olive">@Localizer["OrderSummary"]</h2>
        <a href="/cart" class="text-[11px] font-semibold uppercase tracking-wider text-brand-gold hover:text-brand-olive">@Localizer["Checkout_EditCart"]</a>
    </div>

    <div class="max-h-[310px] space-y-4 overflow-y-auto py-5 pe-1">
        @foreach (var item in sepetItems)
        {
            <div class="flex gap-3">
                <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-brand-cream"><img src="@item.UrunResimUrl" alt="@item.UrunBaslik" class="h-full w-full object-cover" loading="lazy"><span class="absolute end-1 top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-brand-olive px-1 text-[10px] font-bold text-white">@item.Adet</span></div>
                <div class="min-w-0 flex-1"><h3 class="line-clamp-2 text-xs font-semibold leading-relaxed text-brand-darktext">@item.UrunBaslik</h3>@if (!string.IsNullOrWhiteSpace(item.SecenekAdi)) { <p class="mt-0.5 truncate text-[11px] text-brand-mutedtext">@item.SecenekAdi</p> }@if (item.HediyePaketi) { <p class="mt-0.5 text-[11px] text-brand-gold"><i class="fas fa-gift me-1"></i>@(string.IsNullOrWhiteSpace(item.LocalizedHediyePaketAdi) ? Localizer["GiftWrap"].Value : item.LocalizedHediyePaketAdi) (+@item.HediyePaketFiyati.ToString("N2") @currencySymbol / @Localizer["Piece"])</p> }<p class="mt-1 text-xs font-semibold text-brand-olive">@item.Toplam.ToString("N2") @currencySymbol</p></div>
            </div>
        }
    </div>

    <div id="checkoutFreeShippingBanner" class="mb-5 rounded-xl border p-4 @(kalanTutar > 0 ? "border-amber-200 bg-amber-50" : "border-green-200 bg-green-50")">
        @if (kalanTutar > 0)
        {
            <div class="mb-2 flex items-center gap-2 text-xs text-amber-800"><i class="fas fa-truck-fast text-brand-gold"></i><span>@Localizer["FreeShippingNotice", currencySymbol + kalanTutar.ToString("N2")]</span></div><div class="h-1.5 overflow-hidden rounded-full bg-amber-200"><div class="h-full rounded-full bg-brand-gold transition-all" style="width:@shippingProgress%"></div></div>
        }
        else
        {
            <div class="flex items-center gap-2 text-xs font-semibold text-green-800"><i class="fas fa-circle-check"></i>@Localizer["FreeShippingReached"]</div>
        }
    </div>

    <dl class="space-y-3 text-sm">
        <div class="flex justify-between text-brand-mutedtext"><dt>@Localizer["Subtotal"]</dt><dd>@araToplam.ToString("N2") @currencySymbol</dd></div>
        @if (indirim > 0) { <div class="flex justify-between font-medium text-brand-gold"><dt>@Localizer["Discount"] (@kuponKodu)</dt><dd>-@indirim.ToString("N2") @currencySymbol</dd></div> }
        <div id="checkoutKargoSatiri" class="flex justify-between text-brand-mutedtext"><dt>@Localizer["ShippingFee"]</dt><dd id="checkoutKargoUcreti" class="font-medium text-brand-olive">@((ViewBag.GosterilecekKargoBedeli == 0) ? Localizer["Free"].Value : $"{((decimal)ViewBag.GosterilecekKargoBedeli):N2} {currencySymbol}")</dd></div>
        <div id="checkoutCodSurchargeSatiri" class="hidden justify-between text-brand-mutedtext"><dt>@Localizer["CODServiceFee"]</dt><dd id="checkoutCodSurchargeUcreti" class="font-medium text-brand-gold">@codBedel.ToString("N2") @currencySymbol</dd></div>
    </dl>
    <div class="mt-5 flex items-end justify-between border-t border-brand-border pt-5"><span class="text-xs font-semibold uppercase tracking-widest text-brand-mutedtext">@Localizer["GrandTotal"]</span><span id="checkoutGenelToplam" class="font-serif text-3xl text-brand-olive">@genelToplam.ToString("N2") <small class="text-base text-brand-mutedtext">@currencySymbol</small></span></div>
    <div class="mt-6 grid grid-cols-3 gap-2 border-t border-brand-border pt-5 text-center text-[10px] leading-tight text-brand-mutedtext"><div><i class="fas fa-shield-halved mb-1 block text-brand-gold"></i>@Localizer["256BitSslEncryption"]</div><div><i class="fas fa-box mb-1 block text-brand-gold"></i>@Localizer["UndamagedDelivery"]</div><div><i class="fas fa-rotate-left mb-1 block text-brand-gold"></i>@Localizer["EasyReturns"]</div></div>
</div>
