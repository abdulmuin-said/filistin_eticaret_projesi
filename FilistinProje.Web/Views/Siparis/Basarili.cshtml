@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["OrderReceived"];
}

<div class="container mx-auto px-4 py-16 max-w-2xl">
    <!-- BaÅŸarÄ± Ä°konu -->
    <div class="text-center mb-10">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-[#e2e6b3] mb-6">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 20L17 27L30 13" stroke="#313511" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h1 class="font-serif text-4xl text-brand-olive mb-3">@Localizer["OrderReceivedTitle"]</h1>
        <p class="text-sm text-brand-mutedtext max-w-sm mx-auto leading-relaxed">
            @Localizer["OrderProcessingDescription"]
        </p>
    </div>

    <!-- SipariÅŸ KartÄ± -->
    <div class="bg-white border border-brand-border rounded-lg overflow-hidden mb-8">
        <div class="bg-brand-cream px-6 py-4 flex items-center justify-between">
            <div>
                <p class="text-xs uppercase tracking-widest text-brand-mutedtext mb-1">@Localizer["OrderNumber"]</p>
                <p class="font-serif text-2xl text-brand-olive font-semibold">#@ViewBag.SiparisNo</p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs bg-green-50 text-green-700 border border-green-200 px-3 py-1.5 rounded-full">
                <i class="fas fa-circle-check text-[10px]"></i> @Localizer["Confirmed"]
            </span>
        </div>
        <div class="px-6 py-5 grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-xs text-brand-mutedtext uppercase tracking-wide mb-1">@Localizer["TransactionTime"]</p>
                <p class="font-medium text-brand-darktext">@DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
            </div>
            <div>
                <p class="text-xs text-brand-mutedtext uppercase tracking-wide mb-1">@Localizer["ConfirmationEmail"]</p>
                <p class="font-medium text-brand-darktext">@Localizer["Sent"]</p>
            </div>
        </div>
    </div>

    <!-- SÃ¼reÃ§ AdÄ±mlarÄ± -->
    <div class="grid grid-cols-3 gap-4 mb-10">
        <div class="text-center bg-white border border-brand-border rounded-lg p-4">
            <div class="w-10 h-10 rounded-full bg-brand-olive text-white flex items-center justify-center text-sm font-semibold mx-auto mb-3">1</div>
            <h4 class="font-semibold text-brand-darktext text-sm mb-1">@Localizer["Preparing"]</h4>
            <p class="text-xs text-brand-mutedtext leading-relaxed">@Localizer["PreparingDescription"]</p>
        </div>
        <div class="text-center bg-white border border-brand-border rounded-lg p-4">
            <div class="w-10 h-10 rounded-full bg-brand-gold text-white flex items-center justify-center text-sm font-semibold mx-auto mb-3">2</div>
            <h4 class="font-semibold text-brand-darktext text-sm mb-1">@Localizer["Shipped"]</h4>
            <p class="text-xs text-brand-mutedtext leading-relaxed">@Localizer["ShippedDescription"]</p>
        </div>
        <div class="text-center bg-white border border-brand-border rounded-lg p-4">
            <div class="w-10 h-10 rounded-full bg-brand-border text-brand-mutedtext flex items-center justify-center text-sm font-semibold mx-auto mb-3">3</div>
            <h4 class="font-semibold text-brand-darktext text-sm mb-1">@Localizer["Delivery"]</h4>
            <p class="text-xs text-brand-mutedtext leading-relaxed">@Localizer["DeliveryDescription"]</p>
        </div>
    </div>

    <!-- Butonlar -->
    <div class="flex flex-col sm:flex-row gap-3">
        <a href="/Profil/Siparislerim"
           class="flex-1 bg-brand-olive text-white text-center text-xs tracking-widest uppercase py-3.5 rounded hover:bg-[#1c2001] transition-colors">
            <i class="fas fa-box mr-2 text-[10px]"></i>@Localizer["TrackOrder"]
        </a>
        <a href="/Urun"
           class="flex-1 border border-brand-olive text-brand-olive text-center text-xs tracking-widest uppercase py-3.5 rounded hover:bg-brand-olive hover:text-white transition-colors">
            <i class="fas fa-shopping-bag mr-2 text-[10px]"></i>@Localizer["ContinueShopping"]
        </a>
    </div>

    <!-- Destek BaÄŸlantÄ±larÄ± -->
    <div class="text-center mt-8 pt-6 border-t border-brand-border">
        <p class="text-xs text-brand-mutedtext mb-3">@Localizer["HaveQuestions"]</p>
        <div class="flex justify-center gap-6">
            <a href="/Kurumsal/Iletisim" class="text-xs text-brand-gold hover:text-brand-olive transition-colors">
                <i class="fas fa-headset mr-1"></i>@Localizer["ContactUs"]
            </a>
            <a href="/" class="text-xs text-brand-gold hover:text-brand-olive transition-colors">
                <i class="fas fa-home mr-1"></i>@Localizer["ReturnHome"]
            </a>
        </div>
    </div>
</div>
