@model FilistinProje.Core.DTOs.CheckoutRequestDto
@using FilistinProje.Core.Varliklar
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["SecurePayment"];
    var siteSettings = SiteSettingsService.GetSettings();
    var currencySymbol = string.IsNullOrWhiteSpace(siteSettings.ParaBirimi) ? "₪" : siteSettings.ParaBirimi;

    decimal araToplam = ViewBag.AraToplam ?? 0;
    decimal indirim = ViewBag.IndirimTutari ?? 0;
    decimal genelToplam = ViewBag.ToplamTutar ?? 0;
    string? kuponKodu = ViewBag.KuponKodu as string;
    var sepetItems = ViewBag.SepetItems as List<FilistinProje.Core.Varliklar.SepetItem> ?? new List<FilistinProje.Core.Varliklar.SepetItem>();
    var ucretsizKargoLimiti = (decimal)(ViewBag.UcretsizKargoLimiti ?? 500);
    bool codAktif = ViewBag.KapidaOdemeAktifMi is bool codAccess && codAccess;
    decimal codBedel = (decimal)(ViewBag.KapidaOdemeHizmetBedeli ?? 0);
    decimal codLimit = (decimal)(ViewBag.KapidaOdemeLimiti ?? 2000);
    bool receteZorunlu = ViewBag.ReceteZorunluMu is bool rxRequired && rxRequired;
    bool isWholesale = User.IsInRole("Wholesale");
    decimal toptanciMinTutar = (decimal)(ViewBag.ToptanciMinSiparisTutari ?? 500);

    var kayitliAdresler = ViewBag.KayitliAdresler as List<FilistinProje.Core.Varliklar.Adres>;
    bool girisYapmis = User.Identity?.IsAuthenticated == true;
    // Sehir listesi veritabanindaki KargoBolgeSehirler'den gelir.
    var sehirListesi = ViewBag.Sehirler as List<string> ?? new List<string>();
    var sehirler = sehirListesi;
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<style>
    .checkout-page { background: radial-gradient(circle at 12% 10%, rgba(181,135,53,.09), transparent 28rem), linear-gradient(180deg, #fbfaf6 0%, #f5f2ea 100%); }
    .checkout-shell { width: 100%; max-width: 1280px; margin-inline: auto; }
    .checkout-hero { max-width: 42rem; }
    .checkout-layout { display: grid; align-items: start; gap: 1.5rem; }
    .checkout-card, .checkout-summary-card { border: 1px solid #e5dfd3; border-radius: 1.1rem; background: rgba(255,255,255,.94); box-shadow: 0 18px 55px rgba(49,53,17,.055); }
    .checkout-card { padding: clamp(1.15rem, 3vw, 2rem); }
    .checkout-summary-card { padding: clamp(1.15rem, 2.5vw, 1.75rem); }
    .checkout-section-heading { display: flex; align-items: flex-start; gap: .9rem; margin-bottom: 1.6rem; }
    .checkout-section-heading h2 { color: var(--brand-primary); font-family: ui-serif, Georgia, serif; font-size: clamp(1.3rem, 2vw, 1.65rem); line-height: 1.15; }
    .checkout-section-heading p { color: #7a766d; font-size: .75rem; line-height: 1.5; margin-top: .3rem; }
    .checkout-step { display: inline-flex; height: 2.35rem; width: 2.35rem; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 999px; background: var(--brand-primary); color: #fff; font-size: .68rem; font-weight: 700; letter-spacing: .08em; box-shadow: 0 7px 18px rgb(var(--brand-primary-rgb) / .18); }
    .checkout-label { display: block; margin-bottom: .45rem; color: #383a29; font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .checkout-label span { color: #b58735; }
    .checkout-input { display: block; width: 100%; border: 1px solid #ded8cb; border-radius: .75rem; background: #fbfaf7; padding: .78rem .9rem; color: #292b1d; font-size: .875rem; outline: none; transition: border-color .2s, box-shadow .2s, background .2s; }
    .checkout-input:focus { border-color: #b58735; background: #fff; box-shadow: 0 0 0 3px rgba(181,135,53,.12); }
    .checkout-input[aria-invalid="true"] { border-color: #dc2626; background: #fff7f7; box-shadow: 0 0 0 3px rgba(220,38,38,.08); }
    .checkout-field-error { display: block; margin-top: .35rem; color: #b91c1c; font-size: .7rem; line-height: 1.4; }
    .checkout-choice { position: relative; display: flex; min-height: 5.35rem; cursor: pointer; align-items: center; gap: .8rem; overflow: hidden; border: 1px solid #ded8cb; border-radius: .85rem; background: #fff; padding: 1rem; transition: transform .2s, border-color .2s, background .2s, box-shadow .2s; }
    .checkout-choice:hover { border-color: #b58735; transform: translateY(-1px); }
    .checkout-choice:has(.peer:checked) { border-color: var(--brand-primary); background: #f7f8ed; box-shadow: inset 3px 0 0 #b58735; }
    [dir="rtl"] .checkout-choice:has(.peer:checked) { box-shadow: inset -3px 0 0 #b58735; }
    .checkout-choice-icon, .checkout-mini-icon { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: .7rem; background: #f2eee4; color: #b58735; }
    .checkout-choice-icon { height: 2.6rem; width: 2.6rem; }
    .checkout-mini-icon { height: 2.25rem; width: 2.25rem; }
    .checkout-choice-check { position: absolute; inset-inline-end: .7rem; top: .7rem; display: none; height: 1.25rem; width: 1.25rem; align-items: center; justify-content: center; border-radius: 999px; background: var(--brand-primary); color: white; font-size: .55rem; }
    .checkout-choice:has(.peer:checked) .checkout-choice-check { display: inline-flex; }
    .checkout-dropzone { display: flex; min-height: 8rem; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: .45rem; border: 1px dashed #bdb5a5; border-radius: .9rem; background: #fbfaf7; padding: 1rem; text-align: center; transition: border-color .2s, background .2s; }
    .checkout-dropzone:hover { border-color: #b58735; background: #fff; }
    .checkout-secondary-button { border-radius: .7rem; background: var(--brand-primary); padding: .7rem 1.1rem; color: #fff; font-size: .72rem; font-weight: 600; transition: filter .2s; }
    .checkout-secondary-button:hover { filter: brightness(.85); }
    @@media (min-width: 1180px) { .checkout-layout { grid-template-columns: minmax(0, 1fr) 400px; gap: 2rem; } .checkout-summary { position: sticky; top: 6rem; } }
    @@media (max-width: 639px) { .checkout-card, .checkout-summary-card { border-radius: .9rem; } .checkout-choice { min-height: 4.75rem; } }
</style>

<div class="border-b border-brand-border bg-white/80 py-3 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-3 px-4 text-[10px] font-semibold uppercase tracking-[.16em] sm:text-xs">
        <a href="/cart" class="flex items-center gap-2 text-brand-mutedtext transition hover:text-brand-olive"><span class="flex h-6 w-6 items-center justify-center rounded-full border border-brand-border">1</span>@Localizer["Cart"]</a>
        <span class="h-px w-8 bg-brand-border sm:w-16"></span>
        <span class="flex items-center gap-2 text-brand-olive"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-olive text-white">2</span>@Localizer["PaymentAndDelivery"]</span>
    </div>
</div>

<main class="checkout-page px-3 py-7 sm:px-5 sm:py-10 lg:py-14">
    <div class="checkout-shell">
        <header class="checkout-hero mb-7 sm:mb-10">
            <span class="mb-3 inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.22em] text-brand-gold"><i class="fas fa-shield-halved"></i>@Localizer["256BitSslEncryption"]</span>
            <h1 class="font-serif text-3xl leading-tight text-white sm:text-4xl lg:text-5xl">@Localizer["SecurePayment"]</h1>
            <p class="mt-3 text-sm leading-relaxed text-white/80">@Localizer["VerifyDeliveryInfo"]</p>
        </header>

        <div class="checkout-layout">
            <form asp-action="Odeme" method="post" id="odemeForm" class="space-y-5" novalidate>
                @if ((ViewBag.FormHata is string formHata && !string.IsNullOrWhiteSpace(formHata)) || !ViewData.ModelState.IsValid)
                {
                    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800 shadow-sm">
                        <div class="flex items-start gap-3"><i class="fas fa-circle-exclamation mt-0.5"></i><div><strong class="block">@(ViewBag.FormHata as string ?? Localizer["Checkout_ReviewErrors"].Value)</strong><div asp-validation-summary="All" class="mt-2 text-xs leading-relaxed"></div></div></div>
                    </div>
                }
                <div id="checkoutClientAlert" role="alert" tabindex="-1" class="hidden rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800 shadow-sm">
                    <div class="flex items-start gap-3"><i class="fas fa-circle-exclamation mt-0.5"></i><div><strong>@Localizer["Checkout_ReviewErrors"]</strong><ul id="checkoutClientErrors" class="mt-2 list-disc space-y-1 ps-5 text-xs"></ul></div></div>
                </div>
                @await Html.PartialAsync("_AddressForm")
                @await Html.PartialAsync("_PaymentOptions")
                @await Html.PartialAsync("_OrderConfirmation")
            </form>
            <aside class="checkout-summary">@await Html.PartialAsync("_OrderSummary")</aside>
        </div>
    </div>
</main>
<script>
    const checkoutUploadToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CheckoutUploadToken as string ?? string.Empty));
    const currencySymbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currencySymbol));
    const isAr = @(isAr ? "true" : "false");

    const regionCities = {
        'القدس': [
            { ar: 'القدس', en: 'Jerusalem' },
            { ar: 'العيزرية', en: 'Al-Eizariya' },
            { ar: 'الرام', en: 'Al-Ram' },
            { ar: 'أبو ديس', en: 'Abu Dis' }
        ],
        'الضفة الغربية': [
            { ar: 'رام الله والبيرة', en: 'Ramallah & Al-Bireh' },
            { ar: 'نابلس', en: 'Nablus' },
            { ar: 'الخليل', en: 'Hebron' },
            { ar: 'جنين', en: 'Jenin' },
            { ar: 'بيت لحم', en: 'Bethlehem' },
            { ar: 'طولكرم', en: 'Tulkarm' },
            { ar: 'قلقيلية', en: 'Qalqilya' },
            { ar: 'أريحا', en: 'Jericho' },
            { ar: 'سلفيت', en: 'Salfit' },
            { ar: 'طوباس', en: 'Tubas' },
            { ar: 'بيرزيت', en: 'Birzeit' },
            { ar: 'حلحول', en: 'Halhul' },
            { ar: 'يطا', en: 'Yatta' },
            { ar: 'دورا', en: 'Dura' },
            { ar: 'بيت جالا', en: 'Beit Jala' }
        ],
        'قطاع غزة': [
            { ar: 'غزة', en: 'Gaza' },
            { ar: 'خان يونس', en: 'Khan Yunis' },
            { ar: 'رفح', en: 'Rafah' },
            { ar: 'دير البلح', en: 'Deir al-Balah' },
            { ar: 'شمال غزة', en: 'North Gaza' },
            { ar: 'بيت حانون', en: 'Beit Hanoun' },
            { ar: 'بيت لاهيا', en: 'Beit Lahiya' },
            { ar: 'جباليا', en: 'Jabalia' }
        ],
        'المناطق الداخلية 48': [
            { ar: 'يافا', en: 'Jaffa' },
            { ar: 'حيفا', en: 'Haifa' },
            { ar: 'عكا', en: 'Acre' },
            { ar: 'الناصرة', en: 'Nazareth' },
            { ar: 'اللد', en: 'Lydda' },
            { ar: 'الرملة', en: 'Ramla' },
            { ar: 'أم الفحم', en: 'Umm al-Fahm' },
            { ar: 'الطيبة', en: 'Tayibe' }
        ]
    };

    function updateCheckoutCities(region, preselectedCity) {
        var sehirSelect = document.getElementById('Sehir');
        if (!sehirSelect) return;
        var defaultText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SelectCity"].Value));
        sehirSelect.innerHTML = '<option value="">' + defaultText + '</option>';

        if (!region || !regionCities[region]) return;

        var list = regionCities[region];
        list.forEach(function (c) {
            var opt = document.createElement('option');
            var val = isAr ? c.ar : c.en;
            opt.value = val;
            opt.textContent = isAr ? c.ar : c.en;
            if (preselectedCity && (preselectedCity === c.ar || preselectedCity === c.en || preselectedCity === val)) {
                opt.selected = true;
            }
            sehirSelect.appendChild(opt);
        });
    }

    function findRegionForCity(cityName) {
        if (!cityName) return null;
        for (var reg in regionCities) {
            if (Object.prototype.hasOwnProperty.call(regionCities, reg)) {
                var clist = regionCities[reg];
                for (var i = 0; i < clist.length; i++) {
                    var c = clist[i];
                    if (c.ar === cityName || c.en === cityName || cityName.indexOf(c.ar) !== -1 || cityName.indexOf(c.en) !== -1) {
                        return reg;
                    }
                }
            }
        }
        return null;
    }

    function getDeliveryType() {
        var radio = document.querySelector('input[name="TeslimatTipi"]:checked');
        if (radio) return radio.value;
        var hidden = document.querySelector('input[name="TeslimatTipi"]');
        if (hidden) return hidden.value;
        return 'AdreseTeslim';
    }

    function formatCheckoutNumber(amount) {
        return Number(amount).toLocaleString(document.documentElement.lang === 'ar' ? 'ar-PS' : 'en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function selectAddress(ad, tel, sehir, ilce, acikAdres) {
        var nameInput = document.getElementById("MusteriAdSoyad");
        if (nameInput) nameInput.value = ad;
        var phoneInput = document.getElementById("Telefon");
        if (phoneInput) phoneInput.value = tel;
        var districtInput = document.getElementById("Ilce");
        if (districtInput) districtInput.value = ilce;
        var addressInput = document.getElementById("AcikAdres");
        if (addressInput) addressInput.value = acikAdres;

        var bolgeSelect = document.getElementById("BolgeSelect");
        var sehirSelect = document.getElementById("Sehir");
        var reg = findRegionForCity(sehir);
        if (reg && bolgeSelect) {
            bolgeSelect.value = reg;
            updateCheckoutCities(reg, sehir);
        } else if (sehirSelect) {
            sehirSelect.value = sehir;
        }

        if (typeof sehirKargoHesapla === 'function') {
            sehirKargoHesapla();
        }

        if (window.showToast) {
            window.showToast('@Localizer["AddressLoaded"]', 'success');
        }
    }

    function handleReceteFileUpload(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];

            if (file.size > 5 * 1024 * 1024) {
                if (window.showToast) {
                    window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                }
                return;
            }

            var reader = new FileReader();
            reader.onload = function(e) {
                var preview = document.getElementById('recetePreview');
                var pdfPlaceholder = document.getElementById('recetePdfPlaceholder');
                var container = document.getElementById('recetePreviewContainer');

                if (file.type === 'application/pdf') {
                    if (preview) preview.classList.add('hidden');
                    if (pdfPlaceholder) {
                        pdfPlaceholder.classList.remove('hidden');
                        var nameEl = document.getElementById('recetePdfName');
                        if (nameEl) nameEl.textContent = file.name;
                    }
                } else {
                    if (pdfPlaceholder) pdfPlaceholder.classList.add('hidden');
                    if (preview) {
                        preview.src = e.target.result;
                        preview.classList.remove('hidden');
                    }
                }
                if (container) container.classList.remove('hidden');
            };
            reader.readAsDataURL(file);

            uploadRecetePhoto(file, file.name);
        }
    }

    function uploadRecetePhoto(file, filename) {
        var formData = new FormData();
        formData.append('dosya', file, filename);

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/checkout/YukleRecete', true);
        xhr.setRequestHeader('RequestVerificationToken', token);
        xhr.setRequestHeader('X-Checkout-Upload-Token', checkoutUploadToken);

        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        document.getElementById('ReceteDosyaYolu').value = response.url;
                        if (window.showToast) {
                            window.showToast('@Localizer["PrescriptionUploaded"]', 'success');
                        }
                    } else {
                        if (window.showToast) {
                            window.showToast(response.message || 'Hata oluştu', 'error');
                        }
                    }
                } catch (e) {
                    if (window.showToast) {
                        window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                    }
                }
            } else {
                if (window.showToast) {
                    window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                }
            }
        };

        xhr.send(formData);
    }

    function handleDekontUpload(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];

            if (file.size > 8 * 1024 * 1024) {
                if (window.showToast) {
                    window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                }
                return;
            }

            var fileNameEl = document.getElementById('dekontFileName');
            if (fileNameEl) fileNameEl.textContent = file.name;

            var reader = new FileReader();
            reader.onload = function(e) {
                var preview = document.getElementById('dekontPreview');
                var pdfPlaceholder = document.getElementById('dekontPdfPlaceholder');
                var container = document.getElementById('dekontPreviewContainer');

                if (file.type === 'application/pdf') {
                    if (preview) preview.classList.add('hidden');
                    if (pdfPlaceholder) {
                        pdfPlaceholder.classList.remove('hidden');
                        var nameEl = document.getElementById('dekontPdfName');
                        if (nameEl) nameEl.textContent = file.name;
                    }
                } else {
                    if (pdfPlaceholder) pdfPlaceholder.classList.add('hidden');
                    if (preview) {
                        preview.src = e.target.result;
                        preview.classList.remove('hidden');
                    }
                }
                if (container) container.classList.remove('hidden');
                var dekontError = document.getElementById('dekontError');
                if (dekontError) dekontError.classList.add('hidden');
            };
            reader.readAsDataURL(file);

            uploadDekontFile(file, file.name);
        }
    }

    function uploadDekontFile(file, filename) {
        var formData = new FormData();
        formData.append('dosya', file, filename);

        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/checkout/YukleDekont', true);
        xhr.setRequestHeader('RequestVerificationToken', token);
        xhr.setRequestHeader('X-Checkout-Upload-Token', checkoutUploadToken);

        xhr.onload = function() {
            if (xhr.status === 200) {
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        document.getElementById('OdemeDekontYolu').value = response.url;
                        var dekontError = document.getElementById('dekontError');
                        if (dekontError) dekontError.classList.add('hidden');
                        if (window.showToast) {
                            window.showToast('@Localizer["Admin_DocumentUploaded"]', 'success');
                        }
                    } else {
                        if (window.showToast) {
                            window.showToast(response.message || 'Error', 'error');
                        }
                    }
                } catch (e) {
                    if (window.showToast) {
                        window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                    }
                }
            } else {
                if (window.showToast) {
                    window.showToast('@Localizer["Siparis_FileUploadError"]', 'error');
                }
            }
        };

        xhr.send(formData);
    }

    function toggleDeliveryType() {
        var isStorePickup = getDeliveryType() === 'MagazadanTeslim';
        var adresAlanlari = document.getElementById('adresAlanlari');
        var shippingAddressFields = [
            document.getElementById('adresBolgeAlani'),
            document.getElementById('adresSehirAlani'),
            document.getElementById('adresIlceAlani'),
            document.getElementById('adresAcikAdresAlani'),
            document.getElementById('adresKaydetAlani')
        ];
        var requiredShippingInputs = [
            document.getElementById('BolgeSelect'),
            document.getElementById('Sehir'),
            document.getElementById('Ilce'),
            document.getElementById('AcikAdres')
        ];
        var kargoAlanlari = document.getElementById('kargoAlanlari');
        var storePickupInfo = document.getElementById('storePickupInfo');
        var checkoutKargoSatiri = document.getElementById('checkoutKargoSatiri');
        var checkoutFreeShippingBanner = document.getElementById('checkoutFreeShippingBanner');
        var checkoutKargoDisplay = document.getElementById('checkoutKargoUcreti');
        var checkoutCodSurchargeSatiri = document.getElementById('checkoutCodSurchargeSatiri');
        var totalDisplay = document.getElementById('checkoutGenelToplam');
        var btnTotalDisplay = document.getElementById('checkoutBtnTotal');
        var codPaymentOption = document.getElementById('codPaymentOption');

        if (isStorePickup) {
            if (adresAlanlari) adresAlanlari.classList.remove('hidden');
            shippingAddressFields.forEach(function(field) { if (field) field.classList.add('hidden'); });
            requiredShippingInputs.forEach(function(input) { if (input) input.required = false; });
            if (kargoAlanlari) kargoAlanlari.classList.add('hidden');
            if (storePickupInfo) storePickupInfo.classList.remove('hidden');
            if (checkoutKargoSatiri) checkoutKargoSatiri.classList.add('hidden');
            if (checkoutCodSurchargeSatiri) checkoutCodSurchargeSatiri.classList.add('hidden');
            if (checkoutFreeShippingBanner) checkoutFreeShippingBanner.classList.add('hidden');
            if (codPaymentOption) codPaymentOption.classList.remove('hidden');

            var subtotal = parseFloat("@((araToplam - indirim).ToString(System.Globalization.CultureInfo.InvariantCulture))");
            if (totalDisplay) {
                totalDisplay.innerHTML = formatCheckoutNumber(subtotal) + ' <span class="text-lg font-normal text-brand-mutedtext">' + currencySymbol + '</span>';
            }
            if (btnTotalDisplay) {
                btnTotalDisplay.textContent = formatCheckoutNumber(subtotal);
            }
        } else {
            if (adresAlanlari) adresAlanlari.classList.remove('hidden');
            shippingAddressFields.forEach(function(field) { if (field) field.classList.remove('hidden'); });
            requiredShippingInputs.forEach(function(input) { if (input) input.required = true; });
            if (kargoAlanlari) kargoAlanlari.classList.remove('hidden');
            if (storePickupInfo) storePickupInfo.classList.add('hidden');
            if (checkoutKargoSatiri) checkoutKargoSatiri.classList.remove('hidden');
            var selectedPayment = document.querySelector('input[name="odemeYontemi"]:checked')?.value;
            if (checkoutCodSurchargeSatiri) checkoutCodSurchargeSatiri.classList.toggle('hidden', selectedPayment !== 'KapidaOdeme');
            if (checkoutFreeShippingBanner) checkoutFreeShippingBanner.classList.remove('hidden');
            if (codPaymentOption) codPaymentOption.classList.remove('hidden');
            if (typeof sehirKargoHesapla === 'function') {
                sehirKargoHesapla();
            }
        }

        requiredShippingInputs.forEach(function(input) {
            if (input && typeof clearCheckoutFieldError === 'function') clearCheckoutFieldError(input);
        });
        var clientAlert = document.getElementById('checkoutClientAlert');
        if (clientAlert) clientAlert.classList.add('hidden');
    }

    const adresKaydetCheckbox = document.getElementById('AdresiKaydet');
    if (adresKaydetCheckbox) {
        adresKaydetCheckbox.addEventListener('change', function () {
            const target = document.getElementById('adresBaslikWrapper');
            if (!target) return;

            if (this.checked) {
                target.classList.remove('hidden');
            } else {
                target.classList.add('hidden');
            }
        });
    }

    const checkoutValidationMessages = {
        MusteriAdSoyad: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_NameRequired"].Value)),
        Eposta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_EmailRequired"].Value)),
        Telefon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_PhoneRequired"].Value)),
        Bolge: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SelectRegion"].Value)),
        Sehir: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_CityRequired"].Value)),
        Ilce: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_DistrictRequired"].Value)),
        AcikAdres: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_AddressRequired"].Value)),
        OdemeYontemi: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Checkout_PaymentRequired"].Value)),
        SozlesmeOnaylandi: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_TermsRequired"].Value)),
        ReceteDosyaYolu: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Siparis_PrescriptionRequired"].Value)),
        PaymentReceiptRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["PaymentReceiptRequired"].Value))
    };

    function setCheckoutFieldError(fieldName, message) {
        const field = document.getElementById(fieldName) || document.querySelector('[name="' + fieldName + '"]');
        const messageEl = form.querySelector('[data-valmsg-for="' + fieldName + '"]');
        if (field) field.setAttribute('aria-invalid', 'true');
        if (messageEl && !messageEl.textContent.trim()) {
            messageEl.textContent = message;
            messageEl.dataset.clientError = 'true';
        }
    }

    function clearCheckoutFieldError(field) {
        field.removeAttribute('aria-invalid');
        const fieldName = field.name;
        const messageEl = fieldName ? form.querySelector('[data-valmsg-for="' + fieldName + '"]') : null;
        if (messageEl?.dataset.clientError === 'true') {
            messageEl.textContent = '';
            delete messageEl.dataset.clientError;
        }
    }

    // Form submission validation UI
    const form = document.getElementById('odemeForm');
    form.addEventListener('submit', function(e) {
        const errors = [];
        let firstInvalidField = null;
        const requiredFields = ['MusteriAdSoyad', 'Eposta', 'Telefon', 'Bolge', 'Sehir', 'Ilce', 'AcikAdres'];

        requiredFields.forEach(function(fieldName) {
            const field = document.getElementById(fieldName) || document.querySelector('[name="' + fieldName + '"]');
            if (!field || field.disabled || !field.required) return;
            const empty = !field.value.trim();
            const invalidEmail = fieldName === 'Eposta' && !empty && !field.validity.valid;
            const shortAddress = fieldName === 'AcikAdres' && !empty && field.value.trim().length < 10;
            if (empty || invalidEmail || shortAddress) {
                errors.push(checkoutValidationMessages[fieldName]);
                setCheckoutFieldError(fieldName, checkoutValidationMessages[fieldName]);
                firstInvalidField = firstInvalidField || field;
            }
        });

        const selectedPaymentMethod = form.querySelector('input[name="odemeYontemi"]:checked')?.value;
        if (!selectedPaymentMethod) {
            errors.push(checkoutValidationMessages.OdemeYontemi);
            setCheckoutFieldError('OdemeYontemi', checkoutValidationMessages.OdemeYontemi);
            firstInvalidField = firstInvalidField || form.querySelector('input[name="odemeYontemi"]');
        } else if (selectedPaymentMethod === 'BankaHavalesi') {
            const dekontYolu = document.getElementById('OdemeDekontYolu')?.value;
            const dekontFileInput = document.getElementById('dekontFileInput');
            const hasFile = dekontFileInput?.files && dekontFileInput.files.length > 0;
            if ((!dekontYolu || dekontYolu.trim() === '') && !hasFile) {
                errors.push(checkoutValidationMessages.PaymentReceiptRequired);
                const dekontError = document.getElementById('dekontError');
                if (dekontError) dekontError.classList.remove('hidden');
                firstInvalidField = firstInvalidField || document.getElementById('dekontDropzone');
            }
        }

        const terms = document.getElementById('SozlesmeOnaylandi');
        if (!terms?.checked) {
            errors.push(checkoutValidationMessages.SozlesmeOnaylandi);
            setCheckoutFieldError('SozlesmeOnaylandi', checkoutValidationMessages.SozlesmeOnaylandi);
            firstInvalidField = firstInvalidField || terms;
        }

        const receteZorunlu = @(receteZorunlu ? "true" : "false");
        if (receteZorunlu) {
            const receteYolu = document.getElementById('ReceteDosyaYolu')?.value;
            if (!receteYolu || receteYolu.trim() === '') {
                errors.push(checkoutValidationMessages.ReceteDosyaYolu);
                setCheckoutFieldError('ReceteDosyaYolu', checkoutValidationMessages.ReceteDosyaYolu);
            }
        }

        if (errors.length) {
            e.preventDefault();
            const alert = document.getElementById('checkoutClientAlert');
            const list = document.getElementById('checkoutClientErrors');
            list.replaceChildren(...[...new Set(errors)].map(function(message) {
                const item = document.createElement('li');
                item.textContent = message;
                return item;
            }));
            alert.classList.remove('hidden');
            alert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            window.setTimeout(function() { (firstInvalidField || alert).focus({ preventScroll: true }); }, 350);
        }
    });

    form.addEventListener('input', function(event) { clearCheckoutFieldError(event.target); });
    form.addEventListener('change', function(event) { clearCheckoutFieldError(event.target); });

    // Address radio button visual update
    document.querySelectorAll('input[name="kayitliAdresSecimi"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.address-radio-inner').forEach(function(inner) {
                inner.classList.remove('opacity-100', 'scale-100');
                inner.classList.add('opacity-0', 'scale-0');
            });
            var container = this.closest('label').querySelector('.address-radio-inner');
            if (container) {
                container.classList.remove('opacity-0', 'scale-0');
                container.classList.add('opacity-100', 'scale-100');
            }
        });
    });

    function togglePaymentMethod(method) {
        var bankAccountsSection = document.getElementById('bankAccountsSection');
        var bankReceiptSection = document.getElementById('bankReceiptSection');
        var checkoutCodSurchargeSatiri = document.getElementById('checkoutCodSurchargeSatiri');

        if (method === 'KapidaOdeme') {
            if (bankAccountsSection) bankAccountsSection.classList.add('hidden');
            if (bankReceiptSection) bankReceiptSection.classList.add('hidden');
            if (checkoutCodSurchargeSatiri) checkoutCodSurchargeSatiri.classList.remove('hidden');
        } else {
            if (bankAccountsSection) bankAccountsSection.classList.remove('hidden');
            if (bankReceiptSection) bankReceiptSection.classList.remove('hidden');
            if (checkoutCodSurchargeSatiri) checkoutCodSurchargeSatiri.classList.add('hidden');
        }

        var isStorePickup = getDeliveryType() === 'MagazadanTeslim';
        if (!isStorePickup && typeof sehirKargoHesapla === 'function') {
            sehirKargoHesapla();
        }
    }

    // --- Dinamik Kargo Hesaplama (Şehir Bazlı) ---
    function sehirKargoHesapla() {
        const isStorePickup = getDeliveryType() === 'MagazadanTeslim';
        if (isStorePickup) return;

        const sehir = document.getElementById("Sehir")?.value;
        if (!sehir) return;

        const url = "/checkout/shipping-cost?sehir=" + encodeURIComponent(sehir);

        fetch(url)
            .then(r => r.json())
            .then(data => {
                const pickupSelected = getDeliveryType() === 'MagazadanTeslim';
                if (pickupSelected) return;

                if (data.success) {
                    const kargoDisplay = document.getElementById("checkoutKargoUcreti");
                    const totalDisplay = document.getElementById("checkoutGenelToplam");
                    const btnTotalDisplay = document.getElementById("checkoutBtnTotal");
                    const checkoutKargoSatiri = document.getElementById("checkoutKargoSatiri");
                    const freeShippingBanner = document.getElementById("checkoutFreeShippingBanner");

                    const araToplam = parseFloat("@((araToplam - indirim).ToString(System.Globalization.CultureInfo.InvariantCulture))");
                    const codBedel = parseFloat("@codBedel.ToString(System.Globalization.CultureInfo.InvariantCulture))");
                    const selectedPayment = document.querySelector('input[name="odemeYontemi"]:checked')?.value || 'BankaHavalesi';
                    const codPrice = (selectedPayment === 'KapidaOdeme') ? codBedel : 0;

                    // Kargo ücretini güncelle
                    const isFree = data.kargoUcreti <= 0 || araToplam >= data.ucretsizKargoLimiti;
                    const gecerliKargoUcreti = isFree ? 0 : data.kargoUcreti;

                    if (kargoDisplay) {
                        if (gecerliKargoUcreti === 0) {
                            kargoDisplay.textContent = '@Localizer["Free"]';
                            kargoDisplay.className = "text-green-600 font-bold uppercase";
                        } else {
                            kargoDisplay.textContent = currencySymbol + formatCheckoutNumber(gecerliKargoUcreti);
                            kargoDisplay.className = "text-brand-olive font-medium";
                        }
                    }

                    // Free shipping banner güncelleme
                    const kalanTutar = data.ucretsizKargoLimiti - araToplam;
                    if (checkoutFreeShippingBanner) {
                        if (kalanTutar > 0) {
                            checkoutFreeShippingBanner.innerHTML =
                                '<div class="flex items-center gap-2 text-xs text-amber-800 mb-3">' +
                                '<i class="fas fa-truck text-brand-gold"></i>' +
                                '<span>' + formatCheckoutNumber(kalanTutar) + ' ' + currencySymbol + ' @Localizer["FreeShippingAbove"]</span></div>' +
                                '<div class="w-full h-2 bg-amber-200 rounded-full overflow-hidden">' +
                                '<div class="h-full bg-gradient-to-r from-[#b58735] to-[#d4a84b] rounded-full" style="width: ' + Math.min(100, Math.round((araToplam / data.ucretsizKargoLimiti) * 100)) + '%"></div></div>';
                            checkoutFreeShippingBanner.className = "mb-5 bg-amber-50 border border-amber-200 rounded-lg p-4";
                        } else {
                            checkoutFreeShippingBanner.innerHTML =
                                '<div class="flex items-center gap-2 text-xs text-green-800">' +
                                '<i class="fas fa-check-circle text-green-500"></i>' +
                                '<span class="font-semibold">@Localizer["FreeShippingReached"]</span></div>';
                            checkoutFreeShippingBanner.className = "mb-5 bg-green-50 border border-green-200 rounded-lg p-4";
                        }
                        checkoutFreeShippingBanner.classList.remove('hidden');
                    }

                    // Total güncelle
                    const genelToplamVal = araToplam + gecerliKargoUcreti + codPrice;
                    if (totalDisplay) {
                        totalDisplay.innerHTML = formatCheckoutNumber(genelToplamVal) + ' <span class="text-lg font-normal text-brand-mutedtext">' + currencySymbol + '</span>';
                    }
                    if (btnTotalDisplay) {
                        btnTotalDisplay.textContent = formatCheckoutNumber(genelToplamVal);
                    }
                }
            })
            .catch(err => console.error("Kargo hesaplama hatası:", err));
    }

    document.addEventListener("DOMContentLoaded", function () {
        const bolgeSelect = document.getElementById("BolgeSelect");
        const sehirSelect = document.getElementById("Sehir");

        if (bolgeSelect && sehirSelect) {
            bolgeSelect.addEventListener("change", function () {
                updateCheckoutCities(this.value, null);
                sehirKargoHesapla();
            });

            const initialRegion = bolgeSelect.value;
            const initialCity = sehirSelect.dataset.selected || sehirSelect.value || '';
            if (initialRegion) {
                updateCheckoutCities(initialRegion, initialCity);
            } else if (initialCity) {
                const matchedReg = findRegionForCity(initialCity);
                if (matchedReg) {
                    bolgeSelect.value = matchedReg;
                    updateCheckoutCities(matchedReg, initialCity);
                }
            }
        }

        if (sehirSelect) {
            sehirSelect.addEventListener("change", sehirKargoHesapla);
        }

        const kargoDisplay = document.getElementById("checkoutKargoUcreti");
        const totalDisplay = document.getElementById("checkoutGenelToplam");
        const btnTotalDisplay = document.getElementById("checkoutBtnTotal");
        const subtotal = parseFloat("@((araToplam - indirim).ToString(System.Globalization.CultureInfo.InvariantCulture))");
        const codBedel = parseFloat("@codBedel.ToString(System.Globalization.CultureInfo.InvariantCulture))");
        const codLimit = parseFloat("@codLimit.ToString(System.Globalization.CultureInfo.InvariantCulture))");

        function updateCheckoutTotals() {
            const isStorePickup = getDeliveryType() === 'MagazadanTeslim';

            const codPaymentOption = document.getElementById('codPaymentOption');
            if (subtotal > codLimit) {
                if (codPaymentOption) {
                    codPaymentOption.classList.add('hidden');
                    var bankRadio = document.querySelector('input[name="odemeYontemi"][value="BankaHavalesi"]');
                    if (bankRadio && bankRadio.checked === false) {
                        bankRadio.checked = true;
                        togglePaymentMethod('BankaHavalesi');
                    }
                }
            } else if (!isStorePickup) {
                if (codPaymentOption) codPaymentOption.classList.remove('hidden');
            }

            const selectedPayment = document.querySelector('input[name="odemeYontemi"]:checked')?.value || 'BankaHavalesi';
            const codPrice = (selectedPayment === 'KapidaOdeme' && !isStorePickup) ? codBedel : 0;

            // Kargo ücreti için mevcut görünen değeri al (şehir bazlı hesaplama zaten yapıldıysa)
            const mevcutKargo = kargoDisplay ? kargoDisplay.textContent : (isStorePickup ? '0.00 ' + currencySymbol : currencySymbol + '0.00');
            let kargoPrice = 0;
            if (!isStorePickup) {
                const txt = mevcutKargo.replace(currencySymbol, '').replace(/[^0-9.,]/g, '').replace(',', '.');
                kargoPrice = parseFloat(txt) || 0;
            }

            const genelToplamVal = subtotal + kargoPrice + codPrice;

            if (kargoDisplay) {
                if (isStorePickup) {
                    kargoDisplay.textContent = currencySymbol + formatCheckoutNumber(0);
                    kargoDisplay.className = "text-brand-olive font-medium";
                }
            }

            if (totalDisplay) {
                totalDisplay.innerHTML = formatCheckoutNumber(genelToplamVal) + ' <span class="text-lg font-normal text-brand-mutedtext">' + currencySymbol + '</span>';
            }

            if (btnTotalDisplay) {
                btnTotalDisplay.textContent = formatCheckoutNumber(genelToplamVal);
            }
        }

        // COD payment method change listener
        const codRadios = document.querySelectorAll('input[name="odemeYontemi"]');
        codRadios.forEach(radio => {
            radio.addEventListener("change", function() {
                updateCheckoutTotals();
                sehirKargoHesapla();
            });
        });

        updateCheckoutTotals();
        toggleDeliveryType();
        const selectedPayment = document.querySelector('input[name="odemeYontemi"]:checked');
        if (selectedPayment) togglePaymentMethod(selectedPayment.value);
    });
    function copyIban(elementId, btn) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = el.textContent.replace(/\s+/g, '');
        navigator.clipboard.writeText(text).then(() => {
            const icon = btn.querySelector('i');
            if (icon) {
                icon.className = 'fas fa-check text-sm';
                setTimeout(() => { icon.className = 'fas fa-copy text-sm'; }, 2000);
            }
        });
    }
</script>

@functions {
    string FormatIban(string iban)
    {
        if (string.IsNullOrWhiteSpace(iban)) return "";
        var clean = iban.Replace(" ", "");
        var parts = new List<string>();
        for (int i = 0; i < clean.Length; i += 4)
            parts.Add(clean.Substring(i, Math.Min(4, clean.Length - i)));
        return string.Join(" ", parts);
    }
}
