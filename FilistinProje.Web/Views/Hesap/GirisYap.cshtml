@inject IStringLocalizer<SharedResource> Localizer
@inject FilistinProje.Service.Services.ISiteSettingsService SiteSettingsService
@{
    ViewData["Title"] = @Localizer["Login"];
    var siteSettings = SiteSettingsService.GetSettings();
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-brand-cream">
    <div class="w-full max-w-md">
        <!-- Logo / Başlık -->
        <div class="text-center mb-10">
             <a href="/" class="font-serif text-3xl tracking-widest text-brand-olive">@(siteSettings.MarkaAdi ?? "7ANRPS48")</a>
            <p class="text-xs text-brand-mutedtext mt-2 tracking-wide">@Localizer["LoginToYourAccount"]</p>
        </div>

        <!-- Hata / Başarı Mesajları -->
        @if (ViewBag.Hata != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-6 flex items-center gap-2">
                <i class="fas fa-circle-exclamation"></i>
                @ViewBag.Hata
            </div>
        }
        @if (TempData.Peek("Basari") != null)
        {
            <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded mb-6 flex items-center gap-2">
                <i class="fas fa-circle-check"></i>
                @TempData.Peek("Basari")
            </div>
        }

        @if (siteSettings.GirisZorunluMu)
        {
            <div class="bg-amber-50 border border-amber-200 text-amber-800 text-sm px-4 py-3 rounded mb-6 flex items-center gap-2">
                <i class="fas fa-triangle-exclamation text-amber-600"></i>
                 <span>@Localizer["LoginRequiredMessage"]</span>
            </div>
        }

        <!-- Form Kartı -->
        <div class="bg-white border border-brand-border rounded-lg p-8 shadow-sm">
            <form asp-action="GirisYap" method="post" class="space-y-5">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div>
                    <label for="eposta" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Email"]</label>
                    <input id="eposta" name="eposta" type="email" placeholder="@Localizer["ExampleEmail"]" autocomplete="email" required
                           class="w-full border border-brand-border rounded px-4 py-3 text-sm text-brand-darktext focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none transition bg-brand-cream" />
                </div>

                <div>
                    <label for="sifre" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Password"]</label>
                    <input id="sifre" name="sifre" type="password" placeholder="@Localizer["PasswordPlaceholder"]" autocomplete="current-password" required
                           class="w-full border border-brand-border rounded px-4 py-3 text-sm text-brand-darktext focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none transition bg-brand-cream" />
                </div>

                <div class="flex justify-end">
                    <a href="/account/SifremiUnuttum" class="text-xs text-brand-gold hover:underline">@Localizer["ForgotPassword"]</a>
                </div>

                <button type="submit"
                        class="w-full bg-brand-olive text-white py-3 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors font-medium">
                    @Localizer["Login"]
                </button>
            </form>

            <div class="mt-8">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-brand-border"></div>
                    </div>
                    <div class="relative flex justify-center text-xs">
                        <span class="bg-white px-3 text-brand-mutedtext uppercase tracking-widest">
                            @Localizer["Or"]
                        </span>
                    </div>
                </div>

                <div class="mt-6">
                    <a href="#" class="flex w-full items-center justify-center gap-3 rounded border border-brand-border bg-white px-4 py-2.5 text-sm font-medium text-brand-darktext shadow-sm hover:bg-brand-cream transition-colors">
                        <svg class="h-5 w-5" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        @Localizer["LoginWithGoogle"]
                    </a>
                </div>
            </div>
        </div>

        <!-- Kayıt Linki -->
        <p class="text-center text-sm text-brand-mutedtext mt-6">
            @Localizer["NoAccount"]
            <a href="/account/KayitOl" class="text-brand-gold hover:underline font-medium">@Localizer["Register"]</a>
        </p>
    </div>
</div>
