@model FilistinProje.Web.Models.KayitViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = @Localizer["Register"];
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-brand-cream">
    <div class="w-full max-w-lg">
        <div class="text-center mb-10">
             <a href="/" class="font-serif text-3xl tracking-widest text-brand-olive">@Localizer["BrandName"]</a>
            <p class="text-xs text-brand-mutedtext mt-2 tracking-wide">@Localizer["CreateNewAccount"]</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-6 hidden [&:not(:empty)]:block"></div>

        <div class="bg-white border border-brand-border rounded-lg p-8 shadow-sm">
            <form asp-action="KayitOl" method="post" enctype="multipart/form-data" class="space-y-4" id="kayitForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MevcutKimlikFotoUrl" id="MevcutKimlikFotoUrl" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AdSoyad" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["FullName"] <span class="text-red-600">*</span></label>
                        <input asp-for="AdSoyad" id="AdSoyad" placeholder="@Localizer["YourFullName"]" autocomplete="name" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="AdSoyad" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="KimlikNo" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["NationalId"] <span class="text-red-600">*</span></label>
                        <input asp-for="KimlikNo" id="KimlikNo" placeholder="@Localizer["NationalIdPlaceholder"]" autocomplete="off" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="KimlikNo" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DogumTarihi" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["DateOfBirth"] <span class="text-red-600">*</span></label>
                        <input asp-for="DogumTarihi" id="DogumTarihi" type="date" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="DogumTarihi" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Telefon" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Phone"] <span class="text-red-600">*</span></label>
                        <input asp-for="Telefon" id="Telefon" type="tel" inputmode="tel" maxlength="20" placeholder="@Localizer["PhonePlaceholder"]" autocomplete="tel" required dir="ltr"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="Telefon" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Eposta" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Email"] <span class="text-red-600">*</span></label>
                    <input asp-for="Eposta" id="Eposta" type="email" placeholder="@Localizer["ExampleEmail"]" autocomplete="email" required dir="ltr"
                           class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                    <span asp-validation-for="Eposta" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Bolge" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Region"] <span class="text-red-600">*</span></label>
                        <select asp-for="Bolge" id="BolgeSelect" required class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors">
                            <option value="">@Localizer["SelectRegion"]</option>
                            <option value="القدس">@(isAr ? "القدس وضواحيها" : "Jerusalem & Suburbs")</option>
                            <option value="الضفة الغربية">@(isAr ? "الضفة الغربية" : "West Bank")</option>
                            <option value="قطاع غزة">@(isAr ? "قطاع غزة" : "Gaza Strip")</option>
                            <option value="المناطق الداخلية 48">@(isAr ? "المناطق الداخلية 48" : "Interior 48 Areas")</option>
                        </select>
                        <span asp-validation-for="Bolge" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Sehir" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["City"] <span class="text-red-600">*</span></label>
                        <select asp-for="Sehir" id="SehirSelect" required class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" data-selected="@(Model?.Sehir ?? string.Empty)">
                            <option value="">@Localizer["SelectCity"]</option>
                        </select>
                        <span asp-validation-for="Sehir" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Adres" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Address"] <span class="text-red-600">*</span></label>
                    <textarea asp-for="Adres" id="Adres" placeholder="@Localizer["AddressPlaceholder"]" rows="2" required
                              class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream resize-none transition-colors"></textarea>
                    <span asp-validation-for="Adres" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 space-y-2">
                    <div class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-amber-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-xs text-amber-800 leading-relaxed">@Localizer["IdentityPhotoRequiredWarning"]</p>
                    </div>
                    <div class="ps-7">
                        <label asp-for="KimlikFoto" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">
                            @Localizer["IdentityPhoto"] 
                            <span id="identityRequiredStar" class="text-red-600 font-bold @(!string.IsNullOrWhiteSpace(Model?.MevcutKimlikFotoUrl) ? "hidden" : "")">*</span>
                        </label>

                        <div id="existingPhotoBadge" class="@(!string.IsNullOrWhiteSpace(Model?.MevcutKimlikFotoUrl) ? "" : "hidden") mb-2 inline-flex items-center gap-1.5 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded font-medium shadow-sm">
                            <i class="fas fa-check-circle text-emerald-600 text-sm"></i>
                            <span id="existingPhotoText">@(isAr ? "تم إرفاق صورة الهوية مسبقاً (يمكنك تغييرها إن أردت)" : "ID Photo already attached (you can change it if needed)")</span>
                        </div>

                        <div id="identityUploadBox" class="overflow-hidden rounded border border-brand-border bg-white focus-within:border-brand-gold focus-within:ring-1 focus-within:ring-[#b58735] transition-all">
                            <input asp-for="KimlikFoto" id="KimlikFoto" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" aria-describedby="identityFileName identityFileHelp identityFileError" />
                            <label for="KimlikFoto" class="flex min-h-12 cursor-pointer items-center gap-3 px-3 py-2.5">
                                <span class="inline-flex shrink-0 items-center gap-2 rounded bg-brand-olive px-4 py-2 text-[11px] font-medium uppercase tracking-wider text-white transition-colors hover:bg-[#1c2001]">
                                    <i class="fas fa-upload" aria-hidden="true"></i>
                                    @Localizer["ChooseFile"]
                                </span>
                                <span id="identityFileName" class="min-w-0 truncate text-xs text-brand-mutedtext" data-empty-text="@Localizer["NoFileSelected"]">@Localizer["NoFileSelected"]</span>
                            </label>
                        </div>
                        <p id="identityFileHelp" class="text-brand-mutedtext text-xs mt-1">@Localizer["AllowedFormats"]: PNG, JPG, JPEG, WEBP (@Localizer["MaxFileSize"]: 8MB)</p>
                        <span asp-validation-for="KimlikFoto" class="text-red-600 text-xs mt-1 block"></span>
                        <span id="identityFileError" class="text-red-600 text-xs mt-1 hidden block font-medium"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Sifre" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Password"] <span class="text-red-600">*</span></label>
                        <input asp-for="Sifre" id="Sifre" type="password" placeholder="@Localizer["MinSixChars"]" autocomplete="new-password" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="Sifre" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SifreTekrar" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["PasswordRepeat"] <span class="text-red-600">*</span></label>
                        <input asp-for="SifreTekrar" id="SifreTekrar" type="password" placeholder="@Localizer["EnterPasswordAgain"]" autocomplete="new-password" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream transition-colors" />
                        <span asp-validation-for="SifreTekrar" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                 <div class="bg-[#f8f6f2] border border-brand-border rounded-lg p-4">
                     <label class="flex items-start gap-3 cursor-pointer">
                         <input asp-for="ToptanciMi" id="ToptanciMi" type="checkbox"
                                class="mt-0.5 w-4 h-4 rounded border-brand-border text-brand-olive focus:ring-[#b58735] focus:ring-1 focus:ring-offset-0" />
                         <div>
                             <span class="text-sm font-medium text-brand-darktext">@Localizer["RegisterAsWholesale"]</span>
                             <p class="text-xs text-brand-mutedtext mt-0.5 leading-relaxed">@Localizer["WholesaleRegistrationInfo"]</p>
                         </div>
                     </label>
                     <span asp-validation-for="ToptanciMi" class="text-red-600 text-xs mt-1 block"></span>
                 </div>

                <button type="submit" id="submitBtn"
                        class="w-full bg-brand-olive text-white py-3.5 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors font-medium mt-2 cursor-pointer shadow-sm flex items-center justify-center gap-2">
                    <i class="fas fa-user-plus"></i>
                    <span>@Localizer["CreateMembership"]</span>
                </button>
            </form>

            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-brand-border"></div>
                </div>
                <div class="relative flex justify-center text-xs">
                    <span class="bg-white px-3 text-brand-mutedtext uppercase tracking-widest">
                        @Localizer["Or"]
                    </span>
                </div>
            </div>

            <div>
                <form asp-controller="Hesap" asp-action="ExternalLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="flex w-full items-center justify-center gap-3 rounded border border-brand-border bg-white px-4 py-2.5 text-sm font-medium text-brand-darktext shadow-sm hover:bg-brand-cream transition-colors cursor-pointer">
                        <svg class="h-5 w-5" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>@Localizer["RegisterWithGoogle"]</span>
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-sm text-brand-mutedtext mt-6">
            @Localizer["AlreadyHaveAccount"]
            <a href="/account/GirisYap" class="text-brand-gold hover:underline font-medium">@Localizer["Login"]</a>
        </p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- Region & City Dynamic Dropdown Logic ---
        const isAr = @(isAr ? "true" : "false");
        const regionCities = {
            'القدس': [
                { ar: 'القدس', en: 'Jerusalem' },
                { ar: 'العيزرية', en: 'Al-Eizariya' },
                { ar: 'الرام', en: 'Al-Ram' },
                { ar: 'أبو ديس', en: 'Abu Dis' }
            ],
            'الضفة الغربية': [
                { ar: 'رام الله والبيرة', en: 'Ramallah & Al-Bireh' },
                { ar: 'نابلس', en: 'Nablus' },
                { ar: 'الخليل', en: 'Hebron' },
                { ar: 'جنين', en: 'Jenin' },
                { ar: 'بيت لحم', en: 'Bethlehem' },
                { ar: 'طولكرم', en: 'Tulkarm' },
                { ar: 'قلقيلية', en: 'Qalqilya' },
                { ar: 'أريحا', en: 'Jericho' },
                { ar: 'سلفيت', en: 'Salfit' },
                { ar: 'طوباس', en: 'Tubas' },
                { ar: 'بيرزيت', en: 'Birzeit' },
                { ar: 'حلحول', en: 'Halhul' },
                { ar: 'يطا', en: 'Yatta' },
                { ar: 'دورا', en: 'Dura' },
                { ar: 'بيت جالا', en: 'Beit Jala' }
            ],
            'قطاع غزة': [
                { ar: 'غزة', en: 'Gaza' },
                { ar: 'خان يونس', en: 'Khan Yunis' },
                { ar: 'رفح', en: 'Rafah' },
                { ar: 'دير البلح', en: 'Deir al-Balah' },
                { ar: 'شمال غزة', en: 'North Gaza' },
                { ar: 'بيت حانون', en: 'Beit Hanoun' },
                { ar: 'بيت لاهيا', en: 'Beit Lahiya' },
                { ar: 'جباليا', en: 'Jabalia' }
            ],
            'المناطق الداخلية 48': [
                { ar: 'يافا', en: 'Jaffa' },
                { ar: 'حيفا', en: 'Haifa' },
                { ar: 'عكا', en: 'Acre' },
                { ar: 'الناصرة', en: 'Nazareth' },
                { ar: 'اللد', en: 'Lydda' },
                { ar: 'الرملة', en: 'Ramla' },
                { ar: 'أم الفحم', en: 'Umm al-Fahm' },
                { ar: 'الطيبة', en: 'Tayibe' }
            ]
        };

        const bolgeSelect = document.getElementById('BolgeSelect');
        const sehirSelect = document.getElementById('SehirSelect');

        function updateCities(region, preselectedCity) {
            if (!sehirSelect) return;
            const defaultText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SelectCity"].Value));
            sehirSelect.innerHTML = '<option value="">' + defaultText + '</option>';

            if (!region || !regionCities[region]) return;

            const list = regionCities[region];
            list.forEach(function (c) {
                const opt = document.createElement('option');
                const val = isAr ? c.ar : c.en;
                opt.value = val;
                opt.textContent = isAr ? c.ar : c.en;
                if (preselectedCity && (preselectedCity === c.ar || preselectedCity === c.en || preselectedCity === val)) {
                    opt.selected = true;
                }
                sehirSelect.appendChild(opt);
            });
        }

        if (bolgeSelect && sehirSelect) {
            bolgeSelect.addEventListener('change', function () {
                updateCities(this.value, null);
            });

            const initialRegion = bolgeSelect.value;
            const initialCity = sehirSelect.dataset.selected || '';
            if (initialRegion) {
                updateCities(initialRegion, initialCity);
            } else if (initialCity) {
                for (const [reg, clist] of Object.entries(regionCities)) {
                    if (clist.some(c => c.ar === initialCity || c.en === initialCity)) {
                        bolgeSelect.value = reg;
                        updateCities(reg, initialCity);
                        break;
                    }
                }
            }
        }

        // --- ID Photo Upload Handling & Comprehensive Client-Side Form Validation ---
        const form = document.getElementById('kayitForm');
        const adSoyadInput = document.getElementById('AdSoyad');
        const kimlikNoInput = document.getElementById('KimlikNo');
        const dogumTarihiInput = document.getElementById('DogumTarihi');
        const telefonInput = document.getElementById('Telefon');
        const epostaInput = document.getElementById('Eposta');
        const adresInput = document.getElementById('Adres');
        const sifreInput = document.getElementById('Sifre');
        const sifreTekrarInput = document.getElementById('SifreTekrar');
        const input = document.getElementById('KimlikFoto');
        const fileName = document.getElementById('identityFileName');
        const uploadBox = document.getElementById('identityUploadBox');
        const errorMsg = document.getElementById('identityFileError');
        const mevcutKimlikFotoUrlInput = document.getElementById('MevcutKimlikFotoUrl');
        const identityRequiredStar = document.getElementById('identityRequiredStar');
        const existingPhotoBadge = document.getElementById('existingPhotoBadge');

        const i18n = {
            fullNameRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_FullNameRequired"].Value)),
            nationalIdRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_NationalIdRequired"].Value)),
            nationalIdLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_NationalIdLength"].Value)),
            dobRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_DateOfBirthRequired"].Value)),
            phoneRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_PhoneRequired"].Value)),
            emailRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_EmailRequired"].Value)),
            emailInvalid: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_EmailInvalid"].Value)),
            regionRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_RegionRequired"].Value)),
            cityRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_CityRequired"].Value)),
            addressRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_AddressRequired"].Value)),
            idPhotoRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["IDPhotoRequiredError"].Value)),
            passwordRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_PasswordRequired"].Value)),
            passwordLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_PasswordLength"].Value)),
            passwordRepeatRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_PasswordRepeatRequired"].Value)),
            passwordMismatch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Validation_PasswordMismatch"].Value)),
            fileSelectedText: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isAr ? "تم اختيار الملف:" : "File selected:")),
            fileTooLarge: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isAr ? "حجم الملف يتجاوز الحد المسموح (8 ميجابايت)" : "File size cannot exceed 8MB")),
            invalidFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isAr ? "الصيغ المدعومة فقط: PNG, JPG, JPEG, WEBP" : "Supported formats: PNG, JPG, JPEG, WEBP"))
        };

        function escapeHtml(text) {
            if (!text) return '';
            const p = document.createElement('p');
            p.textContent = text;
            return p.innerHTML;
        }

        function showFieldError(element, span, message) {
            if (span) {
                span.textContent = message;
                span.classList.remove('hidden');
                span.classList.add('block');
            }
            if (element) {
                element.classList.remove('border-brand-border', 'border-emerald-500', 'bg-emerald-50/20');
                element.classList.add('border-red-500', 'bg-red-50/20');
            }
        }

        function clearFieldError(element, span) {
            if (span) {
                span.textContent = '';
                span.classList.remove('block');
                span.classList.add('hidden');
            }
            if (element) {
                element.classList.remove('border-red-500', 'bg-red-50/20');
                element.classList.add('border-brand-border');
            }
        }

        function getErrorSpan(fieldName) {
            if (!form) return null;
            return form.querySelector(`span[data-valmsg-for="${fieldName}"]`) ||
                   form.querySelector(`span[asp-validation-for="${fieldName}"]`);
        }

        // Canlı alan doğrulama & hata temizleme dinleyicileri
        if (adSoyadInput) {
            const span = getErrorSpan('AdSoyad');
            adSoyadInput.addEventListener('input', () => {
                if (adSoyadInput.value.trim().length >= 2) clearFieldError(adSoyadInput, span);
            });
        }

        if (kimlikNoInput) {
            const span = getErrorSpan('KimlikNo');
            kimlikNoInput.addEventListener('input', () => {
                const val = kimlikNoInput.value.trim();
                if (val.length >= 5 && val.length <= 11) clearFieldError(kimlikNoInput, span);
            });
        }

        if (dogumTarihiInput) {
            const span = getErrorSpan('DogumTarihi');
            dogumTarihiInput.addEventListener('change', () => {
                if (dogumTarihiInput.value.trim() !== '') clearFieldError(dogumTarihiInput, span);
            });
        }

        if (telefonInput) {
            const span = getErrorSpan('Telefon');
            telefonInput.addEventListener('input', () => {
                if (telefonInput.value.trim().length >= 7) clearFieldError(telefonInput, span);
            });
        }

        if (epostaInput) {
            const span = getErrorSpan('Eposta');
            epostaInput.addEventListener('input', () => {
                const val = epostaInput.value.trim();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (val.length > 0 && emailRegex.test(val)) clearFieldError(epostaInput, span);
            });
        }

        if (bolgeSelect) {
            const span = getErrorSpan('Bolge');
            bolgeSelect.addEventListener('change', () => {
                if (bolgeSelect.value.trim() !== '') clearFieldError(bolgeSelect, span);
            });
        }

        if (sehirSelect) {
            const span = getErrorSpan('Sehir');
            sehirSelect.addEventListener('change', () => {
                if (sehirSelect.value.trim() !== '') clearFieldError(sehirSelect, span);
            });
        }

        if (adresInput) {
            const span = getErrorSpan('Adres');
            adresInput.addEventListener('input', () => {
                if (adresInput.value.trim().length >= 3) clearFieldError(adresInput, span);
            });
        }

        if (sifreInput) {
            const span = getErrorSpan('Sifre');
            sifreInput.addEventListener('input', () => {
                if (sifreInput.value.length >= 8) clearFieldError(sifreInput, span);
                if (sifreTekrarInput && sifreTekrarInput.value.length > 0) {
                    const spanTekrar = getErrorSpan('SifreTekrar');
                    if (sifreTekrarInput.value === sifreInput.value) {
                        clearFieldError(sifreTekrarInput, spanTekrar);
                    }
                }
            });
        }

        if (sifreTekrarInput) {
            const span = getErrorSpan('SifreTekrar');
            sifreTekrarInput.addEventListener('input', () => {
                if (sifreTekrarInput.value.length >= 8 && sifreTekrarInput.value === sifreInput.value) {
                    clearFieldError(sifreTekrarInput, span);
                }
            });
        }

        // Kimlik Fotoğrafı Seçimi ve Canlı Görsel Geri Bildirim
        function validateAndDisplayFile() {
            if (!input || !fileName || !uploadBox) return true;
            const file = input.files && input.files.length > 0 ? input.files[0] : null;

            if (file) {
                const ext = file.name.split('.').pop().toLowerCase();
                const allowed = ['png', 'jpg', 'jpeg', 'webp'];
                if (!allowed.includes(ext)) {
                    showFieldError(uploadBox, errorMsg, i18n.invalidFormat);
                    input.value = '';
                    resetFileState();
                    return false;
                }

                if (file.size > 8 * 1024 * 1024) {
                    showFieldError(uploadBox, errorMsg, i18n.fileTooLarge);
                    input.value = '';
                    resetFileState();
                    return false;
                }

                clearFieldError(uploadBox, errorMsg);
                uploadBox.classList.remove('border-brand-border', 'border-red-500');
                uploadBox.classList.add('border-emerald-500', 'bg-emerald-50/20');

                fileName.innerHTML = `<span class="inline-flex items-center gap-1.5 text-emerald-700 font-semibold truncate"><i class="fas fa-check-circle text-emerald-600"></i> ${escapeHtml(i18n.fileSelectedText)} ${escapeHtml(file.name)} <span class="text-emerald-600 font-bold">&#10003;</span></span>`;
                fileName.classList.remove('text-brand-mutedtext');

                if (identityRequiredStar) identityRequiredStar.classList.add('hidden');
                return true;
            } else {
                resetFileState();
                return false;
            }
        }

        function resetFileState() {
            if (!fileName || !uploadBox) return;
            uploadBox.classList.remove('border-emerald-500', 'bg-emerald-50/20');
            uploadBox.classList.add('border-brand-border');
            fileName.textContent = fileName.dataset.emptyText || '';
            fileName.classList.add('text-brand-mutedtext');

            const hasExisting = Boolean(mevcutKimlikFotoUrlInput && mevcutKimlikFotoUrlInput.value.trim() !== '') ||
                                Boolean(existingPhotoBadge && !existingPhotoBadge.classList.contains('hidden'));
            if (identityRequiredStar) {
                identityRequiredStar.classList.toggle('hidden', hasExisting);
            }
        }

        if (input) {
            input.addEventListener('change', validateAndDisplayFile);
        }

        // Form Submit: Eksiksiz İstemci Doğrulaması (Sayfa yenilenmesini ve dosya kaybını %100 engeller)
        if (form) {
            form.addEventListener('submit', function (e) {
                let isValid = true;
                let firstInvalid = null;

                function checkField(element, span, validCondition, message) {
                    if (!validCondition) {
                        isValid = false;
                        showFieldError(element, span, message);
                        if (!firstInvalid && element) {
                            firstInvalid = element;
                        }
                        return false;
                    } else {
                        clearFieldError(element, span);
                        return true;
                    }
                }

                // 1. Ad Soyad Kontrolü
                if (adSoyadInput) {
                    const val = adSoyadInput.value.trim();
                    checkField(adSoyadInput, getErrorSpan('AdSoyad'), val.length >= 2, i18n.fullNameRequired);
                }

                // 2. Kimlik Numarası Kontrolü (5 - 11 hane)
                if (kimlikNoInput) {
                    const val = kimlikNoInput.value.trim();
                    const hasVal = val.length > 0;
                    const validLen = val.length >= 5 && val.length <= 11;
                    checkField(kimlikNoInput, getErrorSpan('KimlikNo'), hasVal && validLen, !hasVal ? i18n.nationalIdRequired : i18n.nationalIdLength);
                }

                // 3. Doğum Tarihi Kontrolü
                if (dogumTarihiInput) {
                    const val = dogumTarihiInput.value.trim();
                    checkField(dogumTarihiInput, getErrorSpan('DogumTarihi'), val !== '', i18n.dobRequired);
                }

                // 4. Telefon Numarası Kontrolü
                if (telefonInput) {
                    const val = telefonInput.value.trim();
                    checkField(telefonInput, getErrorSpan('Telefon'), val.length >= 7, i18n.phoneRequired);
                }

                // 5. E-posta Kontrolü
                if (epostaInput) {
                    const val = epostaInput.value.trim();
                    const hasVal = val.length > 0;
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    const validEmail = emailRegex.test(val);
                    checkField(epostaInput, getErrorSpan('Eposta'), hasVal && validEmail, !hasVal ? i18n.emailRequired : i18n.emailInvalid);
                }

                // 6. Bölge Kontrolü
                if (bolgeSelect) {
                    const val = bolgeSelect.value.trim();
                    checkField(bolgeSelect, getErrorSpan('Bolge'), val !== '', i18n.regionRequired);
                }

                // 7. Şehir Kontrolü
                if (sehirSelect) {
                    const val = sehirSelect.value.trim();
                    checkField(sehirSelect, getErrorSpan('Sehir'), val !== '', i18n.cityRequired);
                }

                // 8. Adres Kontrolü
                if (adresInput) {
                    const val = adresInput.value.trim();
                    checkField(adresInput, getErrorSpan('Adres'), val.length >= 3, i18n.addressRequired);
                }

                // 9. Kimlik Fotoğrafı Kontrolü
                const hasNewFile = input && input.files && input.files.length > 0;
                const hasExisting = Boolean(mevcutKimlikFotoUrlInput && mevcutKimlikFotoUrlInput.value.trim() !== '') ||
                                    Boolean(existingPhotoBadge && !existingPhotoBadge.classList.contains('hidden'));

                if (!hasNewFile && !hasExisting) {
                    isValid = false;
                    showFieldError(uploadBox, errorMsg, i18n.idPhotoRequired);
                    if (!firstInvalid) {
                        firstInvalid = uploadBox;
                    }
                } else if (hasNewFile) {
                    if (!validateAndDisplayFile()) {
                        isValid = false;
                        if (!firstInvalid) {
                            firstInvalid = uploadBox;
                        }
                    }
                }

                // 10. Şifre Kontrolü
                if (sifreInput) {
                    const val = sifreInput.value;
                    const hasVal = val.length > 0;
                    const validLen = val.length >= 8;
                    checkField(sifreInput, getErrorSpan('Sifre'), hasVal && validLen, !hasVal ? i18n.passwordRequired : i18n.passwordLength);
                }

                // 11. Şifre Tekrar Kontrolü
                if (sifreTekrarInput) {
                    const val = sifreTekrarInput.value;
                    const hasVal = val.length > 0;
                    const matches = val === (sifreInput ? sifreInput.value : '');
                    checkField(sifreTekrarInput, getErrorSpan('SifreTekrar'), hasVal && matches, !hasVal ? i18n.passwordRepeatRequired : i18n.passwordMismatch);
                }

                // Eğer herhangi bir alan eksik/hatalıysa formun post edilmesini KESİNLİKLE ENGELLE
                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        if (typeof firstInvalid.focus === 'function') {
                            firstInvalid.focus();
                        }
                    }
                    return false;
                }
            });
        }
    });
</script>
