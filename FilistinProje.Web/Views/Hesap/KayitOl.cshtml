@model FilistinProje.Web.Models.KayitViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = @Localizer["Register"];
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-brand-cream">
    <div class="w-full max-w-lg">
        <div class="text-center mb-10">
             <a href="/" class="font-serif text-3xl tracking-widest text-brand-olive">@Localizer["BrandName"]</a>
            <p class="text-xs text-brand-mutedtext mt-2 tracking-wide">@Localizer["CreateNewAccount"]</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-6 hidden [&:not(:empty)]:block"></div>

        <div class="bg-white border border-brand-border rounded-lg p-8 shadow-sm">
            <form asp-action="KayitOl" method="post" enctype="multipart/form-data" class="space-y-4">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AdSoyad" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["FullName"]</label>
                        <input asp-for="AdSoyad" placeholder="@Localizer["YourFullName"]" autocomplete="name"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="AdSoyad" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="KimlikNo" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["NationalId"]</label>
                        <input asp-for="KimlikNo" placeholder="@Localizer["NationalIdPlaceholder"]" autocomplete="off"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="KimlikNo" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DogumTarihi" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["DateOfBirth"]</label>
                        <input asp-for="DogumTarihi" type="date"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="DogumTarihi" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Telefon" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Phone"]</label>
                        <input asp-for="Telefon" type="tel" inputmode="tel" maxlength="20" placeholder="@Localizer["PhonePlaceholder"]" autocomplete="tel" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="Telefon" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Eposta" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Email"]</label>
                    <input asp-for="Eposta" type="email" placeholder="@Localizer["ExampleEmail"]" autocomplete="email"
                           class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                    <span asp-validation-for="Eposta" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Adres" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Address"]</label>
                    <textarea asp-for="Adres" placeholder="@Localizer["AddressPlaceholder"]" rows="2"
                              class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream resize-none"></textarea>
                    <span asp-validation-for="Adres" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 space-y-2">
                    <div class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-amber-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-xs text-amber-800 leading-relaxed">@Localizer["IdentityPhotoRequiredWarning"]</p>
                    </div>
                    <div class="pl-7">
                        <label asp-for="KimlikFoto" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["IdentityPhoto"] <span class="text-red-500">*</span></label>
                        <input asp-for="KimlikFoto" type="file" accept="image/png,image/jpeg,image/webp" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-white file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-brand-olive file:text-white file:text-xs file:rounded file:cursor-pointer file:uppercase file:tracking-wider" />
                        <p class="text-brand-mutedtext text-xs mt-1">@Localizer["IdentityPhotoHelp"]</p>
                        <span asp-validation-for="KimlikFoto" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Sehir" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["City"]</label>
                     <select asp-for="Sehir" class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream">
                         <option value="">@Localizer["SelectCity"]</option>
                         <option>Gaza</option><option>North Gaza</option><option>Beit Hanoun</option>
                         <option>Beit Lahiya</option><option>Jabalia</option><option>Ramallah</option>
                         <option>El-Bireh</option><option>Birzeit</option><option>Abu Dis</option>
                         <option>Nablus</option><option>Tubas</option><option>Qalqilya</option>
                         <option>Salfit</option><option>Jenin</option><option>Hebron</option>
                         <option>Yatta</option><option>Dura</option><option>Halhul</option>
                         <option>Bethlehem</option><option>Beit Jala</option><option>Artas</option>
                         <option>Tulkarm</option><option>Ajjah</option><option>Jericho</option>
                         <option>Jerusalem</option><option>Al-Ram</option><option>Al-Eizariya</option>
                     </select>
                    <span asp-validation-for="Sehir" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Sifre" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Password"]</label>
                        <input asp-for="Sifre" type="password" placeholder="@Localizer["MinSixChars"]" autocomplete="new-password"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="Sifre" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="SifreTekrar" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["PasswordRepeat"]</label>
                        <input asp-for="SifreTekrar" type="password" placeholder="@Localizer["EnterPasswordAgain"]" autocomplete="new-password"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="SifreTekrar" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                 <div class="bg-[#f8f6f2] border border-brand-border rounded-lg p-4">
                     <label class="flex items-start gap-3 cursor-pointer">
                         <input asp-for="ToptanciMi" type="checkbox"
                                class="mt-0.5 w-4 h-4 rounded border-brand-border text-brand-olive focus:ring-[#b58735] focus:ring-1 focus:ring-offset-0" />
                         <div>
                             <span class="text-sm font-medium text-brand-darktext">@Localizer["RegisterAsWholesale"]</span>
                             <p class="text-xs text-brand-mutedtext mt-0.5 leading-relaxed">@Localizer["WholesaleRegistrationInfo"]</p>
                         </div>
                     </label>
                     <span asp-validation-for="ToptanciMi" class="text-red-600 text-xs mt-1 block"></span>
                 </div>

                <button type="submit"
                        class="w-full bg-brand-olive text-white py-3 text-xs tracking-widest uppercase rounded hover:bg-[#1c2001] transition-colors font-medium mt-2">
                    @Localizer["CreateMembership"]
                </button>
            </form>

            <div class="mt-8">
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-brand-border"></div>
                    </div>
                    <div class="relative flex justify-center text-xs">
                        <span class="bg-white px-3 text-brand-mutedtext uppercase tracking-widest">
                            @Localizer["Or"]
                        </span>
                    </div>
                </div>

                <div class="mt-6">
                    <a href="#" class="flex w-full items-center justify-center gap-3 rounded border border-brand-border bg-white px-4 py-2.5 text-sm font-medium text-brand-darktext shadow-sm hover:bg-brand-cream transition-colors">
                        <svg class="h-5 w-5" viewBox="0 0 24 24">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        @Localizer["RegisterWithGoogle"]
                    </a>
                </div>
            </div>
        </div>

        <p class="text-center text-sm text-brand-mutedtext mt-6">
            @Localizer["AlreadyHaveAccount"]
            <a href="/account/GirisYap" class="text-brand-gold hover:underline font-medium">@Localizer["Login"]</a>
        </p>
    </div>
</div>
