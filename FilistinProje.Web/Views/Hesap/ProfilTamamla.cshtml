@model FilistinProje.Web.Models.ProfilTamamlaViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["CompleteProfile"];
    bool isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="min-h-[80vh] flex items-center justify-center py-16 px-4 bg-brand-cream">
    <div class="w-full max-w-lg">
        <div class="text-center mb-8">
            <a href="/" class="font-serif text-3xl tracking-widest text-brand-olive">@Localizer["BrandName"]</a>
            <h1 class="text-lg font-bold text-brand-darktext mt-3">@Localizer["CompleteProfile"]</h1>
            <p class="text-xs text-brand-mutedtext mt-1.5 tracking-wide max-w-md mx-auto">@Localizer["CompleteProfile_Desc"]</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-6 hidden [&:not(:empty)]:block"></div>

        <div class="bg-white border border-brand-border rounded-lg p-8 shadow-sm">
            <form asp-action="ProfilTamamla" method="post" enctype="multipart/form-data" class="space-y-4" id="profilTamamlaForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="MevcutKimlikFotoUrl" />

                <!-- E-posta (Salt Okunur) -->
                <div>
                    <label class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Email"]</label>
                    <input type="text" value="@Model.Eposta" readonly dir="ltr"
                           class="w-full border border-brand-border rounded px-4 py-3 text-sm bg-gray-100 text-gray-600 outline-none cursor-not-allowed" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AdSoyad" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["FullName"]</label>
                        <input asp-for="AdSoyad" placeholder="@Localizer["YourFullName"]" autocomplete="name"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="AdSoyad" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="KimlikNo" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["NationalId"] <span class="text-red-600">*</span></label>
                        <input asp-for="KimlikNo" placeholder="@Localizer["NationalIdPlaceholder"]" autocomplete="off" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="KimlikNo" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DogumTarihi" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["DateOfBirth"] <span class="text-red-600">*</span></label>
                        <input asp-for="DogumTarihi" type="date" required
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="DogumTarihi" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Telefon" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Phone"] <span class="text-red-600">*</span></label>
                        <input asp-for="Telefon" type="tel" inputmode="tel" maxlength="20" placeholder="@Localizer["PhonePlaceholder"]" autocomplete="tel" required dir="ltr"
                               class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" />
                        <span asp-validation-for="Telefon" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Bolge" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Region"] <span class="text-red-600">*</span></label>
                        <select asp-for="Bolge" id="BolgeSelect" required class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream">
                            <option value="">@Localizer["SelectRegion"]</option>
                            <option value="القدس">@(isAr ? "القدس وضواحيها" : "Jerusalem & Suburbs")</option>
                            <option value="الضفة الغربية">@(isAr ? "الضفة الغربية" : "West Bank")</option>
                            <option value="قطاع غزة">@(isAr ? "قطاع غزة" : "Gaza Strip")</option>
                            <option value="المناطق الداخلية 48">@(isAr ? "المناطق الداخلية 48" : "Interior 48 Areas")</option>
                        </select>
                        <span asp-validation-for="Bolge" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Sehir" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["City"] <span class="text-red-600">*</span></label>
                        <select asp-for="Sehir" id="SehirSelect" required class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream" data-selected="@(Model?.Sehir ?? string.Empty)">
                            <option value="">@Localizer["SelectCity"]</option>
                        </select>
                        <span asp-validation-for="Sehir" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Adres" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">@Localizer["Address"] <span class="text-red-600">*</span></label>
                    <textarea asp-for="Adres" placeholder="@Localizer["AddressPlaceholder"]" rows="2" required
                              class="w-full border border-brand-border rounded px-4 py-3 text-sm focus:ring-1 focus:ring-[#b58735] focus:border-brand-gold outline-none bg-brand-cream resize-none"></textarea>
                    <span asp-validation-for="Adres" class="text-red-600 text-xs mt-1 block"></span>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 space-y-2">
                    <div class="flex items-start gap-2">
                        <svg class="w-5 h-5 text-amber-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-xs text-amber-800 leading-relaxed">@Localizer["IdentityPhotoRequiredWarning"]</p>
                    </div>
                    <div class="ps-7">
                        <label asp-for="KimlikFoto" class="block text-xs font-medium text-brand-darktext tracking-wide mb-1.5 uppercase">
                            @Localizer["IdentityPhoto"] 
                            @if (string.IsNullOrWhiteSpace(Model.MevcutKimlikFotoUrl))
                            {
                                <span class="text-red-600 font-bold">*</span>
                            }
                        </label>

                        @if (!string.IsNullOrWhiteSpace(Model.MevcutKimlikFotoUrl))
                        {
                            <div class="mb-2 inline-flex items-center gap-1.5 text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded">
                                <i class="fas fa-check-circle text-emerald-600"></i>
                                <span>@(isAr ? "تم إرفاق صورة الهوية مسبقاً (يمكنك تغييرها إن أردت)" : "ID Photo already attached (you can change it if needed)")</span>
                            </div>
                        }

                        <div id="identityUploadBox" class="overflow-hidden rounded border border-brand-border bg-white focus-within:border-brand-gold focus-within:ring-1 focus-within:ring-[#b58735]">
                            <input asp-for="KimlikFoto" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" aria-describedby="identityFileName identityFileHelp identityFileError" />
                            <label for="KimlikFoto" class="flex min-h-12 cursor-pointer items-center gap-3 px-3 py-2.5">
                                <span class="inline-flex shrink-0 items-center gap-2 rounded bg-brand-olive px-4 py-2 text-[11px] font-medium uppercase tracking-wider text-white transition-colors hover:bg-[#1c2001]">
                                    <i class="fas fa-upload" aria-hidden="true"></i>
                                    @Localizer["ChooseFile"]
                                </span>
                                <span id="identityFileName" class="truncate text-xs text-brand-mutedtext" data-empty-text="@Localizer["NoFileChosen"]">@Localizer["NoFileChosen"]</span>
                            </label>
                        </div>
                        <p id="identityFileHelp" class="text-[11px] text-brand-mutedtext mt-1">@Localizer["AllowedFormats"]: PNG, JPG, JPEG, WEBP (@Localizer["MaxFileSize"]: 8MB)</p>
                        <p id="identityFileError" class="text-red-600 text-xs mt-1 hidden"></p>
                        <span asp-validation-for="KimlikFoto" class="text-red-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full bg-brand-olive text-white text-xs tracking-widest uppercase py-3.5 px-8 rounded font-medium hover:bg-[#1c2001] transition-colors shadow-sm flex items-center justify-center gap-2">
                        <i class="fas fa-check"></i>
                        <span>@Localizer["CompleteProfile_Save"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const isAr = @(isAr ? "true" : "false");
        const regionCities = {
            'القدس': [
                { ar: 'القدس', en: 'Jerusalem' },
                { ar: 'البلدة القديمة', en: 'Old City' },
                { ar: 'بيت حنينا', en: 'Beit Hanina' },
                { ar: 'شعفاط', en: 'Shuafat' },
                { ar: 'سلوان', en: 'Silwan' },
                { ar: 'الطور', en: 'At-Tur' },
                { ar: 'العيسوية', en: 'Al-Isawiya' },
                { ar: 'كفر عقب', en: 'Kafr Aqab' },
                { ar: 'مخيم قلنديا', en: 'Qalandia Camp' },
                { ar: 'عناتا', en: 'Anata' },
                { ar: 'الرام', en: 'Al-Ram' },
                { ar: 'العيزرية', en: 'Al-Eizariya' },
                { ar: 'أبو ديس', en: 'Abu Dis' },
                { ar: 'السواحرة', en: 'Al-Sawahreh' },
                { ar: 'جبل المكبر', en: 'Jabal Al-Mukabbir' },
                { ar: 'صور باهر', en: 'Sur Baher' },
                { ar: 'أم طوبا', en: 'Umm Tuba' },
                { ar: 'بيت صفافا', en: 'Beit Safafa' }
            ],
            'الضفة الغربية': [
                { ar: 'رام الله', en: 'Ramallah' },
                { ar: 'البيرة', en: 'Al-Bireh' },
                { ar: 'نابلس', en: 'Nablus' },
                { ar: 'الخليل', en: 'Hebron' },
                { ar: 'جنين', en: 'Jenin' },
                { ar: 'بيت لحم', en: 'Bethlehem' },
                { ar: 'طولكرم', en: 'Tulkarm' },
                { ar: 'قلقيلية', en: 'Qalqilya' },
                { ar: 'أريحا', en: 'Jericho' },
                { ar: 'سلفيت', en: 'Salfit' },
                { ar: 'طوباس', en: 'Tubas' },
                { ar: 'بيتونيا', en: 'Betunia' },
                { ar: 'حلحول', en: 'Halhul' },
                { ar: 'يطا', en: 'Yatta' },
                { ar: 'دورا', en: 'Dura' },
                { ar: 'الظاهرية', en: 'Al-Dhahiriya' }
            ],
            'قطاع غزة': [
                { ar: 'غزة', en: 'Gaza' },
                { ar: 'خان يونس', en: 'Khan Yunis' },
                { ar: 'رفح', en: 'Rafah' },
                { ar: 'دير البلح', en: 'Deir al-Balah' },
                { ar: 'شمال غزة', en: 'North Gaza' },
                { ar: 'بيت حانون', en: 'Beit Hanoun' },
                { ar: 'بيت لاهيا', en: 'Beit Lahiya' },
                { ar: 'جباليا', en: 'Jabalia' }
            ],
            'المناطق الداخلية 48': [
                { ar: 'يافا', en: 'Jaffa' },
                { ar: 'حيفا', en: 'Haifa' },
                { ar: 'عكا', en: 'Acre' },
                { ar: 'الناصرة', en: 'Nazareth' },
                { ar: 'اللد', en: 'Lydda' },
                { ar: 'الرملة', en: 'Ramla' },
                { ar: 'أم الفحم', en: 'Umm al-Fahm' },
                { ar: 'الطيبة', en: 'Tayibe' }
            ]
        };

        const bolgeSelect = document.getElementById('BolgeSelect');
        const sehirSelect = document.getElementById('SehirSelect');

        function updateCities(region, preselectedCity) {
            if (!sehirSelect) return;
            const defaultText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SelectCity"].Value));
            sehirSelect.innerHTML = '<option value="">' + defaultText + '</option>';

            if (!region || !regionCities[region]) return;

            const list = regionCities[region];
            list.forEach(function (c) {
                const opt = document.createElement('option');
                const val = isAr ? c.ar : c.en;
                opt.value = val;
                opt.textContent = isAr ? c.ar : c.en;
                if (preselectedCity && (preselectedCity === c.ar || preselectedCity === c.en || preselectedCity === val)) {
                    opt.selected = true;
                }
                sehirSelect.appendChild(opt);
            });
        }

        if (bolgeSelect && sehirSelect) {
            bolgeSelect.addEventListener('change', function () {
                updateCities(this.value, null);
            });

            const initialRegion = bolgeSelect.value;
            const initialCity = sehirSelect.dataset.selected || '';
            if (initialRegion) {
                updateCities(initialRegion, initialCity);
            } else if (initialCity) {
                for (const [reg, clist] of Object.entries(regionCities)) {
                    if (clist.some(c => c.ar === initialCity || c.en === initialCity)) {
                        bolgeSelect.value = reg;
                        updateCities(reg, initialCity);
                        break;
                    }
                }
            }
        }

        // --- ID Photo Upload Handling & Form Validation ---
        const input = document.getElementById('KimlikFoto');
        const fileName = document.getElementById('identityFileName');
        const uploadBox = document.getElementById('identityUploadBox');
        const errorMsg = document.getElementById('identityFileError');
        const form = document.getElementById('profilTamamlaForm');
        const existingFoto = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MevcutKimlikFotoUrl ?? ""));

        if (input && fileName) {
            input.addEventListener('change', function () {
                const selected = this.files && this.files.length ? this.files[0].name : '';
                fileName.textContent = selected || fileName.dataset.emptyText;
                fileName.classList.toggle('text-brand-darktext', Boolean(selected));
                fileName.classList.toggle('text-brand-mutedtext', !selected);

                if (selected) {
                    if (errorMsg) errorMsg.classList.add('hidden');
                    if (uploadBox) {
                        uploadBox.classList.remove('border-red-500');
                        uploadBox.classList.add('border-brand-border');
                    }
                }
            });
        }

        const idPhotoErrorText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["IDPhotoRequiredError"].Value));
        if (form) {
            form.addEventListener('submit', function (e) {
                const hasFile = input && input.files && input.files.length > 0;
                if (!hasFile && !existingFoto) {
                    e.preventDefault();
                    if (errorMsg) {
                        errorMsg.textContent = idPhotoErrorText;
                        errorMsg.classList.remove('hidden');
                    }
                    if (uploadBox) {
                        uploadBox.classList.remove('border-brand-border');
                        uploadBox.classList.add('border-red-500');
                    }
                    uploadBox ? uploadBox.scrollIntoView({ behavior: 'smooth', block: 'center' }) : (input ? input.focus() : null);
                    return false;
                }
            });
        }
    });
</script>
