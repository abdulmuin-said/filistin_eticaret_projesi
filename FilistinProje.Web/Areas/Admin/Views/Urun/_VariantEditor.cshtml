@model IList<FilistinProje.Core.Varliklar.UrunSecenek>
@using FilistinProje.Service.Helpers
@{
    var variants = (Model ?? new System.Collections.Generic.List<FilistinProje.Core.Varliklar.UrunSecenek>())
        .OrderByDescending(x => x.VarsayilanMi)
        .ThenBy(x => x.Sira)
        .ThenBy(x => x.Id)
        .ToList();
    var canvasOptionCategoryIds = ViewBag.CanvasOptionCategoryIds as IEnumerable<int> ?? Enumerable.Empty<int>();
    var canvasOptionCategoryIdJson = System.Text.Json.JsonSerializer.Serialize(canvasOptionCategoryIds);
    var productImages = (ViewBag.UrunGorselleri as IEnumerable<string> ?? Enumerable.Empty<string>()).ToList();
    var urunId = ViewBag.UrunId as int? ?? 0;
}

<div class="ca-card mt-4" style="border:1px solid var(--ca-border);">
    <div class="ca-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="ca-card-title">@Localizer["Admin_AdvancedVariants"]</span>
            <div class="small text-muted mt-1">@Localizer["Admin_AdvancedVariantsDesc"]</div>
        </div>
        <button type="button" class="ca-btn ca-btn-primary ca-btn-sm" data-variant-add>
            <i class="fas fa-plus"></i> @Localizer["Admin_AddVariation"]
        </button>
    </div>
    <div class="ca-card-body">
        <div id="variantEmptyState" class="alert alert-light border mb-3 @(variants.Any() ? "d-none" : string.Empty)">
            @Localizer["Admin_NoVariantsYet"]
        </div>

        <div id="variantList" class="ca-variant-grid">
            @for (var i = 0; i < variants.Count; i++)
            {
                var variant = variants[i];
                var temizOlcu = (variant.Olcu ?? string.Empty).Trim();
                var temizCerceveTipi = (variant.CerceveTipi ?? string.Empty).Trim();
                var temizCerceveRengi = (variant.CerceveRengi ?? string.Empty).Trim();
                var temizCerceveKalinligi = (variant.CerceveKalinligi ?? string.Empty).Trim();
                var temizMalzemeTuru = (variant.MalzemeTuru ?? string.Empty).Trim();
                var temizYon = (variant.Yon ?? string.Empty).Trim();
                var temizKisilestirmeMetni = (variant.KisilestirmeMetni ?? string.Empty).Trim();
                var temizOzelTasarimNotu = (variant.OzelTasarimNotu ?? string.Empty).Trim();
                var temizVaryantBasligi = (variant.VaryantBasligi ?? string.Empty).Trim();
                var temizVaryantOzeti = (variant.VaryantOzeti ?? string.Empty).Trim();
                <div class="ca-variant-card" data-variant-card data-index="@i">
                    <div class="ca-variant-card-head">
                        <div>
                            <div class="ca-variant-title" data-variant-title>@(string.IsNullOrWhiteSpace(temizVaryantBasligi) ? string.Format(Localizer["Admin_Variation"].Value + " {0}", i + 1) : temizVaryantBasligi)</div>
                            <div class="ca-variant-subtitle" data-variant-subtitle>@(string.IsNullOrWhiteSpace(temizVaryantOzeti) ? Localizer["Admin_VariationSubtitleDefault"].Value : temizVaryantOzeti)</div>
                        </div>
                        <button type="button" class="ca-btn ca-btn-outline ca-btn-sm" data-variant-remove>
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>

                    <input type="hidden" data-variant-field="Id" name="UrunSecenek[@i].Id" value="@variant.Id" />

                    <div class="row g-3">
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Olcu">@Localizer["Admin_Size"]</label>
                            <input class="ca-input" data-variant-field="Olcu" name="UrunSecenek[@i].Olcu" value="@temizOlcu" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="OlcuBirimi">@Localizer["Admin_MeasureUnit"]</label>
                            <select class="ca-input" data-variant-field="OlcuBirimi" name="UrunSecenek[@i].OlcuBirimi">
                                @foreach (var unit in new[] { "", "mm", "cm", "m", "ml", "L", "g", "kg", "adet" })
                                {
                                    <option value="@unit" selected="@(variant.OlcuBirimi == unit ? "selected" : null)">@(string.IsNullOrEmpty(unit) ? Localizer["Admin_NoUnit"].Value : unit)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Beden">@Localizer["Admin_SizeSlash"]</label>
                            <input class="ca-input" data-variant-field="Beden" name="UrunSecenek[@i].Beden" value="@variant.Beden" placeholder="S, M, L, XL..." />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Renk">@Localizer["Admin_Color"]</label>
                            <input class="ca-input" data-variant-field="Renk" name="UrunSecenek[@i].Renk" value="@variant.Renk" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="RenkKodu">@Localizer["Admin_ColorCode"]</label>
                            <div class="ca-variant-color-control">
                                <input class="ca-variant-color-picker" type="color" value="@variant.GuvenliRenkKodu" data-variant-color-picker aria-label="@Localizer["Admin_ColorPicker"]" />
                                <input class="ca-input" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" placeholder="#RRGGBB" autocomplete="off" data-variant-field="RenkKodu" name="UrunSecenek[@i].RenkKodu" value="@variant.RenkKodu" />
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6" data-canvas-option>
                            <label class="ca-label" data-label-for="CerceveTipi">@Localizer["Admin_FrameType"]</label>
                            <input class="ca-input" data-variant-field="CerceveTipi" name="UrunSecenek[@i].CerceveTipi" value="@temizCerceveTipi" />
                        </div>
                        <div class="col-lg-2 col-md-6" data-canvas-option>
                            <label class="ca-label" data-label-for="CerceveRengi">@Localizer["Admin_FrameColor"]</label>
                            <input class="ca-input" data-variant-field="CerceveRengi" name="UrunSecenek[@i].CerceveRengi" value="@temizCerceveRengi" />
                        </div>
                        <div class="col-lg-2 col-md-6" data-canvas-option>
                            <label class="ca-label" data-label-for="CerceveKalinligi">@Localizer["Admin_Thickness"]</label>
                            <input class="ca-input" data-variant-field="CerceveKalinligi" name="UrunSecenek[@i].CerceveKalinligi" value="@temizCerceveKalinligi" />
                        </div>
                        <div class="col-lg-2 col-md-6" data-canvas-option>
                            <label class="ca-label" data-label-for="ParcaSayisi">@Localizer["Admin_Piece"]</label>
                            <input class="ca-input" type="number" min="1" data-variant-field="ParcaSayisi" name="UrunSecenek[@i].ParcaSayisi" value="@(variant.ParcaSayisi < 1 ? 1 : variant.ParcaSayisi)" />
                        </div>

                        <div class="col-lg-3 col-md-6" data-canvas-option>
                            <label class="ca-label" data-label-for="MalzemeTuru">@Localizer["Admin_Material"]</label>
                            <input class="ca-input" data-variant-field="MalzemeTuru" name="UrunSecenek[@i].MalzemeTuru" value="@temizMalzemeTuru" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Yon">@Localizer["Admin_Orientation"]</label>
                            <input class="ca-input" data-variant-field="Yon" name="UrunSecenek[@i].Yon" value="@temizYon" />
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="ca-label" data-label-for="VaryantSku">@Localizer["Admin_VariantSku"]</label>
                            <input class="ca-input" data-variant-field="VaryantSku" name="UrunSecenek[@i].VaryantSku" value="@variant.VaryantSku" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Sira">@Localizer["Admin_Sira"]</label>
                            <input class="ca-input" type="number" min="0" data-variant-field="Sira" name="UrunSecenek[@i].Sira" value="@variant.Sira" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="UretimSuresiGun">@Localizer["Admin_ProductionDays"]</label>
                            <input class="ca-input" type="number" min="0" data-variant-field="UretimSuresiGun" name="UrunSecenek[@i].UretimSuresiGun" value="@variant.UretimSuresiGun" />
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="SatisFiyati">@Localizer["Admin_SalePrice"] (₪)</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="SatisFiyati" name="UrunSecenek[@i].SatisFiyati" value="@variant.SatisFiyati.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="IndirimliFiyat">@Localizer["Admin_VariantDiscountPrice"] (₪)</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="IndirimliFiyat" name="UrunSecenek[@i].IndirimliFiyat" value="@(variant.IndirimliFiyat?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)" placeholder="—" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="FiyatFarki">@Localizer["Admin_PriceDifference"] (₪)</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="FiyatFarki" name="UrunSecenek[@i].FiyatFarki" value="@variant.FiyatFarki.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="MaliyetFiyati">@Localizer["Admin_Cost"] (₪)</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="MaliyetFiyati" name="UrunSecenek[@i].MaliyetFiyati" value="@variant.MaliyetFiyati.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="StokAdedi">@Localizer["Admin_Stok"]</label>
                            <input class="ca-input" type="number" min="0" data-variant-field="StokAdedi" name="UrunSecenek[@i].StokAdedi" value="@variant.StokAdedi" />
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label class="ca-label" data-label-for="Desi">@Localizer["Admin_Weight"]</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="Desi" name="UrunSecenek[@i].Desi" value="@variant.Desi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <label class="ca-label" data-label-for="GorselUrl">@Localizer["Admin_VariantImage"]</label>
                            <div class="ca-variant-image-widget p-2 rounded border d-flex align-items-center gap-3" style="background:#f8fafc;">
                                <div class="ca-variant-thumb position-relative" style="width:58px; height:58px; min-width:58px; border-radius:8px; overflow:hidden; border:1px solid var(--ca-border); background:#fff; display:flex; align-items:center; justify-content:center;">
                                    <img src="@(string.IsNullOrWhiteSpace(variant.GorselUrl) ? "/img/products/placeholder.webp" : variant.GorselUrl)" 
                                         alt="Variant" 
                                         class="ca-variant-thumb-img w-100 h-100" 
                                         style="object-fit:cover; display:@(string.IsNullOrWhiteSpace(variant.GorselUrl) ? "none" : "block");" 
                                         data-variant-img-preview />
                                    <i class="fas fa-image text-muted fs-4 @(!string.IsNullOrWhiteSpace(variant.GorselUrl) ? "d-none" : "")" data-variant-img-placeholder></i>
                                    <div class="ca-variant-img-spinner position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none align-items-center justify-content-center" data-variant-img-spinner>
                                        <i class="fas fa-spinner fa-spin text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <button type="button" class="ca-btn ca-btn-outline ca-btn-sm py-1 px-2" data-variant-upload-trigger>
                                            <i class="fas fa-upload me-1"></i> @Localizer["Admin_UploadImage"]
                                        </button>
                                        <input type="file" accept=".jpg,.jpeg,.png,.webp" class="d-none" data-variant-file-input />
                                        
                                        @if (productImages.Any())
                                        {
                                            <div class="dropdown d-inline-block">
                                                <button type="button" class="ca-btn ca-btn-outline ca-btn-sm py-1 px-2 dropdown-toggle" data-bs-toggle="dropdown" title="@Localizer["Admin_SelectFromGallery"]">
                                                    <i class="fas fa-images me-1"></i> @Localizer["Admin_SelectFromGallery"]
                                                </button>
                                                <div class="dropdown-menu p-2 shadow" style="min-width:260px; max-height:220px; overflow-y:auto; z-index:1070;">
                                                    <div class="small fw-bold text-muted mb-2 px-1">@Localizer["Admin_SelectFromGallery"]</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var pImg in productImages)
                                                        {
                                                            <button type="button" class="border rounded p-0 btn btn-sm btn-light" style="width:46px; height:46px; overflow:hidden;" data-variant-gallery-pick="@pImg" title="@pImg">
                                                                <img src="@pImg" style="width:100%; height:100%; object-fit:cover;" />
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <button type="button" class="ca-btn ca-btn-icon ca-btn-sm text-danger @(string.IsNullOrWhiteSpace(variant.GorselUrl) ? "d-none" : "")" data-variant-img-remove title="@Localizer["Admin_RemoveImage"]">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                    <input class="ca-input ca-input-sm" style="font-size:0.78rem; height:28px; padding:2px 8px;" 
                                           data-variant-field="GorselUrl" 
                                           name="UrunSecenek[@i].GorselUrl" 
                                           value="@variant.GorselUrl" 
                                           placeholder="https://... /img/..." />
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <label class="ca-label" data-label-for="KisilestirmeMetni">@Localizer["Admin_PersonalizationText"]</label>
                            <textarea class="ca-textarea" rows="2" data-variant-field="KisilestirmeMetni" name="UrunSecenek[@i].KisilestirmeMetni">@temizKisilestirmeMetni</textarea>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="ca-label" data-label-for="OzelTasarimNotu">@Localizer["Admin_CustomDesignNote"]</label>
                            <textarea class="ca-textarea" rows="2" data-variant-field="OzelTasarimNotu" name="UrunSecenek[@i].OzelTasarimNotu">@temizOzelTasarimNotu</textarea>
                        </div>

                        <div class="col-12">
                            <div class="ca-variant-flags">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-variant-field="AktifMi" name="UrunSecenek[@i].AktifMi" value="true" @(variant.AktifMi ? "checked" : string.Empty) />
                                    <input type="hidden" name="UrunSecenek[@i].AktifMi" value="false" />
                                    <span class="form-check-label">@Localizer["Admin_Aktif"]</span>
                                </label>
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-variant-field="VarsayilanMi" name="UrunSecenek[@i].VarsayilanMi" value="true" @(variant.VarsayilanMi ? "checked" : string.Empty) data-variant-default />
                                    <input type="hidden" name="UrunSecenek[@i].VarsayilanMi" value="false" />
                                    <span class="form-check-label">@Localizer["Admin_Varsayilan"]</span>
                                </label>
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-variant-field="TukeninceGizle" name="UrunSecenek[@i].TukeninceGizle" value="true" @(variant.TukeninceGizle ? "checked" : string.Empty) />
                                    <input type="hidden" name="UrunSecenek[@i].TukeninceGizle" value="false" />
                                    <span class="form-check-label">@Localizer["Admin_HideWhenSoldOut"]</span>
                                </label>
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-variant-field="OnSipariseAcikMi" name="UrunSecenek[@i].OnSipariseAcikMi" value="true" @(variant.OnSipariseAcikMi ? "checked" : string.Empty) />
                                    <input type="hidden" name="UrunSecenek[@i].OnSipariseAcikMi" value="false" />
                                    <span class="form-check-label">@Localizer["Admin_PreOrder"]</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <template id="variantCardTemplate">
            <div class="ca-variant-card" data-variant-card data-index="__index__">
                <div class="ca-variant-card-head">
                    <div>
                        <div class="ca-variant-title" data-variant-title>@Localizer["Admin_NewVariation"]</div>
                        <div class="ca-variant-subtitle" data-variant-subtitle >@Localizer["Admin_VariationSubtitleDefault"]</div>
                    </div>
                    <button type="button" class="ca-btn ca-btn-outline ca-btn-sm" data-variant-remove>
                        <i class="fas fa-trash"></i>
                    </button>
                </div>

                <input type="hidden" data-variant-field="Id" name="UrunSecenek[__index__].Id" value="0" />

                <div class="row g-3">
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Olcu">@Localizer["Admin_Size"]</label>
                        <input class="ca-input" data-variant-field="Olcu" name="UrunSecenek[__index__].Olcu" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="OlcuBirimi">@Localizer["Admin_MeasureUnit"]</label>
                        <select class="ca-input" data-variant-field="OlcuBirimi" name="UrunSecenek[__index__].OlcuBirimi">
                            <option value="">@Localizer["Admin_NoUnit"]</option><option>mm</option><option>cm</option><option>m</option><option>ml</option><option>L</option><option>g</option><option>kg</option><option>adet</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Beden">@Localizer["Admin_SizeSlash"]</label>
                        <input class="ca-input" data-variant-field="Beden" name="UrunSecenek[__index__].Beden" value="" placeholder="S, M, L, XL..." />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Renk">@Localizer["Admin_Color"]</label>
                        <input class="ca-input" data-variant-field="Renk" name="UrunSecenek[__index__].Renk" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="RenkKodu">@Localizer["Admin_ColorCode"]</label>
                        <div class="ca-variant-color-control">
                            <input class="ca-variant-color-picker" type="color" value="#6B7280" data-variant-color-picker aria-label="@Localizer["Admin_ColorPicker"]" />
                            <input class="ca-input" type="text" maxlength="7" pattern="#[0-9A-Fa-f]{6}" placeholder="#RRGGBB" autocomplete="off" data-variant-field="RenkKodu" name="UrunSecenek[__index__].RenkKodu" value="" />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6" data-canvas-option>
                        <label class="ca-label" data-label-for="CerceveTipi">@Localizer["Admin_FrameType"]</label>
                        <input class="ca-input" data-variant-field="CerceveTipi" name="UrunSecenek[__index__].CerceveTipi" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6" data-canvas-option>
                        <label class="ca-label" data-label-for="CerceveRengi">@Localizer["Admin_FrameColor"]</label>
                        <input class="ca-input" data-variant-field="CerceveRengi" name="UrunSecenek[__index__].CerceveRengi" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6" data-canvas-option>
                        <label class="ca-label" data-label-for="CerceveKalinligi">@Localizer["Admin_Thickness"]</label>
                        <input class="ca-input" data-variant-field="CerceveKalinligi" name="UrunSecenek[__index__].CerceveKalinligi" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6" data-canvas-option>
                        <label class="ca-label" data-label-for="ParcaSayisi">@Localizer["Admin_Piece"]</label>
                        <input class="ca-input" type="number" min="1" data-variant-field="ParcaSayisi" name="UrunSecenek[__index__].ParcaSayisi" value="1" />
                    </div>

                    <div class="col-lg-3 col-md-6" data-canvas-option>
                        <label class="ca-label" data-label-for="MalzemeTuru">@Localizer["Admin_Material"]</label>
                        <input class="ca-input" data-variant-field="MalzemeTuru" name="UrunSecenek[__index__].MalzemeTuru" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Yon">@Localizer["Admin_Orientation"]</label>
                        <input class="ca-input" data-variant-field="Yon" name="UrunSecenek[__index__].Yon" value="" />
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="ca-label" data-label-for="VaryantSku">@Localizer["Admin_VariantSku"]</label>
                        <input class="ca-input" data-variant-field="VaryantSku" name="UrunSecenek[__index__].VaryantSku" value="" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Sira">@Localizer["Admin_Sira"]</label>
                        <input class="ca-input" type="number" min="0" data-variant-field="Sira" name="UrunSecenek[__index__].Sira" value="0" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="UretimSuresiGun">@Localizer["Admin_ProductionDays"]</label>
                        <input class="ca-input" type="number" min="0" data-variant-field="UretimSuresiGun" name="UrunSecenek[__index__].UretimSuresiGun" value="0" />
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="SatisFiyati">@Localizer["Admin_SalePrice"] (₪)</label>
                        <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="SatisFiyati" name="UrunSecenek[__index__].SatisFiyati" value="0" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="IndirimliFiyat">@Localizer["Admin_VariantDiscountPrice"] (₪)</label>
                        <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="IndirimliFiyat" name="UrunSecenek[__index__].IndirimliFiyat" value="" placeholder="—" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="FiyatFarki">@Localizer["Admin_PriceDifference"] (₪)</label>
                        <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="FiyatFarki" name="UrunSecenek[__index__].FiyatFarki" value="0" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="MaliyetFiyati">@Localizer["Admin_Cost"] (₪)</label>
                        <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="MaliyetFiyati" name="UrunSecenek[__index__].MaliyetFiyati" value="0" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="StokAdedi">@Localizer["Admin_Stok"]</label>
                        <input class="ca-input" type="number" min="0" data-variant-field="StokAdedi" name="UrunSecenek[__index__].StokAdedi" value="0" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="ca-label" data-label-for="Desi">@Localizer["Admin_Weight"]</label>
                        <input class="ca-input" type="text" inputmode="decimal" data-decimal data-variant-field="Desi" name="UrunSecenek[__index__].Desi" value="0" />
                    </div>
                    <div class="col-lg-6 col-md-12">
                        <label class="ca-label" data-label-for="GorselUrl">@Localizer["Admin_VariantImage"]</label>
                        <div class="ca-variant-image-widget p-2 rounded border d-flex align-items-center gap-3" style="background:#f8fafc;">
                            <div class="ca-variant-thumb position-relative" style="width:58px; height:58px; min-width:58px; border-radius:8px; overflow:hidden; border:1px solid var(--ca-border); background:#fff; display:flex; align-items:center; justify-content:center;">
                                <img src="/img/products/placeholder.webp" 
                                     alt="Variant" 
                                     class="ca-variant-thumb-img w-100 h-100" 
                                     style="object-fit:cover; display:none;" 
                                     data-variant-img-preview />
                                <i class="fas fa-image text-muted fs-4" data-variant-img-placeholder></i>
                                <div class="ca-variant-img-spinner position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none align-items-center justify-content-center" data-variant-img-spinner>
                                    <i class="fas fa-spinner fa-spin text-primary"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <button type="button" class="ca-btn ca-btn-outline ca-btn-sm py-1 px-2" data-variant-upload-trigger>
                                        <i class="fas fa-upload me-1"></i> @Localizer["Admin_UploadImage"]
                                    </button>
                                    <input type="file" accept=".jpg,.jpeg,.png,.webp" class="d-none" data-variant-file-input />
                                    
                                    @if (productImages.Any())
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button type="button" class="ca-btn ca-btn-outline ca-btn-sm py-1 px-2 dropdown-toggle" data-bs-toggle="dropdown" title="@Localizer["Admin_SelectFromGallery"]">
                                                <i class="fas fa-images me-1"></i> @Localizer["Admin_SelectFromGallery"]
                                            </button>
                                            <div class="dropdown-menu p-2 shadow" style="min-width:260px; max-height:220px; overflow-y:auto; z-index:1070;">
                                                <div class="small fw-bold text-muted mb-2 px-1">@Localizer["Admin_SelectFromGallery"]</div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var pImg in productImages)
                                                    {
                                                        <button type="button" class="border rounded p-0 btn btn-sm btn-light" style="width:46px; height:46px; overflow:hidden;" data-variant-gallery-pick="@pImg" title="@pImg">
                                                            <img src="@pImg" style="width:100%; height:100%; object-fit:cover;" />
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <button type="button" class="ca-btn ca-btn-icon ca-btn-sm text-danger d-none" data-variant-img-remove title="@Localizer["Admin_RemoveImage"]">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                                <input class="ca-input ca-input-sm" style="font-size:0.78rem; height:28px; padding:2px 8px;" 
                                       data-variant-field="GorselUrl" 
                                       name="UrunSecenek[__index__].GorselUrl" 
                                       value="" 
                                       placeholder="https://... /img/..." />
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="ca-label" data-label-for="KisilestirmeMetni">@Localizer["Admin_PersonalizationText"]</label>
                        <textarea class="ca-textarea" rows="2" data-variant-field="KisilestirmeMetni" name="UrunSecenek[__index__].KisilestirmeMetni"></textarea>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="ca-label" data-label-for="OzelTasarimNotu">@Localizer["Admin_CustomDesignNote"]</label>
                        <textarea class="ca-textarea" rows="2" data-variant-field="OzelTasarimNotu" name="UrunSecenek[__index__].OzelTasarimNotu"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="ca-variant-flags">
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" data-variant-field="AktifMi" name="UrunSecenek[__index__].AktifMi" value="true" checked />
                                <input type="hidden" name="UrunSecenek[__index__].AktifMi" value="false" />
                                <span class="form-check-label">@Localizer["Admin_Aktif"]</span>
                            </label>
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" data-variant-field="VarsayilanMi" name="UrunSecenek[__index__].VarsayilanMi" value="true" data-variant-default />
                                <input type="hidden" name="UrunSecenek[__index__].VarsayilanMi" value="false" />
                                <span class="form-check-label">@Localizer["Admin_Varsayilan"]</span>
                            </label>
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" data-variant-field="TukeninceGizle" name="UrunSecenek[__index__].TukeninceGizle" value="true" />
                                <input type="hidden" name="UrunSecenek[__index__].TukeninceGizle" value="false" />
                                <span class="form-check-label">@Localizer["Admin_HideWhenSoldOut"]</span>
                            </label>
                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" data-variant-field="OnSipariseAcikMi" name="UrunSecenek[__index__].OnSipariseAcikMi" value="true" />
                                <input type="hidden" name="UrunSecenek[__index__].OnSipariseAcikMi" value="false" />
                                <span class="form-check-label">@Localizer["Admin_PreOrder"]</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </div>
</div>

<style>
    .ca-variant-grid {
        display: grid;
        gap: 16px;
    }

    .ca-variant-card {
        border: 1px solid var(--ca-border);
        border-radius: var(--ca-radius);
        padding: 18px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    }

    .ca-variant-card-head {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ca-variant-title {
        font-weight: 700;
        color: var(--ca-text);
    }

    .ca-variant-subtitle {
        font-size: 0.85rem;
        color: var(--ca-text-muted);
        margin-top: 4px;
    }

    .ca-variant-flags {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        padding-top: 4px;
    }

    .ca-variant-color-control {
        display: flex;
        align-items: stretch;
        gap: 8px;
    }

    .ca-variant-color-picker {
        width: 46px;
        min-width: 46px;
        min-height: 42px;
        padding: 3px;
        border: 1px solid var(--ca-border);
        border-radius: 8px;
        background: #fff;
        cursor: pointer;
    }

    .ca-canvas-option-hidden {
        display: none !important;
    }
</style>

<script>
    (function () {
        const list = document.getElementById('variantList');
        const template = document.getElementById('variantCardTemplate');
        const emptyState = document.getElementById('variantEmptyState');
        const form = list?.closest('form');
        const addButton = document.querySelector('[data-variant-add]');
        const categorySelect = document.querySelector('[name="KategoriId"]');
        const canvasOptionCategoryIds = new Set(@Html.Raw(canvasOptionCategoryIdJson));
        const canvasFields = ['CerceveTipi', 'CerceveRengi', 'CerceveKalinligi', 'MalzemeTuru', 'ParcaSayisi'];
        const pieceText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_Piece"].Value.ToLowerInvariant()));
        const personalizationPrefixText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_PersonalizationPrefix"].Value));
        const variationSubtitleDefaultText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_VariationSubtitleDefault"].Value));
        const variationFallbackText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_VariationFallbackTitle"].Value));
        const notePrefixText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_NotePrefix"].Value));

        if (!list || !template) {
            return;
        }

        function selector(card, fieldName) {
            return card.querySelector(`[data-variant-field="${fieldName}"]`);
        }

        function supportsCanvasOptions() {
            const categoryId = parseInt(categorySelect?.value || '0', 10);
            return canvasOptionCategoryIds.has(categoryId);
        }

        function clearCanvasFields(card) {
            canvasFields.forEach((field) => {
                const input = selector(card, field);
                if (!input) {
                    return;
                }

                input.value = field === 'ParcaSayisi' ? '1' : '';
            });
        }

        function applyCategoryScope() {
            const enabled = supportsCanvasOptions();
            list.querySelectorAll('[data-canvas-option]').forEach((el) => {
                el.classList.toggle('ca-canvas-option-hidden', !enabled);
            });

            if (!enabled) {
                list.querySelectorAll('[data-variant-card]').forEach(clearCanvasFields);
            }
        }

        function toggleEmptyState() {
            if (!emptyState) {
                return;
            }

            emptyState.classList.toggle('d-none', list.querySelectorAll('[data-variant-card]').length > 0);
        }

        function buildTitle(card, index) {
            const canvasEnabled = supportsCanvasOptions();
            const olcu = selector(card, 'Olcu')?.value?.trim() || '';
            const birim = selector(card, 'OlcuBirimi')?.value?.trim() || '';
            const beden = selector(card, 'Beden')?.value?.trim() || '';
            const genelRenk = selector(card, 'Renk')?.value?.trim() || '';
            const cerceve = canvasEnabled ? selector(card, 'CerceveTipi')?.value?.trim() || '' : '';
            const renk = canvasEnabled ? selector(card, 'CerceveRengi')?.value?.trim() || '' : '';
            const sku = selector(card, 'VaryantSku')?.value?.trim() || '';

            const baseTitle = [genelRenk, beden, [olcu, birim].filter(Boolean).join(' '), cerceve, renk].filter(Boolean).join(' / ');
            if (baseTitle) {
                return baseTitle;
            }

            if (sku) {
                return sku;
            }

            return variationFallbackText.replace('{0}', index + 1);
        }

        function buildSubtitle(card) {
            const canvasEnabled = supportsCanvasOptions();
            const malzeme = canvasEnabled ? selector(card, 'MalzemeTuru')?.value?.trim() || '' : '';
            const yon = selector(card, 'Yon')?.value?.trim() || '';
            const kisellestirme = selector(card, 'KisilestirmeMetni')?.value?.trim() || '';
            const not = selector(card, 'OzelTasarimNotu')?.value?.trim() || '';
            const parca = canvasEnabled ? parseInt(selector(card, 'ParcaSayisi')?.value || '1', 10) : 1;

            const parts = [];
            if (malzeme) parts.push(malzeme);
            if (yon) parts.push(yon);
            if (parca > 1) parts.push(`${parca} ${pieceText}`);
            if (kisellestirme) parts.push(personalizationPrefixText.replace('{0}', kisellestirme));
            if (not) parts.push(`${notePrefixText}${not}`);

            return parts.length > 0 ? parts.join(' | ') : variationSubtitleDefaultText;
        }

        function syncDefaultCheckbox(activeCheckbox) {
            if (!activeCheckbox.checked) {
                return;
            }

            list.querySelectorAll('[data-variant-default]').forEach((checkbox) => {
                if (checkbox !== activeCheckbox) {
                    checkbox.checked = false;
                }
            });
        }

        function reindex() {
            applyCategoryScope();

            list.querySelectorAll('[data-variant-card]').forEach((card, index) => {
                card.dataset.index = index;

                card.querySelectorAll('[name^="UrunSecenek["]').forEach((input) => {
                    input.name = input.name.replace(/UrunSecenek\[[^\]]+\]/, `UrunSecenek[${index}]`);
                });

                card.querySelectorAll('[data-variant-field]').forEach((input) => {
                    const field = input.getAttribute('data-variant-field');
                    if (input.type !== 'hidden' && input.name && input.name.startsWith('UrunSecenek')) {
                        const id = `variant_${field}_${index}`;
                        input.id = id;
                        const label = card.querySelector(`[data-label-for="${field}"]`);
                        if (label) {
                            label.htmlFor = id;
                        }
                    }
                });

                const title = card.querySelector('[data-variant-title]');
                const subtitle = card.querySelector('[data-variant-subtitle]');

                if (title) {
                    title.textContent = buildTitle(card, index);
                }

                if (subtitle) {
                    subtitle.textContent = buildSubtitle(card);
                }
            });

            toggleEmptyState();
        }

        function bindCard(card) {
            card.querySelectorAll('input, textarea, select').forEach((input) => {
                input.addEventListener('input', () => reindex());
                input.addEventListener('change', () => reindex());
            });

            const removeButton = card.querySelector('[data-variant-remove]');
            if (removeButton) {
                removeButton.addEventListener('click', () => {
                    const persistedId = Number.parseInt(selector(card, 'Id')?.value || '0', 10);
                    if (persistedId > 0) {
                        window.caWholesaleTierEditor?.removeVariant(persistedId);
                    }
                    card.remove();
                    reindex();
                });
            }

            const defaultCheckbox = card.querySelector('[data-variant-default]');
            if (defaultCheckbox) {
                defaultCheckbox.addEventListener('change', function () {
                    syncDefaultCheckbox(this);
                    reindex();
                });
            }

            const colorText = selector(card, 'RenkKodu');
            const colorPicker = card.querySelector('[data-variant-color-picker]');
            if (colorText && colorPicker) {
                const normalizeColor = (value) => /^#[0-9a-f]{6}$/i.test(value || '') ? value.toUpperCase() : null;
                const initialColor = normalizeColor(colorText.value);
                if (initialColor) {
                    colorPicker.value = initialColor;
                    colorText.value = initialColor;
                }

                colorPicker.addEventListener('input', () => {
                    colorText.value = colorPicker.value.toUpperCase();
                    colorText.dispatchEvent(new Event('input', { bubbles: true }));
                });

                colorText.addEventListener('input', () => {
                    const color = normalizeColor(colorText.value);
                    if (color) {
                        colorPicker.value = color;
                    }
                });
            }

            // Variant Image Handling
            const uploadTrigger = card.querySelector('[data-variant-upload-trigger]');
            const fileInput = card.querySelector('[data-variant-file-input]');
            const urlInput = selector(card, 'GorselUrl');
            const imgPreview = card.querySelector('[data-variant-img-preview]');
            const placeholder = card.querySelector('[data-variant-img-placeholder]');
            const imgRemove = card.querySelector('[data-variant-img-remove]');
            const spinner = card.querySelector('[data-variant-img-spinner]');

            if (uploadTrigger && fileInput) {
                uploadTrigger.addEventListener('click', (e) => {
                    e.preventDefault();
                    fileInput.click();
                });

                fileInput.addEventListener('change', async () => {
                    const file = fileInput.files?.[0];
                    if (!file) return;

                    if (spinner) {
                        spinner.classList.remove('d-none');
                        spinner.classList.add('d-flex');
                    }

                    try {
                        const formData = new FormData();
                        formData.append('dosya', file);
                        const urunIdInput = document.querySelector('input[name="Id"]');
                        formData.append('urunId', urunIdInput?.value || '0');
                        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                        if (tokenInput) {
                            formData.append('__RequestVerificationToken', tokenInput.value);
                        }

                        const res = await fetch('/Admin/Urun/VaryantGorselYukle', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await res.json();

                        if (data && data.success && data.url) {
                            if (urlInput) {
                                urlInput.value = data.url;
                                urlInput.dispatchEvent(new Event('input', { bubbles: true }));
                            }
                            if (imgPreview) {
                                imgPreview.src = data.url;
                                imgPreview.style.display = 'block';
                            }
                            if (placeholder) placeholder.classList.add('d-none');
                            if (imgRemove) imgRemove.classList.remove('d-none');
                        } else {
                            alert(data?.message || 'Upload error');
                        }
                    } catch (err) {
                        alert('Upload failed: ' + err.message);
                    } finally {
                        if (spinner) {
                            spinner.classList.remove('d-flex');
                            spinner.classList.add('d-none');
                        }
                    }
                });
            }

            card.querySelectorAll('[data-variant-gallery-pick]').forEach((btn) => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const pickUrl = this.getAttribute('data-variant-gallery-pick');
                    if (!pickUrl) return;

                    if (urlInput) {
                        urlInput.value = pickUrl;
                        urlInput.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    if (imgPreview) {
                        imgPreview.src = pickUrl;
                        imgPreview.style.display = 'block';
                    }
                    if (placeholder) placeholder.classList.add('d-none');
                    if (imgRemove) imgRemove.classList.remove('d-none');
                });
            });

            if (imgRemove) {
                imgRemove.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (urlInput) {
                        urlInput.value = '';
                        urlInput.dispatchEvent(new Event('input', { bubbles: true }));
                    }
                    if (imgPreview) {
                        imgPreview.src = '';
                        imgPreview.style.display = 'none';
                    }
                    if (placeholder) placeholder.classList.remove('d-none');
                    if (fileInput) fileInput.value = '';
                    imgRemove.classList.add('d-none');
                });
            }

            if (urlInput) {
                urlInput.addEventListener('input', function () {
                    const val = this.value.trim();
                    if (val) {
                        if (imgPreview) {
                            imgPreview.src = val;
                            imgPreview.style.display = 'block';
                        }
                        if (placeholder) placeholder.classList.add('d-none');
                        if (imgRemove) imgRemove.classList.remove('d-none');
                    } else {
                        if (imgPreview) {
                            imgPreview.src = '';
                            imgPreview.style.display = 'none';
                        }
                        if (placeholder) placeholder.classList.remove('d-none');
                        if (imgRemove) imgRemove.classList.add('d-none');
                    }
                });
            }
        }

        function addCard() {
            const fragment = template.content.cloneNode(true);
            const card = fragment.querySelector('[data-variant-card]');
            if (card) {
                list.appendChild(fragment);
                bindCard(card);
            }
            reindex();
        }

        list.querySelectorAll('[data-variant-card]').forEach(bindCard);
        reindex();

        addButton?.addEventListener('click', addCard);

        if (form) {
            form.addEventListener('submit', () => {
                reindex();

                if (!supportsCanvasOptions()) {
                    list.querySelectorAll('[data-variant-card]').forEach(clearCanvasFields);
                }

                list.querySelectorAll('input[type="number"]').forEach((input) => {
                    if (input.value === '') {
                        input.value = input.min && parseFloat(input.min) > 0 ? input.min : '0';
                    }
                });
            });
        }

        if (categorySelect) {
            categorySelect.addEventListener('change', () => {
                applyCategoryScope();
                reindex();
            });
        }

        window.caVariantEditor = {
            add: addCard,
            refresh: reindex
        };
    })();
</script>
