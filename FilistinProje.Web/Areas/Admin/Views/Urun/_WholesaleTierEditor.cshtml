@model FilistinProje.Core.Varliklar.Urun
@inject Microsoft.Extensions.Localization.IStringLocalizer<FilistinProje.Web.Resources.SharedResource> Localizer
@{
    var tiers = (Model.ToptanFiyatKademeleri ?? new List<FilistinProje.Core.Varliklar.UrunToptanFiyatKademesi>())
        .Where(x => !x.SilindiMi).OrderBy(x => x.MinAdet).ThenBy(x => x.Sira).ToList();
    var variants = (Model.UrunSecenek ?? new List<FilistinProje.Core.Varliklar.UrunSecenek>())
        .Where(x => !x.SilindiMi && x.Id > 0).OrderBy(x => x.Sira).ToList();
}

<div class="ca-card mt-4" style="border:1px solid var(--ca-border);">
    <div class="ca-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <span class="ca-card-title">@Localizer["Admin_QuantityBasedWholesale"]</span>
            <div class="small text-muted mt-1">@Localizer["Admin_QuantityBasedWholesaleDesc"]</div>
        </div>
        <button type="button" class="ca-btn ca-btn-primary ca-btn-sm" id="addWholesaleTier"><i class="fas fa-plus"></i> @Localizer["Admin_AddTier"]</button>
    </div>
    <div class="ca-card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>@Localizer["Admin_Variant"]</th><th>@Localizer["Admin_MinQty"]</th><th>@Localizer["Admin_UnitPrice"] (₪)</th><th>@Localizer["Admin_Aktif"]</th><th></th></tr></thead>
                <tbody id="wholesaleTierList">
                @for (var i = 0; i < tiers.Count; i++)
                {
                    var tier = tiers[i];
                    <tr data-wholesale-tier>
                        <td>
                            <input type="hidden" data-tier-field="Id" name="ToptanFiyatKademeleri[@i].Id" value="@tier.Id" />
                            <select class="ca-input" data-tier-field="UrunSecenekId" name="ToptanFiyatKademeleri[@i].UrunSecenekId">
                                <option value="">@Localizer["Admin_AllProduct"]</option>
                                @foreach (var variant in variants)
                                {
                                    if (tier.UrunSecenekId == variant.Id) { <option value="@variant.Id" selected>@variant.VaryantBasligi</option> }
                                    else { <option value="@variant.Id">@variant.VaryantBasligi</option> }
                                }
                            </select>
                        </td>
                        <td><input class="ca-input" type="number" min="1" data-tier-field="MinAdet" name="ToptanFiyatKademeleri[@i].MinAdet" value="@tier.MinAdet" /></td>
                        <td><input class="ca-input" type="number" inputmode="decimal" min="0.01" step="0.01" required data-decimal data-tier-field="BirimFiyat" name="ToptanFiyatKademeleri[@i].BirimFiyat" value="@tier.BirimFiyat.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td><input class="form-check-input" type="checkbox" data-tier-field="AktifMi" name="ToptanFiyatKademeleri[@i].AktifMi" value="true" @(tier.AktifMi ? "checked" : null) /><input type="hidden" data-tier-false name="ToptanFiyatKademeleri[@i].AktifMi" value="false" /></td>
                        <td><button type="button" class="ca-btn ca-btn-outline ca-btn-sm" data-tier-remove><i class="fas fa-trash"></i></button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="small text-muted mt-3">@Localizer["Admin_TierExample"]</div>
    </div>
</div>

<template id="wholesaleTierTemplate">
    <tr data-wholesale-tier>
        <td><input type="hidden" data-tier-field="Id" value="0" /><select class="ca-input" data-tier-field="UrunSecenekId"><option value="">@Localizer["Admin_AllProduct"]</option>@foreach (var variant in variants) { <option value="@variant.Id">@variant.VaryantBasligi</option> }</select></td>
        <td><input class="ca-input" type="number" min="1" required data-tier-field="MinAdet" value="1" /></td>
        <td><input class="ca-input" type="number" inputmode="decimal" min="0.01" step="0.01" required data-decimal data-tier-field="BirimFiyat" /></td>
        <td><input class="form-check-input" type="checkbox" data-tier-field="AktifMi" value="true" checked /><input type="hidden" data-tier-false value="false" /></td>
        <td><button type="button" class="ca-btn ca-btn-outline ca-btn-sm" data-tier-remove><i class="fas fa-trash"></i></button></td>
    </tr>
</template>

<script>
(() => {
    const list = document.getElementById('wholesaleTierList');
    const template = document.getElementById('wholesaleTierTemplate');
    const add = document.getElementById('addWholesaleTier');
    if (!list || !template || !add) return;
    const reindex = () => list.querySelectorAll('[data-wholesale-tier]').forEach((row, index) => {
        row.querySelectorAll('[data-tier-field]').forEach(input => input.name = `ToptanFiyatKademeleri[${index}].${input.dataset.tierField}`);
        const falseInput = row.querySelector('[data-tier-false]');
        if (falseInput) falseInput.name = `ToptanFiyatKademeleri[${index}].AktifMi`;
    });
    const bind = row => row.querySelector('[data-tier-remove]')?.addEventListener('click', () => { row.remove(); reindex(); });
    list.querySelectorAll('[data-wholesale-tier]').forEach(bind);
    add.addEventListener('click', () => { list.insertAdjacentHTML('beforeend', template.innerHTML); const row = list.lastElementChild; if (row) bind(row); reindex(); });
    reindex();
})();
</script>
