@model FilistinProje.Core.Varliklar.Urun
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_Yeni_Urun_Ekle"];

    var previewUrl = string.IsNullOrWhiteSpace(Model.AnaGorselUrl)
        ? "/img/products/placeholder.webp"
        : Model.AnaGorselUrl;

    var validationErrors = ViewData.ModelState.Values
        .SelectMany(x => x.Errors)
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<style>
    .ca-simple-product {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 22px;
        align-items: start;
    }

    .ca-product-preview {
        aspect-ratio: 1 / 1;
        border: 1px solid var(--ca-border);
        border-radius: var(--ca-radius);
        overflow: hidden;
        background: #fff;
    }

    .ca-product-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .ca-help-box {
        border: 1px solid var(--ca-border);
        border-left: 3px solid var(--ca-accent);
        border-radius: var(--ca-radius);
        padding: 12px 14px;
        background: #fffaf0;
        color: var(--ca-text-secondary);
        font-size: .86rem;
    }

    .ca-required {
        color: #b42318;
        font-weight: 800;
    }

    .ca-seo-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .ca-save-rail {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 18px;
        margin-top: 18px;
        border-top: 1px solid var(--ca-border);
    }

    .ca-side-card {
        position: sticky;
        top: 84px;
        display: grid;
        gap: 16px;
    }

    @@media (max-width: 1100px) {
        .ca-simple-product {
            grid-template-columns: 1fr;
        }

        .ca-side-card {
            position: static;
            grid-row: 1;
        }
    }

    @@media (max-width: 768px) {
        .ca-seo-preview-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container-fluid ca-fade-in">
    <div class="ca-page-header">
        <div>
            <h1 class="ca-page-title">@Localizer["Admin_Yeni_Urun_Ekle"]</h1>
            <p class="ca-page-subtitle">@Localizer["Admin_ProductCreateDesc"]</p>
        </div>
        <a href="/Admin/Urun" class="ca-btn ca-btn-outline">
            <i class="fas fa-arrow-left"></i> @Localizer["Admin_BackToProducts"]
        </a>
    </div>

    <form asp-action="Ekle" method="post" enctype="multipart/form-data" id="productCreateForm">
        @Html.AntiForgeryToken()

        @if (validationErrors.Any())
        {
            <div class="alert alert-danger border-0 shadow-sm">
                <div class="fw-bold mb-2">@Localizer["Admin_ProductSaveFailed"]</div>
                <ul class="mb-0 ps-3">
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <div class="alert alert-info border-0 shadow-sm mb-4">
            <div class="fw-semibold mb-1">@Localizer["Admin_PriceVariantHelpTitle"]</div>
            <div class="small">
                @Localizer["Admin_PriceVariantHelpText"]
            </div>
        </div>

        <div class="ca-simple-product">
            <div class="ca-card">
                <div class="ca-card-header">
                    <span class="ca-card-title"><i class="fas fa-box-open me-2"></i>@Localizer["Admin_ProductInfo"]</span>
                </div>
                <div class="ca-card-body">
                    <div class="ca-help-box mb-4">
                        @Localizer["Admin_ProductCreateHelp"]
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="ca-label"><span class="ca-required">*</span> @Localizer["Admin_Urun_Adi"]</label>
                            <input asp-for="Baslik" id="createTitle" class="ca-input" placeholder="@Localizer["Admin_ProductNamePlaceholder"]" />
                            <span asp-validation-for="Baslik" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="ca-seo-preview-grid">
                                <div>
                                    <label class="ca-label">Slug</label>
                                    <input asp-for="Slug" id="slugInput" class="ca-input" placeholder="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "يتم التوليد تلقائياً من اسم المنتج" : "Auto-generated from title")" readonly />
                                </div>
                                <div>
                                    <label class="ca-label">SEO URL</label>
                                    <input asp-for="UrlYolu" id="seoUrlInput" class="ca-input" placeholder="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "يتم التوليد تلقائياً من اسم المنتج" : "Auto-generated from title")" readonly />
                                </div>
                            </div>
                            <div class="small text-muted mt-1">@Localizer["Admin_ProductAutoSlugHelp"]</div>
                        </div>

                        <div class="col-md-7">
                            <label class="ca-label"><span class="ca-required">*</span> @Localizer["Admin_Kategori"]</label>
                            <select asp-for="KategoriId" asp-items="ViewBag.Kategoriler" class="ca-select">
                                <option value="">@Localizer["Admin_SelectCategory"]</option>
                            </select>
                            <span asp-validation-for="KategoriId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="ca-label"><span class="ca-required">*</span> @Localizer["Admin_SalePrice"] (₪)</label>
                            <input asp-for="Fiyat" id="createPrice" class="ca-input" type="text" inputmode="decimal" data-decimal placeholder="0,00" />
                            <span asp-validation-for="Fiyat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="ca-label">@Localizer["DiscountType"]</label>
                            <select class="ca-select" id="createDiscountType">
                                <option value="">@(isAr ? "بدون خصم / مباشر" : "Direct / None")</option>
                                <option value="Percentage">@Localizer["DiscountTypePercentage"]</option>
                                <option value="Fixed">@Localizer["DiscountTypeFixed"]</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="ca-label">@Localizer["DiscountTypePercentage"]</label>
                            <input class="ca-input" type="number" min="0" max="100" step="any" id="createDiscountPercent" placeholder="%" />
                        </div>

                        <div class="col-md-2">
                            <label class="ca-label">@Localizer["DiscountTypeFixed"]</label>
                            <input class="ca-input" type="text" inputmode="decimal" data-decimal id="createDiscountAmount" placeholder="₪" />
                        </div>

                        <div class="col-md-2">
                            <label class="ca-label">@Localizer["Admin_DiscountPrice"] (₪)</label>
                            <input asp-for="IndirimliFiyat" id="createDiscountedPrice" class="ca-input" type="text" inputmode="decimal" data-decimal placeholder="@Localizer["Admin_OptionalEmpty"]" />
                            <span asp-validation-for="IndirimliFiyat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4 ca-discount-date-wrap" id="createDiscountEndDateContainer">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="KampanyaBitisTarihi" class="ca-label mb-0">
                                    <span class="ca-required text-danger" id="createDiscountEndDateRequiredStar" style="display:none;">*</span>
                                    @Localizer["Admin_DiscountEndDate"]
                                </label>
                                <div class="d-flex flex-wrap gap-1" role="group">
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-hours="1" style="font-size:0.72rem;">@Localizer["QuickTime_1Hour"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-hours="3" style="font-size:0.72rem;">@Localizer["QuickTime_3Hours"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-hours="6" style="font-size:0.72rem;">@Localizer["QuickTime_6Hours"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-hours="12" style="font-size:0.72rem;">@Localizer["QuickTime_12Hours"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-days="1" style="font-size:0.72rem;">@Localizer["QuickTime_1Day"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-days="3" style="font-size:0.72rem;">@Localizer["QuickTime_3Days"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-days="7" style="font-size:0.72rem;">@Localizer["QuickTime_1Week"]</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1 quick-date-btn" data-days="30" style="font-size:0.72rem;">@Localizer["QuickTime_1Month"]</button>
                                </div>
                            </div>
                            <input asp-for="KampanyaBitisTarihi" id="createKampanyaBitisTarihi" class="ca-input" type="datetime-local" />
                            <span asp-validation-for="KampanyaBitisTarihi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label class="ca-label"><span class="ca-required">*</span> @Localizer["Admin_MainImageFile"]</label>
                            <label class="ca-btn ca-btn-outline mb-0" for="mainImageFile"><i class="fas fa-upload"></i> @Localizer["Admin_ChooseFile"]</label>
                            <span id="mainImageFileName" class="small text-muted ms-2">@Localizer["Admin_NoFileChosen"]</span>
                            <input type="file" id="mainImageFile" name="resimDosyasi" class="visually-hidden" accept=".jpg,.jpeg,.png,.webp" onchange="previewFile(event,'mainImgPreview','mainImageFileName')" />
                            <div class="small text-muted mt-1">@Localizer["Admin_ImageFormatsHelp"]</div>
                        </div>

                        <div class="col-12">
                            <label class="ca-label">@Localizer["Admin_MainImageUrl"]</label>
                            <input asp-for="AnaGorselUrl" id="mainImgUrl" class="ca-input" placeholder="/img/products/sample.webp" onchange="updatePreviewFromUrl('mainImgUrl','mainImgPreview')" />
                            <span asp-validation-for="AnaGorselUrl" class="text-danger small"></span>
                            <div class="small text-muted mt-1">@Localizer["Admin_MainImageHelp"]</div>
                        </div>

                        <div class="col-12">
                            <label class="ca-label">@Localizer["Admin_AdditionalImages"]</label>
                            <label class="ca-btn ca-btn-outline mb-0" for="galleryFiles"><i class="fas fa-images"></i> @Localizer["Admin_ChooseFiles"]</label>
                            <input type="file" name="galeriDosyalari" id="galleryFiles" class="visually-hidden" accept=".jpg,.jpeg,.png,.webp" multiple />
                            <div id="galleryFileInfo" class="small text-muted mt-1">@Localizer["Admin_AdditionalImagesHelp"]</div>
                            <div class="small text-muted mt-1">@Localizer["Admin_ImageFormatsHelp"]</div>
                        </div>

                        <div class="col-12">
                            <label class="ca-label">@Localizer["Admin_ShortDescription"]</label>
                            <textarea asp-for="KisaAciklama" class="ca-textarea" rows="3" placeholder="@Localizer["Admin_ShortDescriptionPlaceholder"]"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="ca-label">@Localizer["Admin_DetailedDescription"]</label>
                            <textarea asp-for="Aciklama" class="ca-textarea" rows="5" placeholder="@Localizer["Admin_DetailedDescriptionPlaceholder"]"></textarea>
                        </div>

                        <div class="col-12 mt-3">
                            <div class="ca-card" style="background:#fafaf8;">
                                <div class="ca-card-header" style="background:transparent;border-bottom:1px solid var(--ca-border);">
                                    <span class="ca-card-title"><i class="fas fa-search me-2"></i>@Localizer["Admin_SeoInfo"]</span>
                                </div>
                                <div class="ca-card-body">
                                    <div class="small text-muted mb-3">@Localizer["Admin_SeoInfoHelp"]</div>
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="ca-label">@Localizer["Admin_SEO_Basligi"]</label>
                                            <input asp-for="SeoTitle" class="ca-input" placeholder="@Localizer["Admin_SeoTitlePlaceholder"]" maxlength="70" />
                                            <div class="small text-muted mt-1">@Localizer["Admin_SeoTitleHelp"]</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="ca-label">@Localizer["Admin_SEO_Aciklamasi"]</label>
                                            <textarea asp-for="SeoDescription" class="ca-textarea" rows="2" placeholder="@Localizer["Admin_SeoDescriptionPlaceholder"]" maxlength="160"></textarea>
                                            <div class="small text-muted mt-1">@Localizer["Admin_SeoDescriptionHelp"]</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="ca-label">@Localizer["Admin_SeoKeywords"]</label>
                                            <input asp-for="SeoKeywords" class="ca-input" placeholder="@Localizer["Admin_SeoKeywordsPlaceholder"]" />
                                            <div class="small text-muted mt-1">@Localizer["Admin_SeoKeywordsHelp"]</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="AktifMi" class="form-check-input" type="checkbox" value="true">
                                <label asp-for="AktifMi" class="form-check-label fw-semibold">@Localizer["Admin_ProductPublishedSwitch"]</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="DegisimYapilamazMi" id="noExchangeToggle" class="form-check-input" type="checkbox">
                                <label asp-for="DegisimYapilamazMi" class="form-check-label fw-semibold">@Localizer["Admin_NoExchangePolicy"]</label>
                                <div class="small text-muted">@Localizer["Admin_NoExchangePolicyHelp"]</div>
                            </div>

                            <div id="noExchangeColorSection" class="ca-no-exchange-wrapper mt-3 p-3 rounded-3 border" style="background:#fffcf8; border-color:var(--ca-border); display: @(Model.DegisimYapilamazMi ? "block" : "none");">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <div>
                                        <div class="fw-semibold text-dark"><i class="fas fa-palette me-1.5 text-danger"></i> @Localizer["Admin_NoExchangeBadgeColor"]</div>
                                        <div class="small text-muted">@Localizer["Admin_NoExchangeBadgeColorHelp"]</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small text-muted">@Localizer["Admin_Preview"]:</span>
                                        <span id="noExchangeBadgePreview" class="badge px-3 py-2 d-inline-flex align-items-center gap-2 text-white shadow-sm" style="background-color: @(string.IsNullOrWhiteSpace(Model.NoExchangeBadgeColor) ? "#DC2626" : Model.NoExchangeBadgeColor); font-size: 0.82rem; border-radius: 8px;">
                                            <i class="fas fa-ban"></i>
                                            <span>@Localizer["Product_NoExchangeNotice"]</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center flex-wrap gap-3 mt-3 pt-2 border-top" style="border-color:var(--ca-border);">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="color" id="noExchangeColorPicker" class="form-control form-control-color border-0 p-0" style="width: 44px; height: 38px; cursor: pointer; border-radius: 8px; background: transparent;" value="@(string.IsNullOrWhiteSpace(Model.NoExchangeBadgeColor) ? "#DC2626" : Model.NoExchangeBadgeColor)" title="@Localizer["Admin_NoExchangeBadgeColor"]" />
                                        <div class="input-group input-group-sm" style="width: 130px;">
                                            <input type="text" asp-for="NoExchangeBadgeColor" id="noExchangeColorInput" class="form-control font-monospace text-uppercase" maxlength="7" placeholder="#DC2626" value="@(string.IsNullOrWhiteSpace(Model.NoExchangeBadgeColor) ? "#DC2626" : Model.NoExchangeBadgeColor)" />
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="small text-muted me-1">@Localizer["Admin_FastPalette"]:</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5 ca-palette-btn" data-color="#DC2626" style="border-radius: 6px; font-size: 0.78rem;">
                                            <span style="width: 14px; height: 14px; border-radius: 50%; background: #DC2626; display: inline-block;"></span>
                                            <span>@Localizer["Color_Red"]</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5 ca-palette-btn" data-color="#EA580C" style="border-radius: 6px; font-size: 0.78rem;">
                                            <span style="width: 14px; height: 14px; border-radius: 50%; background: #EA580C; display: inline-block;"></span>
                                            <span>@Localizer["Color_Orange"]</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5 ca-palette-btn" data-color="#1F2937" style="border-radius: 6px; font-size: 0.78rem;">
                                            <span style="width: 14px; height: 14px; border-radius: 50%; background: #1F2937; display: inline-block;"></span>
                                            <span>@Localizer["Color_Dark"]</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 py-1 px-2.5 ca-palette-btn" data-color="#CA8A04" style="border-radius: 6px; font-size: 0.78rem;">
                                            <span style="width: 14px; height: 14px; border-radius: 50%; background: #CA8A04; display: inline-block;"></span>
                                            <span>@Localizer["Color_Gold"]</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    @await Html.PartialAsync("_GiftPackageOptionEditor", Model)
                    @await Html.PartialAsync("_FeatureEditor", Model)
                    @await Html.PartialAsync("_VariantEditor", Model.UrunSecenek)
                    @await Html.PartialAsync("_WholesaleTierEditor", Model)

                    <input asp-for="KisaAd" type="hidden" />
                    <input asp-for="SKU" type="hidden" />
                    <input asp-for="Barkod" type="hidden" />
                    <input asp-for="Marka" type="hidden" />
                    <input asp-for="Etiketler" type="hidden" />
                    <input asp-for="TeknikOzellikler" type="hidden" />
                    <input asp-for="MalzemeBilgisi" type="hidden" />
                    <input asp-for="BakimTalimati" type="hidden" />
                    <input asp-for="PaketlemeBilgisi" type="hidden" />
                    <input asp-for="StokDurumu" type="hidden" />
                    <input asp-for="Maliyet" type="hidden" />
                    <input asp-for="KdvOrani" type="hidden" />
                    <input asp-for="UretimSuresiGun" type="hidden" />
                    <input asp-for="KargoyaVerilisSuresiGun" type="hidden" />
                    <input asp-for="TahminiTeslimSuresiGun" type="hidden" />
                    <input asp-for="OneCikanMi" type="hidden" />
                    <input asp-for="YeniUrunMu" type="hidden" />
                    <input asp-for="KampanyaliMi" type="hidden" />
                    <input asp-for="AnaSayfadaGoster" type="hidden" />
                    <input asp-for="Sira" type="hidden" />
                    <input asp-for="MinSiparisAdedi" type="hidden" />
                    <input asp-for="MaxSiparisAdedi" type="hidden" />

                    <div class="ca-save-rail">
                        <a href="/Admin/Urun" class="ca-btn ca-btn-outline">@Localizer["Admin_Iptal"]</a>
                        <button type="submit" class="ca-btn ca-btn-primary">
                            <i class="fas fa-save"></i> @Localizer["Admin_SaveProduct"]
                        </button>
                    </div>
                </div>
            </div>

            <aside class="ca-side-card">
                <div class="ca-card">
                    <div class="ca-card-header">
                        <span class="ca-card-title">@Localizer["Admin_Preview"]</span>
                    </div>
                    <div class="ca-card-body">
                        <div class="ca-product-preview mb-3">
                            <img src="@previewUrl" id="mainImgPreview" alt="@Localizer["Admin_NewProductImageAlt"]" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/img/products/placeholder.webp';">
                        </div>
                        <div id="liveTitle" class="fw-bold">@(string.IsNullOrWhiteSpace(Model.Baslik) ? Localizer["Admin_ProductNameEmpty"].Value : Model.Baslik)</div>
                        <div class="small text-muted">@Localizer["Admin_AfterSaveDetails"]</div>
                    </div>
                </div>

                <div class="ca-card">
                    <div class="ca-card-header">
                        <span class="ca-card-title">@Localizer["Admin_RequiredFields"]</span>
                    </div>
                    <div class="ca-card-body small text-muted">
                        <div class="mb-2"><i class="fas fa-check text-success me-1"></i> @Localizer["Admin_ProductName"]</div>
                        <div class="mb-2"><i class="fas fa-check text-success me-1"></i> @Localizer["Admin_Kategori"]</div>
                        <div class="mb-2"><i class="fas fa-check text-success me-1"></i> @Localizer["Admin_SalePrice"]</div>
                        <div><i class="fas fa-check text-success me-1"></i> @Localizer["Admin_MainImageFileOrUrl"]</div>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

<script>
    (function () {
        const titleInput = document.getElementById('createTitle');
        const liveTitle = document.getElementById('liveTitle');
        const slugInput = document.getElementById('slugInput');
        const seoUrlInput = document.getElementById('seoUrlInput');
        const mainImgUrl = document.getElementById('mainImgUrl');
        const galleryFiles = document.getElementById('galleryFiles');
        const galleryFileInfo = document.getElementById('galleryFileInfo');
        const productNameEmptyText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_ProductNameEmpty"].Value));
        const additionalImagesHelpText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_AdditionalImagesHelp"].Value));
        const autoCreateAfterSaveText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_AutoCreateAfterSave"].Value));
        const additionalImagesSelectedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_AdditionalImagesSelected"].Value));
        window.autoCreateAfterSaveText = autoCreateAfterSaveText;

        if (mainImgUrl && mainImgUrl.value.startsWith(autoCreateAfterSaveText)) {
            mainImgUrl.value = '';
        }

        function createSlug(value) {
            const map = {
                'ç': 'c', 'Ç': 'c',
                'ğ': 'g', 'Ğ': 'g',
                'ı': 'i', 'I': 'i',
                'İ': 'i', 'i': 'i',
                'ö': 'o', 'Ö': 'o',
                'ş': 's', 'Ş': 's',
                'ü': 'u', 'Ü': 'u'
            };

            return (value || '')
                .split('')
                .map((char) => map[char] || char)
                .join('')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                .replace(/-{2,}/g, '-');
        }

        titleInput?.addEventListener('input', function () {
            const title = titleInput.value.trim();
            const slug = createSlug(title);
            liveTitle.textContent = title || productNameEmptyText;
            if (slugInput) slugInput.value = slug;
            if (seoUrlInput) seoUrlInput.value = slug;
        });

        galleryFiles?.addEventListener('change', function () {
            const count = galleryFiles.files ? galleryFiles.files.length : 0;
            galleryFileInfo.textContent = count > 0
                ? additionalImagesSelectedText.replace('{0}', count)
                : additionalImagesHelpText;
        });
    })();

    function previewFile(event, id, fileNameId) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;
        const urlInput = document.getElementById('mainImgUrl');
        if (urlInput) {
            urlInput.value = '';
            urlInput.placeholder = window.autoCreateAfterSaveText + ' ' + file.name;
        }
        const fileName = document.getElementById(fileNameId);
        if (fileName) fileName.textContent = file.name;
        const reader = new FileReader();
        reader.onload = () => document.getElementById(id).src = reader.result;
        reader.readAsDataURL(file);
    }

    function updatePreviewFromUrl(inputId, previewId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (input && preview && input.value.trim()) {
            preview.src = input.value.trim();
        }
    }

    // New Product Discount Calculation
    (function () {
        const fiyatInput = document.getElementById('createPrice');
        const discountTypeSelect = document.getElementById('createDiscountType');
        const percentInput = document.getElementById('createDiscountPercent');
        const amountInput = document.getElementById('createDiscountAmount');
        const discountedInput = document.getElementById('createDiscountedPrice');

        if (!fiyatInput || !discountedInput) return;

        function parseNum(val) {
            if (!val) return 0;
            const n = parseFloat(String(val).replace(',', '.'));
            return isNaN(n) ? 0 : n;
        }

        function formatNum(n) {
            if (n <= 0) return '';
            return (Math.round(n * 100) / 100).toFixed(2).replace(/\.00$/, '');
        }

        function calcFromPercent() {
            const f = parseNum(fiyatInput.value);
            const p = parseNum(percentInput?.value);
            if (f > 0 && p > 0) {
                const disc = (f * p) / 100;
                const finalP = Math.max(0, f - disc);
                if (amountInput) amountInput.value = formatNum(disc);
                discountedInput.value = formatNum(finalP);
            } else if (p === 0) {
                if (amountInput) amountInput.value = '';
                discountedInput.value = '';
            }
        }

        function calcFromAmount() {
            const f = parseNum(fiyatInput.value);
            const a = parseNum(amountInput?.value);
            if (f > 0 && a > 0) {
                const finalP = Math.max(0, f - a);
                const pct = (a / f) * 100;
                if (percentInput) percentInput.value = formatNum(pct);
                discountedInput.value = formatNum(finalP);
            } else if (a === 0) {
                if (percentInput) percentInput.value = '';
                discountedInput.value = '';
            }
        }

        function calcFromDiscounted() {
            const f = parseNum(fiyatInput.value);
            const discP = parseNum(discountedInput.value);
            if (f > 0 && discP > 0 && discP < f) {
                const a = f - discP;
                const pct = (a / f) * 100;
                if (amountInput) amountInput.value = formatNum(a);
                if (percentInput) percentInput.value = formatNum(pct);
                if (discountTypeSelect && !discountTypeSelect.value) {
                    discountTypeSelect.value = 'Percentage';
                }
            } else if (!discountedInput.value.trim()) {
                if (amountInput) amountInput.value = '';
                if (percentInput) percentInput.value = '';
            }
        }

        percentInput?.addEventListener('input', calcFromPercent);
        amountInput?.addEventListener('input', calcFromAmount);
        discountedInput.addEventListener('input', calcFromDiscounted);

        fiyatInput.addEventListener('input', function () {
            const mode = discountTypeSelect?.value;
            if (mode === 'Percentage') {
                calcFromPercent();
            } else if (mode === 'Fixed') {
                calcFromAmount();
            } else {
                calcFromDiscounted();
            }
        });

        discountTypeSelect?.addEventListener('change', function () {
            if (this.value === 'Percentage') {
                if (percentInput && !percentInput.value && discountedInput.value) {
                    calcFromDiscounted();
                } else {
                    calcFromPercent();
                }
                percentInput?.focus();
            } else if (this.value === 'Fixed') {
                if (amountInput && !amountInput.value && discountedInput.value) {
                    calcFromDiscounted();
                } else {
                    calcFromAmount();
                }
                amountInput?.focus();
            } else {
                if (percentInput) percentInput.value = '';
                if (amountInput) amountInput.value = '';
                discountedInput.value = '';
            }
            updateDateRequirement();
        });

        const createDateInput = document.getElementById('createKampanyaBitisTarihi');
        const createStarEl = document.getElementById('createDiscountEndDateRequiredStar');

        function updateDateRequirement() {
            const discP = parseNum(discountedInput.value);
            const hasDisc = discP > 0;
            if (createStarEl) createStarEl.style.display = hasDisc ? 'inline' : 'none';
        }

        discountedInput.addEventListener('input', updateDateRequirement);
        discountedInput.addEventListener('change', updateDateRequirement);
        updateDateRequirement();

        document.querySelectorAll('#createDiscountEndDateContainer .quick-date-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                if (!createDateInput) return;
                const hoursAttr = this.getAttribute('data-hours');
                const daysAttr = this.getAttribute('data-days');
                const now = new Date();
                if (hoursAttr) {
                    now.setHours(now.getHours() + parseInt(hoursAttr, 10));
                } else {
                    now.setDate(now.getDate() + parseInt(daysAttr || '1', 10));
                }
                const pad = (n) => String(n).padStart(2, '0');
                const val = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
                createDateInput.value = val;
                createDateInput.dispatchEvent(new Event('input', { bubbles: true }));
                createDateInput.dispatchEvent(new Event('change', { bubbles: true }));
            });
        });

        const addProductForm = document.querySelector('form');
        addProductForm?.addEventListener('submit', function (e) {
            const discP = parseNum(discountedInput.value);
            if (discP > 0 && (!createDateInput || !createDateInput.value.trim())) {
                e.preventDefault();
                if (createDateInput) {
                    createDateInput.focus();
                    createDateInput.classList.add('is-invalid');
                }
                alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_Product_DiscountEndDateRequired"].Value)));
                return false;
            }
        });

        // --- No Exchange Policy Toggle & Dynamic Color Picker ---
        (function() {
            const toggle = document.getElementById('noExchangeToggle');
            const colorSection = document.getElementById('noExchangeColorSection');
            const colorPicker = document.getElementById('noExchangeColorPicker');
            const colorInput = document.getElementById('noExchangeColorInput');
            const preview = document.getElementById('noExchangeBadgePreview');
            const paletteBtns = colorSection ? colorSection.querySelectorAll('.ca-palette-btn') : [];

            if (!toggle || !colorSection) return;

            function syncColor(val) {
                if (!val) return;
                let hex = val.trim();
                if (!hex.startsWith('#')) hex = '#' + hex;
                if (/^#[0-9A-Fa-f]{6}$/.test(hex)) {
                    if (colorPicker) colorPicker.value = hex;
                    if (colorInput) colorInput.value = hex.toUpperCase();
                    if (preview) preview.style.backgroundColor = hex;
                }
            }

            toggle.addEventListener('change', function() {
                if (this.checked) {
                    colorSection.style.display = 'block';
                    colorSection.style.opacity = '0';
                    colorSection.style.transition = 'opacity 0.25s ease';
                    requestAnimationFrame(() => {
                        colorSection.style.opacity = '1';
                    });
                } else {
                    colorSection.style.transition = 'opacity 0.2s ease';
                    colorSection.style.opacity = '0';
                    setTimeout(() => {
                        colorSection.style.display = 'none';
                    }, 200);
                }
            });

            colorPicker?.addEventListener('input', function() {
                syncColor(this.value);
            });

            colorInput?.addEventListener('input', function() {
                syncColor(this.value);
            });

            paletteBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const color = this.getAttribute('data-color');
                    if (color) syncColor(color);
                });
            });

            if (colorInput && colorInput.value) {
                syncColor(colorInput.value);
            }
        })();
    })();
</script>
