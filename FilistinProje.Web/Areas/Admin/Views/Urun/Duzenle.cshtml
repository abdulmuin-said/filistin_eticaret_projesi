                <section class="ca-editor-panel" data-product-panel="ozellik">
                    @await Html.PartialAsync("_FeatureEditor", Model)
                </section>

                <section class="ca-editor-panel" data-product-panel="varyasyon">
                    @await Html.PartialAsync("_VariantEditor", Model.UrunSecenek?.ToList() ?? new System.Collections.Generic.List<FilistinProje.Core.Varliklar.UrunSecenek>())
                    @await Html.PartialAsync("_WholesaleTierEditor", Model)
                </section>

                <section class="ca-editor-panel" data-product-panel="medya">
                    <div class="ca-card">
                        <div class="ca-card-header">
                            <span class="ca-card-title">@Localizer["Admin_MainImageClassicGallery"]</span>
                        </div>
                        <div class="ca-card-body">
                            <div class="row g-3">
                                <div class="col-lg-7">
                                    <label class="ca-label">@Localizer["Admin_MainImageUrl"]</label>
                                    <input asp-for="AnaGorselUrl" id="mainImgUrl" class="ca-input" onchange="updatePreviewFromUrl('mainImgUrl','mainImgPreview')" />
                                </div>
                                <div class="col-lg-5">
                                    <label class="ca-label">@Localizer["Admin_UploadNewMainImage"]</label>
                                    <input type="file" name="anaResimDosyasi" class="ca-input" accept=".jpg,.jpeg,.png,.webp" onchange="previewFile(event,'mainImgPreview')" />
                                    <div class="small text-muted mt-1">@Localizer["Admin_ImageFormatsHelp"]</div>
                                </div>
                                <div class="col-12">
                                    <label class="ca-label">@Localizer["Admin_GalleryImages"]</label>
                                    <input type="file" name="galeriDosyalari" multiple class="ca-input" accept=".jpg,.jpeg,.png,.webp" />
                                    <div class="small text-muted mt-1">@Localizer["Admin_ImageFormatsHelp"]</div>
                                </div>
                            </div>

                            <div class="mt-3" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(110px,1fr)); gap:10px;">
                                @foreach (var r in Model.UrunResimleri ?? Enumerable.Empty<FilistinProje.Core.Varliklar.UrunResim>())
                                {
                                    <div style="position:relative; aspect-ratio:1/1; border-radius:var(--ca-radius); overflow:hidden; border:1px solid var(--ca-border); background:#fff;">
                                        <img src="@r.ResimYolu" alt="@Model.Baslik - صورة المعرض" loading="lazy" decoding="async" style="width:100%; height:100%; object-fit:cover;" />
                                         <a href="/Admin/Urun/ResimSil/@r.Id" title="@Localizer["Admin_DeleteImage"]" style="position:absolute; top:6px; right:6px; width:24px; height:24px; border-radius:50%; background:rgba(239,68,68,.92); color:#fff; display:flex; align-items:center; justify-content:center; font-size:.72rem; text-decoration:none;">x</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <div class="ca-save-rail">
                    <a href="/Admin/Urun" class="ca-btn ca-btn-outline">@Localizer["Admin_Iptal"]</a>
                    <button type="submit" class="ca-btn ca-btn-primary">
                        <i class="fas fa-save"></i> @Localizer["Admin_Kaydet"]
                    </button>
                </div>
            </div>

            <aside class="ca-product-aside">
                <div class="ca-card">
                    <div class="ca-card-header">
                        <span class="ca-card-title">@Localizer["Admin_ProductSummary"]</span>
                    </div>
                    <div class="ca-card-body">
                        <div class="ca-product-preview mb-3">
                            @if (previewItems.Any())
                            {
                                for (var i = 0; i < previewItems.Count; i++)
                                {
                                    var item = previewItems[i];
                                    <div class="ca-preview-slide @(i == 0 ? "active" : string.Empty)" data-preview-slide>
                                        @if (item.Type == "video")
                                        {
                                            <video src="@item.Url" poster="@item.Poster" preload="metadata" controls playsinline></video>
                                            <span class="ca-preview-video-chip"><i class="fas fa-play"></i> Video</span>
                                        }
                                        else
                                        {
                                            <img src="@item.Url" id="@(i == 0 ? "mainImgPreview" : null)" alt="@item.Alt" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/img/products/placeholder.webp';">
                                        }
                                    </div>
                                }

                                @if (previewItems.Count > 1)
                                {
                                    <button type="button" class="ca-preview-nav ca-preview-prev" data-preview-prev aria-label="@Localizer["Admin_PreviousMedia"]">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                    <button type="button" class="ca-preview-nav ca-preview-next" data-preview-next aria-label="@Localizer["Admin_NextMedia"]">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                    <span class="ca-preview-counter" data-preview-counter>1 / @previewItems.Count</span>
                                }
                            }
                            else
                            {
                                <img src="/img/products/placeholder.webp" id="mainImgPreview" alt="@Model.Baslik - الصورة الرئيسية" loading="lazy" decoding="async">
                            }
                        </div>
                        <div class="fw-bold">@Model.Baslik</div>
                        <div class="small text-muted mb-3">SKU: @(string.IsNullOrWhiteSpace(Model.SKU) ? "-" : Model.SKU)</div>
                        <div class="ca-mini-stat-grid">
                            <div class="ca-mini-stat"><span>@Localizer["Admin_EffectivePrice"]</span><strong>@Model.EtkinFiyat.ToString("N2") ₪</strong></div>
                            <div class="ca-mini-stat"><span>@Localizer["Admin_Sales"]</span><strong>@Model.SatisSayisi</strong></div>
                            <div class="ca-mini-stat"><span>@Localizer["Admin_Views"]</span><strong>@Model.GoruntulenmeSayisi</strong></div>
                            <div class="ca-mini-stat"><span>@Localizer["Admin_Favorite"]</span><strong>@Model.FavoriSayisi</strong></div>
                            <div class="ca-mini-stat"><span>@Localizer["Admin_Variation"]</span><strong>@variantCount</strong></div>
                            <div class="ca-mini-stat"><span>@Localizer["Admin_Media"]</span><strong>@mediaCount</strong></div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </form>

</div>

<script>
    (function () {
        const tabs = document.querySelectorAll('[data-product-tab]');
        const panels = document.querySelectorAll('[data-product-panel]');
        const storageKey = '7anrps48-product-editor-tab';

        function activate(name) {
            tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.productTab === name));
            panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.productPanel === name));
            localStorage.setItem(storageKey, name);
        }

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => activate(tab.dataset.productTab));
        });

        const initial = localStorage.getItem(storageKey);
        if (initial && document.querySelector(`[data-product-tab="${initial}"]`)) {
            activate(initial);
        }
    })();

    (function () {
        const slides = Array.from(document.querySelectorAll('[data-preview-slide]'));
        const prevButton = document.querySelector('[data-preview-prev]');
        const nextButton = document.querySelector('[data-preview-next]');
        const counter = document.querySelector('[data-preview-counter]');
        let activeIndex = 0;

        if (!slides.length) {
            return;
        }

        function pauseVideos() {
            slides.forEach((slide) => {
                const video = slide.querySelector('video');
                if (video && !video.paused) {
                    video.pause();
                }
            });
        }

        function showSlide(index) {
            activeIndex = (index + slides.length) % slides.length;
            pauseVideos();

            slides.forEach((slide, slideIndex) => {
                slide.classList.toggle('active', slideIndex === activeIndex);
            });

            if (counter) {
                counter.textContent = `${activeIndex + 1} / ${slides.length}`;
            }
        }

        prevButton?.addEventListener('click', () => showSlide(activeIndex - 1));
        nextButton?.addEventListener('click', () => showSlide(activeIndex + 1));
    })();

    function previewFile(event, id) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById(id).src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    // Gift wrap UI
    const giftToggle = document.getElementById('HediyePaketiVarMi');
    const giftContainer = document.getElementById('giftPriceContainer');
    const giftInput = document.getElementById('HediyePaketFiyati');
    if (giftToggle && giftContainer && giftInput) {
        giftToggle.addEventListener('change', function() {
            if (this.checked) {
                giftContainer.style.opacity = '1';
                giftContainer.style.pointerEvents = 'auto';
                giftInput.focus();
            } else {
                giftContainer.style.opacity = '0.5';
                giftContainer.style.pointerEvents = 'none';
            }
        });
    }

    function updatePreviewFromUrl(inputId, previewId) {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (input && preview) {
            preview.src = input.value;
        }
    }
</script>
