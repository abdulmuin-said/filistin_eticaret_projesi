@model FilistinProje.Core.Models.KullaniciIndexViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_Kullanici_Yonetimi"];
}

@functions {
    private static DateTime ToPalestineTime(DateTime utc)
    {
        var utcValue = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        foreach (var id in new[] { "Asia/Hebron", "West Bank Standard Time" })
        {
            try
            {
                return TimeZoneInfo.ConvertTimeFromUtc(utcValue, TimeZoneInfo.FindSystemTimeZoneById(id));
            }
            catch (TimeZoneNotFoundException) { }
            catch (InvalidTimeZoneException) { }
        }
        return utcValue.AddHours(3);
    }

    private static string FormatDate(DateTime? value)
    {
        return value.HasValue ? ToPalestineTime(value.Value).ToString("dd.MM.yyyy HH:mm") : "-";
    }

    private string PageUrl(int page, int? pageSize = null)
    {
        var query = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize ?? Model.PageSize}"
        };

        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            query.Add($"search={Uri.EscapeDataString(Model.Search)}");
        }

        return $"/Admin/Kullanici?{string.Join("&", query)}";
    }
}

<style>
    .ca-user-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(120px, 1fr));
        gap: 8px;
        min-width: 280px;
        justify-content: end;
    }

    .ca-user-actions form {
        margin: 0;
    }

    .ca-user-action {
        width: 100%;
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid var(--ca-border);
        background: #fff;
        color: var(--ca-text);
        transition: .18s ease;
        white-space: nowrap;
    }

    .ca-user-action:hover {
        background: var(--ca-bg);
        color: var(--ca-primary);
        border-color: var(--ca-primary);
    }

    .ca-user-action.is-primary {
        background: var(--ca-primary);
        border-color: var(--ca-primary);
        color: #fff;
    }

    .ca-user-action.is-primary:hover {
        background: var(--ca-primary-dark);
        color: #fff;
    }

    .ca-user-action.is-warning {
        border-color: #f59e0b;
        color: #92400e;
        background: #fffbeb;
    }

    .ca-user-action.is-danger {
        border-color: #fecaca;
        color: #b91c1c;
        background: #fff5f5;
    }

    .ca-user-action:disabled {
        opacity: .45;
        cursor: not-allowed;
        background: #f8fafc;
        color: #94a3b8;
        border-color: var(--ca-border);
    }

    .ca-action-note {
        display: block;
        margin-top: 8px;
        color: var(--ca-text-muted);
        font-size: .75rem;
        text-align: right;
    }

    @@media (max-width: 1200px) {
        .ca-user-actions {
            grid-template-columns: 1fr;
            min-width: 180px;
        }
    }
</style>

<div class="container-fluid ca-fade-in">
    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success">@TempData["Basari"]</div>
    }

    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }

    <div class="ca-page-header">
        <div>
            <h1 class="ca-page-title">@Localizer["Admin_Kullanici_Yonetimi"]</h1>
            <p class="ca-page-subtitle">@Localizer["Admin_UserManagementSubtitle"]</p>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end">
            <div class="ca-badge ca-badge-neutral" style="padding:8px 16px; font-size:.9rem;">
                <i class="fas fa-shield-alt me-1"></i> @Localizer["Admin_AdminCount", Model.AdminCount]
            </div>
            <div class="ca-badge ca-badge-success" style="padding:8px 16px; font-size:.9rem;">
                <i class="fas fa-user me-1"></i> @Localizer["Admin_CustomerCount", Model.CustomerCount]
            </div>
            <a href="/Admin/Kullanici/ExcelExport" class="ca-btn ca-btn-outline ca-btn-sm">
                <i class="fas fa-file-export"></i> @Localizer["Admin_ExportCsv"]
            </a>
        </div>
    </div>

    <div class="ca-card">
        <div class="ca-filter-bar d-flex flex-wrap justify-content-between gap-3">
            <form asp-action="Index" method="get" class="d-flex" style="max-width:340px; width:100%;">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="ca-input-icon-group" style="flex:1;">
                    <i class="fas fa-search ca-icon-left"></i>
                    <input type="text" name="search" value="@Model.Search" class="ca-input" placeholder="@Localizer["Admin_SearchUserPlaceholder"]">
                </div>
            </form>

            <div class="small text-muted d-flex align-items-center">
                @Localizer["Admin_UserPaginationSummary", Model.TotalCount, Model.Page, Model.TotalPages]
            </div>
        </div>

        <div class="ca-table-wrapper">
            <table class="ca-table">
                <thead>
                    <tr>
                        <th class="ps-4">@Localizer["Admin_Kullanici"]</th>
                        <th>@Localizer["Admin_Contact"]</th>
                        <th>@Localizer["Admin_Location"]</th>
                        <th>@Localizer["Admin_Role"]</th>
                        <th>@Localizer["Admin_LastAdminLogin"]</th>
                        <th class="text-end pe-4">@Localizer["Admin_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Kullanicilar)
                    {
                        var firstLetter = !string.IsNullOrWhiteSpace(user.AdSoyad)
                            ? user.AdSoyad.Substring(0, 1).ToUpperInvariant()
                            : "U";

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ca-avatar">@firstLetter</div>
                                    <div>
                                        <div class="ca-fw-bold">@user.AdSoyad</div>
                                        <small class="ca-text-muted">ID: #@user.Id.Substring(0, Math.Min(8, user.Id.Length))</small>
                                        @if (user.IsCurrentUser)
                                        {
                                            <div><small class="text-primary">@Localizer["Admin_ThisIsYourActiveAccount"]</small></div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="ca-text-muted" style="font-size:.85rem;">
                                    <i class="far fa-envelope me-1"></i> @(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)
                                </div>
                                <div class="ca-text-muted" style="font-size:.8rem; margin-top:2px;">
                                    <i class="fas fa-phone me-1"></i> @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)
                                </div>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(user.Sehir))
                                {
                                    <span class="ca-fw-semi"><i class="fas fa-map-marker-alt ca-text-danger me-1"></i>@user.Sehir</span>
                                }
                                else
                                {
                                    <span class="ca-text-muted">-</span>
                                }
                            </td>

                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="ca-badge ca-badge-danger"><i class="fas fa-shield-alt"></i> @user.RoleLabel</span>
                                }
                                else
                                {
                                    <span class="ca-badge ca-badge-success"><i class="fas fa-user"></i> @user.RoleLabel</span>
                                }

                                @if (user.IsBanned)
                                {
                                    <div class="mt-2"><span class="badge text-bg-danger">@Localizer["Admin_Banned"]</span></div>
                                }
                            </td>

                            <td>
                                <div class="small">@FormatDate(user.LastAdminLoginUtc)</div>
                                @if (user.PreviousAdminLoginUtc.HasValue)
                                {
                                    <div class="small text-muted">@Localizer["Admin_PreviousLogin"]: @FormatDate(user.PreviousAdminLoginUtc)</div>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <div class="ca-user-actions ms-auto">
                                    @if (user.CanManage)
                                    {
                                        <a href="/Admin/Kullanici/Duzenle/@user.Id" class="ca-user-action is-primary" title="@Localizer["Admin_EditUserDetailsTitle"]">
                                            <i class="fas fa-pen"></i>
                                            <span>@Localizer["Admin_Edit"]</span>
                                        </a>
                                        <a href="/Admin/Kullanici/SifreSifirla/@user.Id" class="ca-user-action" title="@Localizer["Admin_ChangePasswordTitle"]">
                                            <i class="fas fa-key"></i>
                                            <span>@Localizer["Admin_ChangePassword"]</span>
                                        </a>
                                    }

                                    <form asp-action="DurumDegistir" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsCurrentUser)
                                        {
                                            <button type="submit"
                                                    class="ca-user-action @(user.IsBanned ? string.Empty : "is-warning")"
                                                     title="@Localizer["Admin_CannotChangeOwnStatus"]"
                                                    disabled>
                                                <i class="fas @(user.IsBanned ? "fa-unlock" : "fa-ban")"></i>
                                                <span>@(user.IsBanned ? Localizer["Admin_UnblockLogin"] : Localizer["Admin_BlockLogin"])</span>
                                            </button>
                                        }
                                        else if (user.CanManage)
                                        {
                                            <button type="submit"
                                                    class="ca-user-action @(user.IsBanned ? string.Empty : "is-warning")"
                                                     title="@(user.IsBanned ? Localizer["Admin_UnblockLoginTitle"] : Localizer["Admin_BlockLoginTitle"])"
                                                     data-confirm="@(user.IsBanned ? Localizer["Admin_ConfirmUnblockUser"] : Localizer["Admin_ConfirmBlockUser"])">
                                                <i class="fas @(user.IsBanned ? "fa-unlock" : "fa-ban")"></i>
                                                <span>@(user.IsBanned ? Localizer["Admin_UnblockLogin"] : Localizer["Admin_BlockLogin"])</span>
                                            </button>
                                        }
                                    </form>

                                    <form asp-action="Sil" asp-route-id="@user.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsCurrentUser)
                                        {
                                            <button type="submit"
                                                    class="ca-user-action is-danger"
                                                     title="@Localizer["Admin_CannotDeleteOwnAccount"]"
                                                    disabled>
                                                <i class="fas fa-trash"></i>
                                                <span>@Localizer["Admin_DeleteAccount"]</span>
                                            </button>
                                        }
                                        else if (user.CanManage)
                                        {
                                            <button type="submit"
                                                    class="ca-user-action is-danger"
                                                     title="@Localizer["Admin_DeleteAccountTitle"]"
                                                     data-confirm="@Localizer["Admin_ConfirmDeleteUser"]">
                                                <i class="fas fa-trash"></i>
                                                <span>@Localizer["Admin_DeleteAccount"]</span>
                                            </button>
                                        }
                                    </form>
                                </div>
                                @if (user.IsCurrentUser)
                                {
                                    <small class="ca-action-note">@Localizer["Admin_OwnAccountActionsDisabled"]</small>
                                }
                                else if (!user.CanManage)
                                {
                                    <small class="ca-action-note">@Localizer["Admin_OnlySuperAdminCanManageSuperAdmin"]</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="ca-pagination mt-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">@Localizer["Admin_PageSize"]</span>
                    <select class="ca-input" style="width:90px;" onchange="location.href='@PageUrl(1, 0)'.replace('pageSize=0', 'pageSize=' + this.value)">
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a class="ca-btn ca-btn-outline ca-btn-sm @(Model.Page <= 1 ? "disabled" : string.Empty)" href="@(Model.Page <= 1 ? "#" : PageUrl(Model.Page - 1))">@Localizer["Admin_Previous"]</a>
                    <span class="small text-muted">@Model.Page / @Model.TotalPages</span>
                    <a class="ca-btn ca-btn-outline ca-btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)" href="@(Model.Page >= Model.TotalPages ? "#" : PageUrl(Model.Page + 1))">@Localizer["Admin_Next"]</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-confirm]').forEach(function (button) {
            button.addEventListener('click', function (event) {
                if (!window.confirm(button.dataset.confirm)) {
                    event.preventDefault();
                }
            });
        });
    </script>
}
