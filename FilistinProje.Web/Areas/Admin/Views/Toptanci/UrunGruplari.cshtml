@using FilistinProje.Core.Varliklar
@model List<ToptanciUrunGrubu>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_WholesaleGroupTitle"];
    var gruplar = Model;
}

<div class="container-fluid ca-fade-in">
    <div class="ca-page-header">
        <div>
            <h1 class="ca-page-title">@Localizer["Admin_WholesaleGroupTitle"]</h1>
            <p class="ca-page-subtitle">@Localizer["Admin_WholesaleGroupSubtitle"]</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="ca-card">
                <div class="ca-card-header">
                    <h3 class="ca-card-title d-flex align-items-center gap-2"><i class="fas fa-plus"></i><span>@Localizer["Admin_YeniUrunGrubu"]</span></h3>
                </div>
                <div class="ca-card-body">
                    <form method="post" action="/Admin/Toptanci/GrupKaydet">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="0" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="ca-label">@Localizer["Admin_GrupAdi"]</label>
                                <input name="Ad" class="ca-input" placeholder='@Localizer["Admin_GrupAdiPlaceholder"]' required />
                            </div>
                            <div class="col-12">
                                <label class="ca-label">@Localizer["Admin_Aciklama"]</label>
                                <textarea name="Aciklama" class="ca-input" rows="2" placeholder='@Localizer["Admin_GrupAciklamaPlaceholder"]'></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="ca-label">@Localizer["Admin_Sira"]</label>
                                <input name="Sira" class="ca-input" type="number" min="0" value="0" />
                            </div>
                            <div class="col-md-6">
                                <label class="ca-label">@Localizer["Admin_Durum"]</label>
                                <select name="AktifMi" class="ca-select">
                                    <option value="true">@Localizer["Admin_Aktif"]</option>
                                    <option value="false">@Localizer["Admin_Pasif"]</option>
                                </select>
                            </div>
                        </div>
                        <button class="ca-btn ca-btn-primary mt-3" type="submit">
                            <i class="fas fa-save"></i> @Localizer["Admin_GrubuKaydet"]
                        </button>
                    </form>
                </div>
            </div>

            <div class="ca-card mt-4">
                <div class="ca-card-header">
                    <h3 class="ca-card-title d-flex align-items-center gap-2"><i class="fas fa-percent"></i><span>@Localizer["Admin_IskontoOraniEkle"]</span></h3>
                </div>
                <div class="ca-card-body">
                    <form method="post" action="/Admin/Toptanci/IskontoKaydet">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="0" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="ca-label">@Localizer["Admin_UrunGrubu"]</label>
                                <select name="ToptanciUrunGrubuId" id="mainGrupSelect" class="ca-select" required onchange="onMainGroupChange(this.value)">
                                    <option value="">-- @Localizer["Admin_GrupSecin"] --</option>
                                    @foreach (var g in gruplar.Where(g => g.AktifMi).OrderBy(g => g.Sira))
                                    {
                                        <option value="@g.Id">@g.Ad</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="ca-label">@Localizer["Admin_Urun"]</label>
                                <select name="UrunId" id="mainUrunSelect" class="ca-select" onchange="onMainUrunChange(this.value)">
                                    <option value="">-- @Localizer["Admin_WholesaleAllProductsInGroup"] --</option>
                                </select>
                                <small class="text-muted d-block mt-1">@Localizer["Admin_WholesaleProductOptionalHint"]</small>
                            </div>
                            <div class="col-12" id="mainVaryantContainer" style="display:none;">
                                <label class="ca-label">@Localizer["Admin_Variant"]</label>
                                <select name="UrunSecenekId" id="mainVaryantSelect" class="ca-select">
                                    <option value="">@Localizer["Admin_WholesaleAllVariants"]</option>
                                </select>
                                <small class="text-muted d-block mt-1">@Localizer["Admin_WholesaleVariantOptionalHint"]</small>
                            </div>
                            <div class="col-md-6">
                                <label class="ca-label">@Localizer["Admin_MinAdet"]</label>
                                <input name="MinAdet" class="ca-input" type="number" min="1" value="10" required />
                            </div>
                            <div class="col-md-6">
                                <label class="ca-label">@Localizer["DiscountType"]</label>
                                <select name="IskontoTipi" class="ca-select" id="topIskontoTipi" onchange="toggleTopDiscountFields()">
                                    <option value="Yuzde">@Localizer["DiscountTypePercentage"]</option>
                                    <option value="Tutar">@Localizer["DiscountTypeFixed"]</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="topYuzdeField">
                                <label class="ca-label">@Localizer["Admin_IskontoYuzdesi"]</label>
                                <input name="IskontoYuzdesi" class="ca-input" type="number" min="0" max="100" step="0.5" value="5" />
                            </div>
                            <div class="col-md-6" id="topTutarField" style="display:none;">
                                <label class="ca-label">@Localizer["DiscountAmount"] (₪)</label>
                                <input name="IskontoTutari" class="ca-input" type="number" min="0" step="0.01" value="0" />
                            </div>
                        </div>
                        <button class="ca-btn ca-btn-primary mt-3" type="submit">
                            <i class="fas fa-save"></i> @Localizer["Admin_IskontoKaydet"]
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="ca-card">
                <div class="ca-card-header">
                    <h3 class="ca-card-title"><i class="fas fa-layer-group me-2"></i>@Localizer["Admin_KayitliGruplar"] (@gruplar.Count)</h3>
                </div>
                @if (!gruplar.Any())
                {
                    <div class="ca-card-body text-center py-5">
                        <i class="fas fa-layer-group fa-3x mb-3" style="color:var(--ca-muted);"></i>
                        <p class="text-muted">@Localizer["Admin_GrupYok"]</p>
                    </div>
                }
                else
                {
                    <div class="ca-table-wrapper">
                        <table class="ca-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">@Localizer["Admin_GrupAdi"]</th>
                                    <th>@Localizer["Admin_Aciklama"]</th>
                                    <th>@Localizer["Admin_Durum"]</th>
                                    <th>@Localizer["Admin_IskontoSayisi"]</th>
                                    <th class="text-end pe-4">@Localizer["Admin_Islem"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grup in gruplar)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="ca-fw-bold">@grup.Ad</div>
                                            <div class="small text-muted">@Localizer["Admin_Sira"]: @grup.Sira · @grup.Urunler.Count @Localizer["Admin_UrunSayisiSuffix"]</div>
                                        </td>
                                        <td>
                                            <span class="small">@(!string.IsNullOrWhiteSpace(grup.Aciklama) ? grup.Aciklama : "-")</span>
                                        </td>
                                        <td>
                                            <span class="ca-badge @(grup.AktifMi ? "ca-badge-success" : "ca-badge-neutral")">@(grup.AktifMi ? Localizer["Admin_Aktif"] : Localizer["Admin_Pasif"])</span>
                                        </td>
                                        <td>
                                            <span class="ca-badge ca-badge-info">@(grup.IskontoOranlari?.Count(i => i.AktifMi) ?? 0) @Localizer["Admin_AktifSuffix"]</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="dropdown">
                                                <button class="ca-btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localizer["Admin_Islem"]">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end ca-dropdown-menu">
                                                    <li>
                                                        <button class="dropdown-item" type="button" data-bs-toggle="collapse" data-bs-target="#grup-@grup.Id">
                                                            <i class="fas fa-pen me-2"></i> @Localizer["Admin_Duzenle"]
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" data-bs-toggle="collapse" href="#iskontolar-@grup.Id" role="button">
                                                            <i class="fas fa-percent me-2"></i> @Localizer["Admin_IskontoGor"]
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form method="post" action="/Admin/Toptanci/GrupSil/@grup.Id" class="m-0" onsubmit="return confirm('@Localizer["Admin_GrupSilConfirm"]');">
                                                            @Html.AntiForgeryToken()
                                                            <button class="dropdown-item text-danger" type="submit">
                                                                <i class="fas fa-trash me-2"></i> @Localizer["Admin_Sil"]
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="collapse" id="grup-@grup.Id">
                                        <td colspan="5" class="p-4" style="background:var(--ca-bg);">
                                            <form method="post" action="/Admin/Toptanci/GrupKaydet">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@grup.Id" />
                                                <div class="row g-3">
                                                    <div class="col-md-4"><label class="ca-label">@Localizer["Admin_GrupAdi"]</label><input name="Ad" value="@grup.Ad" class="ca-input" required /></div>
                                                    <div class="col-md-4"><label class="ca-label">@Localizer["Admin_Sira"]</label><input name="Sira" value="@grup.Sira" class="ca-input" type="number" min="0" /></div>
                                                    <div class="col-md-4">
                                                        <label class="ca-label">@Localizer["Admin_Durum"]</label>
                                                        <select name="AktifMi" class="ca-select">
                                                            <option value="true" selected="@grup.AktifMi">@Localizer["Admin_Aktif"]</option>
                                                            <option value="false" selected="@(!grup.AktifMi)">@Localizer["Admin_Pasif"]</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12"><label class="ca-label">@Localizer["Admin_Aciklama"]</label><textarea name="Aciklama" class="ca-input" rows="2">@grup.Aciklama</textarea></div>
                                                    <div class="col-12 text-end"><button class="ca-btn ca-btn-primary" type="submit"><i class="fas fa-save"></i> @Localizer["Admin_Guncelle"]</button></div>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                    <tr class="collapse" id="iskontolar-@grup.Id">
                                        <td colspan="5" class="p-0" style="background:transparent;">
                                            <div class="p-3" style="background:var(--ca-bg);border-top:1px solid var(--ca-border);">
                                                <h6 class="mb-3"><i class="fas fa-percent me-2"></i>@grup.Ad - @Localizer["Admin_IskontoOranlari"]</h6>
                                                @if (grup.IskontoOranlari == null || !grup.IskontoOranlari.Any(i => !i.SilindiMi && i.AktifMi))
                                                {
                                                    <p class="text-muted small mb-2">@Localizer["Admin_IskontoYok"]</p>
                                                }
                                                else
                                                {
                                                    <div class="table-responsive">
                                                        <table class="table table-sm mb-2">
                                                            <thead><tr><th>@Localizer["Admin_MinAdet"]</th><th>@Localizer["Admin_Urun"]</th><th>@Localizer["DiscountType"]</th><th>@Localizer["Admin_IskontoYuzdesi"] / @Localizer["DiscountAmount"]</th><th>@Localizer["Admin_Durum"]</th><th class="text-end">@Localizer["Admin_Sil"]</th></tr></thead>
                                                            <tbody>
                                                                @foreach (var iskonto in grup.IskontoOranlari.Where(i => !i.SilindiMi).OrderBy(i => i.MinAdet))
                                                                {
                                                                    <tr>
                                                                        <td>@iskonto.MinAdet</td>
                                                                        <td>
                                                                            @if (iskonto.Urun != null)
                                                                            {
                                                                                <span class="ca-badge ca-badge-info"><i class="fas fa-box me-1"></i>@(iskonto.Urun.BaslikAr ?? iskonto.Urun.BaslikEn ?? iskonto.Urun.Baslik)</span>
                                                                                @if (iskonto.UrunSecenek != null)
                                                                                {
                                                                                    <span class="ca-badge ca-badge-warning ms-1"><i class="fas fa-tags me-1"></i>@(iskonto.UrunSecenek.GetDetailedVariantBadge(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar")))</span>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="ca-badge ca-badge-neutral"><i class="fas fa-layer-group me-1"></i>@Localizer["Admin_WholesaleAllProductsInGroup"]</span>
                                                                            }
                                                                        </td>
                                                                        <td>
                                                                            @if (iskonto.IskontoTipi == "Tutar")
                                                                            {
                                                                                <span class="ca-badge ca-badge-warning">@Localizer["DiscountTypeFixed"]</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="ca-badge ca-badge-info">@Localizer["DiscountTypePercentage"]</span>
                                                                            }
                                                                        </td>
                                                                        <td>
                                                                            @if (iskonto.IskontoTipi == "Tutar")
                                                                            {
                                                                                <span>₪@iskonto.IskontoTutari.ToString("N2")</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>@iskonto.IskontoYuzdesi%</span>
                                                                            }
                                                                        </td>
                                                                        <td><span class="ca-badge @(iskonto.AktifMi ? "ca-badge-success" : "ca-badge-neutral")">@(iskonto.AktifMi ? Localizer["Admin_Aktif"] : Localizer["Admin_Pasif"])</span></td>
                                                                        <td class="text-end">
                                                                            <form method="post" action="/Admin/Toptanci/IskontoSil/@iskonto.Id" class="m-0" onsubmit="return confirm('@Localizer["Admin_IskontoSilConfirm"]');">
                                                                                @Html.AntiForgeryToken()
                                                                                <button class="ca-btn-icon text-danger" type="submit"><i class="fas fa-trash"></i></button>
                                                                            </form>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                <form method="post" action="/Admin/Toptanci/IskontoKaydet">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="0" />
                                                    <input type="hidden" name="ToptanciUrunGrubuId" value="@grup.Id" />
                                                    <div class="row g-2">
                                                        <div class="col-12 mb-1">
                                                            <select name="UrunId" class="ca-select form-control-sm">
                                                                <option value="">-- @Localizer["Admin_WholesaleAllProductsInGroup"] --</option>
                                                                @if (ViewBag.TumUrunler != null)
                                                                {
                                                                    foreach (var p in (dynamic)ViewBag.TumUrunler)
                                                                    {
                                                                        var pGrupId = (int?)p.ToptanciUrunGrubuId;
                                                                        var label = (string)p.Baslik;
                                                                        if (pGrupId != null && pGrupId != grup.Id && !string.IsNullOrEmpty((string)p.GrupAdi))
                                                                        {
                                                                            label += $" ({Localizer["Admin_CurrentGroup"].Value}: {(string)p.GrupAdi})";
                                                                        }
                                                                        <option value="@p.Id">@label</option>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    foreach (var u in grup.Urunler.Where(u => !u.SilindiMi).OrderBy(u => u.Baslik))
                                                                    {
                                                                        <option value="@u.Id">@(u.BaslikAr ?? u.BaslikEn ?? u.Baslik)</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col"><input name="MinAdet" class="ca-input form-control-sm" type="number" min="1" placeholder='@Localizer["Admin_MinAdet"]' required /></div>
                                                        <div class="col">
                                                            <select name="IskontoTipi" class="ca-select form-control-sm" onchange="toggleInlineDiscount(this)">
                                                                <option value="Yuzde">%</option>
                                                                <option value="Tutar">₪</option>
                                                            </select>
                                                        </div>
                                                        <div class="col inline-yuzde-@grup.Id"><input name="IskontoYuzdesi" class="ca-input form-control-sm" type="number" min="0" max="100" step="0.5" placeholder='@Localizer["Admin_IskontoYuzdesi"]' /></div>
                                                        <div class="col inline-tutar-@grup.Id" style="display:none;"><input name="IskontoTutari" class="ca-input form-control-sm" type="number" min="0" step="0.01" placeholder='@Localizer["DiscountAmount"]' /></div>
                                                        <div class="col-auto"><button class="ca-btn ca-btn-sm ca-btn-primary" type="submit"><i class="fas fa-plus"></i> @Localizer["Admin_Ekle"]</button></div>
                                                    </div>
                                                </form>

                                                <div class="mt-4 pt-3" style="border-top:1px dashed var(--ca-border);">
                                                    <h6 class="mb-3 d-flex align-items-center justify-content-between">
                                                        <span><i class="fas fa-boxes me-2"></i>@Localizer["Admin_GruptakiUrunler"] (@grup.Urunler.Count(u => !u.SilindiMi))</span>
                                                    </h6>
                                                    @if (!grup.Urunler.Any(u => !u.SilindiMi))
                                                    {
                                                        <p class="text-muted small mb-3">@Localizer["Admin_GruptaUrunYok"]</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                                            @foreach (var u in grup.Urunler.Where(u => !u.SilindiMi).OrderBy(u => u.Baslik))
                                                            {
                                                                <span class="ca-badge ca-badge-info d-inline-flex align-items-center gap-1 p-2">
                                                                    <i class="fas fa-box"></i>
                                                                    <span>@(u.BaslikAr ?? u.BaslikEn ?? u.Baslik)</span>
                                                                    <form method="post" action="/Admin/Toptanci/GruptanUrunCikar" class="d-inline m-0 p-0" onsubmit="return confirm('@Localizer["Admin_GrupSilConfirm"]');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="urunId" value="@u.Id" />
                                                                        <button type="submit" class="btn btn-link p-0 text-danger ms-1" style="line-height:1;" title="@Localizer["Admin_GruptanCikar"]">
                                                                            <i class="fas fa-times-circle"></i>
                                                                        </button>
                                                                    </form>
                                                                </span>
                                                            }
                                                        </div>
                                                    }

                                                    <form method="post" action="/Admin/Toptanci/GrubaUrunAta" class="row g-2 align-items-center">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="grupId" value="@grup.Id" />
                                                        <div class="col-sm-8">
                                                            <select name="urunId" class="ca-select form-control-sm" required>
                                                                <option value="">-- @Localizer["Admin_GrubaUrunAta"] --</option>
                                                                @if (ViewBag.TumUrunler != null)
                                                                {
                                                                    foreach (var p in (dynamic)ViewBag.TumUrunler)
                                                                    {
                                                                        if (p.ToptanciUrunGrubuId == grup.Id) continue;
                                                                        var label = (string)p.Baslik;
                                                                        if (p.ToptanciUrunGrubuId != null && !string.IsNullOrEmpty((string)p.GrupAdi))
                                                                        {
                                                                            label += $" ({Localizer["Admin_CurrentGroup"].Value}: {(string)p.GrupAdi})";
                                                                        }
                                                                        <option value="@p.Id">@label</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <button type="submit" class="ca-btn ca-btn-sm ca-btn-secondary w-100">
                                                                <i class="fas fa-plus"></i> @Localizer["Admin_GrubaUrunAta"]
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var allProductsCache = null;
    var allProductsPromise = null;
    var currentGroupLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_CurrentGroup"].Value));
    var allProductsPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_WholesaleAllProductsInGroup"].Value));
    var allVariantsPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin_WholesaleAllVariants"].Value));

    function resetMainVariantSelect() {
        var varyantContainer = document.getElementById('mainVaryantContainer');
        var varyantSelect = document.getElementById('mainVaryantSelect');
        if (varyantSelect) {
            varyantSelect.innerHTML = '<option value="">' + allVariantsPlaceholder + '</option>';
        }
        if (varyantContainer) {
            varyantContainer.style.display = 'none';
        }
    }

    function fetchAllActiveProducts() {
        if (allProductsCache) {
            return Promise.resolve(allProductsCache);
        }
        if (!allProductsPromise) {
            allProductsPromise = fetch('/Admin/Toptanci/GetTumAktifUrunler')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    allProductsCache = Array.isArray(data) ? data : [];
                    return allProductsCache;
                })
                .catch(function(err) {
                    console.error('Error fetching active products:', err);
                    allProductsPromise = null;
                    return [];
                });
        }
        return allProductsPromise;
    }

    function populateMainUrunDropdown(selectedGroupId) {
        var urunSelect = document.getElementById('mainUrunSelect');
        if (!urunSelect) return;
        var prevVal = urunSelect.value;

        fetchAllActiveProducts().then(function(items) {
            urunSelect.innerHTML = '<option value="">-- ' + allProductsPlaceholder + ' --</option>';
            if (Array.isArray(items)) {
                items.forEach(function(item) {
                    var opt = document.createElement('option');
                    opt.value = item.id;
                    var text = item.baslik;
                    if (item.toptanciUrunGrubuId && item.grupAdi && item.toptanciUrunGrubuId != selectedGroupId) {
                        text += ' (' + currentGroupLabel + ': ' + item.grupAdi + ')';
                    }
                    opt.textContent = text;
                    urunSelect.appendChild(opt);
                });
            }
            if (prevVal) {
                urunSelect.value = prevVal;
            }
        });
    }

    function onMainGroupChange(groupId) {
        resetMainVariantSelect();
        populateMainUrunDropdown(groupId);
    }

    function onMainUrunChange(urunId) {
        resetMainVariantSelect();
        if (!urunId) return;

        var varyantContainer = document.getElementById('mainVaryantContainer');
        var varyantSelect = document.getElementById('mainVaryantSelect');

        fetch('/Admin/Toptanci/GetUrunVaryantlari?urunId=' + encodeURIComponent(urunId))
            .then(function(r) { return r.json(); })
            .then(function(items) {
                if (Array.isArray(items) && items.length > 0) {
                    items.forEach(function(item) {
                        var opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.varyantBasligi;
                        varyantSelect.appendChild(opt);
                    });
                    if (varyantContainer) {
                        varyantContainer.style.display = '';
                    }
                } else if (varyantContainer) {
                    varyantContainer.style.display = 'none';
                }
            })
            .catch(function(err) {
                console.error('Error fetching variants:', err);
            });
    }

    function toggleTopDiscountFields() {
        var sel = document.getElementById('topIskontoTipi');
        var yuzde = document.getElementById('topYuzdeField');
        var tutar = document.getElementById('topTutarField');
        if (sel.value === 'Tutar') {
            yuzde.style.display = 'none';
            tutar.style.display = '';
        } else {
            yuzde.style.display = '';
            tutar.style.display = 'none';
        }
    }

    function toggleInlineDiscount(select) {
        var form = select.closest('form');
        var row = form.querySelector('.row');
        var yuzdeCol = row.querySelector('[class*="inline-yuzde"]');
        var tutarCol = row.querySelector('[class*="inline-tutar"]');
        if (select.value === 'Tutar') {
            if (yuzdeCol) yuzdeCol.style.display = 'none';
            if (tutarCol) tutarCol.style.display = '';
        } else {
            if (yuzdeCol) yuzdeCol.style.display = '';
            if (tutarCol) tutarCol.style.display = 'none';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var initialGroupId = document.getElementById('mainGrupSelect')?.value;
        populateMainUrunDropdown(initialGroupId);
    });
</script>
}
