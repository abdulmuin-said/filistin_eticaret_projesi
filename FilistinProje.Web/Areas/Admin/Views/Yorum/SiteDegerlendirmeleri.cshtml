@using FilistinProje.Core.Varliklar
@model List<SiteDegerlendirme>
@{
    ViewData["Title"] = Localizer["Admin_Site_Degerlendirmeleri"];
    var page = ViewBag.Page ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalCount = ViewBag.TotalCount ?? 0;
    var pendingCount = ViewBag.PendingCount ?? 0;
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-semibold text-brand-darktext">@Localizer["Admin_Site_Degerlendirmeleri"]</h1>
    <div class="flex items-center gap-3">
        <span class="text-xs bg-gray-50 text-brand-mutedtext px-3 py-1.5 rounded-full">Total: @totalCount</span>
        @if (pendingCount > 0)
        {
            <span class="text-xs bg-amber-50 text-amber-700 px-3 py-1.5 rounded-full">Pending: @pendingCount</span>
        }
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="bg-green-50 border border-green-200 text-green-700 rounded px-4 py-3 mb-6 text-sm">@TempData["Mesaj"]</div>
}

<div class="bg-white border border-brand-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-gray-50 text-left">
                <th class="px-4 py-3 font-semibold text-brand-darktext">@Localizer["Admin_Ad_Soyad"]</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">Rating</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">Title</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">Review</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">@Localizer["Admin_Durum"]</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">@Localizer["Admin_Tarih"]</th>
                <th class="px-4 py-3 font-semibold text-brand-darktext">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="px-4 py-8 text-center text-brand-mutedtext">No site reviews yet.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr class="border-t border-brand-border hover:bg-[#faf9f6]">
                    <td class="px-4 py-3 font-medium">@item.AdSoyad</td>
                    <td class="px-4 py-3">
                        <span class="text-brand-gold">@item.Puan <i class="fas fa-star text-[10px]"></i></span>
                    </td>
                    <td class="px-4 py-3 text-brand-mutedtext">@(!string.IsNullOrWhiteSpace(item.Baslik) ? item.Baslik : "-")</td>
                    <td class="px-4 py-3 text-brand-mutedtext max-w-[300px] truncate">@item.YorumMetni</td>
                    <td class="px-4 py-3">
                        @if (item.OnayliMi)
                        {
                            <span class="bg-green-50 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-medium">Approved</span>
                        }
                        else
                        {
                            <span class="bg-amber-50 text-amber-700 text-[10px] px-2 py-0.5 rounded-full font-medium">Pending</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-xs text-brand-mutedtext">@item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                            @if (!item.OnayliMi)
                            {
                                <form method="post" action="/Admin/Yorum/SiteOnayla" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="text-xs bg-brand-olive text-white px-3 py-1.5 rounded hover:bg-[#1c2001] transition-colors">Approve</button>
                                </form>
                            }
                            <form method="post" action="/Admin/Yorum/SiteSil" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="text-xs bg-red-50 text-red-600 px-3 py-1.5 rounded hover:bg-red-100 transition-colors" onclick="return confirm('Are you sure you want to delete it?')">@Localizer["Admin_Sil"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <div class="flex items-center justify-center gap-2 mt-8">
        @for (int p = 1; p <= totalPages; p++)
        {
            <a href="/Admin/Yorum/SiteDegerlendirmeleri?page=@p"
               class="w-8 h-8 flex items-center justify-center text-xs rounded border @(p == page ? "bg-brand-olive text-white border-brand-olive" : "border-brand-border text-brand-mutedtext hover:bg-gray-50")">@p</a>
        }
    </div>
}
