                                            <span class="small text-muted">@(isAr ? "الموصى به: 50 - 60 حرفاً" : "Recommended: 50-60 chars")</span>
                                        </div>
                                        <input asp-for="MetaTitle" class="ca-input" maxlength="70" placeholder="@(isAr ? "مثال: 7ANRPS48 - متجرك الإلكتروني | تسوق أونلاين" : "e.g. 7ANRPS48 - Online Shopping")" />
