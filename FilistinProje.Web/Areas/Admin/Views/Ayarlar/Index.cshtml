@model FilistinProje.Core.Models.SiteAyarlari
@using FilistinProje.Core.Varliklar
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_Site_Ayarlari"];
    var kargoFirmalari = ViewBag.KargoFirmalari as List<KargoFirmasi> ?? new List<KargoFirmasi>();
    var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<style>
    .ca-settings-shell {
        max-width: 1320px;
        margin: 0 auto;
    }

    .ca-settings-hero {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .ca-settings-tabs {
        position: sticky;
        top: 84px;
        z-index: 8;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 12px;
        margin-bottom: 16px;
        background: rgba(252, 249, 243, .94);
        border: 1px solid var(--ca-border);
        border-radius: 14px;
        backdrop-filter: blur(12px);
    }

    .ca-settings-tab {
        border: 1px solid transparent;
        background: #fff;
        color: var(--ca-text);
        border-radius: 10px;
        padding: 10px 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: .82rem;
        font-weight: 800;
        transition: .18s ease;
    }

    .ca-settings-tab:hover,
    .ca-settings-tab.active {
        background: var(--ca-primary);
        border-color: var(--ca-primary);
        color: #fff;
    }

    .ca-settings-panel {
        display: none;
    }

    .ca-settings-panel.active {
        display: block;
    }

    .ca-settings-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 16px;
        align-items: start;
    }

    .ca-settings-side {
        position: sticky;
        top: 164px;
    }

    .ca-section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .ca-section-heading i {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(var(--ca-primary-rgb), .08);
        color: var(--ca-primary);
        flex: 0 0 auto;
    }

    .ca-section-heading h2 {
        margin: 0;
        color: var(--ca-text);
        font-size: 1rem;
        font-weight: 800;
    }

    .ca-section-heading p {
        margin: 3px 0 0;
        color: var(--ca-text-muted);
        font-size: .82rem;
    }

    .ca-help-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
    }

    .ca-help-list li {
        display: flex;
        gap: 9px;
        color: var(--ca-text-muted);
        font-size: .82rem;
        line-height: 1.45;
    }

    .ca-help-list i {
        color: var(--ca-accent);
        margin-top: 3px;
    }

    .ca-toggle-box {
        padding: 14px;
        background: var(--ca-bg);
        border: 1px solid var(--ca-border);
        border-radius: 12px;
        min-height: 70px;
        display: flex;
        align-items: center;
    }

    .ca-settings-save-bar {
        position: sticky;
        bottom: 0;
        z-index: 10;
        margin-top: 18px;
        padding: 14px 0 2px;
        background: linear-gradient(180deg, rgba(252,249,243,0), var(--ca-bg) 30%);
    }

    .ca-settings-save-inner {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border: 1px solid var(--ca-border);
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 -8px 24px rgba(49, 53, 17, .045);
    }

    @@media (max-width: 1100px) {
        .ca-settings-layout {
            grid-template-columns: 1fr;
        }

        .ca-settings-side {
            position: static;
        }
    }

    @@media (max-width: 760px) {
        .ca-settings-hero {
            flex-direction: column;
        }

        .ca-settings-tabs {
            position: static;
        }

        .ca-settings-tab {
            flex: 1 1 45%;
            justify-content: center;
        }

        .ca-settings-save-inner {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="container-fluid ca-fade-in">
    <div class="ca-settings-shell">
        <div class="ca-settings-hero">
            <div>
                <div class="ca-page-kicker">@Localizer["Admin_StoreConfiguration"]</div>
                <h1 class="ca-page-title">@Localizer["Admin_Site_Ayarlari"]</h1>
                <p class="ca-page-subtitle">@Localizer["Admin_StoreConfigurationDesc"]</p>
            </div>
            <div class="d-flex gap-2 flex-wrap justify-content-end">
                <a href="/" target="_blank" class="ca-btn ca-btn-outline">
                    <i class="fas fa-arrow-up-right-from-square"></i> @Localizer["Admin_ViewSite"]
                </a>
                <a href="/Admin/AnaSayfa" class="ca-btn ca-btn-outline">
                    <i class="fas fa-images"></i> @Localizer["Admin_HomePageSettings"]
                </a>
            </div>
        </div>

        <form method="post" asp-antiforgery="true">
            <input type="hidden" id="activeSettingsTab" name="aktifSekme" value="@(ViewBag.ActiveTab ?? "genel")" />
            <div class="ca-settings-tabs" role="tablist" aria-label="@Localizer["Admin_SettingsTabs"]">
                <button type="button" class="ca-settings-tab active" data-target="genel"><i class="fas fa-store"></i> @Localizer["Admin_Brand"]</button>
                <button type="button" class="ca-settings-tab" data-target="iletisim"><i class="fas fa-address-card"></i> @Localizer["Admin_Contact"]</button>
                <button type="button" class="ca-settings-tab" data-target="sosyal"><i class="fas fa-share-nodes"></i> @Localizer["Admin_Social"]</button>
                <button type="button" class="ca-settings-tab" data-target="satis"><i class="fas fa-cart-shopping"></i> @Localizer["Admin_Sales"]</button>
                <button type="button" class="ca-settings-tab" data-target="kapida-odeme"><i class="fas fa-hand-holding-dollar"></i> @Localizer["Admin_Kapida_Odeme"]</button>
                <button type="button" class="ca-settings-tab" data-target="seo"><i class="fas fa-magnifying-glass-chart"></i> SEO</button>
                <button type="button" class="ca-settings-tab" data-target="mail"><i class="fas fa-envelope"></i> @Localizer["Admin_Mail"]</button>
                <button type="button" class="ca-settings-tab" data-target="bakim"><i class="fas fa-screwdriver-wrench"></i> @Localizer["Admin_Maintenance"]</button>
            </div>

            <div class="ca-settings-layout">
                <main>
                    <section class="ca-settings-panel active" id="panel-genel">
                        <div class="ca-card">
                            <div class="ca-card-body">
                                <div class="ca-section-heading">
                                    <i class="fas fa-store"></i>
                                    <div>
                                         <h2>@Localizer["Admin_BrandStoreInfo"]</h2>
                                         <p>@Localizer["Admin_BrandStoreInfoDesc"]</p>

                                    </div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_SiteName"] <span class="required">*</span></label>
                                         <input asp-for="SiteAdi" class="ca-input" required />
                                     </div>
                                     <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_BrandName"]</label>
                                         <input asp-for="MarkaAdi" class="ca-input" />
                                     </div>
                                     <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_SiteTitle"]</label>
                                         <input asp-for="SiteBasligi" class="ca-input" />
                                     </div>
                                     <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_SiteURL"]</label>
                                         <input asp-for="BaseUrl" class="ca-input" placeholder="https://7anrps48.com" />
                                     </div>
                                     <div class="col-12">
                                         <label class="ca-label">@Localizer["Admin_SiteDescription"]</label>
                                         <textarea asp-for="SiteAciklamasi" class="ca-textarea" rows="3"></textarea>
                                     </div>
                                     <div class="col-12">
                                         <label class="ca-label">@Localizer["Admin_FooterDescription"]</label>
                                         <textarea asp-for="FooterAciklamasi" class="ca-textarea" rows="2"></textarea>
                                     </div>
                                     <div class="col-md-4">
                                         <label class="ca-label">@Localizer["Admin_LogoURL"]</label>
                                         <input asp-for="SiteLogoUrl" class="ca-input" placeholder="/74anrps48logo2.svg" />
                                     </div>
                                     <div class="col-md-4">
                                         <label class="ca-label">@Localizer["Admin_FaviconURL"]</label>
                                         <input asp-for="FaviconUrl" class="ca-input" placeholder="/74anrps48logo2.svg" />
                                     </div>
                                     <div class="col-md-4">
                                          <label class="ca-label">@Localizer["Admin_ThemeColor"]</label>
                                          <input asp-for="TemaRengi" class="ca-input" placeholder="#313511" />
                                      </div>
                                      <div class="col-12 mt-3">
                                          <div class="border-t pt-4">
                                              <h3 class="font-bold mb-3 text-sm">@Localizer["Admin_HeroBanner"]</h3>
                                          </div>
                                      </div>
                                      <input asp-for="HeroBaslikAr" type="hidden" />
                                      <input asp-for="HeroBaslikEn" type="hidden" />
                                      <input asp-for="HeroAltBaslikAr" type="hidden" />
                                      <input asp-for="HeroAltBaslikEn" type="hidden" />
                                      <div class="col-md-6">
                                          <label class="ca-label">@Localizer["Admin_HeroImage"]</label>
                                          <input asp-for="HeroGorselUrl" class="ca-input" placeholder="/slider-demo.jpg" />
                                      </div>
                                      <div class="col-md-6">
                                          <label class="ca-label">@Localizer["Admin_TopBarMessage"]</label>
                                          <input asp-for="UstBarMesaji" class="ca-input" placeholder="@Localizer["Admin_TopBarMessagePlaceholder"]" />
                                     </div>
                                     <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_CampaignMessage"]</label>
                                         <input asp-for="KampanyaMesaji" class="ca-input" placeholder="@Localizer["Admin_CampaignMessagePlaceholder"]" />
                                     </div>
                                     <div class="col-md-4">
                                         <label class="ca-label">@Localizer["Admin_TopBarEnabled"]</label>
                                         <select asp-for="UstBarEtkin" class="ca-input">
                                             <option value="True">@Localizer["Admin_Active"]</option>
                                             <option value="False">@Localizer["Admin_Passive"]</option>
                                         </select>
                                     </div>
                                     <div class="col-md-4">
                                         <label class="ca-label">@Localizer["Admin_ScrollSpeed"]</label>
                                         <input asp-for="UstBarHizi" class="ca-input" type="number" step="1" min="10" max="100" placeholder="34" />
                                         <small class="text-muted">@Localizer["Admin_AnimationDuration"]</small>
                                     </div>

                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="ca-settings-panel" id="panel-iletisim">
                        <div class="ca-card">
                            <div class="ca-card-body">
                                <div class="ca-section-heading">
                                    <i class="fas fa-address-card"></i>
                                    <div>
                                         <h2>@Localizer["Admin_ContactInfo"]</h2>
                                         <p>@Localizer["Admin_ContactInfoDesc"]</p>

                                    </div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="ca-label">@Localizer["Admin_Telefon"]</label>
                                        <input asp-for="Telefon" class="ca-input" placeholder="+970 5XX XXX XXX" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="ca-label">@Localizer["Admin_E_posta"]</label>
                                        <input asp-for="Email" class="ca-input" type="email" placeholder="info@7anrps48.com" />
                                    </div>
                                    <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_WhatsAppNumber"]</label>
                                         <input asp-for="WhatsappNumarasi" class="ca-input" placeholder="9705XXXXXXXX" />
                                         <small class="text-muted">@Localizer["Admin_WhatsAppHint"]</small>
                                     </div>
                                     <div class="col-md-6">
                                         <label class="ca-label">@Localizer["Admin_WorkingHours"]</label>
                                         <input asp-for="CalismaSaatleri" class="ca-input" placeholder="@Localizer["Admin_WorkingHoursPlaceholder"]" />
                                     </div>

                                    <div class="col-12">
                                        <label class="ca-label">@Localizer["Admin_Adres"]</label>
                                        <textarea asp-for="Adres" class="ca-textarea" rows="3"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="ca-settings-panel" id="panel-sosyal">
                        <div class="ca-card">
                            <div class="ca-card-body">
                                <div class="ca-section-heading">
                                    <i class="fas fa-share-nodes"></i>
                                    <div>
                                         <h2>@Localizer["Admin_SocialMediaLinks"]</h2>
                                         <p>@Localizer["Admin_SocialMediaLinksDesc"]</p>
                                    </div>
                                </div>
                                <input asp-for="InstagramUrl" type="hidden" /><input asp-for="FacebookUrl" type="hidden" />
                                <input asp-for="TiktokUrl" type="hidden" /><input asp-for="YoutubeUrl" type="hidden" />
                                <input asp-for="PinterestUrl" type="hidden" /><input asp-for="TwitterUrl" type="hidden" />
                                
                                <div class="mb-3 p-3 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                    <div class="small text-muted mb-0 d-flex align-items-center gap-2">
                                        <i class="fas fa-circle-info text-primary fa-lg"></i>
                                        <span>
                                            @(isAr 
                                                ? "اختر شبكة التواصل من القائمة المنسدلة وسيتم تعيين الأيقونة والاسم ولون المنصة تلقائياً وبشكل احترافي دون الحاجة لكتابة أكواد Font Awesome يدوياً."
                                                : "Select a social network from the dropdown; the icon, branding, and name are configured automatically without manual Font Awesome codes.")
                                        </span>
                                    </div>
                                </div>

                                <div id="socialLinksList" class="d-grid gap-3 mb-3">
                                    @foreach (var link in (ViewBag.SosyalMedyaLinkleri as IEnumerable<FilistinProje.Core.Varliklar.SosyalMedyaLink> ?? Enumerable.Empty<FilistinProje.Core.Varliklar.SosyalMedyaLink>()))
                                    {
                                        <div class="border rounded-3 p-3 social-link-row shadow-sm" data-id="@link.Id" style="background:#fff;">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-3">
                                                    <label class="ca-label">@(isAr ? "الشبكة / الأيقونة" : "Network & Icon")</label>
                                                    <div class="d-flex gap-2 align-items-center">
                                                        <span class="social-icon-badge rounded-2 d-inline-flex align-items-center justify-content-center shadow-sm" style="width:38px; height:38px; min-width:38px; background:#f1f5f9; font-size:1.15rem;">
                                                            <i class="@(string.IsNullOrWhiteSpace(link.IkonSinifi) ? "fas fa-share-nodes" : link.IkonSinifi)"></i>
                                                        </span>
                                                        <select class="ca-select social-preset-select">
                                                            <option value="fab fa-facebook-f" data-platform="Facebook" data-color="#1877f2" data-bg="#eff6ff" data-ph="https://facebook.com/...">Facebook</option>
                                                            <option value="fab fa-instagram" data-platform="Instagram" data-color="#e1306c" data-bg="#fdf2f8" data-ph="https://instagram.com/...">Instagram</option>
                                                            <option value="fab fa-whatsapp" data-platform="WhatsApp" data-color="#25d366" data-bg="#f0fdf4" data-ph="https://wa.me/970...">WhatsApp</option>
                                                            <option value="fab fa-tiktok" data-platform="TikTok" data-color="#000000" data-bg="#f8fafc" data-ph="https://tiktok.com/@@...">TikTok</option>
                                                            <option value="fab fa-x-twitter" data-platform="X (Twitter)" data-color="#000000" data-bg="#f8fafc" data-ph="https://x.com/...">X (Twitter)</option>
                                                            <option value="fab fa-youtube" data-platform="YouTube" data-color="#ff0000" data-bg="#fef2f2" data-ph="https://youtube.com/@@...">YouTube</option>
                                                            <option value="fab fa-telegram" data-platform="Telegram" data-color="#0088cc" data-bg="#f0f9ff" data-ph="https://t.me/...">Telegram</option>
                                                            <option value="fab fa-snapchat" data-platform="Snapchat" data-color="#ca8a04" data-bg="#fefce8" data-ph="https://snapchat.com/add/...">Snapchat</option>
                                                            <option value="fab fa-linkedin-in" data-platform="LinkedIn" data-color="#0a66c2" data-bg="#eff6ff" data-ph="https://linkedin.com/company/...">LinkedIn</option>
                                                            <option value="fab fa-pinterest-p" data-platform="Pinterest" data-color="#bd081c" data-bg="#fef2f2" data-ph="https://pinterest.com/...">Pinterest</option>
                                                            <option value="fas fa-globe" data-platform="@(isAr ? "موقع إلكتروني" : "Website")" data-color="#475569" data-bg="#f1f5f9" data-ph="https://...">@(isAr ? "موقع آخر / مخصص" : "Other / Custom")</option>
                                                        </select>
                                                    </div>
                                                    <input type="hidden" class="social-icon" value="@link.IkonSinifi" />
                                                </div>
                                                <div class="col-md-2">
                                                    <label class="ca-label">@(isAr ? "اسم العرض" : "Display Name")</label>
                                                    <input class="ca-input social-platform" value="@link.PlatformAdi" placeholder="Facebook, Instagram..." />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="ca-label">URL</label>
                                                    <input class="ca-input social-url" value="@link.Url" dir="ltr" placeholder="https://..." />
                                                </div>
                                                <div class="col-md-1">
                                                    <label class="ca-label">@Localizer["Admin_Sira"]</label>
                                                    <input class="ca-input social-order" type="number" value="@link.Sira" min="0" />
                                                </div>
                                                <div class="col-md-1 text-center">
                                                    <label class="ca-label">@Localizer["Admin_Aktif"]</label>
                                                    <input class="form-check-input social-active d-block mx-auto mt-2" type="checkbox" checked="@link.AktifMi" style="width:2.2em; height:1.2em;" />
                                                </div>
                                                <div class="col-md-1 d-flex gap-1 justify-content-end">
                                                    <button type="button" class="ca-btn ca-btn-primary social-save" title="@(isAr ? "حفظ" : "Save")"><i class="fas fa-save"></i></button>
                                                    <button type="button" class="ca-btn ca-btn-outline text-danger social-delete" title="@(isAr ? "حذف" : "Delete")"><i class="fas fa-trash"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button type="button" id="addSocialLink" class="ca-btn ca-btn-outline"><i class="fas fa-plus"></i> @Localizer["Admin_SosyalMedya_YeniEkle"]</button>
                                <script>
                                    document.addEventListener('DOMContentLoaded', () => {
                                        const list = document.getElementById('socialLinksList');
                                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                                        const syncPreset = (row, presetVal) => {
                                            const select = row.querySelector('.social-preset-select');
                                            const badge = row.querySelector('.social-icon-badge');
                                            const iconInput = row.querySelector('.social-icon');
                                            const platformInput = row.querySelector('.social-platform');
                                            const urlInput = row.querySelector('.social-url');

                                            let matched = false;
                                            if (presetVal) {
                                                for (let opt of select.options) {
                                                    if (opt.value === presetVal) {
                                                        select.value = presetVal;
                                                        matched = true;
                                                        break;
                                                    }
                                                }
                                            }
                                            if (!matched && presetVal) {
                                                select.value = 'fas fa-globe';
                                            }

                                            const selectedOpt = select.options[select.selectedIndex];
                                            if (selectedOpt) {
                                                const iconClass = selectedOpt.value;
                                                const color = selectedOpt.dataset.color || '#475569';
                                                const bg = selectedOpt.dataset.bg || '#f1f5f9';
                                                const platform = selectedOpt.dataset.platform || '';
                                                const placeholder = selectedOpt.dataset.ph || 'https://...';

                                                badge.innerHTML = `<i class="${iconClass}"></i>`;
                                                badge.style.color = color;
                                                badge.style.background = bg;
                                                iconInput.value = iconClass;
                                                if (urlInput && !urlInput.value) {
                                                    urlInput.placeholder = placeholder;
                                                }
                                            }
                                        };

                                        const wire = row => {
                                            const select = row.querySelector('.social-preset-select');
                                            const iconInput = row.querySelector('.social-icon');
                                            const platformInput = row.querySelector('.social-platform');
                                            const urlInput = row.querySelector('.social-url');

                                            // initialize preset
                                            if (iconInput && iconInput.value) {
                                                syncPreset(row, iconInput.value);
                                            } else if (select) {
                                                syncPreset(row, select.value);
                                            }

                                            select?.addEventListener('change', () => {
                                                const opt = select.options[select.selectedIndex];
                                                syncPreset(row, opt.value);
                                                if (!platformInput.value || Object.values(select.options).some(o => o.dataset.platform === platformInput.value)) {
                                                    platformInput.value = opt.dataset.platform || '';
                                                }
                                                if (urlInput && (!urlInput.value || urlInput.value === 'https://')) {
                                                    urlInput.placeholder = opt.dataset.ph || 'https://...';
                                                }
                                            });

                                            row.querySelector('.social-save')?.addEventListener('click', async () => {
                                                const fd = new FormData(); 
                                                fd.append('__RequestVerificationToken', token); 
                                                fd.append('id', row.dataset.id || '0');
                                                fd.append('platformAdi', row.querySelector('.social-platform').value); 
                                                fd.append('url', row.querySelector('.social-url').value);
                                                fd.append('ikonSinifi', row.querySelector('.social-icon').value); 
                                                fd.append('sira', row.querySelector('.social-order').value || '0'); 
                                                fd.append('aktifMi', row.querySelector('.social-active').checked);

                                                const data = await (await fetch('/Admin/SosyalMedya/KaydetJson', { method:'POST', body:fd })).json();
                                                if (data.success) {
                                                    location.href = '/Admin/Ayarlar?tab=sosyal';
                                                } else {
                                                    alert(data.message);
                                                }
                                            });

                                            row.querySelector('.social-delete')?.addEventListener('click', async () => {
                                                if (!confirm('@Localizer["Admin_AreYouSure"]')) return;
                                                const fd = new FormData(); 
                                                fd.append('__RequestVerificationToken', token); 
                                                fd.append('id', row.dataset.id);
                                                const data = await (await fetch('/Admin/SosyalMedya/SilJson', { method:'POST', body:fd })).json();
                                                if (data.success) {
                                                    row.remove();
                                                } else {
                                                    alert(data.message);
                                                }
                                            });
                                        };

                                        list.querySelectorAll('.social-link-row').forEach(wire);

                                        document.getElementById('addSocialLink')?.addEventListener('click', () => {
                                            const row = document.createElement('div'); 
                                            row.className = 'border rounded-3 p-3 social-link-row shadow-sm'; 
                                            row.dataset.id = '0';
                                            row.style.background = '#fff';
                                            row.innerHTML = `
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-3">
                                                        <label class="ca-label">@(isAr ? "الشبكة / الأيقونة" : "Network & Icon")</label>
                                                        <div class="d-flex gap-2 align-items-center">
