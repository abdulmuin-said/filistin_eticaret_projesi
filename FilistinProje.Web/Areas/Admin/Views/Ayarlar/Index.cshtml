                        <div class="ca-card-header">
                             <h2 class="ca-card-title mb-0">@Localizer["Admin_WhatThisPageAffects"]</h2>

                        </div>
                        <div class="ca-card-body">
                            <ul class="ca-help-list">
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem1"]</span></li>
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem2"]</span></li>
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem3"]</span></li>
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem4"]</span></li>
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem5"]</span></li>
                                 <li><i class="fas fa-check-circle"></i><span>@Localizer["Admin_HelpItem6"]</span></li>

                            </ul>
                        </div>
                    </div>
                </aside>
            </div>

            <div class="ca-settings-save-bar">
                <div class="ca-settings-save-inner">
                     <small class="text-muted"><i class="fas fa-circle-info me-1"></i> @Localizer["Admin_ChangesTakeEffectAfterSave"]</small>
                     <button type="submit" class="ca-btn ca-btn-success ca-btn-lg">
                         <i class="fas fa-save"></i> @Localizer["Admin_SaveAllSettings"]
                     </button>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tabs = document.querySelectorAll('.ca-settings-tab');
            const panels = document.querySelectorAll('.ca-settings-panel');
            const activeTabInput = document.getElementById('activeSettingsTab');

            const activateTab = function(target) {
                const tab = Array.from(tabs).find(item => item.dataset.target === target) || tabs[0];
                if (!tab) return;
                tabs.forEach(item => item.classList.remove('active'));
                panels.forEach(panel => panel.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById('panel-' + tab.dataset.target)?.classList.add('active');
                if (activeTabInput) activeTabInput.value = tab.dataset.target;
                history.replaceState(null, '', '?tab=' + encodeURIComponent(tab.dataset.target));
            };

            tabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    activateTab(this.dataset.target);
                });
            });

            activateTab(activeTabInput?.value || new URLSearchParams(window.location.search).get('tab') || 'genel');

            const kargoSelect = document.getElementById('kargoFirmasiSelect');
            const takipInput = document.querySelector('[name="KargoTakipUrl"]');

            kargoSelect?.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const takipUrl = selectedOption?.dataset?.takipUrl;

                if (takipInput && takipUrl && !takipInput.value.trim()) {
                    takipInput.value = takipUrl;
                }
            });
        });
    </script>
}
