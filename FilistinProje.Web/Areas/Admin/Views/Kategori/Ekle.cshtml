@model FilistinProje.Core.Varliklar.Kategori
@inject IStringLocalizer<SharedResource> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_Yeni_Kategori"];
}

<style>
    .category-edit-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 22px;
        align-items: start;
    }

    .category-aside {
        position: sticky;
        top: 84px;
        display: grid;
        gap: 16px;
    }

    .category-preview {
        min-height: 180px;
        border-radius: var(--ca-radius);
        border: 1px solid var(--ca-border);
        overflow: hidden;
        background: linear-gradient(135deg, #f7f4ee, #ffffff);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .category-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .category-preview-placeholder {
        text-align: center;
        color: var(--ca-text-muted);
    }

    .category-preview-placeholder i {
        display: block;
        font-size: 2rem;
        margin-bottom: 8px;
        color: var(--ca-primary);
    }

    .category-save-bar {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding-top: 14px;
        margin-top: 18px;
        background: linear-gradient(180deg, rgba(247, 244, 238, 0), #f7f4ee 34%);
    }

    @@media (max-width: 1180px) {
        .category-edit-layout {
            grid-template-columns: 1fr;
        }

        .category-aside {
            position: static;
            grid-row: 1;
        }
    }
</style>

<div class="container-fluid ca-fade-in">
    <div class="ca-page-header">
        <div>
             <h1 class="ca-page-title">@Localizer["Admin_Yeni_Kategori"]</h1>
             <p class="ca-page-subtitle">@Localizer["Admin_Yeni_KategoriDesc"]</p>

        </div>
        <a href="/Admin/Kategori" class="ca-btn ca-btn-outline">
             <i class="fas fa-arrow-left"></i> @Localizer["Admin_BackToCategories"]

        </a>
    </div>

    <form asp-action="Ekle" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        }

        <div class="category-edit-layout">
            <div>
                <div class="ca-card mb-3">
                    <div class="ca-card-header">
                         <span class="ca-card-title">@Localizer["Admin_BasicInfo"]</span>

                    </div>
                    <div class="ca-card-body">
                        <div class="row g-3">
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_Kategori_Adi"]</label>
                            </div>
                            <div class="col-lg-4">
                                 <label class="ca-label">@Localizer["Admin_ParentCategories"]</label>

                                <select asp-for="ParentKategoriId" asp-items="ViewBag.ParentKategoriler" class="ca-select"></select>
                            </div>
                            <div class="col-lg-4">
                                <label class="ca-label">Slug</label>
                                <input asp-for="Slug" class="ca-input" placeholder="cam-tablo" />
                            </div>
                            <div class="col-lg-4">
                                <label class="ca-label">@Localizer["Admin_Sira"]</label>
                                <input asp-for="Sira" class="ca-input" type="number" min="0" />
                            </div>
                            <div class="col-lg-4">
                                 <label class="ca-label">@Localizer["Admin_ProductSortType"]</label>
                                 <select asp-for="UrunSiralamaTipi" class="ca-select">
                                     <option value="manual">@Localizer["Admin_ManualSort"]</option>
                                     <option value="newest">@Localizer["Admin_Newest"]</option>
                                     <option value="popular">@Localizer["Admin_Popular"]</option>
                                     <option value="price_asc">@Localizer["Admin_PriceAsc"]</option>
                                     <option value="price_desc">@Localizer["Admin_PriceDesc"]</option>
                                 </select>

                            </div>
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_ShortDescription"]</label>
                                 <textarea asp-for="KisaAciklama" class="ca-textarea" rows="2" placeholder="@Localizer["Admin_ShortDescriptionPlaceholder"]"></textarea>

                            </div>
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_Kategori_Aciklamasi"]</label>
                                 <textarea asp-for="Aciklama" class="ca-textarea" rows="4" placeholder="@Localizer["Admin_Kategori_Aciklamasi_Placeholder"]"></textarea>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="ca-card mb-3">
                    <div class="ca-card-header"><span class="ca-card-title">المحتوى العربي والإنجليزي / Arabic &amp; English</span></div>
                    <div class="ca-card-body">
                        <div class="row g-3">
                            <div class="col-lg-6"><label class="ca-label">@Localizer["CategoryNameAR"]</label><input asp-for="AdAr" class="ca-input" dir="rtl" /></div>
                            <div class="col-lg-6"><label class="ca-label">@Localizer["CategoryNameEN"]</label><input asp-for="AdEn" class="ca-input" dir="ltr" /></div>
                            <div class="col-lg-6"><label class="ca-label">الوصف القصير (العربية)</label><textarea asp-for="KisaAciklamaAr" class="ca-textarea" rows="2" dir="rtl"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">Short description (English)</label><textarea asp-for="KisaAciklamaEn" class="ca-textarea" rows="2" dir="ltr"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">الوصف (العربية)</label><textarea asp-for="AciklamaAr" class="ca-textarea" rows="4" dir="rtl"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">Description (English)</label><textarea asp-for="AciklamaEn" class="ca-textarea" rows="4" dir="ltr"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">النص العلوي (العربية)</label><textarea asp-for="UstMetinAr" class="ca-textarea" rows="3" dir="rtl"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">Top text (English)</label><textarea asp-for="UstMetinEn" class="ca-textarea" rows="3" dir="ltr"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">النص السفلي (العربية)</label><textarea asp-for="AltMetinAr" class="ca-textarea" rows="3" dir="rtl"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">Bottom text (English)</label><textarea asp-for="AltMetinEn" class="ca-textarea" rows="3" dir="ltr"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">وسم الحملة (العربية)</label><input asp-for="KampanyaEtiketiAr" class="ca-input" dir="rtl" /></div>
                            <div class="col-lg-6"><label class="ca-label">Campaign label (English)</label><input asp-for="KampanyaEtiketiEn" class="ca-input" dir="ltr" /></div>
                            <div class="col-lg-6"><label class="ca-label">عنوان SEO (العربية)</label><input asp-for="SeoTitleAr" class="ca-input" dir="rtl" /></div>
                            <div class="col-lg-6"><label class="ca-label">SEO title (English)</label><input asp-for="SeoTitleEn" class="ca-input" dir="ltr" /></div>
                            <div class="col-lg-6"><label class="ca-label">وصف SEO (العربية)</label><textarea asp-for="SeoDescriptionAr" class="ca-textarea" rows="2" dir="rtl"></textarea></div>
                            <div class="col-lg-6"><label class="ca-label">SEO description (English)</label><textarea asp-for="SeoDescriptionEn" class="ca-textarea" rows="2" dir="ltr"></textarea></div>
                        </div>
                    </div>
                </div>

                <div class="ca-card mb-3">
                    <div class="ca-card-header">
                         <span class="ca-card-title">@Localizer["Admin_ImageDisplaySEO"]</span>

                    </div>
                    <div class="ca-card-body">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                 <label class="ca-label">@Localizer["Admin_Kategori_Gorsel_URL"]</label>

                                <input asp-for="GorselUrl" class="ca-input" id="categoryImageUrl" onchange="updateCategoryPreview()" />
                            </div>
                            <div class="col-lg-6">
                                <label class="ca-label">@Localizer["Admin_UploadCategoryImage"]</label>
                                <input type="file" name="gorselDosyasi" id="categoryImageFile" class="ca-input" accept=".jpg,.jpeg,.png,.webp" onchange="previewCategoryFile(event)" />
                                <span class="text-danger small" data-valmsg-for="gorselDosyasi"></span>
                                                           <!-- فاصل احترافي لبانر وترويج الكاتيجوري -->
                            <div class="col-12 mt-4 pt-3 border-top">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-panorama text-warning fa-lg"></i>
                                        <h5 class="fw-bold mb-0 text-dark">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "بانر وترويج الكاتيجوري في صفحة المنتجات (Hero Banner)" : "Category Hero Banner & Promotional Intro")</h5>
                                    </div>
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "يظهر في أعلى صفحة المنتجات" : "Shown on top of Products page")</span>
                                </div>

                                <!-- دليل المقاسات الموصى بها -->
                                <div class="alert alert-light border rounded-3 p-3 mb-4 shadow-sm" style="background:#fffdf9; border-color:#e9dec4 !important;">
                                    <div class="d-flex align-items-start gap-3">
                                        <i class="fas fa-ruler-combined text-warning fa-2x mt-1"></i>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold mb-1" style="color:#313511;">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "دليل المقاسات الموصى بها للصور (Image Dimensions Guide)" : "Recommended Image Sizes Guide")</div>
                                            <p class="small text-muted mb-2">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "لضمان ظهور البانر والصور بجودة فائقة وبدون تشوه أو بطء في التصفح:" : "Ensure crisp, fast-loading images on desktop and mobile:")</p>
                                            <div class="row g-2 small">
                                                <div class="col-md-4">
                                                    <div class="p-2 rounded border bg-white">
                                                        <strong class="d-block text-dark"><i class="fas fa-desktop text-primary me-1"></i> @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "سطح المكتب (Desktop)" : "Desktop Banner")</strong>
                                                        <span class="badge bg-success mt-1">1400 × 450 px</span> أو <span>1200 × 400 px</span>
                                                        <div class="text-muted text-xs mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "نسبة عرض إلى ارتفاع عريضة (16:5)" : "Wide aspect ratio (16:5)")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="p-2 rounded border bg-white">
                                                        <strong class="d-block text-dark"><i class="fas fa-mobile-screen text-success me-1"></i> @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "الهواتف الذكية (Mobile)" : "Mobile Banner")</strong>
                                                        <span class="badge bg-info text-dark mt-1">600 × 400 px</span>
                                                        <div class="text-muted text-xs mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "التركيز في المنتصف لتفادي القص" : "Centered focus to prevent cropping")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="p-2 rounded border bg-white">
                                                        <strong class="d-block text-dark"><i class="fas fa-grip text-warning me-1"></i> @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "صورة الكرت والقائمة" : "Card & Menu Image")</strong>
                                                        <span class="badge bg-secondary mt-1">600 × 600 px</span> أو <span>400 × 300 px</span>
                                                        <div class="text-muted text-xs mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "مربعة (1:1) أو (4:3)" : "Square (1:1) or (4:3)")</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <label class="ca-label">@Localizer["Admin_Kategori_Banner_URL"]</label>
                                <input asp-for="BannerUrl" class="ca-input" id="categoryBannerUrl" dir="ltr" placeholder="https://... أو /uploads/kategoriler/..." onchange="updateBannerPreview()" />
                                <div class="small text-muted mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "رابط مباشر لصورة خلفية البانر الترويجي" : "Direct URL of the category hero banner")</div>
                            </div>
                            <div class="col-lg-6">
                                <label class="ca-label">@Localizer["Admin_UploadCategoryBanner"]</label>
                                <input type="file" name="bannerDosyasi" id="categoryBannerFile" class="ca-input" accept=".jpg,.jpeg,.png,.webp" onchange="previewBannerFile(event)" />
                                <span class="text-danger small" data-valmsg-for="bannerDosyasi"></span>
                                <div class="small text-muted mt-1">@Localizer["Admin_CategoryBannerSizeHelp"]</div>
                            </div>

                            <!-- معاينة البانر -->
                            <div class="col-12" id="bannerPreviewContainer" style="display:none;">
                                <label class="ca-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "معاينة البانر الترويجي:" : "Banner Preview:")</label>
                                <div class="rounded-3 overflow-hidden border shadow-sm position-relative" style="max-height: 200px; background: #182f22;">
                                    <img id="categoryBannerPreviewImg" src="" alt="Banner Preview" style="width: 100%; height: 200px; object-fit: cover;" />
                                    <div class="position-absolute bottom-0 start-0 p-3 text-white" style="background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, transparent 100%); width: 100%;">
                                        <span class="badge bg-warning text-dark mb-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "معاينة مباشرة" : "Live Preview")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <label class="ca-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "وسم الحملة الترويجية (العربية)" : "Campaign Tag (Arabic)")</label>
                                <input asp-for="KampanyaEtiketiAr" class="ca-input" dir="rtl" placeholder="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "مثال: تخفيضات الموسم 30%" : "e.g. Special Season Offers")" />
                                <div class="small text-muted mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "يظهر كشعار ذهبي براق فوق عنوان الكاتيجوري" : "Gold glowing badge above category title")</div>
                            </div>
                            <div class="col-lg-6">
                                <label class="ca-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "وسم الحملة الترويجية (English)" : "Campaign Tag (English)")</label>
                                <input asp-for="KampanyaEtiketiEn" class="ca-input" dir="ltr" placeholder="e.g. Summer Collection / Limited Edition" />
                                <div class="small text-muted mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "الترجمة الإنجليزية لوسم الحملة" : "English campaign tag text")</div>
                            </div>

                            <div class="col-lg-6">
                                <label class="ca-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "النص الترويجي للبانر (العربية)" : "Hero Subtitle / Promo Text (Arabic)")</label>
                                <textarea asp-for="UstMetinAr" class="ca-textarea" rows="3" dir="rtl" placeholder="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "اكتب نبذة ترويجية جذابة تظهر في البانر وتشجع الزوار على تصفح المنتجات..." : "Write a compelling category intro for the banner...")"></textarea>
                                <div class="small text-muted mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "يظهر أسفل اسم الكاتيجوري مباشرة داخل البانر" : "Displayed beneath category title in the banner")</div>
                            </div>
                            <div class="col-lg-6">
                                <label class="ca-label">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "النص الترويجي للبانر (English)" : "Hero Subtitle / Promo Text (English)")</label>
                                <textarea asp-for="UstMetinEn" class="ca-textarea" rows="3" dir="ltr" placeholder="Write an engaging overview for the category hero banner..."></textarea>
                                <div class="small text-muted mt-1">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "الترجمة الإنجليزية للنص الترويجي" : "English banner subtitle")</div>
                            </div>

                            <div class="col-12 mt-3 pt-3 border-top">
                                <h6 class="fw-bold mb-3 text-dark">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "إعدادات القائمة والنشر الإضافية" : "Menu & Publishing Settings")</h6>
                            </div>

                            <div class="col-lg-4">
                                <label class="ca-label">صورة القائمة / Menu image URL</label>
                                <input asp-for="MenuGorselUrl" class="ca-input" dir="ltr" placeholder="Special image shown in the dropdown menu" />
                            </div>
                            <div class="d-none">
                                <label class="ca-label">@Localizer["Admin_SEO_Basligi"]</label>
                                <input asp-for="SeoTitle" class="ca-input" />
                            </div>
                            <div class="d-none">
                                <label class="ca-label">@Localizer["Admin_SEO_Aciklamasi"]</label>
                                <input asp-for="SeoDescription" class="ca-input" />
                            </div>
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_Ust_Metin"]</label>

                                <textarea asp-for="UstMetin" class="ca-textarea" rows="4"></textarea>
                            </div>
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_Alt_Metin"]</label>

                                <textarea asp-for="AltMetin" class="ca-textarea" rows="4"></textarea>
                            </div>
                            <div class="d-none">
                                 <label class="ca-label">@Localizer["Admin_CampaignTag"]</label>
                                 <input asp-for="KampanyaEtiketi" class="ca-input" placeholder="@Localizer["Admin_CampaignTagPlaceholder"]" />

                            </div>
                            <div class="col-lg-4 d-flex align-items-end">
                                <label class="form-check form-switch w-100" style="padding:14px 16px; background:var(--ca-bg); border-radius:var(--ca-radius); border:1px solid var(--ca-border);">
                                    <input asp-for="ReceteGerekliMi" class="form-check-input" type="checkbox" style="width:3em; height:1.5em;">
                                     <span class="form-check-label ms-2">@Localizer["Admin_RecipeRequired"]</span>

                                </label>
                            </div>
                            <div class="col-lg-4 d-flex align-items-end">
                                <label class="form-check form-switch w-100" style="padding:14px 16px; background:var(--ca-bg); border-radius:var(--ca-radius); border:1px solid var(--ca-border);">
                                    <input asp-for="AktifMi" class="form-check-input" type="checkbox" style="width:3em; height:1.5em;">
                                     <span class="form-check-label ms-2">@Localizer["Admin_CategoryPublished"]</span>

                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="category-save-bar">
                     <a href="/Admin/Kategori" class="ca-btn ca-btn-outline">@Localizer["Admin_Cancel"]</a>
                     <button type="submit" class="ca-btn ca-btn-primary">
                         <i class="fas fa-save"></i> @Localizer["Admin_SaveCategory"]
                     </button>

                </div>
            </div>

            <aside class="category-aside">
                <div class="ca-card">
                    <div class="ca-card-header">
                         <span class="ca-card-title">@Localizer["Admin_UsageNote"]</span>

                    </div>
                    <div class="ca-card-body">
                        <div class="category-preview mb-3" id="categoryPreview">
                            <div class="category-preview-placeholder">
                                <i class="fas fa-folder-plus"></i>
                                 @Localizer["Admin_ImagePreview"]

                            </div>
                        </div>
                        <p class="small text-muted mb-0">
                            @Localizer["Admin_CategoryParentHelp"]
                        </p>
                    </div>
                </div>
            </aside>
        </div>
    </form>
</div>

<script>
    function updateCategoryPreview() {
        const input = document.getElementById('categoryImageUrl');
        const preview = document.getElementById('categoryPreview');
        if (!input || !preview) return;

        if (!input.value) {
             preview.innerHTML = '<div class="category-preview-placeholder"><i class="fas fa-folder-plus"></i>@Localizer["Admin_ImagePreview"]</div>';

            return;
        }

         preview.innerHTML = `<img src="${input.value}" alt="@Localizer["Admin_Kategori_Gorsel"]" onerror="this.closest('.category-preview').innerHTML='<div class=&quot;category-preview-placeholder&quot;><i class=&quot;fas fa-image&quot;></i>@Localizer["Admin_ImageLoadFailed"]</div>';">`;

    }

    function previewCategoryFile(event) {
        const file = event.target.files && event.target.files[0];
        const preview = document.getElementById('categoryPreview');
        if (!file || !preview) return;

        const imageUrl = URL.createObjectURL(file);
        preview.innerHTML = `<img src="${imageUrl}" alt="@Localizer["Admin_Kategori_Gorsel"]">`;
        preview.querySelector('img').addEventListener('load', () => URL.revokeObjectURL(imageUrl), { once: true });
    }

    function updateBannerPreview() {
        const urlInput = document.getElementById('categoryBannerUrl');
        const container = document.getElementById('bannerPreviewContainer');
        const img = document.getElementById('categoryBannerPreviewImg');
        if (!urlInput || !container || !img) return;

        if (urlInput.value.trim()) {
            img.src = urlInput.value.trim();
            container.style.display = '';
        } else {
            container.style.display = 'none';
        }
    }

    function previewBannerFile(event) {
        const file = event.target.files && event.target.files[0];
        const container = document.getElementById('bannerPreviewContainer');
        const img = document.getElementById('categoryBannerPreviewImg');
        if (!file || !container || !img) return;

        const url = URL.createObjectURL(file);
        img.src = url;
        container.style.display = '';
        img.addEventListener('load', () => URL.revokeObjectURL(url), { once: true });
    }
</script>
