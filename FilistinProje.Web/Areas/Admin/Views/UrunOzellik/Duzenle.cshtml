@model FilistinProje.Core.Varliklar.UrunOzellikTanimi
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = Localizer["Admin_EditFeatureField"];
}

<div class="container-fluid ca-fade-in">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="ca-card">
                <div class="ca-form-header">
                    <div class="d-flex align-items-center position-relative" style="z-index:2;">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3 me-3"><i class="fas fa-sliders fa-2x"></i></div>
                        <div>
                            <h4 class="mb-1 fw-bold">@Localizer["Admin_EditFeatureField"]</h4>
                            <p class="mb-0 small" style="opacity:.7;">@Localizer["Admin_EditFeatureFieldSubtitle", Model.Ad]</p>
                        </div>
                    </div>
                    <i class="fas fa-layer-group ca-form-header-icon"></i>
                </div>
                <div class="ca-card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        @await Html.PartialAsync("_Form", Model)
                        <hr style="border-color:var(--ca-border); margin:24px 0;">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Admin/UrunOzellik" class="ca-btn ca-btn-outline">@Localizer["Admin_Iptal"]</a>
                            <button type="submit" class="ca-btn ca-btn-primary"><i class="fas fa-save"></i> @Localizer["Admin_SaveChanges"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
